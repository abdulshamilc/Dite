<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Failed - Dité</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/checkout/failed.css">
</head>
<body class="min-h-screen bg-black text-white flex flex-col">
    <%- include("../../partials/user/header") %>
    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 pt-32 pb-20">
        <div class="text-center max-w-2xl">
            <!-- Enhanced Animated Xmark (Failed Icon) -->
            <div class="flex justify-center mb-8">
                <div class="xmark-container relative">
                    <div class="w-40 h-40 border-4 border-red-400 rounded-full flex items-center justify-center bg-black xmark-circle">
                        <div class="w-32 h-32 bg-red-500 rounded-full flex items-center justify-center failed-glow relative z-10">
                            <!-- Animated X mark icon using SVG with looping draw animation -->
                            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-black">
                                <path d="M18 6L6 18M6 6l12 12" class="xmark-path" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Failed Title with gradient styling similar to success -->
            <h1 class="text-3xl md:text-4xl font-bold mb-4 tracking-wider bg-gradient-to-r from-[#745727] to-[#fec575] bg-clip-text text-transparent drop-shadow-lg">
                ORDER FAILED
            </h1>
            <!-- Error Reason Field (Dynamic - uses EJS variable) -->
            <div class="error-reason">
                <strong>Reason for Failure:</strong><br>
                <% if (errorType === 'payment_cancelled') { %>
                  You cancelled the payment. No charges applied.
                <% } else if (errorType === 'verification_failed') { %>
                  Payment couldn't be verified. Contact support.
                <% } else if (errorType === 'cod_failed') { %>
                  Cash on Delivery unavailable for this order. Please try another method.
                <% } else if (errorType === 'network_error') { %>
                  Network issue detected. Please check your connection and retry.
                <% } else if (errorType === 'invalid_amount') { %>
                  Order amount is invalid. Please review your cart.
                <% } else if (errorType === 'order_creation_failed') { %>
                  Failed to create payment order. Please try again.
                <% } else if (errorType === 'payment_init_failed') { %>
                  Payment gateway failed to load. Refresh and retry.
                <% } else if (errorType === 'order_placement_failed') { %>
                  Order couldn't be placed after payment. Your payment may be refunded.
                <% } else { %>
                  <%= errorMessage || 'An unexpected error occurred during payment processing. Please check your payment details and try again.' %>
                <% } %>
            </div>
            <p class="retry-incentive">Don't worry—your cart is safe. Try again?</p>
            <!-- Enhanced Layered Action Buttons (mirroring success structure) -->
            <div class="flex flex-col sm:flex-row gap-8 justify-center items-center">
                <a href="<%= addressId ? `/checkout/payment/${addressId}` : '/checkout/address' %>" class="px-8 py-4 text-lg font-semibold tracking-wider text-white rounded-lg btn-layered transition-all duration-300 w-full sm:w-auto">
                    RETRY PAYMENT
                </a>
                <a href="/" class="px-8 py-4 text-lg font-semibold tracking-wider text-white rounded-lg btn-layered transition-all duration-300 w-full sm:w-auto">
                    CONTINUE SHOPPING
                </a>
            </div>
        </div>
    </main>
    <!-- Footer -->
    <%- include("../../partials/user/footer") %>
</body>
</html>