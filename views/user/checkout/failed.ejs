<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Failed - Dité</title>
  <link rel="stylesheet" href="/style/user/header.css">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background-color: #1a1a1a;
      color: #ffffff;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    .failed-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
      text-align: center;
    }

    .failed-icon {
      font-size: 4rem;
      color: #ef4444;
      margin-bottom: 1rem;
    }

    .failed-title {
      font-size: 2.5rem;
      font-weight: 600;
      color: #ef4444;
      margin-bottom: 1rem;
      letter-spacing: 1px;
    }

    .failed-message {
      font-size: 1.1rem;
      color: #ccc;
      margin-bottom: 2rem;
    }

    .retry-btn,
    .home-btn {
      padding: 1rem 2rem;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-decoration: none;
      display: inline-block;
      margin: 0 1rem;
    }

    .retry-btn {
      background-color: #d4c5a9;
      color: #000;
    }

    .retry-btn:hover {
      background-color: #b3a18e;
    }

    .home-btn {
      background-color: #4ade80;
      color: #000;
    }

    .home-btn:hover {
      background-color: #22c55e;
    }

    @media (max-width: 768px) {
      .failed-container {
        padding: 1rem;
      }

      .retry-btn,
      .home-btn {
        display: block;
        margin: 1rem auto;
        width: 100%;
        max-width: 200px;
      }
    }
  </style>
</head>
<body>
  <%- include("../../partials/user/header") %>

  <main class="failed-container">
    <div class="failed-icon">❌</div>
    <h1 class="failed-title">Order Failed</h1>
    <p class="failed-message">We're sorry, but your order could not be processed at this time. Please try again.</p>

    <a href="/checkout" class="retry-btn">Retry Checkout</a>
    <a href="/" class="home-btn">Back to Home</a>
  </main>

  <%- include("../../partials/user/footer") %>
</body>
</html>