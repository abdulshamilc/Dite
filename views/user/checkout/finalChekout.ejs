<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Final Checkout - Dité</title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      .checkout-container,
      .checkout-container * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #1a1a1a;
        color: #ffffff;
        line-height: 1.6;
      }

      /* Main Content */
      .checkout-container {
        max-width: 1400px;
        margin: 6rem auto 2rem;
        padding: 2rem;
      }

      .checkout-title {
        text-align: center;
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 2rem;
        letter-spacing: 2px;
      }

      .checkout-content {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
      }

      .left-content {
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      /* Checkout Sections */
      .checkout-sections {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .section {
        background-color: #1a1a1a;
        padding: 1.5rem;
        border-radius: 8px;
      }

      .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #d4c5a9;
      }

      /* Order Review */
      .order-review .cart-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background-color: #1a1a1a;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        position: relative;
        align-items: flex-start;
      }

      .item-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 4px;
        background-color: #333;
        flex-shrink: 0;
      }

      .item-details {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }

      .item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
      }

      .item-name {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 0.25rem;
        flex: 1;
      }

      .item-size {
        font-size: 0.85rem;
        color: #999;
      }

      .item-price {
        font-size: 1.1rem;
        font-weight: 600;
        white-space: nowrap;
      }

      .quantity-display {
        font-size: 0.9rem;
        color: #ccc;
        min-width: 30px;
        text-align: center;
      }

      .item-total {
        font-size: 1.1rem;
        font-weight: 600;
        color: #4ade80;
      }

      .item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
        gap: 1rem;
      }

      .stock-status {
        font-size: 0.85rem;
        color: #4ade80;
      }

      .delivery-info {
        font-size: 0.75rem;
        color: #999;
      }

      .delivery-date {
        color: #4ade80;
      }

      /* Address Display */
      .address-display {
        background-color: #333;
        padding: 1.5rem;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .address-name {
        font-weight: 500;
        font-size: 1.1rem;
      }

      .address-line {
        font-size: 0.95rem;
        color: #ccc;
      }

      .view-btn {
        padding: 0.5rem 1rem;
        background-color: transparent;
        color: #d4c5a9;
        border: 1px solid #d4c5a9;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        align-self: flex-start;
        margin-top: 1rem;
      }

      .view-btn:hover {
        background-color: #d4c5a9;
        color: #000;
      }

      /* Payment Selection */
      .payment-selection {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .payment-option {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background-color: #333;
        border-radius: 4px;
        border: 2px solid transparent;
        cursor: pointer;
      }

      .payment-option:hover,
      .payment-option.selected {
        border-color: #d4c5a9;
      }

      .payment-radio {
        width: 20px;
        height: 20px;
        accent-color: #d4c5a9;
      }

      .payment-icon {
        font-size: 1.5rem;
      }

      /* Price Sidebar */
      .price-sidebar {
        flex: 1;
        background-color: #2a2a2a;
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 2rem; /* Matches your .checkout-container padding for smooth sticking */
        align-self: flex-start; /* Ensures it doesn't stretch full height */
        max-height: calc(100vh - 4rem); /* Prevents overflow beyond viewport height, accounting for top/bottom padding */
        overflow-y: auto; /* Allows internal scrolling if content is too tall */
      }

      /* Order Summary in Sidebar */
      .order-summary {
        flex: 1;
      }

      .summary-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #d4c5a9;
        margin-bottom: 1rem;
      }

      .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid #444;
        font-size: 0.9rem;
      }

      .summary-item:last-child {
        border-bottom: none;
      }

      .summary-name {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .summary-qty {
        color: #999;
        white-space: nowrap;
        margin-right: 0.5rem;
      }

      .summary-total {
        font-weight: 500;
        color: #4ade80;
        white-space: nowrap;
      }

      .price-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #d4c5a9;
        margin-bottom: 1rem;
      }

      .price-detail {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #444;
      }

      .price-detail:last-child {
        border-bottom: none;
        font-weight: 600;
        color: #4ade80;
      }

      .confirm-btn {
        width: 100%;
        padding: 1rem;
        background-color: #4ade80;
        color: #000;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: auto;
      }

      .confirm-btn:hover {
        background-color: #22c55e;
      }

      .confirm-btn:disabled {
        background-color: #666;
        cursor: not-allowed;
      }

      /* Payment Status Overlay */
      .payment-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.2rem;
      }

      .payment-overlay.show {
        display: flex;
      }

      /* Modal Styles */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }

      .modal-overlay.show {
        display: flex;
      }

      .modal {
        background-color: #2a2a2a;
        padding: 2rem;
        border-radius: 8px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
      }

      .modal-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #d4c5a9;
        text-align: center;
      }

      .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #999;
        font-size: 1.5rem;
        cursor: pointer;
      }

      .modal-close:hover {
        color: #fff;
      }

      .address-detail {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #444;
      }

      .address-detail:last-child {
        border-bottom: none;
      }

      .address-detail-label {
        font-weight: 500;
        color: #d4c5a9;
      }

      .address-detail-value {
        color: #ccc;
        text-align: right;
      }

      /* Responsive Design */
      @media (max-width: 1024px) {
        .checkout-content {
          flex-direction: column;
        }

        .price-sidebar {
          order: -1;
        }
      }

      @media (max-width: 768px) {
        .checkout-container {
          padding: 1rem;
        }

        .order-review .cart-item {
          flex-direction: column;
          align-items: stretch;
        }

        .item-image {
          width: 100%;
          height: 200px;
          align-self: center;
        }

        .item-header {
          flex-direction: column;
          align-items: stretch;
          gap: 0.5rem;
        }

        .item-price,
        .item-total {
          text-align: right;
        }

        .item-footer {
          flex-direction: column;
          align-items: stretch;
          gap: 0.5rem;
          text-align: center;
        }

        .address-display {
          text-align: left;
        }

        .payment-option {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }

        .price-detail {
          flex-direction: column;
          align-items: flex-start;
          text-align: left;
        }

        .address-detail {
          flex-direction: column;
          align-items: flex-start;
          text-align: left;
        }

        .address-detail-value {
          text-align: left;
          margin-top: 0.25rem;
        }

        /* Adjust sidebar summary for mobile */
        .summary-item {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.25rem;
          text-align: left;
        }

        .summary-qty {
          margin-right: 0;
        }

        .summary-total {
          align-self: flex-end;
        }
      }
      /* Back Button Style */
      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #d4c5a9;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1rem;
        transition: color 0.2s;
        cursor: pointer;
        background: none;
        border: none;
        font-size: 1rem;
        padding: 0;
      }
      .back-btn:hover {
        color: #fff;
      }
    </style>
  </head>

  <body>
        <%- include("../../partials/user/header") %>
    <!-- Main Content -->
    <main class="checkout-container">
      <button onclick="history.back()" class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back
      </button>
      <h1 class="checkout-title">FINAL CHECKOUT</h1>

      <div class="checkout-content">
        <div class="left-content">
          <div class="checkout-sections">
            <!-- Product Overview (Order Review) -->
            <div class="section">
              <h2 class="section-title">Product Overview</h2>
              <div class="order-review">
                <% if (cart && cart.items.length > 0) { %> <%
                cart.items.forEach(item => { %>
                <div class="cart-item">
                  <img
                    src="<%= item.image %>"
                    alt="<%= item.name %>"
                    class="item-image"
                  />
                  <div class="item-details">
                    <div class="item-header">
                      <div>
                        <div class="item-name"><%= item.name %></div>
                        <% if (item.size) { %>
                        <div class="item-size">Size: <%= item.size %></div>
                        <% } %>
                        <div class="quantity-display">
                          Qty: <%= item.quantity %>
                        </div>
                      </div>
                      <div class="item-total">
                        Rs.<%= (item.discountedPrice * item.quantity).toFixed(2) %>
                      </div>
                    </div>
                    <div class="item-footer">
                      <div>
                        <div class="stock-status"><%= item.stockStatus %></div>
                        <div class="delivery-info">
                          Arrives by Tuesday,
                          <span class="delivery-date">Oct 07 @ 10:00</span>
                        </div>
                      </div>
                      <div class="free-delivery">Free Delivery</div>
                    </div>
                  </div>
                </div>
                <% }); %> <% } else { %>
                <p style="text-align: center; padding: 2rem; color: #999">
                  No items in cart.
                </p>
                <% } %>
              </div>
            </div>

            <!-- Delivery Address Display -->
            <div class="section">
              <h2 class="section-title">Delivery Address</h2>
              <% if (selectedAddress) { %>
              <div class="address-display">
                <div class="address-name"><%= selectedAddress.fullName %></div>
                <div class="address-line"><%= selectedAddress.hoNo %>, <%= selectedAddress.street %></div>
                <div class="address-line"><%= selectedAddress.city %>, <%= selectedAddress.state %> - <%= selectedAddress.pin %></div>
                <div class="address-line">Phone: <%= selectedAddress.phone %></div>
                <% if (selectedAddress.altPhone) { %>
                <div class="address-line">Alternate Phone: <%= selectedAddress.altPhone %></div>
                <% } %>
                <div class="address-line">Country: <%= selectedAddress.country %></div>
                <button type="button" class="view-btn" onclick="openViewModal(selectedAddressData)">
                  View Full Details
                </button>
              </div>
              <% } else { %>
              <p style="color: #999; text-align: center; padding: 1rem">
                No address selected.
              </p>
              <% } %>
            </div>

            <!-- Payment Options -->
            <div class="section">
              <h2 class="section-title">Payment Option</h2>
              <div class="payment-selection">
                <label class="payment-option">
                  <input type="radio" class="payment-radio" name="payment" value="razorpay" required />
                  <span class="payment-icon">💳</span>
                  <span>Razorpay</span>
                </label>
                <label class="payment-option">
                  <input type="radio" class="payment-radio" name="payment" value="cod" />
                  <span class="payment-icon">💰</span>
                  <span>Cash on Delivery</span>
                </label>
                <label class="payment-option">
                  <input type="radio" class="payment-radio" name="payment" value="wallet" id="walletOption" />
                  <span class="payment-icon">👛</span>
                  <span>Wallet <span id="wallet-balance"></span></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Price Details Sidebar -->
        <div class="price-sidebar">
          <% if (cart && cart.items.length > 0) { %>
          <div class="order-summary">
            <h3 class="summary-title">Order Summary</h3>
            <% cart.items.forEach(item => { %>
            <div class="summary-item">
              <span class="summary-name"><%= item.name %></span>
              <span class="summary-qty">Qty: <%= item.quantity %> x Rs. <%= item.discountedPrice.toFixed(2) %></span>
              <span class="summary-total">Rs. <%= (item.discountedPrice * item.quantity).toFixed(2) %></span>
            </div>
            <% }); %>
          </div>
          <% } %>

          
          <!-- Coupon Section -->
          <div class="coupon-section" style="margin-bottom: 2rem; border-bottom: 1px solid #444; padding-bottom: 1.5rem;">
            <h3 class="summary-title">Have a Coupon?</h3>
            <div style="display: flex; gap: 0.5rem;">
              <input type="text" id="couponInput" placeholder="Enter code" style="flex: 1; padding: 0.75rem; border-radius: 4px; border: 1px solid #444; background: #333; color: #fff; text-transform: uppercase;">
              <button id="applyCouponBtn" onclick="applyCoupon()" style="padding: 0.5rem 1rem; background: #d4c5a9; color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">APPLY</button>
            </div>
             <p id="couponMessage" style="font-size: 0.85rem; margin-top: 0.5rem; min-height: 1.2em;"></p>
          </div>

          <div>
            <h2 class="price-title">Price Details</h2>
            <% let subtotal = 0; %>
            <% if (cart && cart.items.length > 0) { %>
              <% cart.items.forEach(item => { subtotal += item.discountedPrice * item.quantity; }); %>
            <% } %>
            <div class="price-detail">
              <span>Subtotal</span>
              <span id="checkoutSubtotal">Rs. <%= subtotal.toFixed(2) %></span>
            </div>
            <div class="price-detail" id="discountRow" style="display: none;">
               <span>Discount</span>
               <span id="discountDisplay" style="color: #4ade80;">- Rs. 0.00</span>
            </div>
            <div class="price-detail">
              <span>Delivery Charges</span>
              <span>Rs. 0.00</span>
            </div>
            <div class="price-detail">
              <span>Total</span>
              <span id="checkoutTotal">Rs. <%= subtotal.toFixed(2) %></span>
            </div>
          </div>
          <button class="confirm-btn" id="confirmBtn" onclick="confirmOrder()">
            CONFIRM ORDER
          </button>
        </div>
      </div>
    </main>

    <!-- View Address Modal -->
    <div class="modal-overlay" id="viewModal">
      <div class="modal">
        <button class="modal-close" onclick="closeViewModal()">&times;</button>
        <h2 class="modal-title">View Address</h2>
        <div class="address-view">
          <div class="address-detail">
            <span class="address-detail-label">Full Name:</span>
            <span class="address-detail-value" id="viewFullName"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Phone:</span>
            <span class="address-detail-value" id="viewPhone"></span>
          </div>
          <div
            class="address-detail"
            id="viewAltPhoneContainer"
            style="display: none"
          >
            <span class="address-detail-label">Alternate Phone:</span>
            <span class="address-detail-value" id="viewAltPhone"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">House No.:</span>
            <span class="address-detail-value" id="viewHoNo"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Street:</span>
            <span class="address-detail-value" id="viewStreet"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">City:</span>
            <span class="address-detail-value" id="viewCity"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">State:</span>
            <span class="address-detail-value" id="viewState"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Pin Code:</span>
            <span class="address-detail-value" id="viewPin"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Country:</span>
            <span class="address-detail-value" id="viewCountry"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Status Overlay -->
    <div class="payment-overlay" id="paymentOverlay">
      <div id="paymentMessage">Processing payment...</div>
    </div>

    <!-- Error Modal -->
    <div class="modal-overlay" id="errorModal" style="z-index: 200;">
      <div class="modal" style="max-width: 400px; text-align: center; border: 1px solid #444;">
        <button class="modal-close" onclick="closeErrorModal()">&times;</button>
        <div style="margin-bottom: 1rem; color: #ef4444;">
           <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h2 class="modal-title" style="margin-bottom: 0.5rem;" id="errorTitle">Action Required</h2>
        <p style="color: #9ca3af; margin-bottom: 1.5rem;" id="errorMessage">Please select a payment method.</p>
        <button onclick="closeErrorModal()" style="padding: 0.6rem 2rem; background: #333; color: white; border: 1px solid #555; border-radius: 4px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#444'" onmouseout="this.style.background='#333'">OK</button>
      </div>
    </div>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

   <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<%
  let globalSubtotal = 0;
  if (cart && cart.items.length > 0) {
    cart.items.forEach(item => { globalSubtotal += item.discountedPrice * item.quantity; });
  }
%>
<script>
  // Pass data from EJS to JS
  const subtotal = <%= globalSubtotal %>;
  const cartItems = <%- JSON.stringify(cart ? cart.items : []) %>;
  const selectedAddressId = '<%= selectedAddress ? selectedAddress._id : "" %>';
  const selectedAddressData = <%- JSON.stringify(selectedAddress || null) %>;
  const selectedAddress = <%- JSON.stringify(selectedAddress) %>;
  const userEmail = '<%= user ? user.email : "" %>'; // Assume user object from backend; fallback empty
  let razorpayInstance = null;
  let appliedCouponCode = null;
  let currentTotal = subtotal;

  async function applyCoupon() {
    const couponInput = document.getElementById('couponInput');
    const messageEl = document.getElementById('couponMessage');
    const code = couponInput.value.trim();

    if (!code) {
      messageEl.textContent = 'Please enter a coupon code.';
      messageEl.style.color = '#ef4444';
      return;
    }

    // Disable button to prevent double clicks
    const applyBtn = document.getElementById('applyCouponBtn');
    applyBtn.disabled = true;
    applyBtn.textContent = '...';

    try {
      const response = await fetch('/checkout/apply-coupon', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ couponCode: code, subtotal: subtotal }) // Use base subtotal for calculation
      });

      const data = await response.json();

      if (data.success) {
        messageEl.textContent = `Coupon '${data.couponCode}' applied! You saved Rs. ${data.discountAmount.toFixed(2)}`;
        messageEl.style.color = '#4ade80';
        
        // Update UI
        document.getElementById('discountRow').style.display = 'flex';
        document.getElementById('discountDisplay').textContent = `- Rs. ${data.discountAmount.toFixed(2)}`;
        document.getElementById('checkoutTotal').textContent = `Rs. ${data.newTotal.toFixed(2)}`;
        
        appliedCouponCode = data.couponCode;
        currentTotal = data.newTotal;
        
        // Disable input
        couponInput.disabled = true;
        applyBtn.textContent = 'APPLIED';
      } else {
        messageEl.textContent = data.message;
        messageEl.style.color = '#ef4444';
        applyBtn.disabled = false;
        applyBtn.textContent = 'APPLY';
        appliedCouponCode = null;
      }
    } catch (error) {
      console.error('Error applying coupon:', error);
      messageEl.textContent = 'Error applying coupon. Please try again.';
      messageEl.style.color = '#ef4444';
      applyBtn.disabled = false;
      applyBtn.textContent = 'APPLY';
    }
  }

  // Utility to redirect to failed page with error message and type
  function redirectToFailed(errorMsg, errorType = 'unknown', deleteCart = false) {
    const encodedError = encodeURIComponent(errorMsg);
    const encodedType = encodeURIComponent(errorType);
    const params = new URLSearchParams({
      error: encodedError,
      type: encodedType,
      deleteCart: deleteCart ? 'true' : 'false',
      addressId: selectedAddressId
    });
    window.location.href = `/checkout/failed?${params}`;
  }

  // Confirm Order (with validations)
  function confirmOrder() {
    if (cartItems.length === 0) {
      showErrorModal("Your cart is empty. Add items to proceed.", "Cart Empty");
      return;
    }
    if (!selectedAddressId) {
      showErrorModal("Please select a delivery address.", "Address Missing");
      return;
    }
    const selectedPayment = document.querySelector(".payment-radio:checked");
    if (!selectedPayment) {
      showErrorModal("Please select a valid payment option to complete your order.", "Payment Method Missing");
      return;
    }
    const paymentMethod = selectedPayment.value;
    document.getElementById('confirmBtn').disabled = true;
    if (paymentMethod === 'cod') {
      // COD flow
      showPaymentStatus('Placing COD order...');
      fetch('/checkout/placeOrder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cartItems,
          addressId: selectedAddressId,
          paymentMethod: 'cod',
          couponCode: appliedCouponCode
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = '/checkout/success';
        } else {
          const errorMsg = data.message || 'COD order placement failed. Please try again.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'cod_failed', true), 1500); // Brief show, then redirect
        }
      })
      .catch(err => {
        console.error('Error:', err);
        const errorMsg = 'Network error during COD order placement. Please check your connection and try again.';
        showPaymentStatus(errorMsg, true);
        setTimeout(() => redirectToFailed(errorMsg, 'network_error'), 1500);
      });
    } else if (paymentMethod === 'razorpay') {
      showPaymentStatus('Initiating Razorpay...');
      initiateRazorpay();
    } else if (paymentMethod === 'wallet') {
      if(userWalletBalance < subtotal){
        showErrorModal('Insufficient wallet balance.', "Wallet Error");
        document.getElementById('confirmBtn').disabled = false;
        return;
      }
      showPaymentStatus('Paying from Wallet...');
      fetch('/checkout/placeOrder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cartItems,
          addressId: selectedAddressId,
          paymentMethod: 'wallet',
          couponCode: appliedCouponCode // Add coupon code to wallet payment
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = '/checkout/success';
        } else {
          const errorMsg = data.message || 'Wallet payment failed. Please try again.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'wallet_failed', true), 1500);
        }
      })
      .catch(err => {
        console.error('Error:', err);
        const errorMsg = 'Network error during wallet payment. Please check your connection and try again.';
        showPaymentStatus(errorMsg, true);
        setTimeout(() => redirectToFailed(errorMsg, 'network_error'), 1500);
      });
    }
  }

  // Initiate Razorpay (added try-catch)
  function initiateRazorpay() {
    if (!currentTotal || currentTotal < 1) { // Use currentTotal
      const errorMsg = 'Invalid order amount. Please check your cart.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'invalid_amount'), 1500);
      return;
    }
    fetch('/createOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        amount: currentTotal, // Use currentTotal which includes discount
        currency: "INR",
        receipt: "receipt#" + Date.now(),
        notes: { desc: "Order Payment" }
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success && data.order) {
        showPaymentStatus('Opening payment modal...');
        openRazorpayCheckout(data.order);
      } else {
        throw new Error(data.message || 'Order creation failed');
      }
    })
    .catch(err => {
      console.error('Error creating order:', err);
      const errorMsg = err.message || 'Failed to initiate Razorpay order. Please try again.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'order_creation_failed'), 1500);
    });
  }

  // Open Razorpay Checkout (added email prefill)
  function openRazorpayCheckout(order) {
    const options = {
      key: '<%= process.env.RAZORPAY_KEY_ID %>', // Make sure this env var is exposed or hardcoded if safe
      amount: Math.round(currentTotal * 100), // Amount in paise, using updated total
      currency: "INR",
      name: "Dité",
      description: `Payment of Rs. ${currentTotal.toFixed(2)}`, // Use currentTotal for description
      order_id: order.id,
      handler: function(response) {
        verifyRazorpayPayment(response);
      },
      prefill: {
        name: selectedAddress ? selectedAddress.fullName : '',
        email: userEmail, // Now uses user email
        contact: selectedAddress ? selectedAddress.phone : ''
      },
      theme: {
        color: '#d4c5a9'
      },
      modal: {
        ondismiss: function() {
          const errorMsg = 'Payment was cancelled by user.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'payment_cancelled'), 1500);
        }
      }
    };
    try {
      razorpayInstance = new Razorpay(options);
      razorpayInstance.open();
    } catch (err) {
      console.error('Razorpay init error:', err);
      const errorMsg = 'Payment modal failed to load. Please refresh and try again.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'payment_init_failed'), 1500);
    }
  }

  // Verify Razorpay Payment (unchanged, but added catch)
  function verifyRazorpayPayment(response) {
    showPaymentStatus('Verifying payment...');
    fetch('/verifyPayment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        razorpay_payment_id: response.razorpay_payment_id,
        razorpay_order_id: response.razorpay_order_id,
        razorpay_signature: response.razorpay_signature
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        placeOrderAfterPayment('razorpay', response.razorpay_payment_id, response.razorpay_order_id);
      } else {
        throw new Error(data.message || 'Payment verification failed');
      }
    })
    .catch(err => {
      console.error('Verification error:', err);
      const errorMsg = err.message || 'Payment verification failed. Please contact support.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'verification_failed', false), 1500);
    });
  }

  // Place Order After Payment (unchanged)
  function placeOrderAfterPayment(paymentMethod, paymentId, razorpayOrderId) {
    showPaymentStatus('Placing your order...');
    fetch('/checkout/placeOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: cartItems,
        addressId: selectedAddressId,
        paymentMethod: paymentMethod,
        razorpayPaymentId: paymentId,
        razorpayOrderId: razorpayOrderId,
        couponCode: appliedCouponCode // Add coupon code to Razorpay order
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        showPaymentStatus('Order placed successfully!');
        setTimeout(() => window.location.href = '/checkout/success', 2000);
      } else {
        throw new Error(data.message || 'Order placement failed after payment');
      }
    })
    .catch(err => {
      console.error('Order placement error:', err);
      const errorMsg = err.message || 'Order placement failed after payment. Your payment may be refunded.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'order_placement_failed', false), 1500);
    });
  }

  // Utility Functions
  function showErrorModal(message, title = "Action Required") {
    Swal.fire({
      icon: 'warning',
      title: title,
      text: message,
      background: '#2a2a2a',
      color: '#ffffff',
      confirmButtonColor: '#d4c5a9'
    });
  }

  function closeErrorModal() {
      const modal = document.getElementById('errorModal');
      if(modal) modal.classList.remove('show');
  }

  function showPaymentStatus(message, isError = false) {
    const overlay = document.getElementById('paymentOverlay');
    const msgEl = document.getElementById('paymentMessage');
    msgEl.textContent = message;
    if (isError) {
      msgEl.style.color = '#ff6b6b';
    } else {
      msgEl.style.color = '#4ade80';
    }
    overlay.classList.add('show');
  }
  function hidePaymentStatus() {
    document.getElementById('paymentOverlay').classList.remove('show');
  }

  // Handle payment selection (unchanged)
  document.addEventListener("DOMContentLoaded", function () {
    const paymentRadios = document.querySelectorAll(".payment-radio");
    paymentRadios.forEach((radio) => {
      radio.addEventListener("change", function () {
        document.querySelectorAll(".payment-option").forEach((opt) => opt.classList.remove("selected"));
        this.closest(".payment-option").classList.add("selected");
      });
    });
  });

  // Modal functions (unchanged)
  function openViewModal(addressData) {
    document.getElementById("viewFullName").textContent = addressData.fullName || "";
    document.getElementById("viewPhone").textContent = addressData.phone || "";
    const altPhoneContainer = document.getElementById("viewAltPhoneContainer");
    if (addressData.altPhone) {
      document.getElementById("viewAltPhone").textContent = addressData.altPhone;
      altPhoneContainer.style.display = "flex";
    } else {
      altPhoneContainer.style.display = "none";
    }
    document.getElementById("viewHoNo").textContent = addressData.hoNo || "";
    document.getElementById("viewStreet").textContent = addressData.street || "";
    document.getElementById("viewCity").textContent = addressData.city || "";
    document.getElementById("viewState").textContent = addressData.state || "";
    document.getElementById("viewPin").textContent = addressData.pin || "";
    document.getElementById("viewCountry").textContent = addressData.country || "";
    document.getElementById("viewModal").classList.add("show");
  }
  function closeViewModal() {
    document.getElementById("viewModal").classList.remove("show");
  }
  document.getElementById("viewModal").addEventListener("click", function (e) {
    if (e.target === this) {
      closeViewModal();
    }
  });

  let userWalletBalance = 0;
  fetch('/wallet/api/balance').then(res => res.json()).then(({balance})=>{
    userWalletBalance = balance || 0;
    const balLabel = document.getElementById('wallet-balance');
    if(balLabel) {
      balLabel.textContent = `(Balance: ₹${userWalletBalance.toFixed(2)})`;
    }
    const walletRadio = document.getElementById('walletOption');
    if(walletRadio) {
      walletRadio.disabled = userWalletBalance < subtotal;
      if(walletRadio.disabled) {
        walletRadio.parentElement.style.opacity = '0.5';
        walletRadio.parentElement.title = 'Insufficient Wallet Balance';
      }
    }
  }).catch(()=>{});
</script>
</body>
</html>