<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Final Checkout - Dité</title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        background: #050505;
        color: #e0e0e0;
        min-height: 100vh;
        padding-top: 85px;
      }

      /* Price/Amount Standard Font */
      .item-total, .price-value, .summary-total, .summary-qty, 
      #checkoutSubtotal, #checkoutTotal, #discountDisplay, #wallet-balance {
        font-family: Arial, sans-serif !important;
      }

      .checkout-container {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 4rem 6rem;
      }

      @media (max-width: 1200px) {
        .checkout-container {
          padding: 3rem 4rem;
        }
      }

      @media (max-width: 992px) {
        .checkout-container {
          padding: 2rem 3rem;
        }
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 2rem;
        font-size: 1rem;
      }

      .back-btn:hover {
        background: rgba(212, 175, 55, 0.2);
        transform: translateX(-5px);
      }

      .checkout-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 300;
        letter-spacing: 6px;
        text-align: center;
        margin-bottom: 3rem;
        background: linear-gradient(135deg, #d4af37 0%, #f4e5c3 50%, #d4af37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: fadeInDown 0.8s ease-out;
      }

      @keyframes fadeInDown {
        from {
          opacity: 0;
          transform: translateY(-30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .checkout-content {
        display: grid;
        grid-template-columns: 1fr 450px;
        gap: 3rem;
        animation: fadeInUp 0.8s ease-out;
      }

      .left-content {
        flex: 1;
      }

      .section {
        background: #0d0d0d;
        border: 1px solid rgba(212, 175, 55, 0.12);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.4s ease;
      }

      .section:hover {
        border-color: rgba(212, 175, 55, 0.4);
        box-shadow: 0 10px 40px rgba(212, 175, 55, 0.15);
      }

      .section-title {
        font-size: 1.8rem;
        font-weight: 400;
        letter-spacing: 2px;
        color: #d4af37;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      }

      /* Cart Items */
      .cart-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(212, 175, 55, 0.08);
        border-radius: 12px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
      }

      .cart-item:hover {
        border-color: rgba(212, 175, 55, 0.3);
        transform: translateY(-2px);
      }

      .item-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid rgba(212, 175, 55, 0.2);
      }

      .item-details {
        flex: 1;
      }

      .item-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .item-name {
        font-size: 1.3rem;
        font-weight: 500;
        color: #d4af37;
        letter-spacing: 0.5px;
      }

      .item-size, .quantity-display {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 0.25rem;
      }

      .item-total {
        font-size: 1.4rem;
        font-weight: 600;
        color: #fff;
      }

      .item-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(212, 175, 55, 0.1);
      }

      .stock-status {
        color: #4ade80;
        font-size: 0.9rem;
        font-weight: 500;
      }

      .delivery-info {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
      }

      .delivery-date {
        color: #d4af37;
      }

      /* Address Display */
      .address-display {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(212, 175, 55, 0.12);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s ease;
      }

      .address-display:hover {
        border-color: rgba(212, 175, 55, 0.3);
      }

      .address-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #d4af37;
        margin-bottom: 0.75rem;
      }

      .address-line {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 0.5rem;
      }

      .view-btn {
        margin-top: 1rem;
        padding: 0.6rem 1.5rem;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
      }

      .view-btn:hover {
        background: rgba(212, 175, 55, 0.2);
        border-color: #d4af37;
      }

      /* Payment Options */
      .payment-selection {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .payment-option {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.01);
        border: 2px solid rgba(212, 175, 55, 0.12);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        gap: 1rem;
      }

      .payment-option:hover {
        border-color: rgba(212, 175, 55, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(212, 175, 55, 0.1);
      }

      .payment-option.selected {
        border-color: #d4af37;
        background: rgba(212, 175, 55, 0.05);
      }

      .payment-radio {
        width: 20px;
        height: 20px;
        cursor: pointer;
      }

      .payment-icon {
        font-size: 1.5rem;
      }

      /* Price Sidebar */
      .price-sidebar {
        position: sticky;
        top: 100px;
        height: fit-content;
      }

      .order-summary {
        background: #0d0d0d;
        border: 1px solid rgba(212, 175, 55, 0.12);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.4s ease;
      }

      .order-summary:hover {
        border-color: rgba(212, 175, 55, 0.4);
        box-shadow: 0 10px 40px rgba(212, 175, 55, 0.15);
      }

      .summary-title {
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 2px;
        color: #d4af37;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        margin-bottom: 0.75rem;
      }

      .summary-name {
        font-size: 1rem;
        color: #d4af37;
        font-weight: 500;
      }

      .summary-qty {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
      }

      .summary-total {
        font-size: 1.1rem;
        color: #fff;
        font-weight: 600;
      }

      /* Coupon Section */
      .coupon-section {
        background: #0d0d0d;
        border: 1px solid rgba(212, 175, 55, 0.12);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
      }

      .coupon-section input {
        flex: 1;
        padding: 0.9rem 1.2rem;
        background: #0a0a0a;
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 8px;
        color: #fff;
        text-transform: uppercase;
        font-size: 1rem;
      }

      .coupon-section input:focus {
        outline: none;
        border-color: #d4af37;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
      }

      .coupon-section button {
        padding: 0.9rem 1.8rem;
        background: linear-gradient(135deg, #a08830, #c4b896);
        color: #000;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
      }

      .coupon-section button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
      }

      #couponMessage {
        font-size: 0.9rem;
        margin-top: 0.75rem;
        min-height: 1.2em;
      }

      /* Price Details */
      .price-title {
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 2px;
        color: #d4af37;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .price-detail {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.8);
        border-bottom: 1px solid rgba(212, 175, 55, 0.1);
      }

      .price-detail span:last-child {
        font-weight: 600;
        color: #fff;
      }

      #discountRow {
        color: #4ade80;
      }

      /* Coupon List Styles */
      .available-coupons {
        margin-top: 1.5rem;
        border-top: 1px solid rgba(212, 175, 55, 0.1);
        padding-top: 1.5rem;
      }

      .coupon-list-title {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1rem;
      }

      .coupon-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        max-height: 300px;
        overflow-y: auto;
        padding-right: 5px;
      }
      
      .coupon-list::-webkit-scrollbar {
        width: 4px;
      }
      
      .coupon-list::-webkit-scrollbar-thumb {
        background: rgba(212, 175, 55, 0.2); 
        border-radius: 4px;
      }

      .coupon-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(212, 175, 55, 0.15);
        border-radius: 8px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .coupon-card:hover {
        background: rgba(212, 175, 55, 0.08);
        border-color: rgba(212, 175, 55, 0.3);
      }

      .coupon-card.selected {
        background: rgba(74, 222, 128, 0.1);
        border-color: #4ade80;
      }

      .coupon-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.4rem;
      }

      .coupon-code {
        font-family: monospace;
        font-size: 1.1rem;
        color: #d4af37;
        font-weight: 600;
        letter-spacing: 0.5px;
      }

      .coupon-offer {
        color: #4ade80;
        font-size: 0.9rem;
        font-weight: 500;
      }

      .coupon-desc {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.4;
      }

      .view-coupons-link {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.9rem;
        color: #d4af37; /* Gold color matching theme */
        text-decoration: underline;
        cursor: pointer;
        transition: color 0.3s;
      }
      
      .view-coupons-link:hover {
        color: #f4e5c3;
      }

      .remove-coupon-btn {
        padding: 0.9rem 1.2rem;
        background: rgba(239, 68, 68, 0.1); 
        color: #ef4444; 
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        display: none; /* Hidden by default */
        align-items: center;
        justify-content: center;
      }

      .remove-coupon-btn:hover {
        background: rgba(239, 68, 68, 0.2);
        border-color: #ef4444;
      }


      /* Confirm Button */
      .confirm-btn {
        width: 100%;
        padding: 1.2rem;
        background: linear-gradient(135deg, #a08830, #c4b896);
        border: none;
        border-radius: 8px;
        color: #000;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
      }

      .confirm-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
      }

      .confirm-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      /* Modal */
      .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .modal-overlay.show {
        display: flex;
        opacity: 1;
      }

      .modal {
        background: #1a1a1a;
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 15px;
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        position: relative;
        transform: scale(0.9);
        transition: transform 0.3s ease;
      }

      .modal-overlay.show .modal {
        transform: scale(1);
      }

      .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #d4af37;
        font-size: 2rem;
        cursor: pointer;
        line-height: 1;
      }

      .modal-title {
        font-size: 1.8rem;
        color: #d4af37;
        margin-bottom: 1.5rem;
        letter-spacing: 1px;
      }

      .address-detail {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(212, 175, 55, 0.1);
      }

      .address-detail-label {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
      }

      .address-detail-value {
        color: #fff;
        font-weight: 500;
      }

      /* Payment Overlay */
      .payment-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.95);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .payment-overlay.show {
        display: flex;
        opacity: 1;
      }

      #paymentMessage {
        font-size: 1.5rem;
        color: #4ade80;
        text-align: center;
        padding: 2rem;
      }

      @media (max-width: 1200px) {
        .checkout-content {
          grid-template-columns: 1fr 400px;
          gap: 2rem;
        }
      }

      @media (max-width: 992px) {
        .checkout-content {
          grid-template-columns: 1fr;
        }

        .price-sidebar {
          position: static;
        }
      }

      @media (max-width: 768px) {
        .checkout-container {
          padding: 2rem 1.5rem;
        }

        .cart-item {
          flex-direction: column;
        }

        .item-image {
          width: 100%;
          height: 200px;
        }

        .checkout-title {
          font-size: 2rem;
          letter-spacing: 3px;
        }

        .section {
          padding: 1.5rem;
        }
      }
    </style>
  </head>

  <body>
    <%- include("../../partials/user/header") %>
    
    <main class="checkout-container">
      <button onclick="history.back()" class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back
      </button>
      <h1 class="checkout-title">FINAL CHECKOUT</h1>

      <div class="checkout-content">
        <div class="left-content">
          <!-- Product Overview -->
          <div class="section">
            <h2 class="section-title">Product Overview</h2>
            <div class="order-review">
              <% if (cart && cart.items.length > 0) { %>
                <% cart.items.forEach(item => { %>
                  <div class="cart-item">
                    <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image" />
                    <div class="item-details">
                      <div class="item-header">
                        <div>
                          <div class="item-name"><%= item.name %></div>
                          <% if (item.size) { %>
                            <div class="item-size">Size: <%= item.size %></div>
                          <% } %>
                          <div class="quantity-display">Qty: <%= item.quantity %></div>
                        </div>
                        <div class="item-total">Rs.<%= (item.discountedPrice * item.quantity).toFixed(2) %></div>
                      </div>
                      <div class="item-footer">
                        <div>
                          <div class="stock-status"><%= item.stockStatus %></div>
                          <div class="delivery-info">
                            Arrives by <span class="delivery-date"><%= new Date(item.deliveryDate).toLocaleDateString() %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <p style="text-align: center; padding: 2rem; color: #999">No items in cart.</p>
              <% } %>
            </div>
          </div>

          <!-- Delivery Address -->
          <div class="section">
            <h2 class="section-title">Delivery Address</h2>
            <% if (selectedAddress) { %>
              <div class="address-display">
                <div class="address-name"><%= selectedAddress.fullName %></div>
                <div class="address-line"><%= selectedAddress.hoNo %>, <%= selectedAddress.street %></div>
                <div class="address-line"><%= selectedAddress.city %>, <%= selectedAddress.state %> - <%= selectedAddress.pin %></div>
                <div class="address-line">Phone: <%= selectedAddress.phone %></div>
                <% if (selectedAddress.altPhone) { %>
                  <div class="address-line">Alternate Phone: <%= selectedAddress.altPhone %></div>
                <% } %>
                <div class="address-line">Country: <%= selectedAddress.country %></div>
                <button type="button" class="view-btn" onclick="openViewModal(selectedAddressData)">View Full Details</button>
              </div>
            <% } else { %>
              <p style="color: #999; text-align: center; padding: 1rem">No address selected.</p>
            <% } %>
          </div>

          <!-- Payment Options -->
          <div class="section">
            <h2 class="section-title">Payment Option</h2>
            <div class="payment-selection">
              <label class="payment-option">
                <input type="radio" class="payment-radio" name="payment" value="razorpay" required />
                <span class="payment-icon">💳</span>
                <span>Razorpay</span>
              </label>
              <label class="payment-option" id="codPaymentOption">
                <input type="radio" class="payment-radio" name="payment" value="cod" id="codRadio" />
                <span class="payment-icon">💰</span>
                <span>Cash on Delivery</span>
                <span id="codWarning" style="display:none; color: #ef4444; font-size: 0.85rem; margin-left: auto;">(Unavailable > Rs.1000)</span>
              </label>
              <label class="payment-option">
                <input type="radio" class="payment-radio" name="payment" value="wallet" id="walletOption" />
                <span class="payment-icon">👛</span>
                <span>Wallet <span id="wallet-balance"></span></span>
              </label>
            </div>
          </div>
        </div>

        <!-- Price Sidebar -->
        <div class="price-sidebar">
          <% if (cart && cart.items.length > 0) { %>
            <div class="order-summary">
              <h3 class="summary-title">Order Summary</h3>
              <% cart.items.forEach(item => { %>
                <div class="summary-item">
                  <span class="summary-name"><%= item.name %></span>
                  <span class="summary-qty">Qty: <%= item.quantity %> x Rs. <%= item.discountedPrice.toFixed(2) %></span>
                  <span class="summary-total">Rs. <%= (item.discountedPrice * item.quantity).toFixed(2) %></span>
                </div>
              <% }); %>
            </div>
          <% } %>

          <!-- Coupon Section -->
          <div class="coupon-section">
            <h3 class="summary-title" style="display: flex; align-items: baseline; justify-content: space-between;">
               <span>Have a Coupon?</span>
               <a class="view-coupons-link" onclick="openCouponModal()">View Available Coupons</a>
            </h3>
            <div style="display: flex; gap: 0.5rem;">
              <input type="text" id="couponInput" placeholder="Enter code">
              <button id="applyCouponBtn" onclick="applyCoupon()">APPLY</button>
              <button id="removeCouponBtn" class="remove-coupon-btn" onclick="removeCoupon()" title="Remove Coupon">
                <i class="fas fa-times"></i> X
              </button>
            </div>
            <p id="couponMessage"></p>
          </div>

          <!-- Price Details -->
          <div class="order-summary">
            <h2 class="price-title">Price Details</h2>
            <% let subtotal = 0; %>
            <% if (cart && cart.items.length > 0) { %>
              <% cart.items.forEach(item => { subtotal += item.discountedPrice * item.quantity; }); %>
            <% } %>
            <div class="price-detail">
              <span>Subtotal</span>
              <span id="checkoutSubtotal">Rs. <%= subtotal.toFixed(2) %></span>
            </div>
            <div class="price-detail" id="discountRow" style="display: none;">
              <span>Discount</span>
              <span id="discountDisplay">- Rs. 0.00</span>
            </div>
            <div class="price-detail">
              <span>Delivery Charges</span>
              <span>Rs. 40.00</span>
            </div>
            <div class="price-detail" style="border-bottom: none; font-size: 1.2rem; padding-top: 1rem;">
              <span style="color: #d4af37; font-weight: 700;">Total</span>
              <span id="checkoutTotal" style="color: #d4af37; font-weight: 700;">Rs. <%= (subtotal + 40).toFixed(2) %></span>
            </div>
          </div>
          
          <button class="confirm-btn" id="confirmBtn" onclick="confirmOrder()">CONFIRM ORDER</button>
        </div>
      </div>
    </main>

    <!-- View Address Modal -->
    <div class="modal-overlay" id="viewModal">
      <div class="modal">
        <button class="modal-close" onclick="closeViewModal()">&times;</button>
        <h2 class="modal-title">View Address</h2>
        <div class="address-view">
          <div class="address-detail">
            <span class="address-detail-label">Full Name:</span>
            <span class="address-detail-value" id="viewFullName"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Phone:</span>
            <span class="address-detail-value" id="viewPhone"></span>
          </div>
          <div class="address-detail" id="viewAltPhoneContainer" style="display: none">
            <span class="address-detail-label">Alternate Phone:</span>
            <span class="address-detail-value" id="viewAltPhone"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">House No.:</span>
            <span class="address-detail-value" id="viewHoNo"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Street:</span>
            <span class="address-detail-value" id="viewStreet"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">City:</span>
            <span class="address-detail-value" id="viewCity"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">State:</span>
            <span class="address-detail-value" id="viewState"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Pin Code:</span>
            <span class="address-detail-value" id="viewPin"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Country:</span>
            <span class="address-detail-value" id="viewCountry"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Status Overlay -->
    <div class="payment-overlay" id="paymentOverlay">
      <div id="paymentMessage">Processing payment...</div>
    </div>

    <!-- Error Modal -->
    <div class="modal-overlay" id="errorModal" style="z-index: 200;">
      <div class="modal" style="max-width: 400px; text-align: center;">
        <button class="modal-close" onclick="closeErrorModal()">&times;</button>
        <div style="margin-bottom: 1rem; color: #ef4444;">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h2 class="modal-title" style="margin-bottom: 0.5rem;" id="errorTitle">Action Required</h2>
        <p style="color: #9ca3af; margin-bottom: 1.5rem;" id="errorMessage">Please select a payment method.</p>
        <button onclick="closeErrorModal()" style="padding: 0.6rem 2rem; background: rgba(212, 175, 55, 0.1); color: #d4af37; border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 8px; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.background='rgba(212, 175, 55, 0.2)'" onmouseout="this.style.background='rgba(212, 175, 55, 0.1)'">OK</button>
      </div>
    </div>
    
    <!-- Coupon Modal -->
    <div class="modal-overlay" id="couponModal" style="z-index: 1500;">
      <div class="modal" style="max-width: 500px;">
        <button class="modal-close" onclick="closeCouponModal()">&times;</button>
        <h2 class="modal-title">Available Coupons</h2>
        <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
            <div class="coupon-list" style="margin-top: 2rem;"> <!-- Reusing existing list styles -->
              <% coupons.forEach(coupon => { %>
                <div class="coupon-card" onclick="selectCoupon('<%= coupon.code %>')">
                  <div class="coupon-header">
                    <div class="coupon-code"><%= coupon.code %></div>
                    <div class="coupon-offer">
                       <%= coupon.discountType === 'percentage' ? coupon.discountValue + '% OFF' : 'Rs. ' + coupon.discountValue + ' OFF' %>
                    </div>
                  </div>
                  <div class="coupon-desc">
                     <%= coupon.description || 'Save on your order' %>
                     <% if(coupon.minCartValue > 0) { %>
                       (Min purchase: Rs. <%= coupon.minCartValue %>)
                     <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
        <% } else { %>
            <p style="text-align: center; color: #999; padding: 2rem;">No coupons available at the moment.</p>
        <% } %>
      </div>
    </div>

    <%- include("../../partials/user/footer") %>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<%
  let globalSubtotal = 0;
  if (cart && cart.items.length > 0) {
    cart.items.forEach(item => { globalSubtotal += item.discountedPrice * item.quantity; });
  }
%>
<script>
  const subtotal = <%= globalSubtotal %>;
  const cartItems = <%- JSON.stringify(cart ? cart.items : []) %>;
  const selectedAddressId = '<%= selectedAddress ? selectedAddress._id : "" %>';
  const selectedAddressData = <%- JSON.stringify(selectedAddress || null) %>;
  const selectedAddress = <%- JSON.stringify(selectedAddress) %>;
  const userEmail = '<%= user ? user.email : "" %>';
  let razorpayInstance = null;
  let appliedCouponCode = null;
  let currentTotal = subtotal + 40;

  async function applyCoupon() {
    const couponInput = document.getElementById('couponInput');
    const messageEl = document.getElementById('couponMessage');
    const code = couponInput.value.trim();

    if (!code) {
      messageEl.textContent = 'Please enter a coupon code.';
      messageEl.style.color = '#ef4444';
      return;
    }

    const applyBtn = document.getElementById('applyCouponBtn');
    applyBtn.disabled = true;
    applyBtn.textContent = '...';

    try {
      const response = await fetch('/checkout/apply-coupon', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ couponCode: code, subtotal: subtotal })
      });

      const data = await response.json();

      if (data.success) {
        messageEl.textContent = `Coupon '${data.couponCode}' applied! You saved Rs. ${data.discountAmount.toFixed(2)}`;
        messageEl.style.color = '#4ade80';
        
        document.getElementById('discountRow').style.display = 'flex';
        document.getElementById('discountDisplay').textContent = `- Rs. ${data.discountAmount.toFixed(2)}`;
        const totalWithDelivery = data.newTotal + 40;
        document.getElementById('checkoutTotal').textContent = `Rs. ${totalWithDelivery.toFixed(2)}`;
        
        appliedCouponCode = data.couponCode;
        currentTotal = totalWithDelivery;
        
        validateCOD();

        // UI Updates for Success
        couponInput.disabled = true;
        applyBtn.style.display = 'none'; // Hide Apply
        const removeBtn = document.getElementById('removeCouponBtn');
        if(removeBtn) removeBtn.style.display = 'inline-flex'; // Show X
        
      } else {
        messageEl.textContent = data.message;
        messageEl.style.color = '#ef4444';
        applyBtn.disabled = false;
        applyBtn.textContent = 'APPLY';
        appliedCouponCode = null;
      }
    } catch (error) {
      console.error('Error applying coupon:', error);
      messageEl.textContent = 'Error applying coupon. Please try again.';
      messageEl.style.color = '#ef4444';
      applyBtn.disabled = false;
      applyBtn.textContent = 'APPLY';
    }
  }

  function redirectToFailed(errorMsg, errorType = 'unknown', deleteCart = false) {
    const encodedError = encodeURIComponent(errorMsg);
    const encodedType = encodeURIComponent(errorType);
    const params = new URLSearchParams({
      error: encodedError,
      type: encodedType,
      deleteCart: deleteCart ? 'true' : 'false',
      addressId: selectedAddressId
    });
    window.location.href = `/checkout/failed?${params}`;
  }

  function confirmOrder() {
    if (cartItems.length === 0) {
      showErrorModal("Your cart is empty. Add items to proceed.", "Cart Empty");
      return;
    }
    if (!selectedAddressId) {
      showErrorModal("Please select a delivery address.", "Address Missing");
      return;
    }
    const selectedPayment = document.querySelector(".payment-radio:checked");
    if (!selectedPayment) {
      showErrorModal("Please select a valid payment option to complete your order.", "Payment Method Missing");
      return;
    }
    const paymentMethod = selectedPayment.value;
    document.getElementById('confirmBtn').disabled = true;
    if (paymentMethod === 'cod') {
      showPaymentStatus('Placing COD order...');
      fetch('/checkout/placeOrder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cartItems,
          addressId: selectedAddressId,
          paymentMethod: 'cod',
          couponCode: appliedCouponCode
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = '/checkout/success';
        } else {
          hidePaymentStatus();
          if (data.redirect) {
             window.location.href = data.redirect;
             return;
          }
          if (data.message && data.message.toLowerCase().includes('coupon')) {
            Swal.fire({
              icon: 'error',
              title: 'Coupon Issue',
              text: data.message,
              confirmButtonColor: '#d4af37',
              allowOutsideClick: false,
              background: '#1a1a1a',
              color: '#ffffff'
            }).then(() => {
              location.reload();
            });
            return;
          }
          const errorMsg = data.message || 'COD order placement failed. Please try again.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'cod_failed', true), 1500);
        }
      })
      .catch(err => {
        console.error('Error:', err);
        const errorMsg = 'Network error during COD order placement. Please check your connection and try again.';
        showPaymentStatus(errorMsg, true);
        setTimeout(() => redirectToFailed(errorMsg, 'network_error'), 1500);
      });
    } else if (paymentMethod === 'razorpay') {
      showPaymentStatus('Initiating Razorpay...');
      initiateRazorpay();
    } else if (paymentMethod === 'wallet') {
      if(userWalletBalance < currentTotal){
        showErrorModal('Insufficient wallet balance.', "Wallet Error");
        document.getElementById('confirmBtn').disabled = false;
        return;
      }
      showPaymentStatus('Paying from Wallet...');
      fetch('/checkout/placeOrder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cartItems,
          addressId: selectedAddressId,
          paymentMethod: 'wallet',
          couponCode: appliedCouponCode
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = '/checkout/success';
        } else {
          if (data.message && data.message.toLowerCase().includes('coupon')) {
            hidePaymentStatus();
            Swal.fire({
              icon: 'error',
              title: 'Coupon Issue',
              text: data.message,
              confirmButtonColor: '#d4af37',
              allowOutsideClick: false,
              background: '#1a1a1a',
              color: '#ffffff'
            }).then(() => {
              location.reload();
            });
            return;
          }
          const errorMsg = data.message || 'Wallet payment failed. Please try again.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'wallet_failed', true), 1500);
        }
      })
      .catch(err => {
        console.error('Error:', err);
        const errorMsg = 'Network error during wallet payment. Please check your connection and try again.';
        showPaymentStatus(errorMsg, true);
        setTimeout(() => redirectToFailed(errorMsg, 'network_error'), 1500);
      });
    }
  }

  function initiateRazorpay() {
    if (!currentTotal || currentTotal < 1) {
      const errorMsg = 'Invalid order amount. Please check your cart.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'invalid_amount'), 1500);
      return;
    }
    fetch('/createOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        amount: currentTotal,
        currency: "INR",
        receipt: "receipt#" + Date.now(),
        notes: { desc: "Order Payment" },
        items: cartItems,
        addressId: selectedAddressId,
        couponCode: appliedCouponCode
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success && data.order) {
        showPaymentStatus('Opening payment modal...');
        openRazorpayCheckout(data.order);
      } else {
        if (data.redirect) {
            window.location.href = data.redirect;
            return; 
        }
        throw new Error(data.message || 'Order creation failed');
      }
    })
    .catch(err => {
      console.error('Error creating order:', err);
      const errorMsg = err.message || 'Failed to initiate Razorpay order. Please try again.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'order_creation_failed'), 1500);
    });
  }

  function openRazorpayCheckout(order) {
    const options = {
      key: '<%= typeof razorpayKey !== "undefined" ? razorpayKey : "" %>', 
      amount: Math.round(currentTotal * 100),
      currency: "INR",
      name: "Dité",
      description: `Payment of Rs. ${currentTotal.toFixed(2)}`,
      order_id: order.id,
      handler: function(response) {
        verifyRazorpayPayment(response);
      },
      prefill: {
        name: selectedAddress ? selectedAddress.fullName : '',
        email: userEmail,
        contact: selectedAddress ? selectedAddress.phone : ''
      },
      theme: {
        color: '#d4af37'
      },
      modal: {
        ondismiss: function() {
          const errorMsg = 'Payment was cancelled by user.';
          showPaymentStatus(errorMsg, true);
          setTimeout(() => redirectToFailed(errorMsg, 'payment_cancelled'), 1500);
        }
      }
    };
    try {
      razorpayInstance = new Razorpay(options);
      razorpayInstance.open();
    } catch (err) {
      console.error('Razorpay init error:', err);
      const errorMsg = 'Payment modal failed to load. Please refresh and try again.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'payment_init_failed'), 1500);
    }
  }

  function verifyRazorpayPayment(response) {
    showPaymentStatus('Verifying payment...');
    fetch('/verifyPayment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        razorpay_payment_id: response.razorpay_payment_id,
        razorpay_order_id: response.razorpay_order_id,
        razorpay_signature: response.razorpay_signature
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        placeOrderAfterPayment('razorpay', response.razorpay_payment_id, response.razorpay_order_id);
      } else {
        throw new Error(data.message || 'Payment verification failed');
      }
    })
    .catch(err => {
      console.error('Verification error:', err);
      const errorMsg = err.message || 'Payment verification failed. Please contact support.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'verification_failed', false), 1500);
    });
  }

  function placeOrderAfterPayment(paymentMethod, paymentId, razorpayOrderId) {
    showPaymentStatus('Placing your order...');
    fetch('/checkout/placeOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: cartItems,
        addressId: selectedAddressId,
        paymentMethod: paymentMethod,
        razorpayPaymentId: paymentId,
        razorpayOrderId: razorpayOrderId,
        couponCode: appliedCouponCode
      })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        showPaymentStatus('Order placed successfully!');
        setTimeout(() => window.location.href = '/checkout/success', 2000);
      } else {
        hidePaymentStatus();
        if (data.redirect) {
           window.location.href = data.redirect;
           return;
        }
        if (data.message && data.message.toLowerCase().includes('coupon')) {
          Swal.fire({
            icon: 'error',
            title: 'Coupon Issue',
            text: data.message,
            confirmButtonColor: '#d4af37',
            allowOutsideClick: false,
            background: '#1a1a1a',
            color: '#ffffff'
          }).then(() => {
            location.reload();
          });
          return;
        }
        throw new Error(data.message || 'Order placement failed after payment');
      }
    })
    .catch(err => {
      console.error('Order placement error:', err);
      const errorMsg = err.message || 'Order placement failed after payment. Your payment may be refunded.';
      showPaymentStatus(errorMsg, true);
      setTimeout(() => redirectToFailed(errorMsg, 'order_placement_failed', false), 1500);
    });
  }

  function showErrorModal(message, title = "Action Required") {
    Swal.fire({
      icon: 'warning',
      title: title,
      text: message,
      background: '#1a1a1a',
      color: '#ffffff',
      confirmButtonColor: '#d4af37'
    });
  }

  function closeErrorModal() {
    const modal = document.getElementById('errorModal');
    if(modal) modal.classList.remove('show');
  }

  function showPaymentStatus(message, isError = false) {
    const overlay = document.getElementById('paymentOverlay');
    const msgEl = document.getElementById('paymentMessage');
    msgEl.textContent = message;
    if (isError) {
      msgEl.style.color = '#ef4444';
    } else {
      msgEl.style.color = '#4ade80';
    }
    overlay.classList.add('show');
  }
  
  function hidePaymentStatus() {
    document.getElementById('paymentOverlay').classList.remove('show');
  }

  document.addEventListener("DOMContentLoaded", function () {
    const paymentRadios = document.querySelectorAll(".payment-radio");
    paymentRadios.forEach((radio) => {
      radio.addEventListener("change", function () {
        document.querySelectorAll(".payment-option").forEach((opt) => opt.classList.remove("selected"));
        this.closest(".payment-option").classList.add("selected");
      });
    });
  });

  function openViewModal(addressData) {
    document.getElementById("viewFullName").textContent = addressData.fullName || "";
    document.getElementById("viewPhone").textContent = addressData.phone || "";
    const altPhoneContainer = document.getElementById("viewAltPhoneContainer");
    if (addressData.altPhone) {
      document.getElementById("viewAltPhone").textContent = addressData.altPhone;
      altPhoneContainer.style.display = "flex";
    } else {
      altPhoneContainer.style.display = "none";
    }
    document.getElementById("viewHoNo").textContent = addressData.hoNo || "";
    document.getElementById("viewStreet").textContent = addressData.street || "";
    document.getElementById("viewCity").textContent = addressData.city || "";
    document.getElementById("viewState").textContent = addressData.state || "";
    document.getElementById("viewPin").textContent = addressData.pin || "";
    document.getElementById("viewCountry").textContent = addressData.country || "";
    document.getElementById("viewModal").classList.add("show");
  }
  
  function closeViewModal() {
    document.getElementById("viewModal").classList.remove("show");
  }
  
  document.getElementById("viewModal").addEventListener("click", function (e) {
    if (e.target === this) {
      closeViewModal();
    }
  });

  let userWalletBalance = 0;
  fetch('/wallet/api/balance').then(res => res.json()).then(({balance})=>{
    userWalletBalance = balance || 0;
    const balLabel = document.getElementById('wallet-balance');
    if(balLabel) {
      balLabel.textContent = `(Balance: ₹${userWalletBalance.toFixed(2)})`;
    }
    const walletRadio = document.getElementById('walletOption');
    if(walletRadio) {
      walletRadio.disabled = userWalletBalance < subtotal;
      if(walletRadio.disabled) {
        walletRadio.parentElement.style.opacity = '0.5';
        walletRadio.parentElement.title = 'Insufficient Wallet Balance';
      }
    }
  }).catch(()=>{});

  function validateCOD() {
    const codRadio = document.getElementById('codRadio');
    const codOption = document.getElementById('codPaymentOption');
    const codWarning = document.getElementById('codWarning');
    const MAX_COD_AMOUNT = 1000;

    if (codRadio && codOption) {
      if (currentTotal > MAX_COD_AMOUNT) {
        if (codRadio.checked) {
          codRadio.checked = false;
          codOption.classList.remove('selected');
          document.querySelectorAll(".payment-option").forEach((opt) => opt.classList.remove("selected"));
        }
        codRadio.disabled = true;
        codOption.style.opacity = '0.5';
        codOption.style.cursor = 'not-allowed';
        codOption.title = 'Order value exceeds Rs. 1000 limit for COD';
        if(codWarning) codWarning.style.display = 'inline';
      } else {
        codRadio.disabled = false;
        codOption.style.opacity = '1';
        codOption.style.cursor = 'pointer';
        codOption.title = '';
        if(codWarning) codWarning.style.display = 'none';
      }
    }
  }

  function selectCoupon(code) {
    // Populate the input
    const input = document.getElementById('couponInput');
    if (input) {
      input.value = code;
      closeCouponModal();
      // Auto apply
      applyCoupon();
    }
  }

  function removeCoupon() {
      // 1. Clear Input
      const input = document.getElementById('couponInput');
      if(input) {
          input.value = '';
          input.disabled = false; // Re-enable input
      }
      
      // 2. Clear Applied State
      appliedCouponCode = null;
      
      // 3. Reset Total (remove discount)
      const discountRow = document.getElementById('discountRow');
      if(discountRow) discountRow.style.display = 'none';
      
      // Reset total to subtotal + delivery
      // Note: subtotal is global base subtotal. 
      // currentTotal tracks final amount.
      currentTotal = subtotal + 40; 
      
      document.getElementById('checkoutTotal').textContent = `Rs. ${currentTotal.toFixed(2)}`;
      
      // 4. Update UI Buttons
      document.getElementById('applyCouponBtn').style.display = 'block';
      document.getElementById('applyCouponBtn').disabled = false;
      document.getElementById('applyCouponBtn').textContent = 'APPLY';
      
      document.getElementById('removeCouponBtn').style.display = 'none';
      
      // 5. Message
      const messageEl = document.getElementById('couponMessage');
      if(messageEl) {
          messageEl.textContent = 'Coupon removed.';
          messageEl.style.color = '#9ca3af';
          setTimeout(() => { messageEl.textContent = ''; }, 2000);
      }
      
      // Re-validate COD availability based on new total
      validateCOD();
  }
  
  function openCouponModal() {
      document.getElementById('couponModal').classList.add('show');
  }
  
  function closeCouponModal() {
      document.getElementById('couponModal').classList.remove('show');
  }
  
  // Close modal when clicking outside
  document.getElementById("couponModal").addEventListener("click", function (e) {
    if (e.target === this) {
      closeCouponModal();
    }
  });


  // Slight Modification to applyCoupon to handle UI Toggle
  const originalApplyCoupon = applyCoupon; // Backup if needed, but we redefine key parts below
  
  // Let's override applyCoupon logic within the script tag context (since we are replacing the bottom part of file)
  // Actually, I can just rewrite applyCoupon here if I replace the top part, but I am replacing the bottom part.
  // Wait, I didn't replace the top `applyCoupon`.
  // I need to make sure `applyCoupon` updates the UI correctly for the new buttons.
  // The `applyCoupon` function is defined above line 1275 (where I am replacing the selectCoupon).
  // I should probably redefine applyCoupon entirely or modify the existing one if I can access it.
  // Ideally, I should search/replace the existing applyCoupon.
  // BUT, I'll use the fact that functions in JS can be overwritten if defined again, OR I'll modify the previous response to include applyCoupon update.
  // No, let's look at `applyCoupon` in the file. It is around line 833.
  // I will submit a separate chunk to update `applyCoupon` or just update it here if I am updating the block containing it? No, I'm updating `selectCoupon` down at 1275.
  // Better to include `applyCoupon` re-write in the JS replacement chunk if possible, OR separate chunk.
  // Let's add a separate chunk for `applyCoupon` at line 833.


  validateCOD();
</script>
</body>
</html>