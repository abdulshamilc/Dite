<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success - Dité</title>
    <link rel="stylesheet" href="/style/user/header.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles to match the design */
        .tracking-wider { letter-spacing: 0.05em; }
        .border-cyan-400 { border-color: #22d3ee; }
        .hover\:text-cyan-400:hover { color: #22d3ee; }
        .bg-green-500 { background-color: #22c55e; }
        .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
        .border-b-2 { border-bottom-width: 2px; }
        .hover\:border-cyan-400:hover { border-color: #22d3ee; }
    </style>
</head>
<body class="min-h-screen bg-black text-white flex flex-col">
    <%- include("../../partials/user/header") %>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-20">
        <div class="text-center max-w-2xl">
            <!-- Green Checkmark -->
            <div class="flex justify-center mb-8">
                <div class="relative">
                    <div class="w-40 h-40 border-4 border-cyan-400 rounded-lg flex items-center justify-center bg-black">
                        <div class="w-32 h-32 bg-green-500 rounded-lg flex items-center justify-center animate-pulse">
                            <!-- Simple checkmark icon using SVG -->
                            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-black" stroke-width="3">
                                <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thank You Message -->
            <h1 class="text-3xl md:text-4xl font-bold mb-8 tracking-wider">THANK YOU FOR ORDERING</h1>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-8 justify-center items-center">
                <a href="/orders" class="text-lg font-semibold tracking-wider hover:text-cyan-400 transition border-b-2 border-transparent hover:border-cyan-400 pb-2">
                    VIEW ORDERS
                </a>
                <a href="/" class="text-lg font-semibold tracking-wider hover:text-cyan-400 transition border-b-2 border-transparent hover:border-cyan-400 pb-2">
                    CONTINUE SHOPPING
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>
</body>
</html>