<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - Dité</title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Cormorant Garamond', 'Georgia', serif;
        background: #050505;
        color: #e0e0e0;
        min-height: 100vh;
        padding-top: 85px;
      }

      /* Price/Amount Standard Font */
      .item-total, .price-value, .summary-amount {
        font-family: Arial, sans-serif !important;
      }

      .checkout-container {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 4rem 6rem;
      }

      @media (max-width: 1200px) {
        .checkout-container {
          padding: 3rem 4rem;
        }
      }

      @media (max-width: 992px) {
        .checkout-container {
          padding: 2rem 3rem;
        }
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 2rem;
        font-size: 1rem;
      }

      .back-btn:hover {
        background: rgba(212, 175, 55, 0.2);
        transform: translateX(-5px);
      }

      .checkout-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 300;
        letter-spacing: 6px;
        text-align: center;
        margin-bottom: 3rem;
        background: linear-gradient(135deg, #d4af37 0%, #f4e5c3 50%, #d4af37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: fadeInDown 0.8s ease-out;
      }

      @keyframes fadeInDown {
        from {
          opacity: 0;
          transform: translateY(-30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .section {
        background: #0d0d0d;
        border: 1px solid rgba(212, 175, 55, 0.12);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.4s ease;
        animation: fadeInUp 0.8s ease-out;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .section:hover {
        border-color: rgba(212, 175, 55, 0.4);
        box-shadow: 0 10px 40px rgba(212, 175, 55, 0.15);
      }

      .section-title {
        font-size: 1.8rem;
        font-weight: 400;
        letter-spacing: 2px;
        color: #d4af37;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      }

      /* Cart Items */
      .cart-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(212, 175, 55, 0.08);
        border-radius: 12px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
      }

      .cart-item:hover {
        border-color: rgba(212, 175, 55, 0.3);
        transform: translateY(-2px);
      }

      .item-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid rgba(212, 175, 55, 0.2);
      }

      .item-details {
        flex: 1;
      }

      .item-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .item-name {
        font-size: 1.3rem;
        font-weight: 500;
        color: #d4af37;
        letter-spacing: 0.5px;
      }

      .item-size, .quantity-display {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 0.25rem;
      }

      .item-total {
        font-size: 1.4rem;
        font-weight: 600;
        color: #fff;
      }

      .item-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(212, 175, 55, 0.1);
      }

      .stock-status {
        color: #4ade80;
        font-size: 0.9rem;
        font-weight: 500;
      }

      .delivery-info {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
      }

      .delivery-date {
        color: #d4af37;
      }

      /* Address Selection */
      .address-selection {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .saved-address {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.01);
        border: 2px solid rgba(212, 175, 55, 0.12);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .saved-address:hover {
        border-color: rgba(212, 175, 55, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(212, 175, 55, 0.1);
      }

      .saved-address.selected {
        border-color: #d4af37;
        background: rgba(212, 175, 55, 0.05);
      }

      .address-radio {
        margin-right: 1rem;
        width: 20px;
        height: 20px;
        cursor: pointer;
      }

      .address-details {
        flex: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .address-name {
        font-size: 1.2rem;
        font-weight: 600;
        color: #d4af37;
        margin-bottom: 0.5rem;
      }

      .address-line {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 0.25rem;
      }

      .view-btn {
        padding: 0.6rem 1.5rem;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
      }

      .view-btn:hover {
        background: rgba(212, 175, 55, 0.2);
        border-color: #d4af37;
      }

      .add-new-address {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.5rem;
        background: rgba(212, 175, 55, 0.05);
        border: 2px dashed rgba(212, 175, 55, 0.3);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1.1rem;
        color: #d4af37;
        margin-top: 1rem;
      }

      .add-new-address:hover {
        border-color: #d4af37;
        background: rgba(212, 175, 55, 0.1);
      }

      .add-new-icon {
        font-size: 1.5rem;
        font-weight: 300;
      }

      /* New Address Form */
      .new-address-form {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s ease;
        margin-top: 1rem;
      }

      .new-address-form.show {
        max-height: 1000px;
      }

      .address-form {
        background: rgba(255, 255, 255, 0.01);
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid rgba(212, 175, 55, 0.12);
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
      }

      .form-label {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 0.5rem;
      }

      .form-label.required::after {
        content: ' *';
        color: #ef4444;
      }

      .form-input {
        padding: 0.9rem;
        background: #0a0a0a;
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 8px;
        color: #fff;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .form-input:focus {
        outline: none;
        border-color: #d4af37;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
      }

      .error {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: none;
      }

      .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 1.5rem;
      }

      .btn {
        padding: 0.9rem 2rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
      }

      .btn-primary {
        background: linear-gradient(135deg, #a08830, #c4b896);
        color: #000;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
      }

      .btn-secondary {
        background: transparent;
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #d4af37;
      }

      .btn-secondary:hover {
        background: rgba(212, 175, 55, 0.1);
      }

      /* Proceed Button */
      .proceed-btn {
        width: 100%;
        padding: 1.2rem;
        background: linear-gradient(135deg, #a08830, #c4b896);
        border: none;
        border-radius: 8px;
        color: #000;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
      }

      .proceed-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
      }

      /* Modal */
      .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .modal-overlay.show {
        display: flex;
        opacity: 1;
      }

      .modal {
        background: #1a1a1a;
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 15px;
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        position: relative;
        transform: scale(0.9);
        transition: transform 0.3s ease;
      }

      .modal-overlay.show .modal {
        transform: scale(1);
      }

      .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #d4af37;
        font-size: 2rem;
        cursor: pointer;
        line-height: 1;
      }

      .modal-title {
        font-size: 1.8rem;
        color: #d4af37;
        margin-bottom: 1.5rem;
        letter-spacing: 1px;
      }

      .address-detail {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(212, 175, 55, 0.1);
      }

      .address-detail-label {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
      }

      .address-detail-value {
        color: #fff;
        font-weight: 500;
      }

      /* Map Container */
      #map-container {
        height: 300px;
        margin: 1rem 0;
        border-radius: 12px;
        overflow: hidden;
        display: none;
        border: 1px solid rgba(212, 175, 55, 0.2);
      }

      .geo-location-btn {
        display: none;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem;
        background: rgba(212, 175, 55, 0.05);
        border: 1px solid rgba(212, 175, 55, 0.2);
        border-radius: 8px;
        color: #d4af37;
        text-decoration: none;
        margin: 1rem 0;
        transition: all 0.3s ease;
      }

      .geo-location-btn:hover {
        background: rgba(212, 175, 55, 0.1);
        border-color: #d4af37;
      }

      .remove-location-btn {
        padding: 0.75rem 1.5rem;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 1rem;
      }

      .remove-location-btn:hover {
        background: rgba(239, 68, 68, 0.2);
      }

      .geo-location-note {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
        margin-top: -0.5rem;
        margin-bottom: 1rem;
      }

      @media (max-width: 768px) {
        .checkout-container {
          padding: 2rem 1.5rem;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .cart-item {
          flex-direction: column;
        }

        .item-image {
          width: 100%;
          height: 200px;
        }

        .checkout-title {
          font-size: 2rem;
          letter-spacing: 3px;
        }
      }
    </style>
  </head>
  <body>
    <%- include("../../partials/user/header") %>
    
    <main class="checkout-container">
      <button onclick="history.back()" class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back
      </button>
      <h1 class="checkout-title">CHECKOUT</h1>

      <!-- Order Review -->
      <div class="section">
        <h2 class="section-title">Order Review</h2>
        <div class="order-review">
          <% if (cart && cart.items.length > 0) { %>
            <% cart.items.forEach(item => { %>
              <div class="cart-item">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image" />
                <div class="item-details">
                  <div class="item-header">
                    <div>
                      <div class="item-name"><%= item.name %></div>
                      <% if (item.size) { %>
                        <div class="item-size">Size: <%= item.size %></div>
                      <% } %>
                      <div class="quantity-display">Qty: <%= item.quantity %></div>
                    </div>
                    <div class="item-total">Rs.<%= (item.discountedPrice * item.quantity).toFixed(2) %></div>
                  </div>
                  <div class="item-footer">
                    <div>
                      <div class="stock-status"><%= item.stockStatus %></div>
                      <div class="delivery-info">
                        Arrives by <span class="delivery-date"><%= new Date(item.deliveryDate).toLocaleDateString() %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p style="text-align: center; padding: 2rem; color: #999">No items in cart.</p>
          <% } %>
        </div>
      </div>

      <!-- Address Selection -->
      <div class="section">
        <h2 class="section-title">Select Address</h2>
        <div class="address-selection">
          <% if (addresses && addresses.length > 0) { %>
            <% 
               // Determine which address is initially selected (default or first)
               let selectedIndex = addresses.findIndex(a => a.isDefault);
               if (selectedIndex === -1) selectedIndex = 0;
            %>
            <% addresses.forEach((address, index) => { %>
              <label class="saved-address <%= index === selectedIndex ? 'selected' : '' %>" 
                     data-address-index="<%= index %>" 
                     style="<%= index === selectedIndex ? '' : 'display: none;' %>"
                     data-address="<%= JSON.stringify(address) %>">
                <input type="radio" class="address-radio" name="address" value="<%= address._id %>" <%= index === selectedIndex ? 'checked' : '' %> />
                <div class="address-details">
                  <div class="address-info">
                    <div class="address-name"><%= address.fullName %> <%= address.isDefault ? '(Default)' : '' %></div>
                    <div class="address-line"><%= address.hoNo %>, <%= address.street %></div>
                    <div class="address-line"><%= address.city %>, <%= address.state %> - <%= address.pin %></div>
                    <div class="address-line">Phone: <%= address.phone %></div>
                  </div>
                  <button type="button" class="view-btn" onclick="openViewModal(event, <%= index %>)">View</button>
                </div>
              </label>
            <% }); %>

            <% if (addresses.length > 1) { %>
              <div class="show-all-addresses-btn" onclick="toggleAddresses()" style="text-align: center; cursor: pointer; color: #d4af37; padding: 1rem; border: 1px dashed rgba(212, 175, 55, 0.3); border-radius: 8px; margin-top: 1rem;">
                Show All Addresses
              </div>
            <% } %>

          <% } else { %>
            <p style="color: #999; text-align: center; padding: 1rem">No saved addresses. Add a new one below.</p>
          <% } %>
          
          <a href="#" class="geo-location-btn" onclick="getLocation(event)" style="display: flex;">
            <span class="geo-location-icon">📍</span>
            <span>Use My Current Location (Optional)</span>
          </a>
          <div class="geo-location-note">For better delivery estimates</div>
          <div id="map-container"></div>
          <button id="remove-location" class="remove-location-btn" style="display: none;" onclick="removeLocation()">Remove Location</button>
          
          <label class="add-new-address" onclick="toggleNewAddressForm()">
            <span class="add-new-icon">+</span>
            <span>Add New Address</span>
          </label>
          
          <form class="new-address-form" id="newAddressForm" novalidate>
            <div class="address-form">
              <div class="form-group">
                <label class="form-label required" for="newFullName">Full Name</label>
                <input type="text" id="newFullName" class="form-input" />
                <span class="error" id="error-newFullName"></span>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label required" for="newPhone">Phone</label>
                  <input type="tel" id="newPhone" class="form-input" />
                  <span class="error" id="error-newPhone"></span>
                </div>
                <div class="form-group">
                  <label class="form-label" for="newAltPhone">Alternate Phone (Optional)</label>
                  <input type="tel" id="newAltPhone" class="form-input" />
                  <span class="error" id="error-newAltPhone"></span>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label required" for="newHoNo">House No.</label>
                  <input type="text" id="newHoNo" class="form-input" />
                  <span class="error" id="error-newHoNo"></span>
                </div>
                <div class="form-group">
                  <label class="form-label required" for="newStreet">Street</label>
                  <input type="text" id="newStreet" class="form-input" />
                  <span class="error" id="error-newStreet"></span>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label required" for="newPin">Pin Code</label>
                  <input type="text" id="newPin" class="form-input" />
                  <span class="error" id="error-newPin"></span>
                </div>
                <div class="form-group">
                  <label class="form-label required" for="newCity">City</label>
                  <input type="text" id="newCity" class="form-input" placeholder="Auto-filled from pincode" readonly />
                  <span class="error" id="error-newCity"></span>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label required" for="newState">State</label>
                  <input type="text" id="newState" class="form-input" placeholder="Auto-filled from pincode" readonly />
                  <span class="error" id="error-newState"></span>
                </div>
                <div class="form-group">
                  <label class="form-label required" for="newCountry">Country</label>
                  <input type="text" id="newCountry" class="form-input" placeholder="Auto-filled from pincode" readonly />
                  <span class="error" id="error-newCountry"></span>
                </div>
              </div>
              <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="toggleNewAddressForm()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Address</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Proceed Button -->
      <div class="section">
        <button class="proceed-btn" onclick="proceedToPayment()">PROCEED TO PAYMENT</button>
      </div>
    </main>

    <!-- View Address Modal -->
    <div class="modal-overlay" id="viewModal">
      <div class="modal">
        <button class="modal-close" onclick="closeViewModal()">&times;</button>
        <h2 class="modal-title">View Address</h2>
        <div class="address-view">
          <div class="address-detail">
            <span class="address-detail-label">Full Name:</span>
            <span class="address-detail-value" id="viewFullName"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Phone:</span>
            <span class="address-detail-value" id="viewPhone"></span>
          </div>
          <div class="address-detail" id="viewAltPhoneContainer" style="display: none">
            <span class="address-detail-label">Alternate Phone:</span>
            <span class="address-detail-value" id="viewAltPhone"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">House No.:</span>
            <span class="address-detail-value" id="viewHoNo"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Street:</span>
            <span class="address-detail-value" id="viewStreet"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">City:</span>
            <span class="address-detail-value" id="viewCity"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">State:</span>
            <span class="address-detail-value" id="viewState"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Pin Code:</span>
            <span class="address-detail-value" id="viewPin"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Country:</span>
            <span class="address-detail-value" id="viewCountry"></span>
          </div>
        </div>
      </div>
    </div>

    <%- include("../../partials/user/footer") %>

    <script>
      function toggleAddresses() {
        const addresses = document.querySelectorAll('.saved-address');
        const btn = document.querySelector('.show-all-addresses-btn');
        // Check current state based on button text
        const isExpanded = btn.textContent.toLowerCase().includes("hide");

        if (isExpanded) {
          // Collapse: Show only checked, hide others
          addresses.forEach(addr => {
            const radio = addr.querySelector('input[type="radio"]');
            if (radio && radio.checked) {
              addr.style.display = 'flex';
            } else {
              addr.style.display = 'none';
            }
          });
          btn.textContent = "Show All Addresses";
        } else {
          // Expand: Show all
          addresses.forEach(addr => {
            addr.style.display = 'flex';
          });
          btn.textContent = "Hide Addresses";
        }
      }

      const phoneRegex = /^(?!.*(\d)\1{5,})(?!0+$)[+]?[0-9]{6,15}$/;

      // Pincode auto-fill
      document.getElementById('newPin').addEventListener('keyup', async function () {
        const pin = this.value.trim();
        if (pin.length === 6 && /^\d{6}$/.test(pin)) {
          try {
            const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
            const data = await response.json();
            if (data[0].Status === "Success") {
              const postOffice = data[0].PostOffice[0];
              document.getElementById('newCity').value = postOffice.District || '';
              document.getElementById('newState').value = postOffice.State || '';
              document.getElementById('newCountry').value = postOffice.Country || 'India';
              
              document.getElementById('error-newCity').style.display = 'none';
              document.getElementById('error-newState').style.display = 'none';
              document.getElementById('error-newPin').style.display = 'none';
              document.getElementById('error-newCountry').style.display = 'none';
            } else {
              document.getElementById('newCity').value = '';
              document.getElementById('newState').value = '';
              document.getElementById('newCountry').value = '';
              const pinError = document.getElementById('error-newPin');
              pinError.textContent = 'Invalid Pincode';
              pinError.style.display = 'block';
            }
          } catch (error) {
            document.getElementById('newCity').value = '';
            document.getElementById('newState').value = '';
            document.getElementById('newCountry').value = '';
            const pinError = document.getElementById('error-newPin');
            pinError.textContent = 'Unable to fetch location';
            pinError.style.display = 'block';
          }
        }
      });

      function clearNewErrors() {
        const errorEls = document.querySelectorAll('.new-address-form .error');
        errorEls.forEach(el => {
          el.textContent = '';
          el.style.display = 'none';
        });
      }

      function validateNewAddressForm() {
        clearNewErrors();
        const requiredFields = ['newFullName', 'newPhone', 'newHoNo', 'newStreet', 'newCity', 'newState', 'newPin'];
        let hasError = false;
        requiredFields.forEach(id => {
          const input = document.getElementById(id);
          const value = input.value.trim();
          const errorEl = document.getElementById(`error-${id}`);
          if (!value) {
            hasError = true;
            errorEl.textContent = 'This field is required';
            errorEl.style.display = 'block';
          } else if (id === 'newPhone' && !phoneRegex.test(value)) {
            hasError = true;
            errorEl.textContent = 'Enter Valid Phone Number';
            errorEl.style.display = 'block';
          }
        });
        const country = document.getElementById('newCountry').value;
        const countryError = document.getElementById('error-newCountry');
        if (!country) {
          hasError = true;
          countryError.textContent = 'Please select a country';
          countryError.style.display = 'block';
        }
        const altPhoneValue = document.getElementById('newAltPhone').value.trim();
        const altError = document.getElementById('error-newAltPhone');
        if (altPhoneValue && !phoneRegex.test(altPhoneValue)) {
          hasError = true;
          altError.textContent = 'Enter Valid Alternate Phone Number';
          altError.style.display = 'block';
        }
        return !hasError;
      }

      function toggleNewAddressForm() {
        const form = document.getElementById("newAddressForm");
        form.classList.toggle("show");
        if (!form.classList.contains('show')) {
          document.getElementById("newAddressForm").reset();
          clearNewErrors();
        }
      }

      document.getElementById("newAddressForm").addEventListener("submit", async function (e) {
        e.preventDefault();
        if (!validateNewAddressForm()) {
          return;
        }
        const formData = {
          fullName: document.getElementById("newFullName").value.trim(),
          phone: document.getElementById("newPhone").value.trim(),
          altPhone: document.getElementById("newAltPhone").value.trim() || null,
          hoNo: document.getElementById("newHoNo").value.trim(),
          street: document.getElementById("newStreet").value.trim(),
          city: document.getElementById("newCity").value.trim(),
          state: document.getElementById("newState").value.trim(),
          pin: document.getElementById("newPin").value.trim(),
          country: document.getElementById("newCountry").value,
        };
        try {
          const response = await fetch('/checkout/address/add-newaddress', {
            method: 'POST',
            body: JSON.stringify(formData),
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            Swal.fire({
              icon: 'success',
              title: 'Success',
              text: 'Address added successfully!',
              background: '#1a1a1a',
              color: '#ffffff',
              confirmButtonColor: '#d4af37'
            }).then(() => {
              location.reload();
            });
          } else {
            const errorText = await response.text();
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: 'Error adding address: ' + errorText,
              background: '#1a1a1a',
              color: '#ffffff',
              confirmButtonColor: '#d4af37'
            });
          }
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Network Error',
            text: 'Network error: ' + err.message,
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
          });
        }
      });

      function proceedToPayment() {
        const selectedAddress = document.querySelector('input[name="address"]:checked');
        if (!selectedAddress) {
          return Swal.fire({
            icon: 'warning',
            title: 'No Address Selected',
            text: 'Please select an address before proceeding to payment.',
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
          });
        }
        const addressId = selectedAddress.value;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/checkout/payment';
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'addressId';
        input.value = addressId;
        
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      }

      document.addEventListener("DOMContentLoaded", function () {
        const addressRadios = document.querySelectorAll(".address-radio");
        addressRadios.forEach((radio) => {
          radio.addEventListener("change", function () {
            document.querySelectorAll(".saved-address").forEach((addr) => addr.classList.remove("selected"));
            this.closest(".saved-address").classList.add("selected");
          });
        });
      });

      function openViewModal(event, index) {
        event.preventDefault();
        event.stopPropagation();
        const savedAddress = document.querySelector(`[data-address-index="${index}"]`);
        const addressData = JSON.parse(savedAddress.dataset.address);
        document.getElementById("viewFullName").textContent = addressData.fullName || "";
        document.getElementById("viewPhone").textContent = addressData.phone || "";
        const altPhoneContainer = document.getElementById("viewAltPhoneContainer");
        if (addressData.altPhone) {
          document.getElementById("viewAltPhone").textContent = addressData.altPhone;
          altPhoneContainer.style.display = "flex";
        } else {
          altPhoneContainer.style.display = "none";
        }
        document.getElementById("viewHoNo").textContent = addressData.hoNo || "";
        document.getElementById("viewStreet").textContent = addressData.street || "";
        document.getElementById("viewCity").textContent = addressData.city || "";
        document.getElementById("viewState").textContent = addressData.state || "";
        document.getElementById("viewPin").textContent = addressData.pin || "";
        document.getElementById("viewCountry").textContent = addressData.country || "";
        document.getElementById("viewModal").classList.add("show");
      }

      function closeViewModal() {
        document.getElementById("viewModal").classList.remove("show");
      }

      document.getElementById("viewModal").addEventListener("click", function (e) {
        if (e.target === this) {
          closeViewModal();
        }
      });

      function getLocation(event) {
        event.preventDefault();
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(success, error, {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 60000
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Not Supported',
            text: 'Geolocation is not supported by this browser.',
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
          });
        }
      }

      function success(position) {
        const lat = position.coords.latitude;
        const lon = position.coords.longitude;
        const link = `https://www.google.com/maps?q=${lat},${lon}`;
        const mapContainer = document.getElementById('map-container');
        mapContainer.style.display = 'block';
        const map = L.map('map-container').setView([lat, lon], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        L.marker([lat, lon]).addTo(map).bindPopup('Your Current Location').openPopup();
        document.getElementById('remove-location').style.display = 'block';
        const selectedRadio = document.querySelector(".address-radio:checked");
        if (!selectedRadio) {
          Swal.fire({
            icon: 'warning',
            title: 'No address selected',
            text: 'Please select an address first to save the location.',
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
          });
          return;
        }
        const addressId = selectedRadio.value;
        fetch(`/checkout/address/save-location/${addressId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ latitude: lat, longitude: lon, link: link, accuracy: position.coords.accuracy }),
        })
        .then(response => response.json())
        .then(data => console.log('Location saved:', data))
        .catch(err => console.error('Error saving location:', err));
      }

      function removeLocation() {
        const mapContainer = document.getElementById('map-container');
        const removeBtn = document.getElementById('remove-location');
        mapContainer.style.display = 'none';
        removeBtn.style.display = 'none';
        if (window.currentMap) {
          window.currentMap.remove();
          window.currentMap = null;
        }
        const selectedRadio = document.querySelector(".address-radio:checked");
        if (!selectedRadio) {
          Swal.fire({
            icon: 'warning',
            title: 'No address selected',
            text: 'Please select an address first to remove the location.',
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
          });
          return;
        }
        const addressId = selectedRadio.value;
        fetch(`/checkout/address/clear-location/${addressId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        })
        .then(response => response.json())
        .then(data => console.log('Location cleared:', data))
        .catch(err => console.error('Error clearing location:', err));
      }

      function error(err) {
        let message = "Error getting location: ";
        switch(err.code) {
          case err.PERMISSION_DENIED:
            message += "User denied the request for Geolocation.";
            break;
          case err.POSITION_UNAVAILABLE:
            message += "Location information is unavailable.";
            break;
          case err.TIMEOUT:
            message += "The request to get user location timed out.";
            break;
          default:
            message += "An unknown error occurred.";
            break;
        }
        Swal.fire({
            icon: 'error',
            title: 'Location Error',
            text: message,
            background: '#1a1a1a',
            color: '#ffffff',
            confirmButtonColor: '#d4af37'
        });
      }
    </script>
  </body>
</html>