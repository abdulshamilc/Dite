<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - Dité</title>
    <!-- <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> -->
    <style>
      .checkout-container,
      .checkout-container * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #1a1a1a;
        color: #ffffff;
        line-height: 1.6;
      }

      /* Main Content */
      .checkout-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }

      .checkout-title {
        text-align: center;
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 2rem;
        letter-spacing: 2px;
      }

      .checkout-content {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
      }

      /* Checkout Sections */
      .checkout-sections {
        flex: 1;
        background-color: #2a2a2a;
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .section {
        background-color: #1a1a1a;
        padding: 1.5rem;
        border-radius: 8px;
      }

      .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #d4c5a9;
      }

      /* Order Review */
      .order-review .cart-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background-color: #1a1a1a;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        position: relative;
        align-items: flex-start;
      }

      .item-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 4px;
        background-color: #333;
        flex-shrink: 0;
      }

      .item-details {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }

      .item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
      }

      .item-name {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 0.25rem;
        flex: 1;
      }

      .item-size {
        font-size: 0.85rem;
        color: #999;
      }

      .item-price {
        font-size: 1.1rem;
        font-weight: 600;
        white-space: nowrap;
      }

      .quantity-display {
        font-size: 0.9rem;
        color: #ccc;
        min-width: 30px;
        text-align: center;
      }

      .item-total {
        font-size: 1.1rem;
        font-weight: 600;
        color: #4ade80;
      }

      .item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
        gap: 1rem;
      }

      .stock-status {
        font-size: 0.85rem;
        color: #4ade80;
      }

      .delivery-info {
        font-size: 0.75rem;
        color: #999;
      }

      .delivery-date {
        color: #4ade80;
      }

      /* Address Selection */
      .address-selection {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .saved-address {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        background-color: #333;
        border-radius: 4px;
        border: 2px solid transparent;
        cursor: pointer;
        position: relative;
      }

      .saved-address:hover,
      .saved-address.selected {
        border-color: #d4c5a9;
      }

      .address-radio {
        width: 20px;
        height: 20px;
        accent-color: #d4c5a9;
        margin-top: 0.25rem;
      }

      .address-details {
        flex: 1;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
      }

      .address-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .address-name {
        font-weight: 500;
        margin-bottom: 0.25rem;
      }

      .address-line {
        font-size: 0.9rem;
        color: #ccc;
        margin-bottom: 0.25rem;
      }

      .view-btn {
        padding: 0.25rem 0.75rem;
        background-color: transparent;
        color: #d4c5a9;
        border: 1px solid #d4c5a9;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
        align-self: flex-start;
        flex-shrink: 0;
      }

      .view-btn:hover {
        background-color: #d4c5a9;
        color: #000;
      }

      .geo-location-btn {
        display: none;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background-color: #333;
        border-radius: 4px;
        cursor: pointer;
        border: 2px solid #666;
        color: #fff;
        text-decoration: none;
        font-size: 0.95rem;
        transition: border-color 0.2s;
      }

      .geo-location-btn:hover {
        border-color: #d4c5a9;
      }

      .geo-location-icon {
        font-size: 1.2rem;
      }

      .geo-location-note {
        font-size: 0.8rem;
        color: #999;
        text-align: center;
        margin-top: 0.5rem;
      }

      #map-container {
        display: none;
        height: 300px;
        margin-top: 1rem;
        border-radius: 4px;
        overflow: hidden;
        background-color: #333;
      }

      .remove-location-btn {
        padding: 0.5rem 1rem;
        background-color: #666;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        align-self: flex-start;
        transition: background-color 0.2s;
      }

      .remove-location-btn:hover {
        background-color: #d4c5a9;
        color: #000;
      }

      .add-new-address {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background-color: #333;
        border-radius: 4px;
        cursor: pointer;
        border: 2px solid #666;
        color: #fff;
      }

      .add-new-address:hover {
        border-color: #d4c5a9;
      }

      .add-new-icon {
        font-size: 1.2rem;
      }

      .new-address-form {
        display: none;
        margin-top: 1rem;
        padding: 1rem;
        background-color: #333;
        border-radius: 4px;
        border: 1px solid #666;
      }

      .new-address-form.show {
        display: block;
      }

      .address-form {
        display: grid;
        gap: 1rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .form-label {
        font-size: 0.9rem;
        font-weight: 500;
        color: #d4c5a9;
      }

      .form-input {
        padding: 0.75rem;
        border: 1px solid #666;
        border-radius: 4px;
        background-color: #333;
        color: #fff;
        font-size: 1rem;
      }

      .form-input:focus {
        outline: none;
        border-color: #d4c5a9;
      }

      .form-select {
        padding: 0.75rem;
        border: 1px solid #666;
        border-radius: 4px;
        background-color: #333;
        color: #fff;
        font-size: 1rem;
      }

      .form-select:focus {
        outline: none;
        border-color: #d4c5a9;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 1rem;
      }

      .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
      }

      .btn-primary {
        background-color: #d4c5a9;
        color: #000;
      }

      .btn-secondary {
        background-color: transparent;
        color: #fff;
        border: 1px solid #666;
      }

      .btn:hover {
        opacity: 0.8;
      }

      .proceed-btn {
        width: 100%;
        padding: 1rem;
        background-color: #4ade80;
        color: #000;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .proceed-btn:hover {
        background-color: #22c55e;
      }

      /* Modal Styles */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }

      .modal-overlay.show {
        display: flex;
      }

      .modal {
        background-color: #2a2a2a;
        padding: 2rem;
        border-radius: 8px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
      }

      .modal-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #d4c5a9;
        text-align: center;
      }

      .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #999;
        font-size: 1.5rem;
        cursor: pointer;
      }

      .modal-close:hover {
        color: #fff;
      }

      .address-detail {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #444;
      }

      .address-detail:last-child {
        border-bottom: none;
      }

      .address-detail-label {
        font-weight: 500;
        color: #d4c5a9;
      }

      .address-detail-value {
        color: #ccc;
        text-align: right;
      }

      /* Responsive Design */
      @media (max-width: 1024px) {
        .checkout-content {
          flex-direction: column;
        }
      }

      @media (max-width: 768px) {
        .checkout-container {
          padding: 1rem;
        }

        .order-review .cart-item {
          flex-direction: column;
          align-items: stretch;
        }

        .item-image {
          width: 100%;
          height: 200px;
          align-self: center;
        }

        .item-header {
          flex-direction: column;
          align-items: stretch;
          gap: 0.5rem;
        }

        .item-price,
        .item-total {
          text-align: right;
        }

        .item-footer {
          flex-direction: column;
          align-items: stretch;
          gap: 0.5rem;
          text-align: center;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .saved-address {
          flex-direction: column;
          align-items: stretch;
        }

        .address-details {
          flex-direction: column;
          gap: 0.5rem;
        }

        .view-btn {
          align-self: flex-end;
          margin-top: 0.5rem;
        }

        #map-container {
          height: 250px;
        }

        .remove-location-btn {
          align-self: center;
          margin-top: 0.5rem;
        }

        .address-detail {
          flex-direction: column;
          align-items: flex-start;
          text-align: left;
        }

        .address-detail-value {
          text-align: left;
          margin-top: 0.25rem;
        }
      }
    </style>
    <link rel="stylesheet" href="/style/user/header.css">
  </head>
<!-- Header -->
    <%- include("../../partials/user/header") %>
  <body>
    
    <!-- Main Content -->
    <main class="checkout-container">
      <h1 class="checkout-title">CHECKOUT</h1>

      <div class="checkout-content">
        <!-- Checkout Sections -->
        <div class="checkout-sections">
          <!-- Order Review (Product Summary First) -->
          <div class="section">
            <h2 class="section-title">Order Review</h2>
            <div class="order-review">
              <% if (cart && cart.items.length > 0) { %> <%
              cart.items.forEach(item => { %>
              <div class="cart-item">
                <img
                  src="<%= item.image %>"
                  alt="<%= item.name %>"
                  class="item-image"
                />
                <div class="item-details">
                  <div class="item-header">
                    <div>
                      <div class="item-name"><%= item.name %></div>
                      <% if (item.size) { %>
                      <div class="item-size">Size: <%= item.size %></div>
                      <% } %>
                      <div class="quantity-display">
                        Qty: <%= item.quantity %>
                      </div>
                    </div>
                    <div class="item-total">
                      Rs.<%= (item.basePrice * item.quantity).toFixed(2) %>
                    </div>
                  </div>
                  <div class="item-footer">
                    <div>
                      <div class="stock-status"><%= item.stockStatus %></div>
                      <div class="delivery-info">
                        Arrives by Tuesday,
                        <span class="delivery-date">Oct 07 @ 10:00</span>
                      </div>
                    </div>
                    <div class="free-delivery">Free Delivery</div>
                  </div>
                </div>
              </div>
              <% }); %> <% } else { %>
              <p style="text-align: center; padding: 2rem; color: #999">
                No items in cart.
              </p>
              <% } %>
            </div>
          </div>

          <!-- Address Selection -->
          <div class="section">
            <h2 class="section-title">Select Address</h2>
            <div class="address-selection">
              <% if (addresses && addresses.length > 0) { %> <%
              addresses.forEach((address, index) => { %>
              <label
                class="saved-address"
                data-address-index="<%= index %>"
                data-address="<%= JSON.stringify(address) %>"
              >
                <input
                  type="radio"
                  class="address-radio"
                  name="address"
                  value="<%= address._id %>"
                  required
                />
                <div class="address-details">
                  <div class="address-info">
                    <div class="address-name"><%= address.fullName %></div>
                    <div class="address-line"><%= address.hoNo %>,</div>
                    <div class="address-line"><%= address.pin %></div>
                    <div class="address-line">Phone: <%= address.phone %></div>
                  </div>
                  <button
                    type="button"
                    class="view-btn"
                    onclick="openViewModal(event, <%= index %>)"
                  >
                    View
                  </button>
                </div>
              </label>
              <% }); %> <% } else { %>
              <p style="color: #999; text-align: center; padding: 1rem">
                No saved addresses. Add a new one below.
              </p>
              <% } %>
              <a href="#" class="geo-location-btn" onclick="getLocation(event)" style="display: none;">
                <span class="geo-location-icon">📍</span>
                <span>Use My Current Location (Optional)</span>
              </a>
              <div class="geo-location-note">
                For better delivery estimates
              </div>
              <div id="map-container"></div>
              <button id="remove-location" class="remove-location-btn" style="display: none;" onclick="removeLocation()">
                Remove Location
              </button>
              <label class="add-new-address" onclick="toggleNewAddressForm()">
                <span class="add-new-icon">+</span>
                <span>Add New Address</span>
              </label>
              <form class="new-address-form" id="newAddressForm">
                <div class="address-form">
                  <div class="form-group">
                    <label class="form-label" for="newFullName"
                      >Full Name</label
                    >
                    <input
                      type="text"
                      id="newFullName"
                      class="form-input"
                      required
                    />
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="newPhone">Phone</label>
                      <input
                        type="tel"
                        id="newPhone"
                        class="form-input"
                        required
                      />
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="newAltPhone"
                        >Alternate Phone (Optional)</label
                      >
                      <input type="tel" id="newAltPhone" class="form-input" />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="newHoNo">House No.</label>
                      <input
                        type="text"
                        id="newHoNo"
                        class="form-input"
                        required
                      />
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="newStreet">Street</label>
                      <input
                        type="text"
                        id="newStreet"
                        class="form-input"
                        required
                      />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="newCity">City</label>
                      <input
                        type="text"
                        id="newCity"
                        class="form-input"
                        required
                      />
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="newState">State</label>
                      <input
                        type="text"
                        id="newState"
                        class="form-input"
                        required
                      />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label" for="newPin">Pin Code</label>
                      <input
                        type="text"
                        id="newPin"
                        class="form-input"
                        required
                      />
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="newCountry">Country</label>
                      <select id="newCountry" class="form-select" required>
                        <option value="India">India</option>
                        <option value="USA">USA</option>
                        <option value="UAE">UAE</option>
                        <option value="Canada">Canada</option>
                        <option value="UK">UK</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-actions">
                    <button
                      type="button"
                      class="btn btn-secondary"
                      onclick="toggleNewAddressForm()"
                    >
                      Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                      Save Address
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <!-- Proceed Button Section -->
          <div class="section">
            <button class="proceed-btn" onclick="proceedToPayment()">
              PROCEED TO PAYMENT
            </button>
          </div>
        </div>
      </div>
    </main>

    <!-- View Address Modal -->
    <div class="modal-overlay" id="viewModal">
      <div class="modal">
        <button class="modal-close" onclick="closeViewModal()">&times;</button>
        <h2 class="modal-title">View Address</h2>
        <div class="address-view">
          <div class="address-detail">
            <span class="address-detail-label">Full Name:</span>
            <span class="address-detail-value" id="viewFullName"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Phone:</span>
            <span class="address-detail-value" id="viewPhone"></span>
          </div>
          <div
            class="address-detail"
            id="viewAltPhoneContainer"
            style="display: none"
          >
            <span class="address-detail-label">Alternate Phone:</span>
            <span class="address-detail-value" id="viewAltPhone"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">House No.:</span>
            <span class="address-detail-value" id="viewHoNo"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Street:</span>
            <span class="address-detail-value" id="viewStreet"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">City:</span>
            <span class="address-detail-value" id="viewCity"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">State:</span>
            <span class="address-detail-value" id="viewState"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Pin Code:</span>
            <span class="address-detail-value" id="viewPin"></span>
          </div>
          <div class="address-detail">
            <span class="address-detail-label">Country:</span>
            <span class="address-detail-value" id="viewCountry"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      // Toggle new address form
      function toggleNewAddressForm() {
        const form = document.getElementById("newAddressForm");
        form.classList.toggle("show");
      }

      // Handle new address save (stub - integrate with backend POST to /address/save)
      document
        .getElementById("newAddressForm")
        .addEventListener("submit", function (e) {
          e.preventDefault();
          // Collect form data and send POST
          const formData = {
            fullName: document.getElementById("newFullName").value,
            phone: document.getElementById("newPhone").value,
            altPhone: document.getElementById("newAltPhone").value || null,
            hoNo: document.getElementById("newHoNo").value,
            street: document.getElementById("newStreet").value,
            city: document.getElementById("newCity").value,
            state: document.getElementById("newState").value,
            pin: document.getElementById("newPin").value,
            country: document.getElementById("newCountry").value,
          };
          fetch('/checkout/address/add-newaddress', { method: 'POST', body: JSON.stringify(formData), headers: { 'Content-Type': 'application/json' } })
         
          toggleNewAddressForm();
          this.reset();
          document.getElementById("newCountry").value = "India";
        });

      
      function proceedToPayment() {
        const selectedAddress = document.querySelector('input[name="address"]:checked');
        if (!selectedAddress) return alert("Please select an address before proceeding to payment.")
        

        const addressId = selectedAddress.value; // this is address._id from EJS
        console.log("Selected Address ID:", addressId);

        window.location.href = `/checkout/payment/${addressId}`;
         
      }


      

      // Optional: Select saved address
      document.addEventListener("DOMContentLoaded", function () {
        const addressRadios = document.querySelectorAll(".address-radio");
        addressRadios.forEach((radio) => {
          radio.addEventListener("change", function () {
            document
              .querySelectorAll(".saved-address")
              .forEach((addr) => addr.classList.remove("selected"));
            this.closest(".saved-address").classList.add("selected");
            // Enable geo location when an address is selected
            document.querySelector('.geo-location-btn').style.display = 'flex';
          });
        });
        // Initially hide geo location if no address selected
        document.querySelector('.geo-location-btn').style.display = 'none';
      });

      // Modal functions
      function openViewModal(event, index) {
        event.preventDefault();
        event.stopPropagation();
        const savedAddress = document.querySelector(
          `[data-address-index="${index}"]`
        );
        const addressData = JSON.parse(savedAddress.dataset.address);
        document.getElementById("viewFullName").textContent =
          addressData.fullName || "";
        document.getElementById("viewPhone").textContent =
          addressData.phone || "";
        const altPhoneContainer = document.getElementById(
          "viewAltPhoneContainer"
        );
        if (addressData.altPhone) {
          document.getElementById("viewAltPhone").textContent =
            addressData.altPhone;
          altPhoneContainer.style.display = "flex";
        } else {
          altPhoneContainer.style.display = "none";
        }
        document.getElementById("viewHoNo").textContent =
          addressData.hoNo || "";
        document.getElementById("viewStreet").textContent =
          addressData.street || "";
        document.getElementById("viewCity").textContent =
          addressData.city || "";
        document.getElementById("viewState").textContent =
          addressData.state || "";
        document.getElementById("viewPin").textContent = addressData.pin || "";
        document.getElementById("viewCountry").textContent =
          addressData.country || "";
        document.getElementById("viewModal").classList.add("show");
      }

      function closeViewModal() {
        document.getElementById("viewModal").classList.remove("show");
      }

      // Close modal on overlay click
      document
        .getElementById("viewModal")
        .addEventListener("click", function (e) {
          if (e.target === this) {
            closeViewModal();
          }
        });

      function getLocation(event) {
        event.preventDefault();
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(success, error, {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 60000
          });
        } else {
          alert("Geolocation is not supported by this browser.");
        }
      }

      function success(position) {
        const lat = position.coords.latitude;
        const lon = position.coords.longitude;

        // Create a Google Maps link
        const link = `https://www.google.com/maps?q=${lat},${lon}`;

        // Show map
        const mapContainer = document.getElementById('map-container');
        mapContainer.style.display = 'block';

        // Initialize Leaflet map
        const map = L.map('map-container').setView([lat, lon], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        L.marker([lat, lon]).addTo(map)
          .bindPopup('Your Current Location')
          .openPopup();

        // Show remove button
        document.getElementById('remove-location').style.display = 'block';
        // get selected addressId (for example from a checked radio)
        const selectedRadio = document.querySelector(".address-radio:checked");
        if (!selectedRadio) {
          alert("Please select an address");
          return;
        }
        const addressId = selectedRadio.value;

        // Send to backend for saving in DB (associate with current session/user)
        fetch(`/checkout/address/save-location/${addressId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            latitude: lat, 
            longitude: lon, 
            link: link,
            accuracy: position.coords.accuracy
          }),
        })
        .then(response => response.json())
        .then(data => {
          console.log('Location saved:', data);
          // Optionally, reload addresses or update UI
        })
        .catch(err => console.error('Error saving location:', err));
      }

      function removeLocation() {
        const mapContainer = document.getElementById('map-container');
        const removeBtn = document.getElementById('remove-location');
        mapContainer.style.display = 'none';
        removeBtn.style.display = 'none';
        // Clear the map instance if needed (optional, for memory)
        if (window.currentMap) {
          window.currentMap.remove();
          window.currentMap = null;
        }
         document.getElementById('remove-location').style.display = 'block';
        // get selected addressId (for example from a checked radio)
        const selectedRadio = document.querySelector(".address-radio:checked");
        if (!selectedRadio) {
          alert("Please select an address");
          return;
        }
        const addressId = selectedRadio.value;

        // Send to backend to clear location (stub)
        fetch(`/checkout/address/clear-location/${addressId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        })
        .then(response => response.json())
        .then(data => {
          console.log('Location cleared:', data);
        })
        .catch(err => console.error('Error clearing location:', err));
      }

      function error(err) {
        let message = "Error getting location: ";
        switch(err.code) {
          case err.PERMISSION_DENIED:
            message += "User denied the request for Geolocation.";
            break;
          case err.POSITION_UNAVAILABLE:
            message += "Location information is unavailable.";
            break;
          case err.TIMEOUT:
            message += "The request to get user location timed out.";
            break;
          default:
            message += "An unknown error occurred.";
            break;
        }
        alert(message);
      }
    </script>
  </body>
</html>