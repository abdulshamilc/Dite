<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %> - Dité</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "yellow-500": "#eab308",
              "yellow-600": "#ca8a04",
            },
          },
        },
      };
    </script>
    <style>
      .gradient-bg {
        background: linear-gradient(
          135deg,
          rgba(30, 58, 138, 0.2) 0%,
          rgba(0, 0, 0, 1) 100%
        );
      }
      body {
        padding-top: 80px;
      }
    </style>
  </head>
  <body class="min-h-screen bg-black text-white px-10">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-black/95 backdrop-blur-sm border-b border-gray-800">
      <%- include("../partials/user/header") %>
    </header>

    <!-- Main Content -->
    <main class="pt-20">
      <!-- Main Product Section -->
      <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Product Images -->
          <div class="space-y-4">
            <div class="aspect-[3/4] gradient-bg rounded-lg overflow-hidden">
              <img
                id="mainImage"
                src="<%= product.images[0] %>"
                alt="<%= product.name %>"
                class="w-full h-full object-cover"
              />
            </div>

            <div class="grid grid-cols-3 gap-4">
              <% product.images.forEach((image, index) => { %>
              <button
                onclick="changeImage('<%= image %>', <%= index %>)"
                class="thumbnail aspect-square rounded-lg overflow-hidden border-2 transition-colors <%= index === 0 ? 'border-yellow-500' : 'border-gray-700' %>"
                data-index="<%= index %>"
              >
                <img
                  src="<%= image %>"
                  alt="<%= product.name %> view <%= index + 1 %>"
                  class="w-full h-full object-cover"
                />
              </button>
              <% }) %>
            </div>
          </div>

          <!-- Product Info -->
          <div class="space-y-8">
            <div>
              <h1 class="text-4xl font-bold mb-4"><%= product.name %></h1>
              <h3 class="text-gray-400 mb-6"><%= product.concentration %></h3>
              <p class="text-gray-400 mb-6">
                This product comes in <%= product.variants.length %> variants
              </p>

              <!-- Variant (Size) Selection -->
              <div class="flex gap-3 mb-8">
                <% product.variants.forEach((variant, index) => { %>
                <button
                  onclick="selectSize('<%= variant.mlSize %>', <%= variant.discountedPrice %>, <%= variant.basePrice %>)"
                  class="size-btn px-4 py-2 rounded-md border transition-colors <%= index === 0 ? 'bg-yellow-500 text-black border-yellow-500' : 'bg-gray-800 text-white border-gray-600 hover:border-gray-500' %>"
                  data-size="<%= variant.mlSize %>"
                >
                  <%= variant.mlSize %> ml
                </button>
                <% }) %>
              </div>

              <!-- Price -->
              <div id="priceSection" class="text-3xl font-bold mb-8">
                <% if (product.variants.length > 0) { %>
                <span class="text-yellow-500"
                  >₹<%= product.variants[0].discountedPrice.toFixed(2) %></span
                >
                <% if (product.variants[0].discountedPrice <
                product.variants[0].basePrice) { %>
                <span class="line-through text-gray-500 ml-2"
                  >₹<%= product.variants[0].basePrice.toFixed(2) %></span
                >
                <% } %> <% } else { %>
                <span class="text-gray-400">No price available</span>
                <% } %>
              </div>

              <!-- Action Buttons -->
              <div class="space-y-4 mb-8">
                <button
                  class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-medium py-3 px-4 rounded-md transition-colors"
                >
                  ADD TO CART
                </button>
                <button
                  class="w-full border border-gray-600 text-white hover:bg-gray-800 bg-transparent py-3 px-4 rounded-md transition-colors"
                >
                  ADD TO WISHLIST
                </button>
              </div>
            </div>

            <!-- Product Details Section -->
            <div class="space-y-8 border-t border-gray-800 pt-8">
              <!-- Description Tab Section -->
              <div class="flex border-b border-gray-700 pb-4">
                <button id="descriptionTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 border-b-2 border-yellow-500 text-yellow-500">
                  Description
                </button>
                <button id="notesTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 text-gray-400 hover:text-white transition-colors">
                  Notes
                </button>
                <button id="reviewsTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 text-gray-400 hover:text-white transition-colors">
                  Reviews
                </button>
              </div>

              <!-- Description Content -->
              <div id="descriptionContent" class="tab-content space-y-6">
                <div class="text-gray-300 leading-relaxed">
                  <p><%= product.description %></p>
                </div>
              </div>

              <!-- Notes Content -->
              <div id="notesContent" class="tab-content space-y-6 hidden">
                <div class="text-gray-300 leading-relaxed">
                  <%= product.notes %>
                </div>
              </div>

              <!-- Reviews Content -->
              <div id="reviewsContent" class="tab-content space-y-6 hidden">
                <!-- Review Cards -->
                <div class="space-y-6">
                  <% if (typeof product.reviews !== 'undefined' && product.reviews.length > 0) { %>
                    <% product.reviews.forEach(review => { %>
                      <div class="bg-gray-900 rounded-lg p-6 border border-gray-700">
                        <div class="flex items-center mb-3">
                          <div class="flex items-center mr-3">
                            <% for(let i = 1; i <= 5; i++) { %>
                              <svg class="w-5 h-5 <%= i <= review.rating ? 'text-yellow-500 fill-current' : 'text-gray-600' %>" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                              </svg>
                            <% } %>
                          </div>
                          <span class="text-yellow-500 font-medium"><%= review.rating %>/5</span>
                        </div>
                        <p class="text-gray-300 italic mb-4">"<%= review.comment %>"</p>
                        <div class="flex items-center justify-between text-sm text-gray-500">
                          <span><%= review.userName %></span>
                          <span><%= new Date(review.date).toLocaleDateString() %></span>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="text-center py-12">
                      <p class="text-gray-400 text-lg">No reviews yet. Be the first to share your experience!</p>
                    </div>
                  <% } %>
                </div>

                <!-- Add Review Section -->
                <div class="bg-gray-900 rounded-lg p-6 border border-gray-700 mt-8">
                  <h4 class="text-lg font-semibold mb-4 text-yellow-500">Write a Review</h4>
                  <div class="space-y-4">
                    <div class="flex items-center space-x-2">
                      <label class="text-gray-400">Your Rating:</label>
                      <div class="flex items-center space-x-1">
                        <% for(let i = 1; i <= 5; i++) { %>
                          <svg class="w-6 h-6 cursor-pointer text-gray-600 hover:text-yellow-500 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        <% } %>
                      </div>
                    </div>
                    <textarea 
                      class="w-full bg-gray-800 border border-gray-600 rounded-md p-3 text-white placeholder-gray-400 resize-none h-24 focus:outline-none focus:border-yellow-500"
                      placeholder="Share your thoughts about this product..."
                    ></textarea>
                    <div class="flex items-center justify-end space-x-4">
                      <input type="text" class="bg-gray-800 border border-gray-600 rounded-md px-3 py-2 text-white placeholder-gray-400 w-64 max-w-full" placeholder="Your Name">
                      <button class="bg-yellow-500 hover:bg-yellow-600 text-black font-medium px-6 py-2 rounded-md transition-colors">
                        Submit Review
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Brand Info -->
              <div class="pt-8 border-t border-gray-800">
                <h3 class="text-lg font-semibold mb-3 text-yellow-500">About <%= product.brand %></h3>
                <p class="text-gray-300 leading-relaxed"><%= product.brandDescription || 'Discover the luxury and elegance of ' + product.brand %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Suggestions Section -->
      <section class="border-t border-gray-800 py-16">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-3xl font-bold text-center mb-12">Suggestions</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <% if (typeof suggestions !== 'undefined') { %> <%
            suggestions.forEach(item => { %>
            <div class="group cursor-pointer">
              <div
                class="aspect-[3/4] gradient-bg rounded-lg overflow-hidden mb-4"
              >
                <img
                  src="<%= item.image %>"
                  alt="<%= item.name %>"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <h3 class="text-lg font-medium mb-2"><%= item.name %></h3>
              <p class="text-yellow-500 font-bold">
                ₹<%= item.price.toFixed(2) %>
              </p>
            </div>
            <% }) %> <% } %>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="mt-16">
      <%- include("../partials/user/footer") %>
    </footer>

    <!-- JS -->
    <script>
      function changeImage(src, index) {
        document.getElementById("mainImage").src = src;
        document.querySelectorAll(".thumbnail").forEach((thumb, i) => {
          thumb.classList.remove("border-yellow-500");
          thumb.classList.add("border-gray-700");
          if (i === index) {
            thumb.classList.add("border-yellow-500");
            thumb.classList.remove("border-gray-700");
          }
        });
      }

      function selectSize(size, discountedPrice, basePrice) {
        document.querySelectorAll(".size-btn").forEach((btn) => {
          btn.classList.remove(
            "bg-yellow-500",
            "text-black",
            "border-yellow-500"
          );
          btn.classList.add("bg-gray-800", "text-white", "border-gray-600");
          if (btn.dataset.size === size) {
            btn.classList.add(
              "bg-yellow-500",
              "text-black",
              "border-yellow-500"
            );
          }
        });

        const priceSection = document.getElementById("priceSection");
        let html = `<span class="text-yellow-500">₹${discountedPrice.toFixed(
          2
        )}</span>`;
        if (discountedPrice < basePrice) {
          html += `<span class="line-through text-gray-500 ml-2">₹${basePrice.toFixed(
            2
          )}</span>`;
        }
        priceSection.innerHTML = html;
      }

      // Tab functionality
      document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
          tab.addEventListener('click', function() {
            const target = this.id.replace('Tab', 'Content');
            
            // Update tab styles
            tabs.forEach(t => {
              t.classList.remove('border-yellow-500', 'text-yellow-500');
              t.classList.add('text-gray-400');
            });
            this.classList.add('border-yellow-500', 'text-yellow-500');
            this.classList.remove('text-gray-400');

            // Update content visibility
            contents.forEach(content => {
              content.classList.add('hidden');
            });
            document.getElementById(target).classList.remove('hidden');
          });
        });
      });

      // Review star rating functionality
      const stars = document.querySelectorAll('.tab-content svg');
      let currentRating = 0;

      stars.forEach((star, index) => {
        star.addEventListener('click', function() {
          currentRating = index + 1;
          stars.forEach((s, i) => {
            if (i < currentRating) {
              s.classList.remove('text-gray-600');
              s.classList.add('text-yellow-500');
            } else {
              s.classList.remove('text-yellow-500');
              s.classList.add('text-gray-600');
            }
          });
        });

        star.addEventListener('mouseover', function() {
          stars.forEach((s, i) => {
            if (i <= index) {
              s.classList.add('text-yellow-500');
              s.classList.remove('text-gray-600');
            } else {
              s.classList.add('text-gray-600');
              s.classList.remove('text-yellow-500');
            }
          });
        });
      });

      // Reset stars on mouse leave
      document.querySelector('.tab-content').addEventListener('mouseleave', function() {
        stars.forEach((star, index) => {
          if (index < currentRating) {
            star.classList.remove('text-gray-600');
            star.classList.add('text-yellow-500');
          } else {
            star.classList.remove('text-yellow-500');
            star.classList.add('text-gray-600');
          }
        });
      });
    </script>
  </body>
</html>