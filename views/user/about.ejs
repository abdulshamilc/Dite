<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Dité</title>
    <%- include("../partials/user/headerHead") %>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cormorant Garamond', 'Georgia', serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
            color: #fff;
            overflow-x: hidden;
            padding-top: 85px;
        }

        /* Header Scroll Animation - Only for About Page */
        .header {
            transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
        }

        .header.header-hidden {
            transform: translateY(-100%);
            opacity: 0;
        }

        .header.header-visible {
            transform: translateY(0);
            opacity: 1;
        }

        /* Animated Background Particles */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.8), transparent);
            border-radius: 50%;
            animation: float 15s infinite ease-in-out;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) translateX(50px); opacity: 0; }
        }

        .static-page-section {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            padding: 100px 20px 60px;
        }

        .static-container {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
        }

        /* Hero Section with Reveal Animation */
        .static-title {
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 300;
            letter-spacing: 8px;
            text-align: center;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #d4af37 0%, #f4e5c3 50%, #d4af37 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            opacity: 0;
            transform: translateY(50px);
            animation: fadeInUp 1.2s ease-out forwards;
            text-shadow: 0 0 40px rgba(212, 175, 55, 0.3);
        }

        .static-subtitle {
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            text-align: center;
            color: #d4af37;
            letter-spacing: 4px;
            margin-bottom: 80px;
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1.2s ease-out 0.3s forwards;
            font-weight: 300;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Content Blocks with Stagger Animation */
        .content-block {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 20px;
            padding: 60px;
            margin-bottom: 60px;
            opacity: 0;
            transform: translateY(60px) scale(0.95);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .content-block::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .content-block:hover::before {
            opacity: 1;
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .content-block.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .content-block:hover {
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 20px 60px rgba(212, 175, 55, 0.2);
            transform: translateY(-10px) scale(1.02);
        }

        .content-block h2 {
            font-size: clamp(2rem, 4vw, 3rem);
            color: #d4af37;
            margin-bottom: 30px;
            letter-spacing: 3px;
            position: relative;
            display: inline-block;
            font-weight: 300;
        }

        .content-block h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #d4af37, transparent);
            transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .content-block:hover h2::after {
            width: 100%;
        }

        .content-block p {
            font-size: clamp(1rem, 2vw, 1.2rem);
            line-height: 2;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 20px;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 1;
        }

        .content-block ul {
            list-style: none;
            padding: 0;
        }

        .content-block ul li {
            font-size: clamp(1rem, 2vw, 1.2rem);
            line-height: 2;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 20px;
            padding-left: 40px;
            position: relative;
            opacity: 0;
            transform: translateX(-20px);
            transition: all 0.4s ease;
        }

        .content-block.visible ul li {
            opacity: 1;
            transform: translateX(0);
        }

        .content-block.visible ul li:nth-child(1) { transition-delay: 0.1s; }
        .content-block.visible ul li:nth-child(2) { transition-delay: 0.2s; }
        .content-block.visible ul li:nth-child(3) { transition-delay: 0.3s; }
        .content-block.visible ul li:nth-child(4) { transition-delay: 0.4s; }

        .content-block ul li::before {
            content: '◆';
            position: absolute;
            left: 0;
            color: #d4af37;
            font-size: 1.2rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.2); }
        }

        .content-block ul li strong {
            color: #d4af37;
            font-weight: 600;
            letter-spacing: 1px;
        }

        /* Features Grid Cards */
        .features-section {
            background: transparent !important;
            border: none !important;
            padding: 60px 20px !important;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-top: 50px;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 50px 35px;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(50px) rotateX(10deg);
        }

        .features-section.visible .feature-card {
            opacity: 1;
            transform: translateY(0) rotateX(0);
        }

        .features-section.visible .feature-card:nth-child(1) { transition-delay: 0.1s; }
        .features-section.visible .feature-card:nth-child(2) { transition-delay: 0.2s; }
        .features-section.visible .feature-card:nth-child(3) { transition-delay: 0.3s; }
        .features-section.visible .feature-card:nth-child(4) { transition-delay: 0.4s; }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, transparent 100%);
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .feature-card:hover {
            transform: translateY(-15px) scale(1.05);
            border-color: rgba(212, 175, 55, 0.6);
            box-shadow: 0 25px 70px rgba(212, 175, 55, 0.3);
            background: rgba(255, 255, 255, 0.08);
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .card-glow {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.6s ease;
            pointer-events: none;
        }

        .feature-card:hover .card-glow {
            opacity: 1;
            animation: rotate 8s linear infinite;
        }

        .feature-icon {
            font-size: 3rem;
            color: #d4af37;
            margin-bottom: 25px;
            display: inline-block;
            animation: pulse 3s ease-in-out infinite;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.3) rotate(180deg);
            animation: none;
        }

        .feature-card h3 {
            font-size: clamp(1.5rem, 3vw, 1.8rem);
            color: #d4af37;
            margin-bottom: 15px;
            font-weight: 400;
            letter-spacing: 2px;
            position: relative;
            z-index: 1;
        }

        .feature-card p {
            font-size: clamp(1rem, 2vw, 1.1rem);
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.8;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 1;
            margin: 0;
        }

        @media (max-width: 768px) {
            .features-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            .feature-card {
                padding: 40px 30px;
            }
        }

        @media (min-width: 769px) and (max-width: 1024px) {
            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 25px;
            }
        }

        /* Decorative Elements */
        .deco-line {
            position: absolute;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4af37, transparent);
            width: 100%;
            left: 0;
            opacity: 0.3;
        }

        .deco-line.top { top: 0; }
        .deco-line.bottom { bottom: 0; }

        /* Scroll Progress Bar */
        .scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, #d4af37, #f4e5c3);
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 0.1s ease;
            z-index: 1000;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .content-block {
                padding: 40px 30px;
                margin-bottom: 40px;
            }

            .static-page-section {
                padding: 80px 15px 40px;
            }
        }

        /* Smooth Scroll */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>
    <%- include("../partials/user/header") %>
    
    <!-- Scroll Progress Bar -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <!-- Animated Background Particles -->
    <div class="particles" id="particles"></div>

    <section class="static-page-section">
        <div class="static-container">
            <h1 class="static-title">About Dité</h1>
            <p class="static-subtitle">Defining Luxury in Every Scent</p>

            <div class="content-block">
                <div class="deco-line top"></div>
                <h2>Our Story</h2>
                <p>
                    Welcome to Dité, where fragrance meets artistry. Born from a passion for exquisite scents and uncompromising quality, Dité was established to redefine the world of luxury perfumery. We believe that a fragrance is more than just a scent; it is an identity, a memory, and a statement.
                </p>
                <p>
                    Our journey began with a simple vision: to curate a collection of perfumes that embody elegance, sophistication, and timeless beauty. Working with world-renowned perfumers, we source the finest ingredients from across the globe to create olfactory masterpieces that captivate the senses.
                </p>
                <div class="deco-line bottom"></div>
            </div>

            <div class="content-block">
                <div class="deco-line top"></div>
                <h2>Our Philosophy</h2>
                <p>
                    At Dité, we adhere to a philosophy of "Pure Excellence." We are committed to sustainability, ethical sourcing, and craftsmanship. Each bottle is a testament to our dedication to perfection, ensuring that every drop gives you an experience of luxury.
                </p>
                <div class="deco-line bottom"></div>
            </div>

            <div class="content-block features-section">
                <div class="deco-line top"></div>
                <h2>Why Choose Dité?</h2>
                
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">◆</div>
                        <h3>Premium Ingredients</h3>
                        <p>Rare and ethically sourced notes.</p>
                        <div class="card-glow"></div>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon">◆</div>
                        <h3>Long-lasting Scents</h3>
                        <p>Formulated for endurance and projection.</p>
                        <div class="card-glow"></div>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon">◆</div>
                        <h3>Exclusive Collections</h3>
                        <p>Unique blends found nowhere else.</p>
                        <div class="card-glow"></div>
                    </div>
                    
                    <div class="feature-card">
                        <div class="feature-icon">◆</div>
                        <h3>Customer First</h3>
                        <p>A seamless and luxurious shopping experience.</p>
                        <div class="card-glow"></div>
                    </div>
                </div>
                
                <div class="deco-line bottom"></div>
            </div>
        </div>
    </section>

    <script>
        // Create floating particles
        const particlesContainer = document.getElementById('particles');
        for (let i = 0; i < 30; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 15 + 's';
            particle.style.animationDuration = (15 + Math.random() * 10) + 's';
            particlesContainer.appendChild(particle);
        }

        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('visible');
                    }, index * 200);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.content-block').forEach(block => {
            observer.observe(block);
        });

        // Scroll progress bar
        window.addEventListener('scroll', () => {
            const scrollProgress = document.getElementById('scrollProgress');
            const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (window.scrollY / windowHeight);
            scrollProgress.style.transform = `scaleX(${scrolled})`;
        });

        // Parallax effect on scroll
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const parallaxElements = document.querySelectorAll('.content-block');
            parallaxElements.forEach((el, index) => {
                const speed = 0.05 + (index * 0.01);
                el.style.transform = `translateY(${scrolled * speed}px)`;
            });
        });

        // Header hide/show on scroll - Only for About Page
        let lastScrollTop = 0;
        const header = document.querySelector('.header');
        const scrollThreshold = 100; // Start hiding after scrolling 100px

        window.addEventListener('scroll', () => {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            
            if (scrollTop > scrollThreshold) {
                if (scrollTop > lastScrollTop) {
                    // Scrolling down - hide header
                    header.classList.add('header-hidden');
                    header.classList.remove('header-visible');
                } else {
                    // Scrolling up - show header
                    header.classList.remove('header-hidden');
                    header.classList.add('header-visible');
                }
            } else {
                // At the top - always show header
                header.classList.remove('header-hidden');
                header.classList.add('header-visible');
            }
            
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, false);
    </script>
</body>
</html>