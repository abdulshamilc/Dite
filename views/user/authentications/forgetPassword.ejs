<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dité - Forgot Password</title>
    <link rel="stylesheet" href="/style/user/authentications/forgetPassword.css">
  </head>
  <body>
    <div class="container">
      <!-- Left Side -->
      <div class="left">
        <div class="logo">
          <img src="/images/logo/DiteLogo.png" alt="Dité Logo" />
        </div>

        <!-- Messages -->
        <span id="errorMsg"></span>
        <span id="successMsg"></span>

        <div class="title">Forgot Password</div>
        <div class="subtitle">Please confirm your mail address</div>

        <form id="forgotForm">
          <div class="input-group">
            <input
              id="email"
              type="text"
              name="email"
              placeholder="Email address"
            />
          </div>
          <button type="submit">Send OTP</button>
        </form>

        <a href="/login" class="back">Go back to Login Page</a>
      </div>

      <!-- Right Side -->
      <div class="right"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      // Handle form submit with Axios
      document
        .getElementById("forgotForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();

          const email = document.getElementById("email").value;

          try {
            const res = await axios.post("/forgot-password", { email });
             console.log("Response from server:", res.data);
             
            // Success message
            document.getElementById("successMsg").innerText =
              res.data.message || "OTP sent successfully!";
            document.getElementById("errorMsg").innerText = "";
            
            // Delay redirect to show message briefly
            if (res.data.redirect) {
              setTimeout(() => {
                window.location.href = res.data.redirect;
              }, 1500); // 1.5 seconds – adjust as needed
            }
          } catch (err) {
            // Error message
            console.error(err);
            const msg = err.response?.data?.message || "Something went wrong!";
            document.getElementById("errorMsg").innerText = msg;
            document.getElementById("successMsg").innerText = "";
          }
        });
    </script>
  </body>
</html>