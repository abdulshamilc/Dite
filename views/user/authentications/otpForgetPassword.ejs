<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dité - OTP Verification</title>
    <link rel="stylesheet" href="/style/user/authentications/otpForgetPassword.css">
  </head>
  <body>
    <div class="container">
      <!-- Left Image -->
      <div class="left"></div>

      <!-- Right Content -->
      <div class="right">
        <div class="logo">
          <img src="/images/logo/DiteLogo.png" alt="Dité Logo" />
        </div>

        <!-- Messages -->
        <span id="errorMsg"></span>
        <span id="successMsg"></span>

        <div class="title">Confirm with OTP</div>
        <div class="subtitle">Please check your mail address for OTP</div>

        <!-- OTP Inputs -->
        <form id="otpForm">
          <div class="otp-inputs">
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
          </div>

          <!-- Timer + Resend -->
          <div class="resend">
            Remaining Time: <span id="timer">01:00</span>
            Didn’t receive code?
            <a href="#" id="resendLink">Resend</a>
          </div>

          <button type="submit">CONFIRM</button>
        </form>

        <a href="/admin" class="back">Go back to Login page</a>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      // Elements
      const timerEl = document.getElementById("timer");
      const resendLink = document.getElementById("resendLink");
      const inputs = document.querySelectorAll(".otp-inputs input");

      let time = 60;
      let currentInterval = null;

      // Function to update timer and handle enable/disable
      const updateTimer = () => {
        time--;
        let m = String(Math.floor(time / 60)).padStart(2, "0");
        let s = String(time % 60).padStart(2, "0");
        timerEl.textContent = `${m}:${s}`;

        if (time <= 0) {
          clearInterval(currentInterval);
          // Enable resend
          resendLink.style.pointerEvents = "auto";
          resendLink.style.opacity = 1;
          resendLink.style.color = "blue";
        } else {
          // Disable resend
          resendLink.style.pointerEvents = "none";
          resendLink.style.opacity = 0.5;
          resendLink.style.color = "#999";
        }
      };

      // Start initial timer
      currentInterval = setInterval(updateTimer, 1000);

      // Initial disable
      resendLink.style.pointerEvents = "none";
      resendLink.style.opacity = 0.5;
      resendLink.style.color = "#999";

      // OTP Input Auto-Focus
      inputs.forEach((input, index) => {
        input.addEventListener("input", () => {
          if (input.value && index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
        });
      });

      // Handle OTP Submit
      document
        .getElementById("otpForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          let otp = "";
          inputs.forEach((i) => (otp += i.value));
          console.log("Entered OTP:", otp);

          try {
            const res = await axios.post("/forgot-password/otpVerification", { otp });

            if (res.data.success && res.data.redirectUrl) {
              window.location.href = res.data.redirectUrl;
            }
          } catch (err) {
            // Error message
            console.error(err);
            const msg = err.response?.data?.message || "Something went wrong!";
            document.getElementById("errorMsg").innerText = msg;
            document.getElementById("successMsg").innerText = "";
          }
        });

      // Resend handler
      resendLink.addEventListener("click", async (e) => {
        e.preventDefault();

        try {
          const res = await axios.post("/admin/resend-otp");
          
          // Show success message
          document.getElementById("successMsg").innerText =
            res.data.message || "OTP resent successfully!";
          document.getElementById("errorMsg").innerText = "";

          // Clear OTP inputs
          inputs.forEach((i) => (i.value = ""));

          // Reset timer to 60 seconds and restart countdown
          time = 60;
          let m = String(Math.floor(time / 60)).padStart(2, "0");
          let s = String(time % 60).padStart(2, "0");
          timerEl.textContent = `${m}:${s}`;

          // Clear existing interval and start new one
          if (currentInterval) clearInterval(currentInterval);
          currentInterval = setInterval(updateTimer, 1000);

          // Initial disable after reset
          resendLink.style.pointerEvents = "none";
          resendLink.style.opacity = 0.5;
          resendLink.style.color = "#999";

        } catch (err) {
          // Error message
          console.error(err);
          const msg = err.response?.data?.message || "Failed to resend OTP!";
          document.getElementById("errorMsg").innerText = msg;
          document.getElementById("successMsg").innerText = "";
        }
      });
    </script>
  </body>
</html> 