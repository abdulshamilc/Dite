<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dité - Reset Password</title>
     <link rel="stylesheet" href="/style/user/authentications/resetPassword.css">
</head>
<body>
  <div class="container">
    <!-- Left Image -->
    <div class="left"></div>

    <!-- Right Content -->
    <div class="right">
      <div class="logo">
        <img src="/images/logo/DiteLogo.png" alt="Dité Logo">
      </div>

      <!-- Messages -->
      <span id="errorMsg"></span>
      <span id="successMsg"></span>

      <div class="title">Reset Your Password</div>
      <div class="subtitle">Enter your new password below</div>

      <!-- Password Form -->
      <form id="passwordForm">
        <div class="password-inputs">
          <input 
            type="password" 
            id="newPassword"
            name="newPassword" 
            placeholder="New Password"
          />
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword"
            placeholder="Confirm Password"
            
          />

        <button type="submit" id="submitBtn">RESET PASSWORD</button>
      </form>

      <a href="/login" class="back">Go back to Login page</a>
    </div>
  </div>

 <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>


 


  const newPasswordInput = document.getElementById('newPassword');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const submitBtn = document.getElementById('submitBtn');

  function checkPasswordsMatch() {
    const newPass = newPasswordInput.value.trim();
    const confirmPass = confirmPasswordInput.value.trim();

    // Enable button only when passwords match and not empty
    const isValid = newPass !== "" && newPass === confirmPass;
    submitBtn.disabled = !isValid;

    return isValid;
  }

  // Real-time validation
  newPasswordInput.addEventListener('input', checkPasswordsMatch);
  confirmPasswordInput.addEventListener('input', checkPasswordsMatch);

  // Handle form submit
  document.getElementById("passwordForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const newPassword = newPasswordInput.value.trim();
    const confirmPassword = confirmPasswordInput.value.trim();

    if (newPassword !== confirmPassword) {
      document.getElementById("errorMsg").innerText = "Passwords do not match!";
      document.getElementById("successMsg").innerText = "";
      return;
    }

    try {
      const token = "<%= token %>";
      const res = await axios.post(`/reset-password/${token}`, { newPassword, confirmPassword });

      document.getElementById("successMsg").innerText = res.data.message || "Password reset successfully!";
      document.getElementById("errorMsg").innerText = "";

      if (res.data.success) {
        setTimeout(() => {
          window.location.href = "/login";
        }, 2000);
      }
    } catch (err) {
      const msg = err.response?.data?.message || "Something went wrong!";
      document.getElementById("errorMsg").innerText = msg;
      document.getElementById("successMsg").innerText = "";
    }
  });

  // Initial validation check
  checkPasswordsMatch();
</script>

</body>
</html>