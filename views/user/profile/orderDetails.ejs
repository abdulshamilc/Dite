<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <style>
        :root {
            --primary: #1a1a1a;
            --secondary: #ffffff;
            --accent: #d4af37;
            --light-bg: #f5f5f5;
        }
       
        body {
            background-color: var(--primary);
            color: var(--secondary);
        }
       
        .accent-text {
            color: var(--accent);
        }
       
        .accent-border {
            border-color: var(--accent);
        }
       
        .accent-bg {
            background-color: var(--accent);
            color: var(--primary);
        }
       
        .card {
            background-color: #2a2a2a;
            border: 1px solid #404040;
        }
       
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
       
        .status-delivered {
            background-color: #10b981;
            color: white;
        }
       
        .status-shipped {
            background-color: var(--accent);
            color: var(--primary);
        }
       
        .status-pending {
            background-color: #6b7280;
            color: white;
        }
        .status-active {
            background-color: #10b981;
            color: white;
        }
        .status-partial {
            background-color: #f59e0b;
            color: white;
        }
        .status-cancelled {
            background-color: #ef4444;
            color: white;
        }
        .status-returned {
            background-color: #ef4444;
            color: white;
        }
        .status-partial-return {
            background-color: #f59e0b;
            color: white;
        }
        .status-requested {
            background-color: #f59e0b;
            color: white;
        }
        .status-approved {
            background-color: #10b981;
            color: white;
        }
        .status-rejected {
            background-color: #ef4444;
            color: white;
        }
       
        .timeline-item {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
            position: relative;
        }
       
        .timeline-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-top: 4px;
            flex-shrink: 0;
            position: relative;
            z-index: 2;
        }
       
        .timeline-dot.completed {
            background-color: #10b981;
        }
       
        .timeline-dot.current {
            background-color: var(--accent);
            border: 3px solid var(--accent);
            width: 18px;
            height: 18px;
        }
       
        .timeline-dot.pending {
            background-color: #404040;
            border: 2px solid #6b7280;
        }
        .timeline-dot.canceled {
            background-color: #ef4444;
        }
        .timeline-dot.returned {
            background-color: #ef4444;
        }
       
        .timeline-line {
            width: 2px;
            background-color: #404040;
            margin-left: 5px;
            position: absolute;
            left: 5px;
            top: 20px;
            bottom: -20px;
            z-index: 1;
        }
       
        .timeline-line.completed {
            background-color: #10b981;
        }
       
        .timeline-line.current {
            background-color: var(--accent);
            border-style: dotted;
            border-width: 0 0 0 2px;
        }
       
        .timeline-line.pending {
            background-color: #6b7280;
            border-style: dotted;
            border-width: 0 0 0 2px;
        }
        .timeline-line.pending-yellow {
            background-color: #f59e0b;
            border-style: dotted;
            border-width: 0 0 0 2px;
        }
        .timeline-line.canceled {
            background-color: #ef4444;
        }
        .timeline-line.returned {
            background-color: #ef4444;
        }
       
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 50;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.5);
        }
       
        .modal-content {
            background-color: #2a2a2a;
            margin: 5% auto;
            padding: 0;
            border: 1px solid #404040;
            width: 90%;
            max-width: 500px;
            border-radius: 8px;
            overflow: hidden;
        }
       
        .modal-header {
            background-color: #404040;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
       
        .modal-body {
            padding: 16px;
            max-height: 400px;
            overflow-y: auto;
        }
       
        .modal-footer {
            padding: 16px;
            border-top: 1px solid #404040;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }
       
        .product-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid #404040;
            border-radius: 4px;
            margin-bottom: 8px;
        }
       
        .product-checkbox {
            flex-shrink: 0;
        }
       
        .qty-section {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }
       
        .qty-input {
            width: 60px;
            padding: 4px;
            background-color: #404040;
            color: var(--secondary);
            border: 1px solid #6b7280;
            border-radius: 4px;
            text-align: center;
        }
       
        .qty-input:focus {
            outline: none;
            border-color: var(--accent);
        }
       
        .qty-input.hidden {
            display: none;
        }
       
        .close {
            color: #aaa;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
       
        .close:hover {
            color: var(--accent);
        }
       
        .btn {
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
       
        .btn-primary {
            background-color: var(--accent);
            color: var(--primary);
            border: none;
        }
       
        .btn-secondary {
            background-color: transparent;
            color: #aaa;
            border: 1px solid #404040;
        }
       
        .btn:hover {
            opacity: 0.9;
        }
       
        .estimated-delivery {
            background-color: #10b981;
            color: white;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            display: inline-block;
            margin-top: 8px;
        }
        /* Canceled Items Styles */
        .canceled-item {
            opacity: 0.6;
        }
        .canceled-badge {
            background-color: #ef4444;
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }
        .timeline-dot.canceled {
            background-color: #ef4444;
        }
        .timeline-line.canceled {
            background-color: #ef4444;
        }
        .reason-text {
            font-style: italic;
            color: #fca5a5;
            font-size: 0.875rem;
            margin-top: 4px;
        }
        /* Returned Items Styles */
        .returned-item {
            opacity: 0.7;
        }
        .returned-badge {
            background-color: #ef4444;
            color: white;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }
        .approval-badge {
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 4px;
        }
        .reason-text-return {
            font-style: italic;
            color: #fca5a5;
            font-size: 0.875rem;
            margin-top: 4px;
        }
        .reject-reason {
            color: #ef4444;
            font-size: 0.875rem;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <%- include("../../partials/user/header") %>
    <div class="min-h-screen pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto w-full">
            <%
            // Compute effective quantities for active items by subtracting approved returned quantities (cancels already reflected in item.quantity)
            // Compute effective quantities for active items
            // Logic: item.quantity in DB is already reduced by Approved returns.
            // We subtract 'Requested' and 'Rejected' returns here so they don't show as "Active" 
            // (since they appear in the "Returned Items" list or are potentially in flux).
            let effectiveItems = [];
            let hasActiveItems = false;
            let hasApprovedReturn = false;
            
            // First check if there are any approved returns to set the flag correctly
            if (order.returndProduct && order.returndProduct.length > 0) {
                 hasApprovedReturn = order.returndProduct.some(rp => rp.adminApproved === 'Approved');
            }

            if (order.items && order.items.length > 0) {
                effectiveItems = order.items.map(item => {
                    let effectiveQty = item.quantity || 0;
                    let pendingOrRejectedQty = 0;
                    
                    if (order.returndProduct && order.returndProduct.length > 0) {
                        order.returndProduct.forEach(rp => {
                            // Only subtract Requested or Rejected from Active view
                            // Approved is already subtracted from item.quantity in DB
                            if ((rp.adminApproved === 'Requested' || rp.adminApproved === 'Rejected') &&
                                rp.productId.toString() === item.productId.toString() &&
                                rp.mlSize === item.mlSize) {
                                pendingOrRejectedQty += rp.returndQuantity || 0;
                            }
                        });
                    }
                    
                    effectiveQty -= pendingOrRejectedQty;
                    
                    if (effectiveQty > 0) {
                        hasActiveItems = true;
                    }
                    return {
                        ...item.toObject(),
                        effectiveQuantity: Math.max(0, effectiveQty)
                    };
                }).filter(item => item.effectiveQuantity > 0);
            }

            // Compute available for return: 
            // Start with item.quantity (which excludes Approved).
            // Subtract 'Requested' and 'Rejected' to see what's left to request.
            let returnAvailableItems = [];
            if (order.items && order.items.length > 0) {
                returnAvailableItems = order.items.map(item => {
                    let effectiveQty = item.quantity || 0;
                    let unavailableQty = 0;
                    if (order.returndProduct && order.returndProduct.length > 0) {
                        order.returndProduct.forEach(rp => {
                            // Don't subtract Approved (already gone from item.quantity)
                            if (rp.adminApproved !== 'Approved' && 
                                rp.productId.toString() === item.productId.toString() &&
                                rp.mlSize === item.mlSize) {
                                unavailableQty += rp.returndQuantity || 0;
                            }
                        });
                    }
                    effectiveQty -= unavailableQty;
                    return {
                        ...item.toObject(),
                        effectiveQuantity: Math.max(0, effectiveQty)
                    };
                }).filter(item => item.effectiveQuantity > 0);
            }

            let isPartialCancel = (order.cancelProducts && order.cancelProducts.length > 0) && order.orderStatus !== 'Cancelled';
            let isFullCancel = order.orderStatus === 'Cancelled';
            let isPartialReturn = hasApprovedReturn && hasActiveItems;
            let isFullReturn = order.orderStatus === 'Returned';
            %>
            <!-- Header -->
            <div class="mb-8">
                <a href="/orders" class="text-sm accent-text hover:underline mb-4 inline-block">← Back to Orders</a>
                <div class="flex items-start">
                    <div class="flex-1 text-center">
                        <h1 class="text-4xl font-bold mb-2">Order Details</h1>
                        <p class="text-gray-400">Order ID: <span class="accent-text font-semibold"><%= order.orderID %></span></p>
                    </div>
                    <%
                    let statusClass = 'status-pending';
                    let statusText = 'Pending';
                    if (order.orderStatus) {
                        const lowerStatus = order.orderStatus.toLowerCase();
                        if (lowerStatus === 'delivered') {
                            statusClass = 'status-delivered';
                            statusText = 'Delivered';
                        } else if (lowerStatus === 'shipped') {
                            statusClass = 'status-shipped';
                            statusText = 'Shipped';
                        } else if (isPartialReturn) {
                            statusClass = 'status-partial-return';
                            statusText = 'Partially Returned';
                        } else if (isFullReturn) {
                            statusClass = 'status-returned';
                            statusText = 'Returned';
                        } else if (isPartialCancel) {
                            statusClass = 'status-partial';
                            statusText = 'Partially Cancelled';
                        } else if (isFullCancel) {
                            statusClass = 'status-cancelled';
                            statusText = 'Cancelled';
                        } else {
                            statusText = order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1);
                        }
                    }
                    %>
                    <div class="flex items-center gap-4 ml-4">
                        <span class="status-badge <%= statusClass %>"><%= statusText %></span>
                    </div>
                </div>
            </div>
            <!-- Main Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                <!-- Order Summary -->
                <div class="lg:col-span-2">
                    <div class="card p-6 rounded-lg mb-6">
                        <h2 class="text-xl font-bold mb-4 accent-text">Order Summary</h2>
                       
                        <!-- Active Order Items -->
                        <div class="space-y-4 mb-6 pb-6 border-b border-gray-600">
                            <h3 class="text-lg font-semibold text-gray-300 mb-3">Active Items</h3>
                            <% if (effectiveItems && effectiveItems.length > 0) { %>
                                <% effectiveItems.forEach(item => { %>
                                    <div class="flex items-center gap-4">
                                        <% if (item.image) { %>
                                            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
                                        <% } else { %>
                                            <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                                <span class="text-gray-400 text-xs">No Image</span>
                                            </div>
                                        <% } %>
                                        <div class="flex-1 min-w-0">
                                        <p class="font-semibold">
                                            <%= item.name || 'Unknown Product' %>
                                        </p>
                                        <p class="text-gray-500 text-sm">
                                            <%= (item.mlSize || 0) + ' ml' %>
                                        </p>
                                        </div>
                                        <div class="text-right flex-shrink-0">
                                            <% 
                                                // Display the price BEFORE coupon discount (revert net price)
                                                // Since we now store net price in DB, we add back the coupon portion for display
                                                const storedPrice = item.discoundedPrice || item.discountedPrice || item.basePrice || 0;
                                                const priceBeforeCoupon = storedPrice + (item.couponDiscount || 0);
                                                
                                                const total = priceBeforeCoupon * (item.effectiveQuantity || 1);
                                                const baseTotal = (item.basePrice || 0) * (item.effectiveQuantity || 1);
                                            %>
                                            <% if (item.basePrice > priceBeforeCoupon) { %>
                                                <p class="text-xs text-gray-500 line-through">₹<%= baseTotal.toFixed(2) %></p>
                                            <% } %>
                                            <p class="font-semibold">₹<%= total.toFixed(2) %></p>
                                            <p class="text-sm text-gray-400">Qty: <%= item.effectiveQuantity || 1 %></p>
                                        </div>
                                    </div>
                                <% }); %>
                                <% if (!hasActiveItems) { %>
                                    <p class="text-gray-400 text-center py-4">No active items remaining.</p>
                                <% } %>
                            <% } else { %>
                                <p class="text-gray-400 text-center py-4">No active items found.</p>
                            <% } %>
                        </div>
                        <!-- Canceled Items Section -->
                        <% if (order.cancelProducts && order.cancelProducts.length > 0) { %>
                        <div class="space-y-4 mb-6 pb-6 border-b border-gray-600">
                            <h3 class="text-lg font-semibold text-red-400 mb-3 flex items-center gap-2">
                                Canceled Items
                                <span class="canceled-badge">CANCELED</span>
                            </h3>
                            <% order.cancelProducts.forEach(item => { %>
                                <% const itemTotal = (item.discountedPrice || item.basePrice || 0) * (item.canceledQuantity || 1); %>
                                <div class="flex items-center gap-4 canceled-item">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <span class="text-gray-400 text-xs">No Image</span>
                                        </div>
                                    <% } %>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-semibold">
                                            <%= item.name || 'Unknown Product' %>
                                        </p>
                                        <p class="text-gray-500 text-sm">
                                            <%= (item.mlSize || 0) + ' ml' %>
                                        </p>
                                        <% if (item.reason && item.reason.trim() !== "") { %>
                                            <p class="reason-text">Reason: <%= item.reason %></p>
                                        <% } %>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <p class="font-semibold text-red-400">₹<%= itemTotal.toFixed(2) %></p>
                                        <p class="text-sm text-gray-400">Canceled Qty: <%= item.canceledQuantity || 1 %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <% } %>
                        <!-- Returned Items Section -->
                        <% if (order.returndProduct && order.returndProduct.length > 0) { %>
                        <div class="space-y-4 mb-6 pb-6 border-b border-gray-600">
                            <h3 class="text-lg font-semibold text-red-400 mb-3 flex items-center gap-2">
                                Returned Items
                                <span class="returned-badge">RETURNED</span>
                            </h3>
                            <% order.returndProduct.forEach(item => { %>
                                <% const itemTotal = (item.discountedPrice || item.basePrice || 0) * (item.returndQuantity || 1); %>
                                <div class="flex items-center gap-4 returned-item">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <span class="text-gray-400 text-xs">No Image</span>
                                        </div>
                                    <% } %>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-semibold">
                                            <%= item.name || 'Unknown Product' %>
                                        </p>
                                        <p class="text-gray-500 text-sm">
                                            <%= (item.mlSize || 0) + ' ml' %>
                                        </p>
                                        <% if (item.reason && item.reason.trim() !== "") { %>
                                            <p class="reason-text-return">Reason: <%= item.reason %></p>
                                        <% } %>
                                        <% if (item.rejectReason && item.rejectReason.trim() !== "" && item.adminApproved === 'Rejected') { %>
                                            <p class="reject-reason">Reject Reason: <%= item.rejectReason %></p>
                                        <% } %>
                                        <p class="text-xs text-gray-400 mt-1">
                                            Requested on: <%= new Date(item.returnedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </p>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <p class="font-semibold text-red-400">₹<%= itemTotal.toFixed(2) %></p>
                                        <p class="text-sm text-gray-400">Returned Qty: <%= item.returndQuantity || 1 %></p>
                                        <span class="approval-badge <%= item.adminApproved === 'Requested' ? 'status-requested' : item.adminApproved === 'Approved' ? 'status-approved' : 'status-rejected' %>">
                                            <%= item.adminApproved %>
                                        </span>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <% } %>
                        <!-- Pricing -->
                        <div class="space-y-2">
                            <div class="flex justify-between text-gray-300">
                                <span>Subtotal</span>
                                <span>₹<%= (order.totalAmount + (order.discountAmount || 0)).toFixed(2) %></span>
                            </div>
                            
                            <% if (order.couponCode) { %>
                            <div class="flex justify-between text-gray-300">
                                <span>Coupon Applied (<span class="text-green-400 font-semibold"><%= order.couponCode %></span>)</span>
                                <span class="text-green-400">-₹<%= (order.discountAmount || 0).toFixed(2) %></span>
                            </div>
                            <% } else if (order.discount > 0) { %>
                             <!-- Check if generic discount exists if no specific coupon code (fallback) -->
                             <div class="flex justify-between text-gray-300">
                                <span>Discount</span>
                                <span class="text-green-400">-₹<%= (order.discount || 0).toFixed(2) %></span>
                            </div>
                            <% } %>

                            <div class="flex justify-between text-gray-300">
                                <span>Shipping</span>
                                <span>₹<%= (order.shipping || 0).toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between text-gray-300">
                                <span>Tax</span>
                                <span>₹<%= (order.tax || 0).toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between text-lg font-bold accent-text pt-2 border-t border-gray-600">
                                <span>Total Paid</span>
                                <span>₹<%= (order.totalAmount || 0).toFixed(2) %></span>
                            </div>
                        </div>
                    </div>
                    <!-- Delivery Timeline -->
                    <div class="card p-6 rounded-lg">
                        <h2 class="text-xl font-bold mb-6 accent-text">Delivery Timeline</h2>
                        <p class="text-gray-400 mb-4">Estimated delivery: <span class="accent-text">3-5 business days from order placement</span> (Expected arrival: <%= new Date((order.placedAt || order.createdAt || Date.now()) + (4 * 24 * 60 * 60 * 1000)).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>)</p>
                       
                        <div class="relative space-y-6">
                            <!-- Dynamic Timeline Steps -->
                            <%
                            let baseCurrentIndex = 0;
                            const statusMap = {
                                'placed': 0,
                                'shipped': 1,
                                'out for delivery': 2,
                                'delivered': 3,
                                'returned': 4,
                                'cancelled': 1
                            };
                            if (order.orderStatus) {
                                baseCurrentIndex = statusMap[order.orderStatus.toLowerCase()] || 0;
                            }
                            const allMainSteps = [
                                { title: 'Order Placed', mainIndex: 0 },
                                { title: 'Shipped', mainIndex: 1 },
                                { title: 'Out for Delivery', mainIndex: 2 },
                                { title: 'Delivered', mainIndex: 3 },
                                { title: 'Returned', mainIndex: 4 }
                            ];
                            let steps = [];
                            // Always start with Order Placed
                            steps.push({ title: allMainSteps[0].title, mainIndex: allMainSteps[0].mainIndex, isMain: true });
                            let cancelInserted = false;
                            let returnInserted = false;
                            if ((isPartialCancel || isFullCancel) && !cancelInserted) {
                                const cancelTitle = isFullCancel ? 'Cancelled' : 'Partially Cancelled';
                                steps.push({ title: cancelTitle, isMain: false });
                                cancelInserted = true;
                            }
                            if ((isPartialReturn || isFullReturn) && !returnInserted) {
                                const returnTitle = isFullReturn ? 'Returned' : 'Partially Returned';
                                steps.push({ title: returnTitle, isMain: false });
                                returnInserted = true;
                            }
                            if (!isFullCancel && !isFullReturn) {
                                for (let i = 1; i < allMainSteps.length; i++) {
                                    const step = allMainSteps[i];
                                    if (step.mainIndex === 4 && order.orderStatus.toLowerCase() !== 'returned') {
                                        continue;
                                    }
                                    step.isMain = true;
                                    steps.push(step);
                                }
                            }
                            %>
                           
                            <% steps.forEach((step, index) => { %>
                                <%
                                let dotClass = 'timeline-dot pending';
                                let lineClass = 'timeline-line pending';
                                let textClass = 'text-gray-500';
                               
                                // Special handling for Canceled/Partially Canceled step
                                if (!step.isMain) {
                                    if (step.title.includes('Cancel') || step.title.includes('cancelled')) {
                                        dotClass = 'timeline-dot canceled';
                                        lineClass = isPartialCancel ? 'timeline-line pending-yellow' : 'timeline-line canceled';
                                        textClass = 'text-red-400';
                                    } else if (step.title.includes('Return') || step.title.includes('returned')) {
                                        dotClass = 'timeline-dot returned';
                                        lineClass = isPartialReturn ? 'timeline-line pending-yellow' : 'timeline-line returned';
                                        textClass = 'text-red-400';
                                    }
                                } else {
                                    // Main steps: past (completed), current, next upcoming, further future (pending)
                                    if (step.mainIndex < baseCurrentIndex) {
                                        // Past: completed
                                        dotClass = 'timeline-dot completed';
                                        lineClass = 'timeline-line completed';
                                        textClass = 'text-green-400';
                                    } else if (step.mainIndex === baseCurrentIndex) {
                                        // Current: completed dot and line, green text
                                        dotClass = 'timeline-dot completed';
                                        lineClass = 'timeline-line completed';
                                        textClass = 'text-green-400';
                                    } else if (step.mainIndex === baseCurrentIndex + 1) {
                                        // Next upcoming: gold dot and text
                                        dotClass = 'timeline-dot current';
                                        lineClass = 'timeline-line pending';
                                        textClass = 'accent-text';
                                    } else {
                                        // Further future: pending
                                        dotClass = 'timeline-dot pending';
                                        lineClass = 'timeline-line pending';
                                        textClass = 'text-gray-500';
                                    }
                                    // Special handling for Returned step
                                    if (step.title === 'Returned') {
                                        dotClass = 'timeline-dot returned';
                                        lineClass = 'timeline-line returned';
                                        textClass = 'text-red-400';
                                    }
                                }
                                %>
                                <div class="timeline-item">
                                    <div class="<%= dotClass %>"></div>
                                    <div class="flex-1">
                                        <p class="font-semibold <%= textClass %>"><%= step.title %></p>
                                        <%
                                        let formattedDate = 'Date not available';
                                        let eventMessage = '';
                                        let dateClass = 'text-gray-500';
                                        let messageClass = 'text-gray-500';
                                       
                                        // Adjust dateClass and messageClass based on textClass and step type
                                        if (textClass === 'text-green-400') {
                                            dateClass = 'text-green-400';
                                            messageClass = 'text-green-300';
                                        } else if (textClass === 'accent-text') {
                                            dateClass = 'accent-text';
                                            messageClass = 'accent-text';
                                        } else if (textClass === 'text-red-400') {
                                            dateClass = 'text-red-400';
                                            messageClass = 'text-red-300';
                                        } else if (step.title.includes('Cancel') || step.title.includes('cancelled')) {
                                            dateClass = 'text-red-400';
                                            messageClass = 'text-red-300';
                                        } else if (step.title.includes('Return') || step.title.includes('returned')) {
                                            dateClass = 'text-red-400';
                                            messageClass = 'text-red-300';
                                        } else if (step.mainIndex === baseCurrentIndex + 1 && step.isMain) {
                                            dateClass = 'accent-text';
                                            messageClass = 'accent-text';
                                        }
                                       
                                        if (step.title === 'Order Placed') {
                                            // Special handling for Order Placed: Use placedAt or createdAt
                                            const placedDate = order.placedAt || order.createdAt;
                                            if (placedDate) {
                                                const date = new Date(placedDate);
                                                if (!isNaN(date.getTime())) {
                                                    formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                                }
                                            }
                                        } else if (order.tracking && order.tracking.length > 0) {
                                            const searchTitle = step.title.toLowerCase().replace('partially ', '');
                                            const matchingEvent = order.tracking.find(event => event.status && event.status.toLowerCase().includes(searchTitle));
                                            if (matchingEvent && matchingEvent.date) {
                                                const date = new Date(matchingEvent.date);
                                                if (!isNaN(date.getTime())) {
                                                    formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                                }
                                                if (matchingEvent.message && !matchingEvent.message.toLowerCase().includes('by admin')) {
                                                    eventMessage = matchingEvent.message;
                                                }
                                            }
                                        }
                                       
                                        // Fallback for non-tracking cases
                                        if (formattedDate === 'Date not available') {
                                            if (step.title.includes('Canceled') || step.title.includes('cancelled')) {
                                                const cancelDate = order.cancelledAt || order.updatedAt || order.createdAt;
                                                if (cancelDate) {
                                                    const date = new Date(cancelDate);
                                                    if (!isNaN(date.getTime())) {
                                                        formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                                    }
                                                } else {
                                                    formattedDate = 'Date not available';
                                                }
                                            } else if (step.title.includes('Returned') || step.title.includes('return')) {
                                                const returnDate = order.updatedAt || new Date();
                                                const date = new Date(returnDate);
                                                if (!isNaN(date.getTime())) {
                                                    formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                                }
                                            } else {
                                                formattedDate = 'Pending';
                                            }
                                        }
                                        %>
                                        <p class="text-sm <%= dateClass %>"><%= formattedDate %></p>
                                        <% if (eventMessage && !step.title.toLowerCase().includes('cancel') && !step.title.toLowerCase().includes('return')) { %>
                                            <p class="text-sm <%= messageClass %> mt-1"><%= eventMessage %></p>
                                        <% } %>
                                    </div>
                                    <% if (index < steps.length - 1) { %>
                                        <div class="<%= lineClass %>"></div>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
                <!-- Sidebar -->
                <div class="space-y-6">
                    <!-- Shipping Address -->
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Shipping Address</h3>
                        <div class="text-sm space-y-1 text-gray-300">
                            <% if (order.address) { %>
                                <p class="font-semibold"><%= order.address.fullName || '' %></p>
                                <p><%= order.address.street || '' %></p>
                                <p><%= order.address.hoNo || '' %></p>
                                <p><%= (order.address.city || '') + ', ' + (order.address.state || '') + ' ' + (order.address.pin || '') %></p>
                                <p><%= order.address.country || '' %></p>
                                <p class="mt-3 accent-text"><%= order.address.phone || '' %></p>
                            <% } else { %>
                                <p class="text-gray-400">Shipping address not available.</p>
                            <% } %>
                        </div>
                    </div>
                    <!-- Payment Method -->
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Payment Method</h3>
                        <div class="text-sm space-y-2 text-gray-300">
                            <%
                            let paymentDisplay = 'Payment details not available.';
                            if (order.paymentMethod) {
                                if (typeof order.paymentMethod === 'string' && order.paymentMethod.toLowerCase() === 'cod') {
                                    paymentDisplay = 'Cash On Delivery';
                                } else if (typeof order.paymentMethod === 'object' && order.paymentMethod.last4) {
                                    paymentDisplay = `${order.paymentMethod.type || 'Card'} ending in ${order.paymentMethod.last4}`;
                                } else {
                                    paymentDisplay = typeof order.paymentMethod === 'string' ? order.paymentMethod : 'Payment details not available.';
                                }
                            }
                            %>
                            <p><%= paymentDisplay %></p>
                        </div>
                    </div>
                    <!-- Coupon -->
                    <% if (order.coupon) { %>
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Coupon</h3>
                        <div class="text-sm space-y-2 text-gray-300">
                            <p class="font-semibold"><%= order.coupon.code || 'Coupon Applied' %></p>
                            <p><%= order.coupon.description || '' %></p>
                            <% if (order.coupon.discountType === 'percentage') { %>
                            <p class="accent-text"><%= order.coupon.discountValue %>% off</p>
                            <% } else { %>
                            <p class="accent-text">₹<%= order.coupon.discountValue || 0 %> off</p>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                    <!-- Actions -->
                    <% if (order.paymentMethod === 'online' && order.paymentInfo && (order.paymentInfo.paymentStatus === 'Failed' || order.paymentInfo.paymentStatus === 'Pending') && order.orderStatus !== 'Cancelled' && order.orderStatus !== 'Returned' && order.orderStatus !== 'Delivered') { %>
                        <button id="retryPaymentBtn" class="block w-full bg-yellow-600 hover:bg-yellow-700 text-white py-3 rounded-lg font-semibold transition text-center mb-3" aria-label="Retry Payment">Retry Payment</button>
                    <% } %>
                    <% if (order.orderStatus === 'Placed' && hasActiveItems) { %>
                    <button id="cancelOrderBtn" class="block w-full bg-red-600 hover:bg-red-700 text-white py-3 rounded-lg font-semibold transition text-center" aria-label="Cancel order items">Cancel Order</button>
                    <% } %>
                    <% 
                        let isReturnable = false;
                        if (order.orderStatus === 'Delivered' && order.deliveredAt) {
                            const deliveryDate = new Date(order.deliveredAt);
                            const currentDate = new Date();
                            const timeDiff = currentDate - deliveryDate;
                            const daysDiff = timeDiff / (1000 * 3600 * 24);
                            if (daysDiff <= 3) {
                                isReturnable = true;
                            }
                        }
                    %>
                    <% if (order.orderStatus === 'Delivered' && hasActiveItems && isReturnable) { %>
                    <button id="returnOrderBtn" class="block w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold transition text-center" aria-label="Return order items">Return Order</button>
                    <% } %>
                    <button id="downloadInvoiceBtn" class="block w-full border border-gray-600 py-3 rounded-lg font-semibold hover:border-accent transition text-center" aria-label="Download invoice PDF">Download Invoice</button>
                </div>
            </div>
        </div>
        <!-- Cancel Order Modal -->
        <div id="cancelModal" class="modal">
            <form id="cancelForm" method="POST">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 class="font-bold accent-text">Cancel Order Items</h3>
                        <span class="close">&times;</span>
                    </div>
                    <div class="modal-body">
                        <p class="text-gray-300 mb-4">Select items to cancel and specify the quantity (starting from 1 up to available):</p>
                        <% if (effectiveItems && effectiveItems.length > 0) { %>
                            <% effectiveItems.forEach((item, index) => { %>
                                <div class="product-item">
                                    <input type="checkbox" class="product-checkbox" id="item<%= index %>">
                                    <label for="item<%= index %>" class="flex-1 cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-12 h-12 object-cover rounded">
                                            <% } else { %>
                                                <div class="w-12 h-12 bg-gray-600 rounded flex items-center justify-center">
                                                    <span class="text-gray-400 text-xs">No Image</span>
                                                </div>
                                            <% } %>
                                            <div>
                                                <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                                                <p class="text-sm text-gray-500"><%= (item.mlSize || 0) + ' ml' %></p>
                                                <p class="text-sm text-gray-400">Available to cancel: <%= item.effectiveQuantity || 1 %></p>
                                            </div>
                                        </div>
                                    </label>
                                    <div class="qty-section">
                                        <label for="qty<%= index %>" class="text-sm text-gray-400">Qty:</label>
                                        <input type="number" class="qty-input hidden" id="qty<%= index %>" name="qty<%= index %>" min="1" max="<%= item.effectiveQuantity || 1 %>" value="1" data-item-index="<%= index %>">
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-400 text-center py-4">No items to cancel.</p>
                        <% } %>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="confirmCancel" class="btn btn-primary">Confirm Cancel</button>
                        <button type="button" id="closeModal" class="btn btn-secondary">Close</button>
                    </div>
                </div>
            </form>
        </div>
        <!-- Return Order Modal -->
        <div id="returnModal" class="modal">
            <form id="returnForm" method="POST">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 class="font-bold accent-text">Return Order Items</h3>
                        <span class="close">&times;</span>
                    </div>
                    <div class="modal-body">
                        <p class="text-gray-300 mb-4">Select items to return and specify the quantity (starting from 1 up to available):</p>
                        <% if (returnAvailableItems && returnAvailableItems.length > 0) { %>
                            <% returnAvailableItems.forEach((item, index) => { %>
                                <div class="product-item">
                                    <input type="checkbox" class="product-checkbox" id="returnItem<%= index %>">
                                    <label for="returnItem<%= index %>" class="flex-1 cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-12 h-12 object-cover rounded">
                                            <% } else { %>
                                                <div class="w-12 h-12 bg-gray-600 rounded flex items-center justify-center">
                                                    <span class="text-gray-400 text-xs">No Image</span>
                                                </div>
                                            <% } %>
                                            <div>
                                                <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                                                <p class="text-sm text-gray-500"><%= (item.mlSize || 0) + ' ml' %></p>
                                                <p class="text-sm text-gray-400">Available to return: <%= item.effectiveQuantity || 1 %></p>
                                            </div>
                                        </div>
                                    </label>
                                    <div class="qty-section">
                                        <label for="returnQty<%= index %>" class="text-sm text-gray-400">Qty:</label>
                                        <input type="number" class="qty-input hidden" id="returnQty<%= index %>" name="returnQty<%= index %>" min="1" max="<%= item.effectiveQuantity || 1 %>" value="1" data-item-index="<%= index %>">
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-gray-400 text-center py-4">No items to return.</p>
                        <% } %>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="confirmReturn" class="btn btn-primary">Confirm Return</button>
                        <button type="button" id="closeReturnModal" class="btn btn-secondary">Close</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const orderId = '<%= order._id %>';
        const cancelItems = <%- JSON.stringify(effectiveItems || []) %>;
        const returnItems = <%- JSON.stringify(returnAvailableItems || []) %>;
        const cancelModal = document.getElementById('cancelModal');
        const returnModal = document.getElementById('returnModal');
        const cancelForm = document.getElementById('cancelForm');
        const returnForm = document.getElementById('returnForm');
        const cancelBtn = document.getElementById('cancelOrderBtn');
        const returnBtn = document.getElementById('returnOrderBtn');
        const cancelCloseSpan = document.querySelector('#cancelModal .close');
        const returnCloseSpan = document.querySelector('#returnModal .close');
        const closeModalBtn = document.getElementById('closeModal');
        const closeReturnModalBtn = document.getElementById('closeReturnModal');
        const confirmCancelBtn = document.getElementById('confirmCancel');
        const confirmReturnBtn = document.getElementById('confirmReturn');
        // Handle checkbox toggle for quantity input in cancel modal
        document.querySelectorAll('#cancelModal .product-checkbox').forEach((checkbox, index) => {
            const qtyInput = document.getElementById(`qty${index}`);
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    qtyInput.classList.remove('hidden');
                    qtyInput.value = 1; // Start from 1
                } else {
                    qtyInput.classList.add('hidden');
                    qtyInput.value = 1; // Reset but hidden
                }
            });
        });
        // Handle checkbox toggle for quantity input in return modal
        document.querySelectorAll('#returnModal .product-checkbox').forEach((checkbox, index) => {
            const qtyInput = document.getElementById(`returnQty${index}`);
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    qtyInput.classList.remove('hidden');
                    qtyInput.value = 1; // Start from 1
                } else {
                    qtyInput.classList.add('hidden');
                    qtyInput.value = 1; // Reset but hidden
                }
            });
        });
        // Set form actions
        if (cancelForm) cancelForm.action = `/cancelOrder/${orderId}`;
        if (returnForm) returnForm.action = `/return/${orderId}`;
        // Cancel modal handlers
        if (cancelBtn) {
            cancelBtn.onclick = function() {
                cancelModal.style.display = 'block';
            };
        }
        if (cancelCloseSpan) {
            cancelCloseSpan.onclick = function() {
                cancelModal.style.display = 'none';
            };
        }
        if (closeModalBtn) {
            closeModalBtn.onclick = function() {
                cancelModal.style.display = 'none';
            };
        }
        // Return modal handlers
        if (returnBtn) {
            returnBtn.onclick = function() {
                returnModal.style.display = 'block';
            };
        }
        if (returnCloseSpan) {
            returnCloseSpan.onclick = function() {
                returnModal.style.display = 'none';
            };
        }
        if (closeReturnModalBtn) {
            closeReturnModalBtn.onclick = function() {
                returnModal.style.display = 'none';
            };
        }
        // Close modals on outside click
        window.onclick = function(event) {
            if (event.target == cancelModal) {
                cancelModal.style.display = 'none';
            }
            if (event.target == returnModal) {
                returnModal.style.display = 'none';
            }
        };
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                cancelModal.style.display = 'none';
                returnModal.style.display = 'none';
            }
        });
        // Handle cancel form submit
        if (confirmCancelBtn) {
            confirmCancelBtn.onclick = function(e) {
                e.preventDefault(); // Prevent default submit
                const selectedItems = [];
                let hasSelection = false;
                document.querySelectorAll('#cancelModal .product-checkbox:checked').forEach(checkbox => {
                    const index = parseInt(checkbox.id.replace('item', ''));
                    const qtyInput = document.getElementById(`qty${index}`);
                    const qty = parseInt(qtyInput.value);
                    if (isNaN(qty) || qty < 1 || qty > parseInt(qtyInput.max)) {
                        alert(`Invalid quantity for ${cancelItems[index]?.name || 'item'}: Must be 1-${qtyInput.max}`);
                        return;
                    }
                    const item = cancelItems[index];
                    selectedItems.push({
                        productId: item._id,
                        mlSize: item.mlSize || 0,
                        cancelQty: qty
                    });
                    hasSelection = true;
                });
                if (!hasSelection) {
                    alert('Please select at least one item and specify a valid quantity (1 to available) to cancel.');
                    return;
                }
                // Reset non-selected qty inputs
                document.querySelectorAll('#cancelModal .product-checkbox:not(:checked)').forEach(checkbox => {
                    const index = parseInt(checkbox.id.replace('item', ''));
                    const qtyInput = document.getElementById(`qty${index}`);
                    qtyInput.value = '';
                });
                // Create hidden input for cancelledItems JSON
                let hiddenInput = document.querySelector('#cancelForm input[name="cancelledItems"]');
                if (!hiddenInput) {
                    hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'cancelledItems';
                    cancelForm.appendChild(hiddenInput);
                }
                hiddenInput.value = JSON.stringify(selectedItems);
                // Submit the form to proceed to the cancel confirmation page
                cancelForm.submit();
            };
        }
        // Handle return form submit
        if (confirmReturnBtn) {
            confirmReturnBtn.onclick = function(e) {
                e.preventDefault(); // Prevent default submit
                const selectedItems = [];
                let hasSelection = false;
                document.querySelectorAll('#returnModal .product-checkbox:checked').forEach(checkbox => {
                    const index = parseInt(checkbox.id.replace('returnItem', ''));
                    const qtyInput = document.getElementById(`returnQty${index}`);
                    const qty = parseInt(qtyInput.value);
                    if (isNaN(qty) || qty < 1 || qty > parseInt(qtyInput.max)) {
                        alert(`Invalid quantity for ${returnItems[index]?.name || 'item'}: Must be 1-${qtyInput.max}`);
                        return;
                    }
                    const item = returnItems[index];
                    selectedItems.push({
                        productId: item._id,
                        mlSize: item.mlSize || 0,
                        returnQty: qty
                    });
                    hasSelection = true;
                });
                if (!hasSelection) {
                    alert('Please select at least one item and specify a valid quantity (1 to available) to return.');
                    return;
                }
                // Reset non-selected qty inputs
                document.querySelectorAll('#returnModal .product-checkbox:not(:checked)').forEach(checkbox => {
                    const index = parseInt(checkbox.id.replace('returnItem', ''));
                    const qtyInput = document.getElementById(`returnQty${index}`);
                    qtyInput.value = '';
                });
                // Create hidden input for returnedItems JSON
                let hiddenInput = document.querySelector('#returnForm input[name="returnedItems"]');
                if (!hiddenInput) {
                    hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = 'returnedItems';
                    returnForm.appendChild(hiddenInput);
                }
                hiddenInput.value = JSON.stringify(selectedItems);
                // Submit the form to proceed to the return confirmation page
                returnForm.submit();
            };
        }
        // Retry Payment Logic
        const retryPaymentBtn = document.getElementById('retryPaymentBtn');
        if (retryPaymentBtn) {
            retryPaymentBtn.addEventListener('click', async () => {
                try {
                    retryPaymentBtn.disabled = true;
                    retryPaymentBtn.textContent = 'Processing...';

                    const response = await fetch(`/checkout/payment/retry/${orderId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    
                    const data = await response.json();
                    
                    if (!data.success) {
                        Swal.fire({
                             icon: 'error',
                             title: 'Retry Failed',
                             text: data.message || 'Failed to initiate retry',
                             background: '#1a1a1a', color: '#ffffff'
                        });
                        retryPaymentBtn.disabled = false;
                        retryPaymentBtn.textContent = 'Retry Payment';
                        return;
                    }

                    const options = {
                        "key": data.key,
                        "amount": data.order.amount,
                        "currency": "INR",
                        "name": "Dité",
                        "description": "Retry Payment",
                        "image": "/img/logo.png",
                        "order_id": data.order.id, 
                        "handler": async function (response){
                             try {
                                const verifyRes = await fetch('/checkout/payment/verify-retry', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_signature: response.razorpay_signature,
                                        orderId: orderId
                                    })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Payment Successful',
                                        text: 'Your payment has been requested successfully.',
                                        showConfirmButton: false,
                                        timer: 1500,
                                        background: '#1a1a1a', color: '#ffffff'
                                    }).then(() => {
                                        window.location.reload();
                                    });
                                } else {
                                     Swal.fire({
                                        icon: 'error',
                                        title: 'Verification Failed',
                                        text: verifyData.message || 'Payment verification failed',
                                        background: '#1a1a1a', color: '#ffffff'
                                    });
                                }
                             } catch(err) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Verification error: ' + err.message,
                                    background: '#1a1a1a', color: '#ffffff'
                                });
                             }
                        },
                        "prefill": {
                            "name": data.user.name,
                            "email": data.user.email,
                            "contact": data.user.phone
                        },
                        "theme": {
                            "color": "#d4c5a9"
                        },
                        "modal": {
                            "ondismiss": function(){
                                retryPaymentBtn.disabled = false;
                                retryPaymentBtn.textContent = 'Retry Payment';
                            }
                        }
                    };
                    const rzp1 = new Razorpay(options);
                    rzp1.on('payment.failed', function (response){
                         Swal.fire({
                            icon: 'error',
                            title: 'Payment Failed',
                            text: response.error.description,
                            background: '#1a1a1a', color: '#ffffff'
                        });
                        retryPaymentBtn.disabled = false;
                        retryPaymentBtn.textContent = 'Retry Payment';
                    });
                    rzp1.open();

                } catch (err) {
                    console.error(err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error: ' + err.message,
                        background: '#1a1a1a', color: '#ffffff'
                    });
                    retryPaymentBtn.disabled = false;
                    retryPaymentBtn.textContent = 'Retry Payment';
                }
            });
        }

        // Download Invoice
        const downloadInvoiceBtn = document.getElementById('downloadInvoiceBtn');
        if (downloadInvoiceBtn) {
            downloadInvoiceBtn.addEventListener('click', async () => {
                try {
                    const response = await fetch(`/invoice/${orderId}`);
                    if (!response.ok) throw new Error('Download failed');
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Invoice-${orderId}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);
                } catch (err) {
                    alert('Error downloading invoice: ' + err.message);
                }
            });
        }
    </script>
    <%- include("../../partials/user/footer") %>
</body>
</html>