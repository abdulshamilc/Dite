<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details</title>
    <link rel="stylesheet" href="/style/user/header.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary: #1a1a1a;
            --secondary: #ffffff;
            --accent: #d4af37;
            --light-bg: #f5f5f5;
        }
        
        body {
            background-color: var(--primary);
            color: var(--secondary);
        }
        
        .accent-text {
            color: var(--accent);
        }
        
        .accent-border {
            border-color: var(--accent);
        }
        
        .accent-bg {
            background-color: var(--accent);
            color: var(--primary);
        }
        
        .card {
            background-color: #2a2a2a;
            border: 1px solid #404040;
        }
        
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-delivered {
            background-color: #10b981;
            color: white;
        }
        
        .status-shipped {
            background-color: var(--accent);
            color: var(--primary);
        }
        
        .status-pending {
            background-color: #6b7280;
            color: white;
        }
        
        .timeline-item {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }
        
        .timeline-dot {
            width: 12px;
            height: 12px;
            background-color: var(--accent);
            border-radius: 50%;
            margin-top: 4px;
            flex-shrink: 0;
        }
        
        .timeline-line {
            width: 2px;
            background-color: #404040;
            margin-left: 5px;
        }
    </style>
</head>
<body>
    <%- include("../../partials/user/header") %>
    <div class="min-h-screen pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto w-full">
            <!-- Header -->
            <div class="mb-8">
                <a href="/orders" class="text-sm accent-text hover:underline mb-4 inline-block">← Back to Orders</a>
                <div class="flex items-start">
                    <div class="flex-1 text-center">
                        <h1 class="text-4xl font-bold mb-2">Order Details</h1>
                        <p class="text-gray-400">Order ID: <span class="accent-text font-semibold"><%= order.orderID  %></span></p>
                    </div>
                    <% 
                    let statusClass = 'status-pending';
                    let statusText = 'Pending';
                    if (order.orderStatus) {
                        const lowerStatus = order.orderStatus.toLowerCase();
                        if (lowerStatus === 'delivered') {
                            statusClass = 'status-delivered';
                            statusText = 'Delivered';
                        } else if (lowerStatus === 'shipped') {
                            statusClass = 'status-shipped';
                            statusText = 'Shipped';
                        } else {
                            statusText = order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1);
                        }
                    }
                    %>
                    <div class="flex-none ml-4">
                        <span class="status-badge <%= statusClass %>"><%= statusText %></span>
                    </div>
                </div>
            </div>

            <!-- Main Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                <!-- Order Summary -->
                <div class="lg:col-span-2">
                    <div class="card p-6 rounded-lg mb-6">
                        <h2 class="text-xl font-bold mb-4 accent-text">Order Summary</h2>
                        
                        <!-- Order Items -->
                        <div class="space-y-4 mb-6 pb-6 border-b border-gray-600">
                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.forEach(item => { %>
                                <div class="flex items-center gap-4">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" alt="<%= item.name || item.name %>" class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <span class="text-gray-400 text-xs">No Image</span>
                                        </div>
                                    <% } %>
                                    <div class="flex-1 min-w-0">
                                    <p class="font-semibold">
                                        <%= item ? item.name : (item.name || 'Unknown Product') %>
                                    </p>
                                    <p class="text-gray-500 text-sm">
                                        <%= item ? (item.mlSize || 0) + ' ml' : 'Size Unknown' %>
                                    </p>
                                    </div>

                                    <div class="text-right flex-shrink-0">
                                        <p class="font-semibold"><%= ((item.basePrice || 0) * (item.qty || 1)).toFixed(2) %></p>
                                        <p class="text-sm text-gray-400">Qty: <%= item.quantity || 1 %></p>
                                    </div>
                                </div>
                                <% }); %>
                            <% } else { %>
                                <p class="text-gray-400 text-center py-4">No items found.</p>
                            <% } %>
                        </div>

                        <!-- Pricing -->
                        <div class="space-y-2">
                            <div class="flex justify-between text-gray-300">
                                <span>Subtotal</span>
                                <span><%=  subTotal || 0 %></span>
                            </div>
                            <div class="flex justify-between text-gray-300">
                                <span>Discount</span>
                                <span class="text-red-400">-<%= discount || 0%></span>
                            </div>
                            <div class="flex justify-between text-gray-300">
                                <span>Shipping</span>
                                <span><%= (order.shipping || 0).toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between text-gray-300">
                                <span>Tax</span>
                                <span><%= (order.tax || 0).toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between text-lg font-bold accent-text pt-2 border-t border-gray-600">
                                <span>Total</span>
                                <span> <%= totalAmount || 0 %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery Timeline -->
                    <div class="card p-6 rounded-lg">
                        <h2 class="text-xl font-bold mb-6 accent-text">Delivery Timeline</h2>
                        
                        <div class="relative">
                            <% if (order.tracking && order.tracking.length > 0) { %>
                                <% order.tracking.forEach((event, index) => { %>
                                <% 
                                let formattedDate = 'Date not available';
                                if (event.date) {
                                    const date = new Date(event.date);
                                    if (!isNaN(date.getTime())) {
                                        formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                    }
                                }
                                %>
                                <% if (index < order.tracking.length - 1) { %>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="flex-1">
                                        <p class="font-semibold"><%= event.status || 'Event' %></p>
                                        <p class="text-sm text-gray-400"><%= formattedDate %></p>
                                        <% if (event.message) { %>
                                        <p class="text-sm text-gray-300 mt-1"><%= event.message %></p>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="timeline-line h-8 ml-1"></div>
                                <% } else { %>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="flex-1">
                                        <p class="font-semibold"><%= event.status || 'Event' %></p>
                                        <p class="text-sm text-gray-400"><%= formattedDate %></p>
                                        <% if (event.message) { %>
                                        <p class="text-sm text-gray-300 mt-1"><%= event.message %></p>
                                        <% } %>
                                    </div>
                                </div>
                                <% } %>
                                <% }); %>
                            <% } else { %>
                                <p class="text-gray-400 text-center py-8">No timeline available.</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <!-- Shipping Address -->
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Shipping Address</h3>
                        <div class="text-sm space-y-1 text-gray-300">
                            <% if (order.address) { %>
                                <p class="font-semibold"><%= order.address.fullName || '' %></p>
                                <p><%= order.address.street || '' %></p>
                                <p><%= order.address.hoNo || '' %></p>
                                <p><%= (order.address.city || '') + ', ' + (order.address.state || '') + ' ' + (order.address.pin || '') %></p>
                                <p><%= order.address.country || '' %></p>
                                <p class="mt-3 accent-text"><%= order.address.phone || '' %></p>
                            <% } else { %>
                                <p class="text-gray-400">Shipping address not available.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Payment Method</h3>
                        <div class="text-sm space-y-2 text-gray-300">
                            <% if (order.paymentMethod) { %>
                                <p>
                                <% if(order.paymentMethod === "cod") { %>
                                    Cash On Delivery
                                <% } else { %>
                                    <%= order.paymentMethod %> 
                                    <span class="accent-text font-semibold">
                                    <%= order.paymentMethod.last4 ? order.paymentMethod.last4 : '' %>
                                    </span>
                                <% } %>
                                </p>

                            <% } else { %>
                                <p class="text-gray-400">Payment details not available.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- Coupon -->
                    <% if (order.coupon) { %>
                    <div class="card p-6 rounded-lg">
                        <h3 class="font-bold mb-4 accent-text">Coupon</h3>
                        <div class="text-sm space-y-2 text-gray-300">
                            <p class="font-semibold"><%= order.coupon.code || 'Coupon Applied' %></p>
                            <p><%= order.coupon.description || '' %></p>
                            <% if (order.coupon.discountType === 'percentage') { %>
                            <p class="accent-text"><%= order.coupon.discountValue %>% off</p>
                            <% } else { %>
                            <p class="accent-text">₹<%= order.coupon.discountValue || 0 %> off</p>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <!-- Actions -->
                    <a href="/track/<%= order._id %>" class="block w-full accent-bg py-3 rounded-lg font-semibold hover:opacity-90 transition text-center">Track Package</a>
                    <a href="/invoice/<%= order._id %>" class="block w-full border border-gray-600 py-3 rounded-lg font-semibold hover:border-accent transition text-center">Download Invoice</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>