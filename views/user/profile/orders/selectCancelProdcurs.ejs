<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit Items to Cancel' : 'Select Items to Cancel' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <%- include("../../../partials/user/headerHead") %>
    <%- include("../../../partials/user/footerHead") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style/user/profile/orders/selectCancelProdcurs.css">
</head>
<body>
    <%- include("../../../partials/user/header") %>
    <div class="min-h-screen pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto w-full">
            <!-- Header -->
            <div class="mb-8">
                <a href="<%= isEdit ? `/cancel-order/${order._id}` : `/orders/${order._id}` %>" class="text-sm accent-text hover:underline mb-4 inline-block">← <%= isEdit ? 'Back to Confirmation' : 'Back to Order Details' %></a>
                <div class="flex items-start">
                    <div class="flex-1 text-center">
                        <h1 class="text-4xl font-bold mb-2"><%= isEdit ? 'Edit Items to Cancel' : 'Select Items to Cancel' %></h1>
                        <p class="text-gray-400">Order ID: <span class="accent-text font-semibold"><%= order.orderID %></span></p>
                    </div>
                    <div class="flex-none ml-4">
                        <span class="status-badge status-cancel">Cancelling</span>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="space-y-6">
                <form id="cancelForm" action="/cancelOrder/<%= order._id %>/cancel-select" method="POST">
                    <div class="card p-6 rounded-lg">
                        <h2 class="text-xl font-bold mb-4 accent-text"><%= isEdit ? 'Edit Items to Cancel' : 'Select Items to Cancel' %></h2>
                        <p class="text-gray-300 mb-4">Select items to cancel and specify the quantity (starting from 1 up to available):</p>
                        <div class="space-y-2">
                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.forEach((item, index) => { %>
                                    <% 
                                        let preCancelQty = 0;
                                        let isPreSelected = false;
                                        if (cancelledItems) {
                                            const matchingItem = cancelledItems.find(ic => ic.item._id.toString() === item._id.toString());
                                            if (matchingItem) {
                                                preCancelQty = matchingItem.cancelQty;
                                                isPreSelected = preCancelQty > 0;
                                            }
                                        }
                                    %>
                                    <div class="product-item">
                                        <input type="checkbox" class="product-checkbox" id="item<%= index %>" <%= isPreSelected ? 'checked' : '' %>>
                                        <label for="item<%= index %>" class="flex-1 cursor-pointer">
                                            <div class="flex items-center gap-3">
                                                <% if (item.image) { %>
                                                    <img src="<%= item.image %>" alt="<%= item.name %>" class="w-12 h-12 object-cover rounded">
                                                <% } else { %>
                                                    <div class="w-12 h-12 bg-gray-600 rounded flex items-center justify-center">
                                                        <span class="text-gray-400 text-xs">No Image</span>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                                                    <p class="text-sm text-gray-500"><%= (item.mlSize || 0) + ' ml' %></p>
                                                    <p class="text-sm text-gray-400">Available to cancel: <%= item.quantity || 1 %></p>
                                                    <% 
                                                       // Show Effective Price per unit for clarity
                                                       const price = item.discountedPrice || item.basePrice || 0;
                                                       const perUnitCouponDiscount = item.couponDiscount || 0;
                                                       const effectivePrice = Math.max(0, price - perUnitCouponDiscount);
                                                    %>
                                                    <p class="text-xs text-green-400">Refundable: ₹<%= effectivePrice.toFixed(2) %>/unit</p>
                                                </div>
                                            </div>
                                        </label>
                                        <div class="qty-section">
                                            <label for="qty<%= index %>" class="text-sm text-gray-400">Qty:</label>
                                            <input type="number" class="qty-input <%= isPreSelected ? '' : 'hidden' %>" id="qty<%= index %>" name="qty<%= index %>" min="1" max="<%= item.quantity || 1 %>" value="<%= isPreSelected ? preCancelQty : 1 %>" data-item-index="<%= index %>">
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p class="text-gray-400 text-center py-4">No items to cancel.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-4 pt-4">
                        <a href="/cancelOrder/<%= order._id %>" class="flex-1 btn btn-secondary text-center py-3">Back</a>
                        <button type="button" id="confirmCancel" class="flex-1 btn btn-primary py-3 font-semibold">Proceed to Confirmation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const orderId = '<%= order._id %>';
        const orderItems = <%- JSON.stringify(order.items || []) %>;
        const couponMinCartValue = <%= order.couponMinCartValue || 0 %>;
        const cancelForm = document.getElementById('cancelForm');
        const confirmCancelBtn = document.getElementById('confirmCancel');

        // Handle checkbox toggle for quantity input
        document.querySelectorAll('.product-checkbox').forEach((checkbox, index) => {
            const qtyInput = document.getElementById(`qty${index}`);
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    qtyInput.classList.remove('hidden');
                    if (qtyInput.value < 1) {
                        qtyInput.value = 1;
                    }
                } else {
                    qtyInput.classList.add('hidden');
                    qtyInput.value = 1; // Reset but hidden
                }
            });
        });

        // Handle confirm button click to validate and add hidden fields for selected items
        confirmCancelBtn.onclick = function(e) {
            e.preventDefault(); // Prevent default submit

            const selectedItems = [];
            let hasSelection = false;
            let totalActiveItems = 0;
            let totalCancelQty = 0;
            
            // Calculate totals for validation
            orderItems.forEach((item, idx) => {
                const q = item.activeQty !== undefined ? item.activeQty : item.quantity;
                if(q > 0) totalActiveItems += q;
            });

            document.querySelectorAll('.product-checkbox:checked').forEach(checkbox => {
                const index = parseInt(checkbox.id.replace('item', ''));
                const qtyInput = document.getElementById(`qty${index}`);
                const qty = parseInt(qtyInput.value);
                if (qty >= 1 && qty <= parseInt(qtyInput.max)) {
                    const item = orderItems[index];
                    selectedItems.push({
                        item: {
                            _id: item._id,
                            name: item.name,
                            mlSize: item.mlSize || 0,
                            basePrice: item.basePrice || 0,
                            paidUnitPrice: item.paidUnitPrice, 
                            discountedPrice: item.discountedPrice,
                            couponDiscount: item.couponDiscount,
                            image: item.image
                            // Pass necessary fields; server re-validates item existence
                        },
                        cancelQty: qty
                    });
                    hasSelection = true;
                    totalCancelQty += qty;
                }
            });

            if (!hasSelection) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Selection',
                    text: 'Please select at least one item and specify a valid quantity (1 to available) to cancel.',
                    background: '#2a2a2a',
                    color: '#ffffff',
                    confirmButtonColor: '#d4af37'
                });
                return;
            }

            // --- Coupon Minimum Cart Validation ---
            if (couponMinCartValue > 0) {
                const isFullCancel = totalCancelQty >= totalActiveItems;
                if (!isFullCancel) {
                    let remainingSubtotal = 0;
                    
                    orderItems.forEach((item, index) => {
                       const currentQty = item.activeQty !== undefined ? item.activeQty : item.quantity;
                       if (currentQty <= 0) return; // Skip already dead items
                       
                       // Find if this item is being cancelled
                       // Need to match ID exactly. orderItems is source of truth indices.
                       const selected = selectedItems.find(si => si.item._id === item._id);
                       const cancelQ = selected ? selected.cancelQty : 0;
                       
                       const newQty = Math.max(0, currentQty - cancelQ);
                       
                       // Determine price to use (must match backend logic)
                       // Backend uses: paidUnitPrice if exists, else (discountedPrice - couponDiscount)
                       let effectivePrice = 0;
                       if (item.paidUnitPrice !== undefined) {
                           effectivePrice = item.paidUnitPrice;
                       } else {
                           const price = item.discountedPrice || 0;
                           const coupon = item.couponDiscount || 0;
                           effectivePrice = Math.max(0, price - coupon);
                       }
                       
                       remainingSubtotal += effectivePrice * newQty;
                    });
                    
                    // console.log("Projected Remaining Subtotal:", remainingSubtotal, "Min:", couponMinCartValue);

                    if (remainingSubtotal < couponMinCartValue) {
                         Swal.fire({
                            icon: 'warning',
                            title: 'Coupon Violation Warning',
                            html: `Cancelling these items would reduce your order below the coupon's minimum value of <b>₹${couponMinCartValue}</b>.<br><br>
                                   You can either:<br>
                                   1. Keep the items (Cancel request aborted)<br>
                                   2. Cancel the <b>ENTIRE</b> order`,
                            showCancelButton: true,
                            showDenyButton: true,
                            confirmButtonText: 'Abort (Keep Items)',
                            denyButtonText: 'Cancel Entire Order',
                            cancelButtonText: 'Close',
                            background: '#2a2a2a', color: '#ffffff', confirmButtonColor: '#10b981', denyButtonColor: '#d33'
                        }).then((result) => {
                            if (result.isDenied) {
                                // Cancel Entire Order Logic - Select all and submit
                                const allItems = [];
                                orderItems.forEach(item => {
                                    const q = item.activeQty !== undefined ? item.activeQty : item.quantity;
                                    if (q > 0) {
                                        allItems.push({
                                            item: { _id: item._id, mlSize: item.mlSize }, // minimal needed for backend lookup 
                                            cancelQty: q
                                        });
                                    }
                                });
                                
                                submitCancellation(allItems);
                            } else if (result.isConfirmed) {
                                // 'Abort (Keep Items)' clicked
                                window.location.href = `/order/${orderId}`;
                            }
                        });
                        return; // Blocking partial cancel submit
                    }
                }
            }
            // --------------------------------------

            submitCancellation(selectedItems);
        };

        function submitCancellation(items) {
             // Create hidden input for cancelledItems JSON
            let hiddenInput = document.querySelector('input[name="cancelledItems"]');
            if (!hiddenInput) {
                hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'cancelledItems';
                cancelForm.appendChild(hiddenInput);
            }
            hiddenInput.value = JSON.stringify(items);

            // Submit the form to proceed to the cancel confirmation page
            cancelForm.submit();
        }

        // Auto-select all items if query param exists (for full order cancel flow)
        if (new URLSearchParams(window.location.search).get('selectAll') === 'true') {
            document.querySelectorAll('.product-checkbox').forEach((checkbox, index) => {
                if (!checkbox.checked) {
                    checkbox.click(); // Trigger change event logic naturally
                    
                    // Ensure max quantity is selected
                    const qtyInput = document.getElementById(`qty${index}`);
                    if (qtyInput) {
                        qtyInput.value = qtyInput.max;
                    }
                }
            });
        }
    </script>
    <%- include("../../../partials/user/footer") %>
</body>
</html>