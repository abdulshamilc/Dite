<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Address - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
  <link rel="stylesheet" href="/style/user/profile/address/address.css">
</head>
<body>
  <%- include("../../../partials/user/header") %>
  <div class="container">
    <h1 class="page-title">ADDRESS</h1>
    <section class="layout" aria-label="Address layout">
      <%- include("../../../partials/user/profileSideBar") %>
      <main class="card view-mode" aria-labelledby="address-details-title">
        <div class="view-mode">
          <button class="add-btn" onclick="toggleEditMode('add')">Add New Address</button>
         
          <% if (address && address.length > 0) { %>
            <% address.forEach((addr) => { %>
              <div class="address-card <%= addr.isDefault ? 'default' : '' %>">
                <h3><%= addr.hoNo || 'Address' %></h3>
                <div class="row"><label>Full Name:</label><span class="field-text"><%= addr.fullName || '' %></span></div>
                <div class="row"><label>Street:</label><span class="field-text"><%= addr.street || '' %></span></div>
                <div class="row"><label>Zip Code:</label><span class="field-text"><%= addr.pin || '' %></span></div>
                <div class="row"><label>City:</label><span class="field-text"><%= addr.city || '' %></span></div>
                <div class="row"><label>State:</label><span class="field-text"><%= addr.state || '' %></span></div>
                <div class="row"><label>Country:</label><span class="field-text"><%= addr.country || '' %></span></div>
                <div class="row"><label>Phone:</label><span class="field-text"><%= addr.phone || '' %></span></div>
                <div class="row"><label>Alt Phone:</label><span class="field-text"><%= addr.altPhone || '' %></span></div>
                <div class="row">
                  <label></label>
                  <div>
                    <button class="edit-btn" onclick="toggleEditMode('edit', '<%= addr._id %>')">Edit</button>
                    <% if (!addr.isDefault) { %>
                      <button class="set-default-btn" onclick="setDefaultAddress('<%= addr._id %>')">Set as Default</button>
                      <button class="delete-btn" onclick="showDeleteModal('<%= addr._id %>')">Delete</button>
                    <% } else { %>
                      <span style="font-size: 14px; color: var(--accent); margin-left: 10px;">Default</span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p>No addresses found.</p>
          <% } %>
        </div>
        <form class="form" id="address-form" method="post" onsubmit="return validateForm()">
          <input type="hidden" name="addressId" id="addressId" value="">
          <div class="row">
            <label class="required">Full Name:</label>
            <div class="input-wrapper">
              <input class="field" name="fullName" type="text" placeholder="Enter Full Name" />
              <span class="error" id="error-fullName"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">House No:</label>
            <div class="input-wrapper">
              <input class="field" name="hoNo" type="text" placeholder="Enter House Number or Name" />
              <span class="error" id="error-hoNo"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">Street:</label>
            <div class="input-wrapper">
              <input class="field" name="street" type="text" placeholder="Enter street address" />
              <span class="error" id="error-street"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">Zip Code:</label>
            <div class="input-wrapper">
              <input class="field" name="pin" id="pin" type="text" placeholder="Enter zip code" />
              <div class="loading-spinner" id="pin-spinner"></div>
              <span class="error" id="error-pin"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">City:</label>
            <div class="input-wrapper">
              <input class="field" name="city" id="city" type="text" placeholder="Auto-filled from pincode" readonly />
              <span class="error" id="error-city"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">State:</label>
            <div class="input-wrapper">
              <input class="field" name="state" id="state" type="text" placeholder="Auto-filled from pincode" readonly />
              <span class="error" id="error-state"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">Country:</label>
            <div class="input-wrapper">
              <input class="field" name="country" id="country" type="text" placeholder="Auto-filled from pincode" readonly />
              <span class="error" id="error-country"></span>
            </div>
          </div>
          <div class="row">
            <label class="required">Phone:</label>
            <div class="input-wrapper">
              <input class="field" name="phone" type="text" placeholder="Enter Phone" />
              <span class="error" id="error-phone"></span>
            </div>
          </div>
          <div class="row"><label>Alt Phone:</label><input class="field" name="altPhone" type="text" placeholder="Enter Alt Phone" /></div>
          <div class="row"><label>Default:</label><input type="checkbox" name="isDefault" value="true" /><span style="font-size: 14px; margin-left: 10px;">Set as default address</span></div>
          <div class="row form-buttons">
            <label></label>
            <div class="form-buttons">
              <button type="button" class="edit-btn" onclick="toggleEditMode()">Cancel</button>
              <button type="submit" class="edit-btn">Save</button>
            </div>
          </div>
        </form>
        <div class="modal" id="delete-modal">
          <div class="modal-content">
            <p>Are you sure you want to delete this address?</p>
            <div class="modal-buttons">
              <button class="modal-btn cancel" onclick="hideDeleteModal()">Cancel</button>
              <button class="modal-btn confirm" onclick="confirmDelete()">Confirm</button>
            </div>
          </div>
        </div>
      </main>
    </section>
  </div>
  <!-- Message Container -->
  <div class="message-container" id="messageContainer"></div>
  <script>
    const phoneRegex = /^(?!.*(\d)\1{5,})(?!0+$)[+]?[0-9]{6,15}$/;

    document.getElementById('pin').addEventListener('keyup', async function () {
      const pin = this.value.trim();
      const spinner = document.getElementById('pin-spinner');
  
      if (pin.length === 6 && /^\d{6}$/.test(pin)) {
        spinner.style.display = 'block';
        try {
          const response = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
          const data = await response.json();
         
          if (data[0].Status === "Success") {
            const postOffice = data[0].PostOffice[0];
            document.getElementById('city').value = postOffice.District || '';
            document.getElementById('state').value = postOffice.State || '';
            document.getElementById('country').value = postOffice.Country || 'India';
            showMessage("Location auto-filled from pincode", "success");
          } else {
            showMessage("Invalid Pincode!", "error");
            document.getElementById('city').value = '';
            document.getElementById('state').value = '';
            document.getElementById('country').value = '';
          }
        } catch (error) {
          showMessage("Unable to fetch location!", "error");
          document.getElementById('city').value = '';
          document.getElementById('state').value = '';
          document.getElementById('country').value = '';
        } finally {
          spinner.style.display = 'none';
        }
      }
    });
    let deleteAddressId = '';
    // Display server-side success/error messages on page load from session
    <% if (typeof messages !== 'undefined') { %>
      <% if (messages.success) { %>
        showMessage('<%= messages.success %>', 'success');
      <% } %>
      <% if (messages.error) { %>
        showMessage('<%= messages.error %>', 'error');
      <% } %>
    <% } %>
    function showMessage(message, type = 'success') {
      const container = document.getElementById('messageContainer');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${type}`;
      msgDiv.textContent = message;
      container.appendChild(msgDiv);
      // Auto remove after 5 seconds (fade away)
      setTimeout(() => {
        msgDiv.remove();
      }, 5000);
    }
    function clearErrors() {
      const errorEls = document.querySelectorAll('.error');
      errorEls.forEach(el => {
        el.textContent = '';
        el.style.display = 'none';
      });
    }
    function validateForm() {
      clearErrors();
      const requiredFields = ['fullName', 'hoNo', 'street', 'city', 'pin', 'country', 'phone', 'state'];
      let hasError = false;
      requiredFields.forEach(key => {
        const input = document.querySelector(`[name="${key}"]`);
        const value = input ? input.value.trim() : '';
        const errorEl = document.getElementById(`error-${key}`);
        if (!value) {
          hasError = true;
          errorEl.textContent = 'This field is required';
          errorEl.style.display = 'block';
        } else if (key === 'phone' && !phoneRegex.test(value)) {
          hasError = true;
          errorEl.textContent = 'Enter Valid Phone Number';
          errorEl.style.display = 'block';
        }
      });
      return !hasError;
    }
    function toggleEditMode(mode = 'edit', addressId = '') {
      const card = document.querySelector('.card');
      const form = document.getElementById('address-form');
      const addressIdInput = document.getElementById('addressId');
      if (card.classList.contains('view-mode')) {
        card.classList.remove('view-mode');
        card.classList.add('edit-mode');
        clearErrors();
        if (mode === 'add') {
          form.reset();
          addressIdInput.value = '';
          form.action = '/add-address';
        } else if (addressId) {
          const addr = <%- JSON.stringify(address || []) %>.find(a => a._id === addressId);
          if (addr) {
            form.querySelector('[name="fullName"]').value = addr.fullName || '';
            form.querySelector('[name="hoNo"]').value = addr.hoNo || '';
            form.querySelector('[name="street"]').value = addr.street || '';
            form.querySelector('[name="city"]').value = addr.city || '';
            form.querySelector('[name="state"]').value = addr.state || '';
            form.querySelector('[name="pin"]').value = addr.pin || '';
            form.querySelector('[name="country"]').value = addr.country || '';
            form.querySelector('[name="phone"]').value = addr.phone || '';
            form.querySelector('[name="altPhone"]').value = addr.altPhone || '';
            form.querySelector('[name="isDefault"]').checked = addr.isDefault || false;
            addressIdInput.value = addr._id;
            form.action = '/edit-address/' + addr._id;
          }
        }
      } else {
        card.classList.remove('edit-mode');
        card.classList.add('view-mode');
        form.reset();
        addressIdInput.value = '';
        clearErrors();
      }
    }
    function setDefaultAddress(addressId) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/address/set-default';
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'addressId';
      input.value = addressId;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
    function showDeleteModal(addressId) {
      deleteAddressId = addressId;
      document.getElementById('delete-modal').style.display = 'flex';
    }
    function hideDeleteModal() {
      document.getElementById('delete-modal').style.display = 'none';
      deleteAddressId = '';
    }
    function confirmDelete() {
      if (deleteAddressId) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/delete-address/' + deleteAddressId;
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'addressId';
        input.value = deleteAddressId;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      }
      hideDeleteModal();
    }
  </script>
  <%- include("../../../partials/user/footer") %>
</body>
</html>