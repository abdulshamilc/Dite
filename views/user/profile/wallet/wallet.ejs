<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wallet - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/profile/wallet/wallet.css">
</head>
<body>
  <%- include("../../../partials/user/header") %>
  <div class="container">
    <h1 class="page-title">WALLET</h1>
    <section class="layout" aria-label="Wallet layout">
      <%- include("../../../partials/user/profileSideBar") %>
      <main class="card" aria-labelledby="wallet-details-title">
        <div class="balance-section">
          <h2 class="balance-label">Available Balance</h2>
          <p class="balance-amount">
            ₹<%= wallet.balance.toFixed(2) %><span class="balance-currency">INR</span>
          </p>
          <button class="balance-add-btn primary" onclick="openAddMoneyModal()">Add Funds</button>
        </div>
        <div class="action-buttons">
          <button class="action-btn" onclick="showMessage('Withdraw feature coming soon!', 'info')">Withdraw</button>
          <button class="action-btn" onclick="showMessage('Transfer feature coming soon!', 'info')">Transfer</button>
        </div>
        <div class="quick-actions">
          <div class="quick-action-card" onclick="openAddMoneyModal()">
            <div class="quick-action-icon">💳</div>
            <div class="quick-action-title">Add Funds</div>
            <div class="quick-action-desc">Top up your wallet instantly</div>
          </div>
          <div class="quick-action-card" onclick="viewTransactions()">
            <div class="quick-action-icon">📊</div>
            <div class="quick-action-title">View History</div>
            <div class="quick-action-desc">See all your transactions</div>
          </div>
          <div class="quick-action-card" onclick="showMessage('Rewards feature coming soon!', 'info')">
            <div class="quick-action-icon">⭐</div>
            <div class="quick-action-title">Rewards</div>
            <div class="quick-action-desc">Earn and redeem points</div>
          </div>
        </div>
        <div class="transaction-history">
          <div class="transaction-header">
            <span>Recent Transactions</span>
            <a href="#" onclick="viewAllTransactions()">View All</a>
          </div>
          <div class="transactions-list" id="transactionsList">
            <% if (wallet.transactions && wallet.transactions.length > 0) { %>
              <% wallet.transactions.slice(0, 5).forEach(function(transaction) { %>
                <div class="transaction-item">
                  <div class="transaction-desc">
                    <div><%= transaction.description %></div>
                    <div class="transaction-date"><%= new Date(transaction.date).toLocaleDateString() %></div>
                  </div>
                  <div class="transaction-amount <%= (transaction.type === 'debit' || transaction.amount < 0) ? 'negative' : 'positive' %>">
                    <%= (transaction.type === 'debit' || transaction.amount < 0) ? '-' : '+' %>₹<%= Math.abs(transaction.amount).toFixed(2) %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="transaction-item" style="justify-content: center; color: #666;">
                No transactions yet. Add money to get started!
              </div>
            <% } %>
          </div>
        </div>
      </main>
    </section>
  </div>
  <!-- Add Money Modal -->
  <div id="addMoneyModal" class="add-money-modal">
    <div class="add-money-content">
      <span class="close-modal" onclick="closeAddMoneyModal()">&times;</span>
      <h2 class="modal-title">Add Funds</h2>
      <p style="text-align: center; color: #666; margin-bottom: 20px;">Enter amount to add (min ₹100)</p>
      <form id="addMoneyForm" onsubmit="handleAddMoney(event)">
        <input type="number" class="amount-field" id="addAmount" name="amount" placeholder="100.00" step="0.01" value="100" required />
        <div class="modal-buttons">
          <button type="button" class="modal-btn" onclick="closeAddMoneyModal()">Cancel</button>
          <button type="submit" class="modal-btn primary" id="addMoneyBtn">Add ₹<span id="amountDisplay">100</span></button>
        </div>
      </form>
    </div>
  </div>
  <!-- Payment Status Overlay -->
  <div class="payment-overlay" id="paymentOverlay">
    <div id="paymentMessage">Processing payment...</div>
  </div>
  <!-- Message Container -->
  <div class="message-container" id="messageContainer"></div>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    // Pass data from EJS to JS
    const userEmail = '<%= user ? user.email : "" %>';
    let razorpayInstance = null;

    // Assume wallet data is passed from server: window.walletData = <%= JSON.stringify(wallet) %>;
    // For demo, we'll use the EJS variables, but extend for dynamic updates if needed.
    function showMessage(message, type = 'success') {
      const container = document.getElementById('messageContainer');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${type}`;
      msgDiv.textContent = message;
      container.appendChild(msgDiv);
      setTimeout(() => msgDiv.remove(), 5000);
    }
    function openAddMoneyModal() {
      document.getElementById('addMoneyModal').style.display = 'block';
      document.getElementById('addAmount').focus();
      updateAmountDisplay();
    }
    function closeAddMoneyModal() {
      document.getElementById('addMoneyModal').style.display = 'none';
      document.getElementById('addMoneyForm').reset();
      updateAmountDisplay();
      const addBtn = document.getElementById('addMoneyBtn');
      addBtn.disabled = false;
      addBtn.innerHTML = 'Add ₹<span id="amountDisplay">100</span>';
      hidePaymentStatus();
    }
    function updateAmountDisplay() {
      const amount = document.getElementById('addAmount').value || 100;
      const display = document.getElementById('amountDisplay');
      if (display) {
          display.textContent = amount;
      }
    }
    document.getElementById('addAmount').addEventListener('input', updateAmountDisplay);
    function showPaymentStatus(message, isError = false) {
      const overlay = document.getElementById('paymentOverlay');
      const msgEl = document.getElementById('paymentMessage');
      msgEl.textContent = message;
      if (isError) {
        msgEl.style.color = '#ff6b6b';
      } else {
        msgEl.style.color = '#4ade80';
      }
      overlay.classList.add('show');
    }
    function hidePaymentStatus() {
      document.getElementById('paymentOverlay').classList.remove('show');
    }
    function handleAddMoney(event) {
      event.preventDefault();
      const amount = parseFloat(document.getElementById('addAmount').value);
      if (isNaN(amount) || amount < 100) {
        showMessage('Minimum amount is ₹100.', 'error');
        document.getElementById('addAmount').focus();
        return;
      }
      const addBtn = document.getElementById('addMoneyBtn');
      addBtn.disabled = true;
      addBtn.innerHTML = 'Initiating Payment...';
      showPaymentStatus('Initiating Razorpay...');
      initiateRazorpay(amount);
    }
    async function initiateRazorpay(amount) {
      if (!amount || amount < 100) {
        const errorMsg = 'Invalid amount. Minimum is ₹100.';
        showPaymentStatus(errorMsg, true);
        showMessage(errorMsg, 'error');
        resetAddButton();
        return;
      }
      try {
        const response = await fetch('/createOrder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await response.json();
        if (data.success && data.order) {
          showPaymentStatus('Opening payment modal...');
          openRazorpayCheckout(data.order, amount);
        } else {
          throw new Error(data.message || 'Failed to create order');
        }
      } catch (error) {
        console.error('Error creating order:', error);
        const errorMsg = error.message || 'Failed to initiate payment. Please try again.';
        showPaymentStatus(errorMsg, true);
        showMessage(errorMsg, 'error');
        resetAddButton();
      }
    }
    function openRazorpayCheckout(order, amount) {
      const options = {
        key: '<%= process.env.RAZORPAY_KEY_ID || "rzp_test_your_key" %>',
        amount: order.amount,
        currency: order.currency || 'INR',
        name: 'Dité Wallet',
        description: `Add ₹${amount.toFixed(2)} to Wallet`,
        order_id: order.id,
        handler: function(response) {
          verifyRazorpayPayment(response, amount);
        },
        prefill: {
          name: '<%= user ? user.name || "" : "" %>',
          email: userEmail,
          contact: ''
        },
        theme: {
          color: '#d3a35b'
        },
        modal: {
          ondismiss: function() {
            const errorMsg = 'Payment was cancelled.';
            showPaymentStatus(errorMsg, true);
            showMessage(errorMsg, 'error');
            resetAddButton();
          }
        }
      };
      try {
        razorpayInstance = new Razorpay(options);
        razorpayInstance.open();
      } catch (err) {
        console.error('Razorpay init error:', err);
        const errorMsg = 'Payment modal failed to load. Please refresh and try again.';
        showPaymentStatus(errorMsg, true);
        showMessage(errorMsg, 'error');
        resetAddButton();
      }
    }
    async function verifyRazorpayPayment(response, amount) {
      showPaymentStatus('Verifying payment...');
      try {
        const res = await fetch('/verifyPayment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature
          })
        });
        const data = await res.json();
        if (data.success) {
          addFundsAfterPayment(amount, response.razorpay_payment_id, response.razorpay_order_id);
        } else {
          throw new Error(data.message || 'Payment verification failed');
        }
      } catch (error) {
        console.error('Verification error:', error);
        const errorMsg = error.message || 'Payment verification failed. Please contact support.';
        showPaymentStatus(errorMsg, true);
        showMessage(errorMsg, 'error');
        resetAddButton();
      }
    }
    async function addFundsAfterPayment(amount, paymentId, orderId) {
      showPaymentStatus('Adding funds to wallet...');
      try {
        const response = await fetch('/wallet/add-funds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount,
            razorpayPaymentId: paymentId,
            razorpayOrderId: orderId
          })
        });
        const data = await response.json();
        if (response.ok && data.success) {
          showPaymentStatus('Funds added successfully! Reloading...');
          document.getElementById('paymentOverlay').classList.add('reloading'); 
          // Reload to reflect changes and show success message from session
          window.location.reload();
        } else {
          throw new Error(data.message || 'Failed to add funds');
        }
      } catch (error) {
        console.error('Add funds error:', error);
        const errorMsg = error.message || 'Failed to add funds after payment. Your payment may be refunded.';
        showPaymentStatus(errorMsg, true);
        showMessage(errorMsg, 'error');
        resetAddButton();
      } finally {
        // Ensure overlay is hidden if it wasn't handled by success/reload
        if (!document.getElementById('paymentOverlay').classList.contains('reloading')) {
             setTimeout(hidePaymentStatus, 2000);
        }
      }
    }
    function resetAddButton() {
      const addBtn = document.getElementById('addMoneyBtn');
      const amount = document.getElementById('addAmount').value || 100;
      addBtn.disabled = false;
      addBtn.innerHTML = `Add ₹<span id="amountDisplay">${amount}</span>`;
      hidePaymentStatus();
    }
    function addTransactionToList(description, amount, date) {
      const list = document.getElementById('transactionsList');
      const item = document.createElement('div');
      item.className = 'transaction-item';
      item.innerHTML = `
        <div class="transaction-desc">
          <div>${description}</div>
          <div class="transaction-date">${new Date(date).toLocaleDateString()}</div>
        </div>
        <div class="transaction-amount ${amount > 0 ? 'positive' : 'negative'}">
          ${amount > 0 ? '+' : ''}₹${Math.abs(amount).toFixed(2)}
        </div>
      `;
      list.insertBefore(item, list.firstChild);
      // Remove oldest if more than 5
      while (list.children.length > 6) {
        list.removeChild(list.lastChild);
      }
    }
    function viewTransactions() {
      window.location.href = '/wallet/history';
    }
    function viewAllTransactions() {
      window.location.href = '/wallet/history';
    }
    // Close modal on outside click
    window.onclick = function(event) {
      const modal = document.getElementById('addMoneyModal');
      if (event.target === modal) {
        closeAddMoneyModal();
      }
    };
    // Display any server messages
    <% if (typeof success !== 'undefined' && success) { %>
      showMessage('<%= success %>', 'success');
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      showMessage('<%= error %>', 'error');
    <% } %>
  </script>
  <%- include("../../../partials/user/footer") %>
</body>
</html>