<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wallet History - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
  <link rel="stylesheet" href="/style/user/walletHistory.css">
</head>
<body>
  <%- include("../../../partials/user/header") %>
  <div class="container">
    <h1 class="page-title">TRANSACTION HISTORY</h1>
    <section class="layout" aria-label="Wallet layout">
      <%- include("../../../partials/user/profileSideBar") %>
      <main class="card" aria-labelledby="wallet-history-title">
        <div class="header-actions">
           <a href="/wallet" class="back-btn">
             <i class="lucide-arrow-left"></i> Back to Wallet
           </a>
           <div style="font-weight: 600; color: #3a2e22;">
             Balance: ₹<%= wallet.balance.toFixed(2) %>
           </div>
        </div>

        <% if (transactions && transactions.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>Description</th>
                  <th>Date</th>
                  <th>Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% transactions.forEach(function(tx) { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600; margin-bottom: 4px;"><%= tx.description %></div>
                      <div style="font-size: 0.8em; color: #888;">ID: <%= tx._id %></div>
                    </td>
                    <td class="transaction-date">
                       <%= new Date(tx.date).toLocaleString('en-US', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: 'numeric' }) %>
                    </td>
                    <td class="amount <%= (tx.type === 'debit' || tx.amount < 0) ? 'negative' : 'positive' %>">
                      <%= (tx.type === 'debit' || tx.amount < 0) ? '-' : '+' %>₹<%= Math.abs(tx.amount).toFixed(2) %>
                    </td>
                    <td>
                      <span style="display:inline-block; padding: 4px 10px; border-radius: 12px; font-size: 0.8em; background: #e8f5e9; color: #2e7d32; font-weight: 600;">Success</span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="pagination">
              <!-- Previous -->
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>" class="page-link">‹</a>
              <% } else { %>
                <span class="page-link disabled">‹</span>
              <% } %>

              <!-- Pages -->
              <% for(let i = 1; i <= totalPages; i++) { %>
                 <% if (i === currentPage) { %>
                    <span class="page-link active"><%= i %></span>
                 <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                    <a href="?page=<%= i %>" class="page-link"><%= i %></a>
                 <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                    <span class="page-link disabled" style="border:none; background:transparent;">...</span>
                 <% } %>
              <% } %>

              <!-- Next -->
              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>" class="page-link">›</a>
              <% } else { %>
                <span class="page-link disabled">›</span>
              <% } %>
            </div>
          <% } %>

        <% } else { %>
          <div style="text-align: center; padding: 60px 20px; color: #666;">
            <div style="font-size: 3rem; margin-bottom: 20px; color: #ddd;">💸</div>
            <p>No transactions found.</p>
          </div>
        <% } %>
      </main>
    </section>
  </div>
  <%- include("../../../partials/user/footer") %>
</body>
</html>
