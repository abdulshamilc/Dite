<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order History</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <style>
        :root {
            --primary: #080808;
            --secondary: #ffffff;
            --accent: #d4af37;
            --border: #333333;
        }
        
        body {
            background-color: var(--primary);
            color: var(--secondary);
        }
        
        .accent-text { color: var(--accent); }
        .accent-border { border-color: var(--accent); }
        .order-card {
            background-color: #262626;
            border: 1px solid var(--border);
            transition: all 0.3s ease;
        }
        .order-card:hover {
            border-color: var(--accent);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.1);
        }
        .status-pending { background-color: rgba(212, 175, 55, 0.1); color: var(--accent); }
        .status-shipped { background-color: rgba(100, 200, 100, 0.1); color: #64c864; }
        .status-delivered { background-color: rgba(100, 200, 100, 0.1); color: #64c864; }
        .status-canceled { background-color: rgba(255, 100, 100, 0.1); color: #ff6464; }
        .status-returned { background-color: rgba(255, 100, 100, 0.1); color: #ff6464; }
        .pagination-btn { @apply px-3 py-2 rounded-md font-medium transition-colors; }
        .pagination-btn:hover:not(.disabled) { @apply bg-gray-700 text-accent; }
        .pagination-btn.active { @apply bg-accent text-primary font-semibold; }
        .pagination-btn.disabled { @apply text-gray-500 cursor-not-allowed; }

        /* Style for clickable order link */
        .order-link {
            @apply block no-underline text-current;
        }
        .order-link:hover {
            @apply no-underline text-current;
        }
    </style>
    
</head>
<body>
    <%- include("../../partials/user/header") %>
    <div class="min-h-screen pt-20 p-8 flex flex-col items-center justify-center"> <!-- Added flex flex-col items-center justify-center for vertical/horizontal centering -->
        <!-- Page Header - Centered -->
        <div class="max-w-6xl mx-auto mb-12 text-center"> <!-- Added text-center -->
            <h1 class="text-4xl font-bold mb-2">Your Orders</h1>
            <p class="text-gray-400">Track and manage your orders</p>
            <div class="h-1 w-20 accent-border border-t-2 mt-4 mx-auto"></div> <!-- Added mx-auto for underline centering -->
        </div>

        <!-- Search and Sort - Centered -->
        <div class="max-w-6xl mx-auto mb-8 w-full flex flex-col md:flex-row gap-4 items-center justify-between bg-[#262626] p-4 rounded-lg border border-gray-700">
            <div class="w-full md:w-1/2 relative">
                <input type="text" id="orderSearch" value="<%= locals.search || '' %>" placeholder="Search by Order ID..." 
                    class="w-full bg-[#1a1a1a] border border-gray-600 text-white px-4 py-2 rounded-md focus:outline-none focus:border-accent transition-colors"
                >
                <button class="absolute right-3 top-2.5 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>
            </div>
            <div class="flex items-center gap-2 w-full md:w-auto">
                <label class="text-gray-400 text-sm whitespace-nowrap">Sort By:</label>
                <select id="orderSort" class="bg-[#1a1a1a] border border-gray-600 text-white px-4 py-2 rounded-md focus:outline-none focus:border-accent transition-colors w-full md:w-auto">
                    <option value="date_desc" <%= locals.sort === 'date_desc' ? 'selected' : '' %>>Newest First</option>
                    <option value="date_asc" <%= locals.sort === 'date_asc' ? 'selected' : '' %>>Oldest First</option>
                    <option value="amount_desc" <%= locals.sort === 'amount_desc' ? 'selected' : '' %>>Amount: High to Low</option>
                    <option value="amount_asc" <%= locals.sort === 'amount_asc' ? 'selected' : '' %>>Amount: Low to High</option>
                </select>
            </div>
        </div>

        <!-- Orders Container -->
        <div class="max-w-6xl mx-auto space-y-4 mb-8 w-full">
            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(function(order) { %>
                <!-- Transform inline: Format ID, status, date, etc. -->
                <% 
                    // Format ID
                    const formattedId = order.orderID ? `#${order.orderID}` : `#ORD-${order._id.toString().slice(-8).toUpperCase()}`;
                    
                    // Map status (using consistent orderStatus property)
                    let statusText = order.orderStatus || 'Processing';
                    let statusClass = 'pending';
                    if (order.orderStatus === 'Shipped' || order.orderStatus === 'shipped') {
                        statusText = 'Shipped';
                        statusClass = 'shipped';
                    } else if (order.orderStatus === 'Delivered' || order.orderStatus === 'delivered') {
                        statusText = 'Delivered';
                        statusClass = 'delivered';
                    } else if (order.orderStatus === 'Canceled' || order.orderStatus === 'cancelled' || order.orderStatus === 'cancelled') {
                        statusText = 'Canceled';
                        statusClass = 'canceled';
                    } else if (order.orderStatus === 'Returned' || order.orderStatus === 'returned') {
                        statusText = 'Returned';
                        statusClass = 'returned';
                    }
                    
                    // Date logic: Always calculate estimated delivery as 7 days from placedAt (no hardcoded today)
                    let dateLabel = 'Estimated Delivery';
                    let dateValue;
                    if (statusText === 'Delivered' && order.deliveredAt) {
                        dateLabel = 'Delivered On';
                        dateValue = new Date(order.deliveredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    } else if (statusText === 'Canceled' && order.updatedAt) {
                        dateLabel = 'Canceled On';
                        dateValue = new Date(order.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    } else if (statusText === 'Returned' && order.updatedAt) {
                        dateLabel = 'Returned On';
                        dateValue = new Date(order.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    } else {
                        const placedDate = new Date(order.placedAt);
                        const estimatedDate = new Date(placedDate);
                        estimatedDate.setDate(estimatedDate.getDate() + 7);  // Exactly +7 days from placedAt
                        dateValue = estimatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    }
                    
                    // Other formats
                    const totalFormatted = `${parseFloat(order.totalAmount || 0).toFixed(2)} RS`;
                    const itemsCount = order.items ? order.items.length : 0;
                    const tracking = order.tracking ? order.tracking[order.tracking.length - 1]?.status || 'Pending' : 'Pending';  // Use latest tracking status if available
                %>
                <!-- Order Card - Wrapped in Link -->
                <a href="/order/<%= order._id %>" class="order-link">
                    <div class="order-card rounded-lg p-6">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                            <div>
                                <p class="text-gray-400 text-sm mb-1">Order ID</p>
                                <p class="text-xl font-semibold accent-text"><%= formattedId %></p>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm mb-1">Status</p>
                                <span class="status-<%= statusClass %> px-3 py-1 rounded-full text-sm font-medium inline-block"><%= statusText %></span>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm mb-1">
                                    <% if (statusText === 'Delivered') { %>
                                        Delivered On
                                    <% } else if (statusText === 'Canceled') { %>
                                        Canceled On
                                    <% } else if (statusText === 'Returned') { %>
                                        Returned On
                                    <% } else { %>
                                        Estimated Delivery
                                    <% } %>
                                </p>
                                <p class="text-lg font-semibold"><%= dateValue %></p>
                            </div>
                            <div>
                                <p class="text-gray-400 text-sm mb-1">Total Amount</p>
                                <p class="text-lg font-semibold accent-text"><%= totalFormatted %></p>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-700">
                            <p class="text-sm text-gray-400">Items: <%= itemsCount %> | Tracking: <%= tracking %></p>
                        </div>
                    </div>
                </a>
                <% }); %>
            <% } else { %>
                <div class="text-center py-12">
                    <p class="text-gray-400 text-lg">No orders found.</p>
                </div>
            <% } %>
        </div>

        <!-- Pagination with Search/Sort Persistence -->
        <% if (totalPages > 1) { %>
        <div class="max-w-6xl mx-auto flex justify-center items-center space-x-2">
            <!-- Previous Button -->
            <a href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>&search=<%= locals.search %>&sort=<%= locals.sort %>" 
               class="pagination-btn <%= currentPage === 1 ? 'disabled' : '' %>">
                Previous
            </a>

            <!-- Numbered Pages -->
            <% 
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);

            // Adjust window if near start
            if (currentPage <= 3) {
                endPage = Math.min(5, totalPages);
            }
            // Adjust window if near end
            if (currentPage >= totalPages - 2) {
                startPage = Math.max(1, totalPages - 4);
            }

            // Show first page if not in range
            if (startPage > 1) { %>
                <a href="?page=1&search=<%= locals.search %>&sort=<%= locals.sort %>" class="pagination-btn">1</a>
                <% if (startPage > 2) { %>
                    <span class="text-gray-500 px-2">...</span>
                <% } %>
            <% } %>

            <% for(let p = startPage; p <= endPage; p++) { %>
                <a href="?page=<%= p %>&search=<%= locals.search %>&sort=<%= locals.sort %>" 
                   class="pagination-btn <%= currentPage === p ? 'active' : '' %>">
                    <%= p %>
                </a>
            <% } %>

            <!-- Show last page if not in range -->
            <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %>
                    <span class="text-gray-500 px-2">...</span>
                <% } %>
                <a href="?page=<%= totalPages %>&search=<%= locals.search %>&sort=<%= locals.sort %>" class="pagination-btn"><%= totalPages %></a>
            <% } %>

            <!-- Next Button -->
            <a href="?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>&search=<%= locals.search %>&sort=<%= locals.sort %>" 
               class="pagination-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
                Next
            </a>
        </div>
        <% } %>

        <script>
            let searchTimeout;
            const searchInput = document.getElementById('orderSearch');
            const sortSelect = document.getElementById('orderSort');

            // Handle Search
            searchInput.addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    updateUrl('search', e.target.value);
                }, 500); // 500ms debounce
            });

            // Handle Sort
            sortSelect.addEventListener('change', function(e) {
                updateUrl('sort', e.target.value);
            });

            function updateUrl(key, value) {
                const url = new URL(window.location.href);
                url.searchParams.set(key, value);
                url.searchParams.set('page', 1); // Reset to page 1 on filter change
                window.location.href = url.toString();
            }
        </script>
    </div>
    <%- include("../../partials/user/footer") %>
</body>
</html>