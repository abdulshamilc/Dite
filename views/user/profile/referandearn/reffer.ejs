<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Referrals - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style/user/profile/referandearn/reffer.css"></head>
<body>
  <%- include("../../../partials/user/header") %>
  <div class="container">
    <h1 class="page-title">REFERRALS</h1>
    <section class="layout" aria-label="Referrals layout">
      <%- include("../../../partials/user/profileSideBar") %>
      <main class="card" aria-labelledby="referrals-title">
        <div class="referral-section">
          <div class="referral-code-section">
            <h2 style="color: #fff; margin-bottom: 8px; font-size: 1.8rem; text-transform: uppercase; letter-spacing: 2px;">REFERRAL</h2>
            <h3 style="color: rgba(255,255,255,0.7); margin-bottom: 12px; font-size: 1rem;">CODE</h3>
            <div class="referral-code-display" id="referralCode"><%= user.referralCode || 'Generate one if needed' %></div>
            <div class="share-buttons">
              <button class="share-btn primary" onclick="copyReferralCode()">Copy Code</button>
            </div>
          </div>
          <div class="referral-link-section">
            <h3 style="color: #fff; margin-bottom: 12px;">REFERRAL LINK</h3>
            <div class="referral-link-display" id="referralLink"></div>
            <div class="share-buttons">
              <button class="share-btn primary" onclick="copyReferralLink()">Copy Link</button>
              <button class="share-btn" onclick="shareReferral()">Share</button>
            </div>
          </div>
          <% if (referrer && referrer.name) { %>
          <div class="referred-by-section" style="margin-top: 20px; padding: 12px 16px; background: rgba(255,255,255,0.08); border-radius: 8px; text-align: center;">
            <span style="color: rgba(255,255,255,0.6); font-size: 0.75rem; text-transform: lowercase; letter-spacing: 0.5px;">referred by</span>
            <p style="color: #d3a35b; font-size: 0.85rem; margin-top: 4px; text-transform: lowercase; font-weight: 500;"><%= referrer.name.toLowerCase() %></p>
          </div>
          <% } %>
        </div>
        <div class="stats-section">
          <div class="referral-stats">
            <div class="stat-item">
              <p class="stat-value"><%= referredCount || 0 %></p>
              <p class="stat-label">Friends Referred</p>
            </div>
            <div class="stat-item">
              <p class="stat-value">₹<%= (referredCount || 0) * 100 %></p>
              <p class="stat-label">Total Earned</p>
            </div>
          </div>
        </div>
        <div class="benefits">
          <h3>Why Refer?</h3>
          <ul>
            <li>Earn rewards for every successful referral</li>
            <li>Help friends discover amazing products</li>
            <li>Unlimited referrals – the more, the merrier!</li>
          </ul>
        </div>
        <div class="how-it-works">
          <h3>How It Works</h3>
          <ul>
            <li>Share your unique referral link with friends</li>
            <li>They sign up and make their first purchase</li>
            <li>You earn ₹100 credited to your wallet instantly</li>
          </ul>
        </div>
        <div class="referral-history">
          <div class="history-header">
            <span>Recent Referrals</span>
            <% if (referredUsers && referredUsers.length > 5) { %>
              <a href="#" id="viewAllBtn" onclick="toggleViewAll(event)">View All</a>
            <% } %>
          </div>
          <div class="history-list" id="historyList">
            <% if (referredUsers && referredUsers.length > 0) { %>
              <% referredUsers.forEach(function(refUser, index) { %>
                <div class="history-item <%= index >= 5 ? 'hidden-row' : '' %>" style="<%= index >= 5 ? 'display: none;' : '' %>">
                  <div class="history-name" style="text-align: left; flex: 1; padding-left: 10px;">
                    <%= refUser.name || refUser.email.split('@')[0] %>
                  </div>
                  <div class="history-date" style="text-align: center; flex: 1;">
                    <%= new Date(refUser.referredDate || refUser.createdAt).toLocaleDateString() %>
                  </div>
                  <div class="history-reward" style="text-align: right; flex: 1; padding-right: 20px;">
                    +₹100
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="history-item" style="justify-content: center; color: #666;">
                No referrals yet. Start sharing!
              </div>
            <% } %>
          </div>
        </div>
      </main>
    </section>
  </div>
  <!-- Message Container -->
  <div class="message-container" id="messageContainer"></div>
  <script>
    // Safe data initialization
    const userReferralCode = <%- JSON.stringify(user?.referralCode || "") %>;
    const baseUrl = window.location.origin;
    const referralLink = userReferralCode ? `${baseUrl}/signup?ref=${userReferralCode}` : baseUrl;
    const referredCount = <%= (typeof referredCount !== 'undefined') ? referredCount : 0 %>;

    // Initialize display
    document.addEventListener('DOMContentLoaded', function() {
      const linkEl = document.getElementById('referralLink');
      if (linkEl) linkEl.textContent = referralLink;
    });

    // Toast Message Helper
    function showMessage(message, type = 'success') {
      const container = document.getElementById('messageContainer');
      if (!container) {
          Swal.fire({
             text: message,
             icon: type === 'success' ? 'success' : 'error',
             background: '#fff',
             color: '#000',
             confirmButtonColor: '#d3a35b'
          });
          return;
      }
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${type}`;
      msgDiv.textContent = message;
      container.appendChild(msgDiv);
      setTimeout(() => msgDiv.remove(), 5000);
    }

    // Copy to Clipboard Logic
    window.copyTextToClipboard = function(text, itemDescription) {
      if (!text) {
        showMessage('Nothing to copy.', 'error');
        return;
      }

      // Try modern Async API first
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text)
          .then(() => showMessage(`${itemDescription} copied!`, 'success'))
          .catch((err) => {
             console.error('Async copy failed:', err);
             // Fallback to sync method
             window.fallbackCopyText(text, itemDescription);
          });
      } else {
        // Fallback for HTTP / older browsers
        window.fallbackCopyText(text, itemDescription);
      }
    };

    // Fallback Copy Logic (execCommand)
    window.fallbackCopyText = function(text, itemDescription) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      
      // Ensure element is part of DOM but invisible
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      textArea.style.top = "0";
      textArea.setAttribute('readonly', '');
      
      document.body.appendChild(textArea);
      
      textArea.focus();
      textArea.select();
      textArea.setSelectionRange(0, 99999); // For mobile

      try {
        const successful = document.execCommand('copy');
        if (successful) {
          showMessage(`${itemDescription} copied!`, 'success');
        } else {
          throw new Error('execCommand returned false');
        }
      } catch (err) {
        console.error('Fallback copy failed:', err);
        showMessage(`Failed to copy ${itemDescription}. Please copy manually.`, 'error');
        Swal.fire({
            title: `Copy this ${itemDescription}`,
            input: 'text',
            inputValue: text,
            background: '#fff',
            confirmButtonColor: '#d3a35b'
        });
      }

      document.body.removeChild(textArea);
    };

    // Button Handlers
    window.copyReferralCode = function() {
      window.copyTextToClipboard(userReferralCode, 'Referral Code');
    };

    window.copyReferralLink = function() {
      window.copyTextToClipboard(referralLink, 'Referral Link');
    };

    window.shareReferral = function() {
      if (!referralLink) {
        showMessage('Link not available', 'error');
        return;
      }
      
      const shareData = {
        title: 'Join Dité',
        text: 'Sign up with my link and get started with amazing products!',
        url: referralLink
      };

      if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
        navigator.share(shareData)
          .catch((err) => {
             console.log('Share dismissed or failed:', err);
          });
      } else {
        // Fallback to copy if share is not supported
        window.copyReferralLink();
      }
    };

    window.toggleViewAll = function(event) {
      event.preventDefault();
      const hiddenRows = document.querySelectorAll('.history-item.hidden-row');
      const btn = document.getElementById('viewAllBtn');
      
      let isHidden = false;
      hiddenRows.forEach(row => {
        if (row.style.display === 'none') {
           row.style.display = 'flex';
           isHidden = true;
        } else {
           row.style.display = 'none';
        }
      });

      if (btn) {
        btn.textContent = isHidden ? "Show Less" : "View All";
      }
    };

    // Server-side Messages
    <% if (typeof success !== 'undefined' && success) { %>
      showMessage('<%= success %>', 'success');
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      showMessage('<%= error %>', 'error');
    <% } %>
  </script>
  <%- include("../../../partials/user/footer") %>
</body>
</html>