<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
    <link rel="stylesheet" href="/style/user/profile/profile/profile.css">
</head>
<body>
  <%- include("../../../partials/user/header") %>
  <div class="container">
    <h1 class="page-title">PROFILE</h1>

    <section class="layout" aria-label="Profile layout">
      <%- include("../../../partials/user/profileSideBar") %>

      <main class="card view-mode" aria-labelledby="profile-details-title">
        <button class="edit-btn" onclick="toggleEditMode()">Edit</button>
        
        

        <div class="avatar-container">
          <img src="<%= user.image  %>" alt="Profile Picture" class="avatar-lg" id="avatarLg">
          <button type="button" class="image-overlay" onclick="document.getElementById('imageUploadForm').click()" title="Change Photo">📷</button>
        </div>

        <div class="view-mode">
          <div class="row">
            <label>Name:</label>
            <span class="field-text"><%= user.name || '' %></span>
          </div>

          <div class="row">
            <label>Gender:</label>
            <span class="field-text"><%= user.gender || '' %></span>
          </div>

          <div class="divider"></div>

          <div class="row">
            <label for="email">Email:</label>
            <span class="field-text"><%= user.email %></span>
          </div>

          <div class="row">
            <label for="phone">Phone:</label>
            <span class="field-text"><%= user.phone || '' %></span>
          </div>
        </div>

        <form class="form" action="/profile" method="post" onsubmit="return handleSubmit(event)" enctype="multipart/form-data">
          <input type="file" id="imageUploadForm" name="image" class="file-input" accept="image/*" style="display: none;" onchange="handleImageUpload(event)">

          <div class="row">
            <label>Name:</label>
            <input class="field" name="name" type="text" value="<%= user.name || '' %>" />
          </div>

          <fieldset class="row">
            <legend style="min-width:120px;font-weight:700;color:#3a2e22">Gender:</legend>
            <div class="gender">
              <label>
                <input type="radio" name="gender" value="Male" <%= user.gender === "Male" ? "checked" : "" %> /> Male
              </label>
              <label>
                <input type="radio" name="gender" value="Female" <%= user.gender === "Female" ? "checked" : "" %> /> Female
              </label>
              <label>
                <input type="radio" name="gender" value="Others" <%= user.gender === "Others" ? "checked" : "" %> /> Others
              </label>
              <label>
                <input type="radio" name="gender" value="Not" <%= user.gender === "Not" ? "checked" : "" %> /> Prefer Not To Say
              </label>
            </div>
          </fieldset>

          <div class="divider"></div>

          <div class="row">
            <label for="email">Email:</label>
            <input class="field" id="email" name="email" type="email" value="<%= user.email %>" disabled />
            <button type="button" class="verify-to-edit-btn" id="verifyToEditBtn" onclick="sendCurrentOTP()">Verify to Edit</button>
          </div>

          <div class="row">
            <label for="phone">Phone:</label>
            <input class="field" id="phone" name="phone" type="tel" value="<%= user.phone || '' %>" maxlength="13" />
          </div>

          <div class="row form-buttons">
            <label></label> <!-- Empty label to align buttons with fields -->
            <div class="form-buttons">
              <button type="button" class="edit-btn" onclick="toggleEditMode()">Cancel</button>
              <button type="submit" class="edit-btn" id="submitBtn">Save</button>
            </div>
          </div>
        </form>
      </main>
    </section>
  </div>

  <!-- OTP Modal -->
  <div id="otpModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeOTPModal()">&times;</span>
      <h2 class="modal-title" id="modalTitle">Verify Email</h2>
      <p class="modal-message" id="modalMessage">OTP sent to <span id="targetEmail"></span></p>
      <div class="otp-input-container">
        <input type="text" class="otp-input" maxlength="1" id="otpDigit1" oninput="moveToNext(this, 'otpDigit2')" />
        <input type="text" class="otp-input" maxlength="1" id="otpDigit2" oninput="moveToNext(this, 'otpDigit3')" />
        <input type="text" class="otp-input" maxlength="1" id="otpDigit3" oninput="moveToNext(this, 'otpDigit4')" />
        <input type="text" class="otp-input" maxlength="1" id="otpDigit4" oninput="moveToNext(this, 'otpDigit5')" />
        <input type="text" class="otp-input" maxlength="1" id="otpDigit5" oninput="moveToNext(this, 'otpDigit6')" />
        <input type="text" class="otp-input" maxlength="1" id="otpDigit6" oninput="verifyOTPFromModal()" />
      </div>
      <div class="modal-buttons">
        <button class="modal-btn" id="resendBtn" onclick="resendOTP()" disabled>Resend OTP</button>
        <button class="modal-btn" id="verifyBtn" onclick="verifyOTPFromModal()">Verify</button>
      </div>
      <div class="resend-timer" id="resendTimer"></div>
    </div>
  </div>

  <!-- Crop Modal -->
  <div id="crop-modal">
    <div class="crop-container">
      <div class="crop-header">
        <h3 class="crop-title">Crop Image</h3>
        <button id="close-crop-modal" class="crop-close" onclick="closeCropModal(true)">&times;</button>
      </div>
      <div class="crop-image-wrapper">
        <img id="crop-image" />
      </div>
      <div class="crop-footer">
        <button id="cancel-crop" class="crop-btn btn-cancel" onclick="closeCropModal(true)">Cancel</button>
        <button id="apply-crop" class="crop-btn btn-apply" onclick="applyCrop()">Apply Crop</button>
      </div>
    </div>
  </div>

  <!-- Message Container -->
  <div class="message-container" id="messageContainer"></div>

  <script>
    let originalEmail = '<%= user.email %>';
    let otpSent = false;
    let currentVerified = false;
    let newVerified = false;
    let currentTimer = null;
    let isCurrentOTP = true; // Flag to distinguish between current and new OTP
    let currentEmailForOTP = ''; // Track email for resend
    const RESEND_TIME = 60; // 60 seconds

    // Display server-side success/error messages on page load
    <% if (typeof success !== 'undefined' && success) { %>
      showMessage('<%= success %>', 'success');
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      showMessage('<%= error %>', 'error');
    <% } %>

    function showMessage(message, type = 'success') {
      const container = document.getElementById('messageContainer');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${type}`;
      msgDiv.textContent = message;
      container.appendChild(msgDiv);

      // Auto remove after 5 seconds
      setTimeout(() => {
        msgDiv.remove();
      }, 5000);
    }

    function toggleEditMode() {
      const card = document.querySelector('.card');
      const editButton = document.querySelector('.edit-btn[onclick="toggleEditMode()"]');
      if (card.classList.contains('view-mode')) {
        card.classList.remove('view-mode');
        card.classList.add('edit-mode');
        editButton.textContent = 'Edit';
        // Reset states on entering edit mode
        resetAllStates();
      } else {
        card.classList.remove('edit-mode');
        card.classList.add('view-mode');
        editButton.textContent = 'Edit';
      }
    }

    function resetAllStates() {
      resetOTPModal();
      document.getElementById('email').disabled = true;
      document.getElementById('verifyToEditBtn').style.display = 'inline-block';
      currentVerified = false;
      newVerified = false;
      document.getElementById('submitBtn').disabled = false;
      // Reset image state
      const avatarEl = document.getElementById('avatarLg');
      const initialImage = '<%= user.image || "" %>';
      const defaultAvatar = `https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=3a2f25&color=d3a35b&size=128&bold=true`;
      
      avatarEl.src = initialImage || defaultAvatar;      
      document.getElementById('imageUploadForm').value = '';
    }

    function resetOTPModal() {
      closeOTPModal();
      if (currentTimer) {
        clearInterval(currentTimer);
        currentTimer = null;
      }
      // Clear OTP inputs
      for (let i = 1; i <= 6; i++) {
        document.getElementById(`otpDigit${i}`).value = '';
      }
      document.getElementById('resendBtn').disabled = true;
      document.getElementById('resendTimer').textContent = '';
    }

    function openOTPModal(email, isCurrent) {
      currentEmailForOTP = email;
      isCurrentOTP = isCurrent;
      document.getElementById('targetEmail').textContent = email;
      document.getElementById('modalTitle').textContent = isCurrent ? 'Verify Current Email' : 'Verify New Email';
      document.getElementById('otpModal').style.display = 'block';
      document.getElementById('otpDigit1').focus();
      startResendTimer();
    }

    function closeOTPModal() {
      document.getElementById('otpModal').style.display = 'none';
      resetOTPModal();
    }

    // OTP input navigation
    function moveToNext(current, nextId) {
      if (current.value.length === 1 && nextId) {
        document.getElementById(nextId).focus();
      }
    }

    function startResendTimer() {
      let timeLeft = RESEND_TIME;
      document.getElementById('resendBtn').disabled = true;
      document.getElementById('resendTimer').textContent = `Resend in ${timeLeft}s`;
      currentTimer = setInterval(() => {
        timeLeft--;
        if (timeLeft > 0) {
          document.getElementById('resendTimer').textContent = `Resend in ${timeLeft}s`;
        } else {
          document.getElementById('resendBtn').disabled = false;
          document.getElementById('resendTimer').textContent = 'You can resend now';
          clearInterval(currentTimer);
          currentTimer = null;
        }
      }, 1000);
    }

    async function sendOTPToBackend(email, type) {
      try {
        const response = await fetch('/profile/changeEmail', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, type })
        });

        if (response.ok) {
          const data = await response.json();
          return { success: true, message: data.message || 'OTP sent successfully!' };
        } else {
          const data = await response.json();
          return { success: false, message: data.message || 'Failed to send OTP' };
        }
      } catch (error) {
        console.error('Network error:', error);
        return { success: false, message: 'Network error. Please try again.' };
      }
    }

    async function resendOTP() {
      const result = await sendOTPToBackend(currentEmailForOTP, isCurrentOTP ? 'current' : 'new');
      if (result.success) {
        showMessage(result.message, 'success');
      } else {
        showMessage(result.message, 'error');
      }
      startResendTimer();
    }

    async function verifyOTPFromModal() {
      const otp = Array.from({length: 6}, (_, i) => document.getElementById(`otpDigit${i+1}`).value).join('');
      if (otp.length !== 6) {
        showMessage('Please enter a valid 6-digit OTP.', 'error');
        return;
      }

      try {
        // Send OTP verification to backend route /profile/verify-email
        const response = await fetch('/profile/verify-email', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ 
            otp: otp, 
            email: currentEmailForOTP, 
            type: isCurrentOTP ? 'current' : 'new' 
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {

          showMessage(isCurrentOTP ? 'Current email verified successfully!' : 'New email verified successfully!', 'success');
          
          if (isCurrentOTP) {
            currentVerified = true;
            document.getElementById('email').disabled = false;
            document.getElementById('verifyToEditBtn').style.display = 'none';
          } else {
            newVerified = true;
          }
          closeOTPModal();
          if (!isCurrentOTP) {
            document.getElementById('email').focus();
          }
        } else {
          showMessage(data.message || 'Invalid OTP. Please try again.', 'error');
          // Clear inputs on error
          for (let i = 1; i <= 6; i++) {
            document.getElementById(`otpDigit${i}`).value = '';
          }
          document.getElementById('otpDigit1').focus();
        }
      } catch (error) {
        console.error('Verification network error:', error);
        // showMessage('Network error during verification. Please try again.', 'error');
        // Clear inputs on error
        for (let i = 1; i <= 6; i++) {
          document.getElementById(`otpDigit${i}`).value = '';
        }
        document.getElementById('otpDigit1').focus();
      }
    }

    // Initial button click to start current verification
    async function sendCurrentOTP() {
      openOTPModal(originalEmail, true);
      const result = await sendOTPToBackend(originalEmail, 'current');
      if (result.success) {
        showMessage(result.message, 'success');
      } else {
        showMessage(result.message, 'error');
        closeOTPModal();
      }
    }

    document.getElementById('email').addEventListener('input', function() {
      const currentEmail = this.value.trim();
      if (currentVerified && currentEmail && currentEmail !== originalEmail) {
        if (!document.getElementById('sendNewOtpBtn')) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'verify-to-edit-btn';
          btn.id = 'sendNewOtpBtn';
          btn.textContent = 'Send New OTP';
          btn.onclick = sendNewOTP;
          this.parentNode.appendChild(btn);
        }
      }
    });

    async function sendNewOTP() {
      const newEmail = document.getElementById('email').value.trim();
      if (!newEmail || newEmail === originalEmail || !currentVerified) {
        showMessage('Please verify your current email first and enter a new email address.', 'error');
        return;
      }
      openOTPModal(newEmail, false);
      const result = await sendOTPToBackend(newEmail, 'new');
      if (result.success) {
        showMessage(result.message, 'success');
      } else {
        showMessage(result.message, 'error');
        closeOTPModal();
      }
    }

    async function handleSubmit(event) {
      event.preventDefault();
      const newEmail = document.getElementById('email').value.trim();
      if (newEmail !== originalEmail) {
        if (!currentVerified) {
          showMessage('Please verify your current email before changing it.', 'error');
          return false;
        }
        if (!newVerified) {
          showMessage('Please verify the new email with OTP.', 'error');
          return false;
        }
      }

      // Phone number validation: required, Indian phone number format
      const phone = document.getElementById('phone').value.trim();
      if (!phone) {
        showMessage('Phone number is required', 'error');
        return false;
      }
      const indianPhoneRegex = /^(?:\+91|91|0)?[6-9]\d{9}$/;
      if (!indianPhoneRegex.test(phone)) {
        showMessage('Please enter a valid Indian phone number', 'error');
        return false;
      }
      
      const submitBtn = document.getElementById('submitBtn');
      const originalText = submitBtn.innerText;
      submitBtn.disabled = true;
      submitBtn.innerText = 'Saving...';

      try {
        const form = document.querySelector('.form');
        const formData = new FormData(form);
        
        // Remove file input to avoid sending original file if we have a crop or nothing
        formData.delete('image');

        if (profileImageBlob) {
          formData.append('image', profileImageBlob, 'profile.jpg');
        }

        const response = await fetch('/profile', {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
           const data = await response.json();
           if (data.success) {
             showMessage(data.message || 'Profile updated successfully!', 'success');
             setTimeout(() => {
               window.location.reload();
             }, 1000);
           } else {
             showMessage(data.message || 'Failed to update profile.', 'error');
             submitBtn.disabled = false;
             submitBtn.innerText = originalText;
           }
        } else {
           // Handle HTTP errors that might not return JSON or unexpected errors
           let message = 'Failed to update profile.';
           try {
              const data = await response.json();
              if (data.message) message = data.message;
           } catch(e) {}
           showMessage(message, 'error');
           submitBtn.disabled = false;
           submitBtn.innerText = originalText;
        }
      } catch (err) {
        console.error(err);
        showMessage('An error occurred. Please try again.', 'error');
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
      }

      return false;
    }

    // Image Upload & Cropping Logic
    let cropper = null;
    let profileImageBlob = null;

    function handleImageUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const cropImg = document.getElementById('crop-image');
        cropImg.src = e.target.result;
        
        const modal = document.getElementById('crop-modal');
        modal.classList.remove('hidden'); // Tailwind hidden
        modal.style.display = 'flex'; // Ensure flex override if needed for non-tailwind
        
        if (cropper) {
          cropper.destroy();
        }
        
        // Wait for image load
        setTimeout(() => {
            cropper = new Cropper(cropImg, {
                aspectRatio: 1, // Profile usually square
                viewMode: 1,
                autoCropArea: 0.8,
                scalable: true,
                zoomable: true,
                dragMode: 'crop',
                cropBoxMovable: true,
                cropBoxResizable: true,
                minCropBoxWidth: 100,
                minCropBoxHeight: 100,
            });
        }, 100);
      };
      reader.readAsDataURL(file);
    }

    function closeCropModal(cancel = false) {
      const modal = document.getElementById('crop-modal');
      modal.classList.add('hidden');
      modal.style.display = 'none';
      
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      
      if (cancel) {
         document.getElementById('imageUploadForm').value = ''; 
      }
    }

    function applyCrop() {
      if (!cropper) return;
      
      cropper.getCroppedCanvas({
          width: 300,
          height: 300,
          imageSmoothingQuality: 'high'
      }).toBlob((blob) => {
          if (blob) {
              profileImageBlob = blob;
              const url = URL.createObjectURL(blob);
              document.getElementById('avatarLg').src = url;
              closeCropModal(false);
          }
      }, 'image/jpeg', 0.9);
    }

    // Close modal on outside click
    window.onclick = function(event) {
      const modal = document.getElementById('otpModal');
      const cropModal = document.getElementById('crop-modal');
      if (event.target === modal) {
        closeOTPModal();
      }
      if (event.target === cropModal) {
        closeCropModal(true);
      }
    }
  </script>
  <%- include("../../../partials/user/footer") %>
</body>
</html>