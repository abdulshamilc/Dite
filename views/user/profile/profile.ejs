<%- include("../../partials/user/header") %>

<style>
  :root {
    --bg: linear-gradient(135deg, #0b0b0b, #1e1e1e);
    --text:#f5f5f5;        
    --surface:#ffffff;
    --accent:#d3a35b;
    --radius:14px;
  }

  *,*::before,*::after { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 "Inter", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; transition: color .25s; }
  a:hover { color: #b5823d; }

  .container {
    max-width: 1500px;
    margin-inline: auto;
    padding: 10px 0px;
  }
  .page-title {
    text-align: center;
    font-size: 2rem;
    margin: 20px 0;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--accent);
  }

  .layout {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    flex-direction: column;
  }
  @media (min-width: 960px) {
    .layout { flex-direction: row; }
  }

  .card {
    flex: 1;
    background: var(--surface);
    color: #1a1a1a;
    border-radius: var(--radius);
    padding: 28px;
    position: relative;
    box-shadow: 0 0 0 1px rgba(0,0,0,.08), 0 12px 30px rgba(0,0,0,.15);
    text-align: center;
  }

  .edit-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background .25s, transform .25s;
  }
  .edit-btn:hover {
    background: #b5823d;
    transform: scale(1.05);
  }

  .avatar-container {
    position: relative;
    display: inline-block;
    margin: 8px auto 28px;
  }
  .avatar-lg {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--accent);
    box-shadow: 0 6px 18px rgba(0,0,0,.3);
    display: block;
  }

  .image-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background .25s, transform .25s;
    font-size: 18px;
    opacity: 0;
    z-index: 1;
  }
  .avatar-container:hover .image-overlay,
  .edit-mode .image-overlay {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .image-overlay:hover {
    background: #b5823d;
    transform: translate(-50%, -50%) scale(1.05);
  }

  .form {
    max-width: 720px;
    margin-inline: auto;
    display: grid;
    gap: 24px;
  }
  .row {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .row label {
    min-width: 120px;
    font-weight: 700;
    color: #3a2e22;
  }
  .field {
    flex: 1;
    min-width: 280px;
    background: #fafafa;
    color: #111;
    border: 1px solid #caa880;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 15px;
    transition: border-color .25s, box-shadow .25s;
  }
  .field:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(211,163,91,.25);
    outline: none;
  }
  .field:disabled {
    background: #f0f0f0;
    color: #666;
    cursor: not-allowed;
  }

  .gender { display: flex; align-items: center; gap: 20px; }
  .divider { height: 1px; background: #caa880; opacity: .5; margin: 14px 0; }

  .otp-section, .current-otp-section {
    display: none;
    margin-top: 12px;
  }
  .otp-section.active, .current-otp-section.active {
    display: block;
  }
  .otp-row {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .send-otp-btn, .verify-otp-btn, .send-current-otp-btn, .verify-current-otp-btn, .verify-to-edit-btn {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background .25s;
    min-width: 120px;
    flex-shrink: 0;
  }
  .send-otp-btn:hover, .verify-otp-btn:hover, .send-current-otp-btn:hover, .verify-current-otp-btn:hover, .verify-to-edit-btn:hover {
    background: #b5823d;
  }
  .send-otp-btn:disabled, .send-current-otp-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
  .otp-field {
    flex: 1;
    min-width: 280px;
  }

  .view-mode .field-text {
    flex: 1;
    min-width: 280px;
    padding: 14px 16px;
    color: #111;
    font-size: 15px;
  }
  .view-mode .row {
    margin-bottom: 24px;
  }
  .view-mode .form { display: none; }
  .edit-mode .view-mode { display: none; }
  .edit-mode .form { display: grid; }

  .form-buttons {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }
  .form-buttons .edit-btn {
    position: static; /* Override absolute positioning for form buttons */
  }

  /* Image Upload Styles */
  .file-input {
    display: none;
  }
</style>

<body>
  <div class="container">
    <h1 class="page-title">PROFILE</h1>

    <section class="layout" aria-label="Profile layout">
      <%- include("../../partials/user/profileSideBar") %>

      <main class="card view-mode" aria-labelledby="profile-details-title">
        <button class="edit-btn" onclick="toggleEditMode()">Edit</button>
        
        <div class="avatar-container">
          <img src="<%= user.image || '/images/default-avatar.jpg' %>" alt="Profile Picture" class="avatar-lg" id="avatarLg">
          <button type="button" class="image-overlay" onclick="document.getElementById('imageUploadForm').click()" title="Change Photo">📷</button>
        </div>

        <div class="view-mode">
          <div class="row">
            <label>Name:</label>
            <span class="field-text"><%= user.name || '' %></span>
          </div>

          <div class="row">
            <label>Gender:</label>
            <span class="field-text"><%= user.gender || '' %></span>
          </div>

          <div class="divider"></div>

          <div class="row">
            <label for="email">Email:</label>
            <span class="field-text"><%= user.email %></span>
          </div>

          <div class="row">
            <label for="phone">Phone:</label>
            <span class="field-text"><%= user.phone || '' %></span>
          </div>
        </div>

        <form class="form" action="/profile" method="post" onsubmit="return handleSubmit(event)" enctype="multipart/form-data">
          <input type="file" id="imageUploadForm" name="image" class="file-input" accept="image/*" style="display: none;" onchange="handleImageUpload(event)">

          <div class="row">
            <label>Name:</label>
            <input class="field" name="name" type="text" value="<%= user.name || '' %>" />
          </div>

          <fieldset class="row">
            <legend style="min-width:120px;font-weight:700;color:#3a2e22">Gender:</legend>
            <div class="gender">
              <label>
                <input type="radio" name="gender" value="Male" <%= user.gender === "Male" ? "checked" : "" %> /> Male
              </label>
              <label>
                <input type="radio" name="gender" value="Female" <%= user.gender === "Female" ? "checked" : "" %> /> Female
              </label>
              <label>
                <input type="radio" name="gender" value="Others" <%= user.gender === "Others" ? "checked" : "" %> /> Others
              </label>
              <label>
                <input type="radio" name="gender" value="Not" <%= user.gender === "Not" ? "checked" : "" %> /> Prefer Not To Say
              </label>
            </div>
          </fieldset>

          <div class="divider"></div>

          <div class="row">
            <label for="email">Email:</label>
            <input class="field" id="email" name="email" type="email" value="<%= user.email %>" disabled />
            <button type="button" class="verify-to-edit-btn" id="verifyToEditBtn" onclick="sendCurrentOTP()">Verify to Edit</button>
          </div>
          <div class="current-otp-section" id="currentOtpSection">
            <div class="otp-row">
              <label for="currentOtp">Current OTP:</label>
              <input class="field otp-field" id="currentOtp" name="currentOtp" type="text" placeholder="Enter 6-digit OTP" maxlength="6" />
              <button type="button" class="send-current-otp-btn" id="sendCurrentOtpBtn" onclick="sendCurrentOTP()" style="display: none;">Resend OTP</button>
              <button type="button" class="verify-current-otp-btn" id="verifyCurrentOtpBtn" onclick="verifyCurrentOTP()" style="display: none;">Verify OTP</button>
            </div>
            <small style="color: #666; margin-left: 136px;">We'll send a 6-digit code to your current email for verification.</small>
          </div>
          <div class="otp-section" id="otpSection">
            <div class="otp-row">
              <label for="otp">New OTP:</label>
              <input class="field otp-field" id="otp" name="otp" type="text" placeholder="Enter 6-digit OTP" maxlength="6" />
              <button type="button" class="send-otp-btn" id="sendOtpBtn" onclick="sendOTP()">Send OTP</button>
              <button type="button" class="verify-otp-btn" id="verifyOtpBtn" onclick="verifyOTP()" style="display: none;">Verify OTP</button>
            </div>
            <small style="color: #666; margin-left: 136px;">We'll send a 6-digit code to your new email for verification.</small>
          </div>

          <div class="row">
            <label for="phone">Phone:</label>
            <input class="field" id="phone" name="phone" type="text" value="<%= user.phone || '' %>" />
          </div>

          <div class="row form-buttons">
            <label></label> <!-- Empty label to align buttons with fields -->
            <div class="form-buttons">
              <button type="button" class="edit-btn" onclick="toggleEditMode()">Cancel</button>
              <button type="submit" class="edit-btn" id="submitBtn">Save</button>
            </div>
          </div>
        </form>
      </main>
    </section>
  </div>

  <script>
    let originalEmail = '<%= user.email %>';
    let otpSent = false;
    let currentVerified = false;
    let newVerified = false;

    function toggleEditMode() {
      const card = document.querySelector('.card');
      const editButton = document.querySelector('.edit-btn[onclick="toggleEditMode()"]');
      if (card.classList.contains('view-mode')) {
        card.classList.remove('view-mode');
        card.classList.add('edit-mode');
        editButton.textContent = 'Edit';
        // Reset states on entering edit mode
        resetAllStates();
      } else {
        card.classList.remove('edit-mode');
        card.classList.add('view-mode');
        editButton.textContent = 'Edit';
      }
    }

    function resetAllStates() {
      resetCurrentOTPState();
      resetNewOTPState();
      document.getElementById('email').disabled = true;
      document.getElementById('verifyToEditBtn').style.display = 'inline-block';
      currentVerified = false;
      newVerified = false;
      document.getElementById('submitBtn').disabled = false;
      // Reset image state
      document.getElementById('avatarLg').src = '<%= user.image || '/images/default-avatar.jpg' %>';
      document.getElementById('imageUploadForm').value = '';  // Updated to clear form input
    }

    function resetCurrentOTPState() {
      document.getElementById('currentOtpSection').classList.remove('active');
      document.getElementById('currentOtpSection').style.display = 'none';
      document.getElementById('sendCurrentOtpBtn').style.display = 'none';
      document.getElementById('verifyCurrentOtpBtn').style.display = 'none';
      document.getElementById('verifyToEditBtn').style.display = 'inline-block';
      document.getElementById('currentOtp').value = '';
    }

    function resetNewOTPState() {
      document.getElementById('otpSection').classList.remove('active');
      document.getElementById('sendOtpBtn').style.display = 'inline-block';
      document.getElementById('verifyOtpBtn').style.display = 'none';
      document.getElementById('sendOtpBtn').disabled = false;
      document.getElementById('otp').value = '';
      otpSent = false;
    }

    // Initial button click to start current verification
    function sendCurrentOTP() {
      // Here, you would typically make an AJAX call to your backend to send OTP to originalEmail
      // For demo: Simulate sending OTP
      console.log('Sending current OTP to:', originalEmail); // Replace with actual fetch/post request
      // alert('Current OTP sent to ' + originalEmail + '! Check your inbox.'); // Uncomment for alert

      document.getElementById('verifyToEditBtn').style.display = 'none';
      document.getElementById('currentOtpSection').style.display = 'block';
      document.getElementById('sendCurrentOtpBtn').style.display = 'inline-block';
      document.getElementById('verifyCurrentOtpBtn').style.display = 'inline-block';
      document.getElementById('currentOtp').focus();
    }

    function verifyCurrentOTP() {
      const currentOtp = document.getElementById('currentOtp').value.trim();
      if (currentOtp.length !== 6) {
        alert('Please enter a valid 6-digit OTP.');
        return;
      }
      // Here, you would typically make an AJAX call to your backend to verify current OTP
      // For demo: Simulate verification (always succeeds for now)
      console.log('Verifying current OTP:', currentOtp); // Replace with actual fetch/post request
      // alert('Current OTP verified successfully!'); // Uncomment for alert

      currentVerified = true;
      document.getElementById('email').disabled = false;
      resetCurrentOTPState(); // Hide the section after verification
      document.getElementById('email').focus();
    }

    document.getElementById('email').addEventListener('input', function() {
      const currentEmail = this.value.trim();
      if (currentVerified && currentEmail && currentEmail !== originalEmail) {
        document.getElementById('otpSection').classList.add('active');
      } else {
        resetNewOTPState();
      }
    });

    function sendOTP() {
      const newEmail = document.getElementById('email').value.trim();
      if (!newEmail || newEmail === originalEmail || !currentVerified) {
        alert('Please verify your current email first and enter a new email address.');
        return;
      }
      // Here, you would typically make an AJAX call to your backend to send OTP to newEmail
      // For demo: Simulate sending OTP
      console.log('Sending new OTP to:', newEmail); // Replace with actual fetch/post request
      // alert('New OTP sent to ' + newEmail + '! Check your inbox.'); // Uncomment for alert
      otpSent = true;
      document.getElementById('sendOtpBtn').style.display = 'none';
      document.getElementById('verifyOtpBtn').style.display = 'inline-block';
      document.getElementById('otp').focus();
    }

    function verifyOTP() {
      const otp = document.getElementById('otp').value.trim();
      if (otp.length !== 6) {
        alert('Please enter a valid 6-digit OTP.');
        return;
      }
      // Here, you would typically make an AJAX call to your backend to verify new OTP
      // For demo: Simulate verification (always succeeds for now)
      console.log('Verifying new OTP:', otp); // Replace with actual fetch/post request
      // alert('New OTP verified successfully!'); // Uncomment for alert
      newVerified = true;
      document.getElementById('verifyOtpBtn').style.display = 'none';
      // Optionally, hide OTP section after verification
      // document.getElementById('otpSection').classList.remove('active');
    }

    function handleSubmit(event) {
      const newEmail = document.getElementById('email').value.trim();
      if (newEmail !== originalEmail) {
        if (!currentVerified) {
          alert('Please verify your current email before changing it.');
          event.preventDefault();
          return false;
        }
        const otp = document.getElementById('otp').value.trim();
        if (!newVerified || !otp || otp.length !== 6) {
          alert('Please enter and verify the OTP for the new email.');
          event.preventDefault();
          return false;
        }
      }
      // Backend should also verify the OTPs on submit for security
      // For image, the file will be sent
      return true;
    }

    // Image Upload Function - Simple Preview
    function handleImageUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('avatarLg').src = e.target.result;
      };
      reader.readAsDataURL(file);
    }
  </script>
</body>