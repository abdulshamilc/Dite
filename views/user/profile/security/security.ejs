<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Security - Dité</title>
  <%- include("../../../partials/user/headerHead") %>
  <%- include("../../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/profile/security/security.css">
</head>
<body>
  <%- include("../../../partials/user/header") %>
  <!-- Notification Container -->
  <div class="notification-container" id="notificationContainer"></div>

  <div class="container">
    <h1 class="page-title">SECURITY</h1>

    <section class="layout" aria-label="Security layout">
      <%- include("../../../partials/user/profileSideBar") %>

      <main class="card">
        <!-- Password Section -->
        <div class="section">
          <h2 class="section-title">Password</h2>
          <div class="security-item">
            <div class="item-info">
              <div class="item-label">Change Password</div>
              <div class="item-description">Update your password regularly to keep your account secure</div>
            </div>
            <button class="btn" onclick="openResetPasswordModal()">Reset</button>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Two-Factor Authentication Section -->
        <div class="section">
          <h2 class="section-title">Two-Factor Authentication</h2>
          <div class="security-item">
            <div class="item-info">
              <div class="item-label">2FA Status</div>
              <div class="item-description">Add an extra layer of security to your account</div>
            </div>
            <div class="item-status <%= is2FAEnabled ? 'status-enabled' : 'status-disabled' %>">
              <span class="status-badge"></span>
              <span><%= is2FAEnabled ? 'Enabled' : 'Disabled' %></span>
            </div>
          </div>
          <div style="margin-top: 12px;">
            <% if (!is2FAEnabled) { %>
              <button class="btn" onclick="openEnable2FAModal()">Enable 2FA</button>
            <% } else { %>
              <button class="btn btn-secondary" onclick="openDisable2FAModal()">Disable 2FA</button>
            <% } %>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Login History Section -->
        <div class="section">
          <h2 class="section-title">Login History</h2>
          <div class="login-history">
            <% if (logHistory && logHistory.length > 0) { %>
              <% logHistory.forEach(function(log) { %>
                <div class="history-item">
                  <div class="history-info">
                    <div class="history-device"><%= log.device || 'Unknown Device' %></div>
                    <div class="history-time"><%= new Date(log.loginTime).toLocaleString() %></div>
                    <div class="history-location">📍 <%= log.location || 'Unknown Location' %></div>
                  </div>
                  <% if (log.isCurrentSession) { %>
                    <span class="status-enabled">Current</span>
                  <% } %>
                </div>
              <% }); %>
            <% } else { %>
              <div class="history-item">
                <div class="history-info">
                  <div class="history-device">No login history available</div>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Account Deletion Section -->
        <div class="section">
          <div class="alert alert-warning">
            <div class="alert-icon">⚠️</div>
            <div class="alert-content">
              <div class="alert-title">Danger Zone</div>
              <div class="alert-description">Deleting your account is permanent and cannot be undone. All your data will be permanently removed.</div>
            </div>
          </div>
          <div class="security-item">
            <div class="item-info">
              <div class="item-label">Delete Account</div>
              <div class="item-description">Permanently delete your account and all associated data</div>
            </div>
            <button class="btn btn-danger" onclick="window.location.href='/security/delete-account-confirm'">Delete Account</button>
        </div>
      </main>
    </section>
  </div>

  <!-- Reset Password Modal -->
  <div class="modal" id="resetPasswordModal">
    <div class="modal-content">
      <h3 class="modal-title">Reset Password</h3>
      <form id="resetPasswordForm">
        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter your current password">
        </div>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="newPassword" placeholder="Enter your new password">
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your new password">
        </div>
        <div id="passwordError" class="error-message"></div>
        <div class="modal-buttons">
          <button type="button" class="btn btn-secondary" onclick="closeResetPasswordModal()">Cancel</button>
          <button type="submit" class="btn" id="submitPasswordBtn">Reset Password</button>
        </div>
      </form>
      <div class="forgot-password-link" onclick="window.location.href='/forgot-password'">Forgot Password?</div>
    </div>
  </div>

  <!-- Enable 2FA Modal -->
  <div class="modal" id="enable2FAModal">
    <div class="modal-content">
      <h3 class="modal-title">Enable Two-Factor Authentication</h3>
      <div class="modal-description">
        <p>Two-factor authentication adds an extra layer of security to your account. You'll need to enter a code from your authenticator app in addition to your password when logging in.</p>
      </div>
      <div class="form-group">
        <label>Scan this QR code with your authenticator app:</label>
        <div id="qrCodeContainer" style="background: #f0f0f0; padding: 20px; border-radius: 8px; text-align: center; margin: 12px 0;">
          <div id="qrCodeLoading" style="font-size: 14px; color: #666;">
            <div style="font-size: 32px; margin-bottom: 10px;">⏳</div>
            Loading QR Code...
          </div>
          <img id="qrCodeImage" style="display: none; max-width: 200px; margin: 0 auto;" alt="2FA QR Code">
        </div>
      </div>
      <div class="form-group">
        <label for="twoFACode">Enter the 6-digit code from your app:</label>
        <input type="text" id="twoFACode" name="twoFACode" maxlength="6" placeholder="000000" style="text-align: center; letter-spacing: 8px; font-size: 18px;">
        <div id="enable2FAError" class="error-message" style="display: none;"></div>
      </div>
      <div class="modal-buttons">
        <button type="button" class="btn btn-secondary" onclick="closeEnable2FAModal()">Cancel</button>
        <button type="button" class="btn" id="enable2FABtn" onclick="verifyTwoFA()">Verify & Enable</button>
      </div>
    </div>
  </div>

  <!-- Disable 2FA Modal -->
  <div class="modal" id="disable2FAModal">
    <div class="modal-content">
      <h3 class="modal-title">Disable Two-Factor Authentication</h3>
      <div class="modal-description">
        <p>Disabling 2FA will remove the extra security layer from your account. This action cannot be undone without re-enabling it.</p>
      </div>
      <div class="form-group">
        <label for="disable2FACode">Enter the 6-digit code from your app to confirm:</label>
        <input type="text" id="disable2FACode" name="disable2FACode" maxlength="6" placeholder="000000" style="text-align: center; letter-spacing: 8px; font-size: 18px;">
        <div id="disable2FAError" class="error-message" style="display: none;"></div>
      </div>
      <div class="modal-buttons">
        <button type="button" class="btn btn-secondary" onclick="closeDisable2FAModal()">Cancel</button>
        <button type="button" class="btn btn-danger" id="disable2FABtn" onclick="verifyDisable2FA()">Disable 2FA</button>
      </div>
    </div>
  </div>

  <script>
    // Notification Functions
    function showNotification(type, message, duration = 5000) {
      const container = document.getElementById('notificationContainer');
      const notification = document.createElement('div');
      notification.className = `notification ${type}`;
      notification.innerHTML = `
        <span>${message}</span>
        <button class="close-btn" onclick="this.parentElement.remove();">&times;</button>
      `;
      container.appendChild(notification);

      // Auto-remove after duration
      setTimeout(() => {
        if (notification.parentElement) {
          notification.classList.add('fade-out');
          setTimeout(() => notification.remove(), 300);
        }
      }, duration);
    }

    // Reset Password Modal
    function openResetPasswordModal() {
      document.getElementById('resetPasswordModal').classList.add('active');
      hidePasswordError(); // Clear any previous errors
    }
    function closeResetPasswordModal() {
      document.getElementById('resetPasswordModal').classList.remove('active');
      document.getElementById('resetPasswordForm').reset();
      hidePasswordError();
    }

    function showPasswordError(message) {
      const errorDiv = document.getElementById('passwordError');
      errorDiv.textContent = message;
      errorDiv.style.display = 'block';
    }

    function hidePasswordError() {
      const errorDiv = document.getElementById('passwordError');
      errorDiv.textContent = '';
      errorDiv.style.display = 'none';
    }

    // Client-side validation and submit handler
    document.getElementById('resetPasswordForm').addEventListener('submit', async function(event) {
      event.preventDefault();
      const currentPassword = document.getElementById('currentPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const submitBtn = document.getElementById('submitPasswordBtn');

      // Clear previous errors
      hidePasswordError();

      // Client-side checks
      if (!currentPassword) {
        showPasswordError('Current password is required!');
        return;
      }
      if (!newPassword) {
        showPasswordError('New password is required!');
        return;
      }
      if (!confirmPassword) {
        showPasswordError('Confirm password is required!');
        return;
      }
      if (newPassword !== confirmPassword) {
        showPasswordError('New passwords do not match!');
        return;
      }
      if (newPassword.length < 8) {
        showPasswordError('Password must be at least 8 characters long!');
        return;
      }

      if(currentPassword == newPassword){
        showPasswordError(' New Password must be Diffent From Current Password');
        return;
      }

      // Disable button during submission
      submitBtn.disabled = true;
      submitBtn.textContent = 'Processing...';

      try {
        // Send to server for Joi validation and processing
        const response = await fetch('/reset-password', { 
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            currentPassword,
            newPassword,
            confirmPassword 
          }),
        });

        const data = await response.json();

        if (response.ok) {
          showNotification('success', data.message || 'Password reset successfully!');
          closeResetPasswordModal();
        } else {
          showPasswordError(data.message || 'Failed to reset password. Please try again.');
        }
      } catch (error) {
        console.error('Error:', error);
        showPasswordError('An error occurred. Please try again.');
      } finally {
        // Re-enable button
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reset Password';
      }
    });

    // Enable 2FA Modal
    async function openEnable2FAModal() {
      const modal = document.getElementById('enable2FAModal');
      modal.classList.add('active');
      
      // Reset state
      document.getElementById('qrCodeLoading').style.display = 'block';
      document.getElementById('qrCodeImage').style.display = 'none';
      document.getElementById('twoFACode').value = '';
      document.getElementById('enable2FAError').style.display = 'none';
      
      // Fetch QR code from server
      try {
        const response = await fetch('/security/2fa/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
          // Show QR code
          const qrImage = document.getElementById('qrCodeImage');
          qrImage.src = data.qrCode;
          qrImage.style.display = 'block';
          document.getElementById('qrCodeLoading').style.display = 'none';
        } else {
          showNotification('error', data.message || 'Failed to generate QR code');
          closeEnable2FAModal();
        }
      } catch (error) {
        console.error('Error:', error);
        showNotification('error', 'An error occurred. Please try again.');
        closeEnable2FAModal();
      }
    }
    
    function closeEnable2FAModal() {
      document.getElementById('enable2FAModal').classList.remove('active');
      document.getElementById('twoFACode').value = '';
      document.getElementById('enable2FAError').style.display = 'none';
    }
    
    async function verifyTwoFA() {
      const code = document.getElementById('twoFACode').value.trim();
      const errorDiv = document.getElementById('enable2FAError');
      const btn = document.getElementById('enable2FABtn');
      
      // Validate
      if (!code) {
        errorDiv.textContent = 'Please enter the code from your authenticator app.';
        errorDiv.style.display = 'block';
        return;
      }
      
      if (code.length !== 6 || !/^\d{6}$/.test(code)) {
        errorDiv.textContent = 'Please enter a valid 6-digit code.';
        errorDiv.style.display = 'block';
        return;
      }
      
      errorDiv.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Verifying...';
      
      try {
        const response = await fetch('/security/2fa/enable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
          showNotification('success', data.message || 'Two-factor authentication enabled successfully!');
          closeEnable2FAModal();
          // Reload page to update status
          setTimeout(() => window.location.reload(), 1500);
        } else {
          errorDiv.textContent = data.message || 'Invalid code. Please try again.';
          errorDiv.style.display = 'block';
        }
      } catch (error) {
        console.error('Error:', error);
        errorDiv.textContent = 'An error occurred. Please try again.';
        errorDiv.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Verify & Enable';
      }
    }

    // Disable 2FA Modal
    function openDisable2FAModal() {
      document.getElementById('disable2FAModal').classList.add('active');
      document.getElementById('disable2FACode').value = '';
      document.getElementById('disable2FAError').style.display = 'none';
    }
    
    function closeDisable2FAModal() {
      document.getElementById('disable2FAModal').classList.remove('active');
      document.getElementById('disable2FACode').value = '';
      document.getElementById('disable2FAError').style.display = 'none';
    }
    
    async function verifyDisable2FA() {
      const code = document.getElementById('disable2FACode').value.trim();
      const errorDiv = document.getElementById('disable2FAError');
      const btn = document.getElementById('disable2FABtn');
      
      // Validate
      if (!code) {
        errorDiv.textContent = 'Please enter the code from your authenticator app.';
        errorDiv.style.display = 'block';
        return;
      }
      
      if (code.length !== 6 || !/^\d{6}$/.test(code)) {
        errorDiv.textContent = 'Please enter a valid 6-digit code.';
        errorDiv.style.display = 'block';
        return;
      }
      
      errorDiv.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Disabling...';
      
      try {
        const response = await fetch('/security/2fa/disable', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
          showNotification('success', data.message || 'Two-factor authentication disabled successfully!');
          closeDisable2FAModal();
          // Reload page to update status
          setTimeout(() => window.location.reload(), 1500);
        } else {
          errorDiv.textContent = data.message || 'Invalid code. Please try again.';
          errorDiv.style.display = 'block';
        }
      } catch (error) {
        console.error('Error:', error);
        errorDiv.textContent = 'An error occurred. Please try again.';
        errorDiv.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Disable 2FA';
      }
    }

    // Close modals when clicking outside
    document.addEventListener('click', function(event) {
      const modals = document.querySelectorAll('.modal.active');
      modals.forEach(modal => {
        if (event.target === modal) {
          modal.classList.remove('active');
        }
      });
    });
  </script>
  <%- include("../../../partials/user/footer") %>
</body>
</html>