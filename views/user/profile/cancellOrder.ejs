<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Order Cancellation</title>
    <link rel="stylesheet" href="/style/user/header.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary: #1a1a1a;
            --secondary: #ffffff;
            --accent: #d4af37;
            --light-bg: #f5f5f5;
        }
        
        body {
            background-color: var(--primary);
            color: var(--secondary);
        }
        
        .accent-text {
            color: var(--accent);
        }
        
        .accent-border {
            border-color: var(--accent);
        }
        
        .accent-bg {
            background-color: var(--accent);
            color: var(--primary);
        }
        
        .card {
            background-color: #2a2a2a;
            border: 1px solid #404040;
        }
        
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-cancel {
            background-color: #ef4444;
            color: white;
        }
        
        .close {
            color: #aaa;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
        
        .close:hover {
            color: var(--accent);
        }
        
        .btn {
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        
        .btn-primary {
            background-color: var(--accent);
            color: var(--primary);
            border: none;
        }
        
        .btn-secondary {
            background-color: transparent;
            color: #aaa;
            border: 1px solid #404040;
        }
        
        .btn-danger {
            background-color: #ef4444;
            color: white;
            border: none;
        }
        
        .btn-edit {
            background-color: transparent;
            color: var(--accent);
            border: 1px solid var(--accent);
            padding: 6px 12px;
            font-size: 14px;
        }
        
        .btn:hover {
            opacity: 0.9;
        }
        
        .estimated-refund {
            background-color: #10b981;
            color: white;
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            display: inline-block;
            margin-top: 8px;
        }
        
        .reason-textarea {
            width: 100%;
            padding: 8px;
            background-color: #404040;
            color: var(--secondary);
            border: 1px solid #6b7280;
            border-radius: 4px;
            resize: vertical;
            min-height: 80px;
        }
        
        .reason-textarea:focus {
            outline: none;
            border-color: var(--accent);
        }
        
        .item-cancel {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid #ef4444;
            border-radius: 4px;
            margin-bottom: 8px;
            background-color: rgba(239, 68, 68, 0.1);
        }

        .refund-section {
            display: none;
        }

        .refund-section:not(.cod-hidden) {
            display: block;
        }

        .payment-mode {
            background-color: rgba(52, 211, 153, 0.1);
            border: 1px solid #10b981;
        }

        .cod-note {
            background-color: rgba(239, 68, 68, 0.1);
            border: 1px solid #ef4444;
            color: #fca5a5;
        }
    </style>
</head>
<body>
    <%- include("../../partials/user/header") %>
    <div class="min-h-screen pt-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto w-full">
            <!-- Header -->
            <div class="mb-8">
                <a href="/orders/<%= order._id %>" class="text-sm accent-text hover:underline mb-4 inline-block">← Back to Order Details</a>
                <div class="flex items-start">
                    <div class="flex-1 text-center">
                        <h1 class="text-4xl font-bold mb-2">Confirm Cancellation</h1>
                        <p class="text-gray-400">Order ID: <span class="accent-text font-semibold"><%= order.orderID %></span></p>
                    </div>
                    <div class="flex-none ml-4">
                        <span class="status-badge status-cancel">Cancelling</span>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="space-y-6">
                <!-- Items to Cancel -->
                <div class="card p-6 rounded-lg">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-bold accent-text">Items to Cancel</h2>
                        <a href="/cancelOrder/<%= order._id %>/cancel-select?edit=true" class="btn btn-edit">Edit Items</a>
                    </div>
                    <div class="space-y-4">
                        <% if (cancelledItems && cancelledItems.length > 0) { %>
                            <% let cancelSubtotal = 0; %>
                            <% cancelledItems.forEach(itemCancel => { %>
                                <% const item = itemCancel.item; %>
                                <% const cancelQty = itemCancel.cancelQty; %>
                                <% const itemTotal = (item.basePrice || 0) * cancelQty; %>
                                <% cancelSubtotal += itemTotal; %>
                                <div class="item-cancel">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
                                    <% } else { %>
                                        <div class="w-16 h-16 bg-gray-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <span class="text-gray-400 text-xs">No Image</span>
                                        </div>
                                    <% } %>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                                        <p class="text-gray-500 text-sm">
                                            <%= (item.mlSize || 0) + ' ml' %> • Qty: <%= cancelQty %>
                                        </p>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <p class="font-semibold text-red-400">₹<%= itemTotal.toFixed(2) %></p>
                                    </div>
                                </div>
                            <% }); %>
                            <div class="flex justify-between text-lg font-bold accent-text pt-2 border-t border-gray-600 mt-4">
                                <span>Cancel Subtotal</span>
                                <span>₹<%= cancelSubtotal.toFixed(2) %></span>
                            </div>
                            <p class="text-sm text-gray-400 mt-2">Note: Refund amount may be adjusted based on shipping and tax prorations. Full details will be provided post-cancellation.</p>
                        <% } else { %>
                            <p class="text-gray-400 text-center py-4">No items selected for cancellation.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Payment Method (Always Visible) -->
                <div class="card p-6 rounded-lg">
                    <h3 class="font-bold mb-4 accent-text">Payment Method</h3>
                    <div class="text-sm space-y-2 text-gray-300">
                        <% if (order.paymentMethod) { %>
                            <% if (order.paymentMethod === 'cod') { %>
                                <div class="cod-note p-3 rounded-lg">
                                    <p class="font-semibold text-red-300">Cash on Delivery</p>
                                    
                                </div>
                            <% } else { %>
                                <div class="payment-mode p-3 rounded-lg">
                                    <p class="font-semibold">
                                        <%= typeof order.paymentMethod === 'string' ? order.paymentMethod.charAt(0).toUpperCase() + order.paymentMethod.slice(1) : order.paymentMethod.type || 'Card' %> 
                                        <span class="accent-text">
                                            **** <%= order.paymentMethod.last4 ? order.paymentMethod.last4 : '' %>
                                        </span>
                                    </p>
                                    <p class="text-sm text-gray-400">Refund will be processed to this method within 5-7 business days.</p>
                                </div>
                            <% } %>
                        <% } else { %>
                            <p class="text-gray-400">Payment details not available.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Order Summary (Partial) - Hidden for COD -->
                <div class="refund-section card p-6 rounded-lg <%= order.paymentMethod === 'cod' ? 'cod-hidden' : '' %>">
                    <h2 class="text-xl font-bold mb-4 accent-text">Refund Estimate</h2>
                    <div class="space-y-2 text-gray-300">
                        <div class="flex justify-between">
                            <span>Cancel Subtotal</span>
                            <span>₹<%= cancelSubtotal || 0 %></span>
                        </div>
                        <div class="flex justify-between text-red-400">
                            <span>Prorated Shipping/Tax Adjustment</span>
                            <span>-₹0.00</span> <!-- TODO: Calculate prorated if needed -->
                        </div>
                        <div class="flex justify-between text-lg font-bold accent-text pt-2 border-t border-gray-600">
                            <span>Estimated Refund</span>
                            <span class="estimated-refund">₹<%= cancelSubtotal || 0 %></span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address (for reference) -->
                <div class="card p-6 rounded-lg">
                    <h3 class="font-bold mb-4 accent-text">Shipping Address (for Reference)</h3>
                    <div class="text-sm space-y-1 text-gray-300">
                        <% if (order.address) { %>
                            <p class="font-semibold"><%= order.address.fullName || '' %></p>
                            <p><%= order.address.street || '' %></p>
                            <p><%= order.address.hoNo || '' %></p>
                            <p><%= (order.address.city || '') + ', ' + (order.address.state || '') + ' ' + (order.address.pin || '') %></p>
                            <p><%= order.address.country || '' %></p>
                            <p class="mt-3 accent-text"><%= order.address.phone || '' %></p>
                        <% } else { %>
                            <p class="text-gray-400">Shipping address not available.</p>
                        <% } %>
                    </div>
                    <p class="text-sm text-gray-400 mt-2">Note: If all items are cancelled, the order will be fully cancelled. Partial cancellations may affect shipping.</p>
                </div>

                <!-- Reason for Cancellation -->
                <div class="card p-6 rounded-lg">
                    <h3 class="font-bold mb-4 accent-text">Reason for Cancellation (Optional)</h3>
                    <div class="text-sm text-gray-300">
                        <p class="mb-2">Help us improve by sharing why you're cancelling.</p>
                        <textarea class="reason-textarea" name="cancellationReason" placeholder="e.g., Changed my mind, Found a better price, Item not as expected..."></textarea>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex gap-4 pt-4">
                    <a href="/order/<%= order._id %>" class="flex-1 btn btn-secondary text-center py-3">Back to Order</a>
                    <form id="confirmCancelForm" action="/cancelOrder/<%= order._id %>/cancel-select" method="POST" style="flex: 1;">
                        <input type="hidden" name="cancelledItems" value="<%= JSON.stringify(cancelledItems || []) %>">
                        <input type="hidden" name="cancellationReason" value="">
                        <button type="submit" class="w-full btn btn-danger py-3 font-semibold">Confirm Cancellation</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Copy reason to hidden input on submit
        document.getElementById('confirmCancelForm').addEventListener('submit', function() {
            const textarea = document.querySelector('textarea[name="cancellationReason"]');
            const hiddenInput = this.querySelector('input[name="cancellationReason"]');
            hiddenInput.value = textarea.value;
        });
    </script>
</body>
</html>