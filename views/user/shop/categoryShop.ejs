<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dité - <%= name %></title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/shop/categoryShop.css">
  </head>
  <body>
    <!-- Header -->
    <%- include("../../partials/user/header") %>

    <!-- Shop Section -->
    <section class="shop-section">
      <div class="container">
        <h1 class="shop-title"><%= name %></h1>
        <p class="shop-subtitle">
          Explore our exclusive collection of <%= name.toLowerCase() %> perfumes, crafted to leave a lasting impression.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <main class="container">
      <% if (error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <!-- Search Section -->
      <div class="search-section">
        <div class="search-bar">
          <input
            type="text"
            class="search-input"
            id="searchInput"
            placeholder="Search products..."
            value="<%= search %>"
          />
          <i class="fas fa-search search-icon" onclick="performSearch()"></i>
        </div>
      </div>

      <!-- Filter Section -->
      <div class="filter-section">
        <form id="filterForm" style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; width: 100%;">
          <!-- Sort Filter -->
          <select class="filter-dropdown" id="sortFilter" name="sort">
            <option value="" <%= sort === '' ? 'selected' : '' %>>SORT BY</option>
            <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
          </select>
           <!-- Filter Button to Open Modal -->
           <button type="button" class="filter-btn" id="filterButton">FILTER</button>
        </form>
      </div>

      <!-- Product Grid -->
      <div class="product-grid">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <% const isInWishlist = wishlist && wishlist.some(item => item.product && item.product._id.toString() === product._id.toString()); %>
            <a href="/shop/<%= product._id %>">
              <div class="product-card">
                <button class="wishlist-btn <%= isInWishlist ? 'active' : '' %>" data-product-id="<%= product._id %>" title="<%= isInWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>" onclick="toggleWishlist(event); return false;">
                  <i class="<%= isInWishlist ? 'fas' : 'far' %> fa-heart"></i>
                </button>
                <img
                  src="<%= product.images[0] %>"
                  alt="<%= product.name %>"
                  class="product-image"
                />
                <div class="product-info">
                  <h3 class="product-name"><%= product.name %></h3>
                  <div class="product-price">
                    <% if(product.variants[0].discountedPrice < product.variants[0].basePrice) { %>
                      <span class="base-price"><%= product.variants[0].basePrice %> Rs</span>
                    <% } %>
                    <span class="discounted-price"><%= product.variants[0].discountedPrice %> Rs</span>
                  </div>
                  <button class="shop-now-btn">Shop Now</button>
                </div>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 50px; color: #999;">
            No products found matching your criteria.
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <button 
            class="pagination-btn" 
            <%= page === 1 ? 'disabled' : '' %>
            onclick="updatePage('<%= page - 1 %>')"
          >‹ Previous</button>
          
          <% for (let i = 1; i <= totalPages; i++) { %>
            <div 
              class="pagination-dot <%= i === page ? 'active' : '' %>" 
              onclick="updatePage('<%= i %>')"
              title="Page <%= i %>"
            ></div>
          <% } %>
          
          <button 
            class="pagination-btn" 
            <%= page === totalPages ? 'disabled' : '' %>
            onclick="updatePage('<%= page + 1 %>')"
          >Next ›</button>
        </div>
      <% } %>
    </main>
         <!-- Filter Modal -->
         <div id="filterModal" class="modal">
            <div class="modal-content">
              <div class="modal-header">
                <h2>Filters</h2>
                <span class="close" onclick="closeFilterModal()">&times;</span>
              </div>
              <div class="modal-body">
                <!-- Price Range -->
                <div class="filter-group">
                  <h3>Price Range</h3>
                  <div class="price-selects">
                    <div class="price-select-group">
                      <label>From:</label>
                      <select id="minPriceSelect" class="price-select">
                        <option value="" <%= (!queryMinPrice || queryMinPrice === '') ? 'selected' : '' %>>Lowest</option>
                        <% minPriceOptions.slice(1).forEach(option => { %>
                          <option value="<%= option %>" <%= (queryMinPrice == option) ? 'selected' : '' %>><%= option %> Rs</option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="price-select-group">
                      <label>To:</label>
                      <select id="maxPriceSelect" class="price-select">
                        <% maxPriceOptions.slice(0, -1).forEach(option => { %>
                          <option value="<%= option %>" <%= (queryMaxPrice == option) ? 'selected' : '' %>><%= option %> Rs</option>
                        <% }); %>
                        <option value="" <%= (!queryMaxPrice || queryMaxPrice === '') ? 'selected' : '' %>>Highest</option>
                      </select>
                    </div>
                  </div>
                </div>
                <!-- Brands -->
                <div class="filter-group">
                  <h3>Brands</h3>
                  <% topBrands.forEach(brand => { %>
                    <label class="checkbox-label">
                      <input type="checkbox" value="<%= brand.toLowerCase() %>" <%= selectedBrands.map(b => b.toLowerCase()).includes(brand.toLowerCase()) ? 'checked' : '' %>>
                      <%= brand %>
                    </label>
                  <% }); %>
                  <div id="moreBrands" class="brands-hidden">
                    <% otherBrands.forEach(brand => { %>
                      <label class="checkbox-label">
                        <input type="checkbox" value="<%= brand.toLowerCase() %>" <%= selectedBrands.map(b => b.toLowerCase()).includes(brand.toLowerCase()) ? 'checked' : '' %>>
                        <%= brand %>
                      </label>
                    <% }); %>
                  </div>
                  <% if (otherBrands.length > 0) { %>
                    <button type="button" class="show-more-btn" onclick="toggleMoreBrands(event)">Show More</button>
                  <% } %>
                </div>
                <!-- Concentrations -->
                <div class="filter-group">
                  <h3>Concentration</h3>
                  <% concentrations.forEach(conc => { %>
                    <label class="checkbox-label">
                      <input type="checkbox" value="<%= conc.toLowerCase() %>" <%= selectedConcentrations.map(c => c.toLowerCase()).includes(conc.toLowerCase()) ? 'checked' : '' %>>
                      <%= conc %>
                    </label>
                  <% }); %>
                </div>
              </div>
              <div class="modal-footer">
                <button onclick="clearFilters()">Clear</button>
                <button onclick="applyFilters()">Apply</button>
              </div>
            </div>
          </div>
    <!-- Footer -->
    <%- include("../../partials/user/footer") %>
    
    <!-- Toast Container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      // Preserve current params for updates
      const currentParams = new URLSearchParams(window.location.search);
      let searchTimer;

      function buildQuery(newParams = {}) {
        const params = new URLSearchParams(currentParams);
        let shouldResetPage = false;
        Object.entries(newParams).forEach(([key, value]) => {
          if (value === 'ALL' || value === '' || value === null || value === undefined || !value) {
            params.delete(key);
          } else {
            params.set(key, value);
          }
          if (key !== 'page') {
            shouldResetPage = true;
          }
        });
        if (shouldResetPage) {
          params.set('page', 1);
        }
        return `?${params.toString()}`;
      }

      function performSearch() {
        clearTimeout(searchTimer);
        const searchVal = document.getElementById('searchInput').value;
        const newParams = { search: searchVal };
        window.location.search = buildQuery(newParams);
      }

      function debounceSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          performSearch();
        }, 500); 
      }

      function updatePage(newPage) {
        const params = new URLSearchParams(currentParams);
        params.set('page', newPage);
        window.location.search = params.toString();
      }

      // Search input events
      document.getElementById('searchInput').addEventListener('input', debounceSearch);

      document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault(); // Prevent form submission
          performSearch();
        }
      });

      document.getElementById('sortFilter').addEventListener('change', function() {
        const newParams = { sort: this.value };
        window.location.search = buildQuery(newParams);
      });

      // Filter Button Logic
      const filterBtn = document.querySelector('.filter-btn');

      function hasModalFilters() {
        const params = new URLSearchParams(window.location.search);
        return params.has('minPrice') || params.has('maxPrice') || params.has('brands') || params.has('concentrations');
      }

      function clearModalFilters() {
        const clearParams = { minPrice: '', maxPrice: '', brands: '', concentrations: '' };
        window.location.search = buildQuery(clearParams);
      }

      function updateFilterButton() {
        const hasFilters = hasModalFilters();
        filterBtn.textContent = hasFilters ? 'CLEAR' : 'FILTER';
        filterBtn.onclick = hasFilters ? clearModalFilters : openFilterModal;
      }

      // Call on load
      updateFilterButton();
      
       // Modal functions
       function openFilterModal() {
        document.getElementById('filterModal').style.display = 'block';
      }

      function closeFilterModal() {
        document.getElementById('filterModal').style.display = 'none';
      }

      // Close modal on outside click
      window.onclick = function(event) {
        const modal = document.getElementById('filterModal');
        if (event.target === modal) {
          closeFilterModal();
        }
      }

      function toggleMoreBrands(event) {
        const moreBrands = document.getElementById('moreBrands');
        const btn = event.target;
        if (moreBrands.classList.contains('brands-hidden')) {
          moreBrands.classList.remove('brands-hidden');
          btn.textContent = 'Show Less';
        } else {
          moreBrands.classList.add('brands-hidden');
          btn.textContent = 'Show More';
        }
      }

      function applyFilters() {
        const minP = document.getElementById('minPriceSelect').value;
        const maxP = document.getElementById('maxPriceSelect').value;
        const checkboxes = document.querySelectorAll('.filter-group input[type="checkbox"]:checked');
        let selectedBrands = [];
        let selectedConcs = [];
        checkboxes.forEach(cb => {
          const group = cb.closest('.filter-group').querySelector('h3').textContent;
          if (group === 'Brands') {
            selectedBrands.push(cb.value);
          } else if (group === 'Concentration') {
            selectedConcs.push(cb.value);
          }
        });

        let newParams = {};
        if (minP && minP !== '') newParams.minPrice = minP;
        if (maxP && maxP !== '') newParams.maxPrice = maxP;
        if (selectedBrands.length > 0) {
          newParams.brands = selectedBrands.join(',');
        }
        if (selectedConcs.length > 0) {
          newParams.concentrations = selectedConcs.join(',');
        }

        window.location.search = buildQuery(newParams);
        closeFilterModal();
      }

      function clearFilters() {
        // Reset selects
        document.getElementById('minPriceSelect').selectedIndex = 0;
        document.getElementById('maxPriceSelect').selectedIndex = 0;
        // Reset checkboxes
        document.querySelectorAll('.filter-group input[type="checkbox"]').forEach(cb => {
          cb.checked = false;
        });
        // Hide more brands
        document.getElementById('moreBrands').classList.add('brands-hidden');
        const showMoreBtn = document.querySelector('.show-more-btn');
        if (showMoreBtn) showMoreBtn.textContent = 'Show More';
        // Clear params
        const clearParams = { minPrice: '', maxPrice: '', brands: '', concentrations: '' };
        window.location.search = buildQuery(clearParams);
        closeFilterModal();
      }
      
      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `
          <span>${message}</span>
          <button class="close" onclick="const t=this.closest('.toast'); t.classList.add('fadeOut'); setTimeout(() => { if (t.parentElement) t.parentElement.removeChild(t); }, 300);">&times;</button>
        `;
        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('fadeOut');
          setTimeout(() => {
            if (container.contains(toast)) {
              container.removeChild(toast);
            }
          }, 300);
        }, 5000);
      }

      function toggleWishlist(event) {
        event.stopPropagation(); // Prevent link navigation
        const button = event.currentTarget;
        const productId = button.dataset.productId;
        const isActive = button.classList.contains('active');
        const url = isActive ? `/wishlist/remove/${productId}` : `/wishlist/add/${productId}`;

        fetch(url, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({})
        })
        .then(res => {
          if (!res.ok) {
            throw new Error('Network response was not ok');
          }
          return res.json();
        })
        .then(data => {
          if (data.redirect) {
            window.location.href = data.redirect;
            return;
          }
          if (data.success) {
            button.classList.toggle('active');
            const icon = button.querySelector('i');
            icon.classList.toggle('far');
            icon.classList.toggle('fas');
            button.title = isActive ? 'Add to Wishlist' : 'Remove from Wishlist';
            showToast(data.message || (isActive ? 'Removed from wishlist!' : 'Added to wishlist!'), 'success');
          } else {
            showToast(data.message || 'Failed to update wishlist.', 'error');
            // Revert UI if failed
            if (isActive) {
              button.classList.add('active');
              const icon = button.querySelector('i');
              if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas');
              }
            } else {
              button.classList.remove('active');
              const icon = button.querySelector('i');
              if (icon.classList.contains('fas')) {
                icon.classList.remove('fas');
                icon.classList.add('far');
              }
            }
          }
        })
        .catch(err => {
          console.error('Error:', err);
          showToast('An error occurred. Please try again.', 'error');
          // Revert UI on error
          if (isActive) {
            button.classList.add('active');
            const icon = button.querySelector('i');
            if (icon.classList.contains('far')) {
              icon.classList.remove('far');
              icon.classList.add('fas');
            }
          } else {
            button.classList.remove('active');
            const icon = button.querySelector('i');
            if (icon.classList.contains('fas')) {
              icon.classList.remove('fas');
              icon.classList.add('far');
            }
          }
        });
      }
    </script>
  </body>
</html>
