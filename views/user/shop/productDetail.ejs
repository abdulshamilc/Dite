<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %> - Dité</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "yellow-500": "#eab308",
              "yellow-600": "#ca8a04",
            },
          },
        },
      };
    </script>
    <link rel="stylesheet" href="/style/user/shop/productDetail.css">
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        #priceSection, #priceSection span {
            font-family: Arial, sans-serif !important;
        }
    </style>
  </head>
  <body class="min-h-screen bg-black text-white px-10">
    <%- include("../../partials/user/header") %>

    <main class="pt-20">
      <!-- Error Alert handled via SweetAlert below -->

      <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Product Images -->
          <div class="space-y-4">
            <div id="imageContainer" class="aspect-[3/4] gradient-bg rounded-lg overflow-hidden relative group cursor-none">
              <img
                id="mainImage"
                src="<%= product.images && product.images.length > 0 ? product.images[0] : '/images/placeholder.png' %>"
                alt="<%= product.name %>"
                class="w-full h-full object-cover"
              />
              <div id="magnifierLens" class="hidden absolute border-2 border-yellow-500 rounded-lg pointer-events-none z-10 bg-no-repeat bg-cover" 
                   style="width: 250px; height: 250px; box-shadow: 0 0 10px rgba(0,0,0,0.5);">
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4">
              <% if (product.images) { %>
              <% product.images.forEach((image, index) => { %>
              <button
                onclick="changeImage('<%= image %>', <%= index %>)"
                class="thumbnail aspect-square rounded-lg overflow-hidden border-2 transition-colors <%= index === 0 ? 'border-yellow-500' : 'border-gray-700' %>"
                data-index="<%= index %>"
              >
                <img
                  src="<%= image %>"
                  alt="<%= product.name %> view <%= index + 1 %>"
                  class="w-full h-full object-cover"
                />
              </button>
              <% }) %>
              <% } %>
            </div>
          </div>

          <!-- Product Info -->
          <div class="space-y-8">
            <div>
              <h1 class="text-4xl font-bold mb-4"><%= product.name %></h1>
              <h3 class="text-gray-400 mb-6"><%= product.concentration %></h3>
              <p class="text-gray-400 mb-6">
                This product comes in <%= product.variants.length %> variants
              </p>

              <!-- Variant Selection -->
              <div class="flex gap-3 mb-8">
                <% product.variants.forEach((variant, index) => { %>
                <button
                  onclick="selectSize('<%= variant.mlSize %>', <%= variant.discountedPrice %>, <%= variant.basePrice %>, <%= variant.stock %>)"
                  class="size-btn px-4 py-2 rounded-md border transition-colors <%= index === 0 ? 'bg-yellow-500 text-black border-yellow-500' : 'bg-gray-800 text-white border-gray-600 hover:border-gray-500' %>"
                  data-size="<%= variant.mlSize %>"
                >
                  <%= variant.mlSize %> ml
                </button>
                <% }) %>
              </div>

              <!-- Special Offers -->
              <% if (typeof activeOffers !== 'undefined' && activeOffers && activeOffers.length > 0) { %>
                <div class="mb-8 p-4 bg-gray-900 border border-yellow-500/30 rounded-lg">
                  <h4 class="text-yellow-500 font-bold mb-2 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                    </svg>
                    Special Offers Available!
                  </h4>
                  <ul class="space-y-2">
                    <% activeOffers.forEach(offer => { %>
                      <li class="text-sm text-gray-300">
                        <span class="font-semibold text-white"><%= offer.name %>:</span>
                        <%= offer.discountType === 'percentage' ? offer.discountValue + '% Off' : 'Flat ₹' + offer.discountValue + ' Off' %>
                        <% if(offer.description) { %> - <span class="text-gray-400 italic"><%= offer.description %></span><% } %>
                        <div class="mt-1 text-xs text-red-400 flex items-center gap-1">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                             <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                          </svg>
                          Ends in: <%= new Date(offer.endDate).toLocaleDateString() %>
                        </div>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              <% } %>

             <!-- Price -->
<div id="priceSection" class="text-3xl font-bold mb-8">
  <% if (product.variants.length > 0) { %>
    <% if (product.variants[0].stock > 0 ) { %>
      <span class="text-yellow-500">
        ₹<%= typeof product.variants[0].discountedPrice !== 'undefined' && product.variants[0].discountedPrice !== null ? product.variants[0].discountedPrice.toFixed(2) : 'N/A' %>
      </span>
      <% if (product.variants[0].discountedPrice < product.variants[0].basePrice) { %>
        <span class="line-through text-gray-500 ml-2">
          ₹<%= typeof product.variants[0].basePrice !== 'undefined' && product.variants[0].basePrice !== null ? product.variants[0].basePrice.toFixed(2) : 'N/A' %>
        </span>
      <% } %>
    <% } else { %>
      <span class="text-red-600 font-semibold">Out of Stock</span>
    <% } %>
  <% } else { %>
    <span class="text-gray-400">No price available</span>
  <% } %>
</div>


              <!-- Action Buttons -->
              <div class="space-y-4 mb-8">
                  <!-- Quantity Selection -->
                  <div class="flex items-center gap-3 mb-4">
                    <label for="quantityInput" class="text-sm font-medium text-gray-300">Quantity:</label>
                    <input
                      type="number"
                      id="quantityInput"
                      name="quantity"
                      value="1"
                      min="1"
                      class="bg-gray-800 text-white border border-gray-600 rounded-md px-2 py-1 w-12 focus:outline-none focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500"
                    />
                  </div>
                  
                  <button 
                    onclick="addToCart('<%= product._id %>')"
                    id="addToCartBtn"
                    class="w-full font-medium py-3 px-4 rounded-md transition-colors <%= (!product.isListed || product.isDeleted) ? 'bg-gray-600 cursor-not-allowed text-white' : 'bg-yellow-500 hover:bg-yellow-600 text-black' %>"
                    <%= (!product.isListed || product.isDeleted) ? 'disabled' : '' %>
                  >
                    <%= (!product.isListed || product.isDeleted) ? 'Currently Unavailable' : 'ADD TO CART' %>
                  </button>
                  <input type="hidden" id="selectedVariantSize" value="<%= product.variants[0].mlSize %>">

                <% if (typeof isInWishlist !== 'undefined' && isInWishlist) { %>
                <button
                  id="wishlistBtn"
                  onclick="removeFromWishlist('<%= product._id %>')"
                  class="w-full border border-red-500 text-red-500 hover:bg-red-500/10 bg-transparent py-3 px-4 rounded-md transition-colors"
                >
                  REMOVE FROM WISHLIST
                </button>
                <% } else { %>
                <button
                  id="wishlistBtn"
                  onclick="addToWishlist('<%= product._id %>')"
                  class="w-full border border-gray-600 text-white hover:bg-gray-800 bg-transparent py-3 px-4 rounded-md transition-colors"
                >
                  ADD TO WISHLIST
                </button>
                <% } %>
              </div>

              <!-- Tabs: Description, Notes, Reviews -->
              <div class="space-y-8 border-t border-gray-800 pt-8">
                <div class="flex border-b border-gray-700 pb-4">
                  <button id="descriptionTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 border-b-2 border-yellow-500 text-yellow-500">
                    Description
                  </button>
                  <button id="notesTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 text-gray-400 hover:text-white transition-colors border-b-2 border-transparent">
                    Notes
                  </button>
                  <button id="reviewsTab" class="tab-btn text-lg font-semibold flex-1 text-center py-2 text-gray-400 hover:text-white transition-colors border-b-2 border-transparent">
                    Reviews
                  </button>
                </div>

                <!-- Description -->
                <div id="descriptionContent" class="tab-content space-y-6">
                  <div class="text-gray-300 leading-relaxed">
                    <p><%= product.description %></p>
                  </div>
                </div>

                <!-- Notes -->
                <div id="notesContent" class="tab-content space-y-6 hidden">
                  <div class="text-gray-300 leading-relaxed">
                    <%= product.notes %>
                  </div>
                </div>

                <!-- Reviews -->
                <!-- Reviews -->
                <div id="reviewsContent" class="tab-content space-y-8 hidden">
                  
                  <!-- Review Summary Section -->
                  <% if (typeof reviewStats !== 'undefined') { %>
                  <div class="bg-gray-900/50 rounded-xl p-8 border border-gray-800 max-w-2xl mx-auto">
                      <!-- Average Rating Header -->
                      <div class="text-center mb-8">
                          <h2 class="text-6xl font-bold text-indigo-500 mb-2"><%= reviewStats.averageRating %></h2>
                          <div class="flex justify-center gap-1 mb-2">
                              <% 
                              const avg = Math.round(reviewStats.averageRating);
                              for(let i=1; i<=5; i++) { 
                              %>
                                  <svg class="w-6 h-6 <%= i <= avg ? 'text-yellow-500 fill-current' : 'text-gray-600' %>" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.817a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"></path>
                                  </svg>
                              <% } %>
                          </div>
                          <p class="text-gray-400 font-medium">Product Rating</p>
                      </div>

                      <!-- Distribution Bars -->
                      <div class="space-y-3">
                          <% for(let star=5; star>=1; star--) { %>
                          <div class="flex items-center gap-4">
                              <!-- Bar -->
                              <div class="flex-1 h-2 bg-gray-700 rounded-full overflow-hidden">
                                  <div class="h-full bg-green-500 rounded-full" style="width: <%= reviewStats.percentages[star] %>%"></div>
                              </div>
                              
                              <!-- Stars -->
                              <div class="flex gap-0.5 min-w-[80px]">
                                  <% for(let i=1; i<=5; i++) { %>
                                    <svg class="w-3 h-3 <%= i <= star ? 'text-yellow-500 fill-current' : 'text-gray-600' %>" viewBox="0 0 24 24">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                                    </svg>
                                  <% } %>
                              </div>
                              
                              <!-- Count -->
                              <span class="text-blue-500 font-medium min-w-[30px] text-right"><%= reviewStats.starCounts[star] %></span>
                          </div>
                          <% } %>
                      </div>
                  </div>
                  <% } %>

                  <!-- Reviews List -->
                  <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
                    <div class="space-y-6 mt-12">
                    <% reviews.forEach(review => { %>
                      <div class="bg-transparent p-0 border-b border-gray-800 pb-8 last:border-0">
                        <!-- 1. Stars -->
                        <div class="flex items-center gap-1 mb-3">
                          <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-5 h-5 <%= i <= review.rating ? 'text-yellow-500 fill-current' : 'text-gray-600' %>" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.817a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"></path>
                            </svg>
                          <% } %>
                        </div>

                        <!-- 2. User Info & Date -->
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <h4 class="text-lg font-bold text-white"><%= review.userName %></h4>
                            </div>
                            <span class="text-sm text-gray-500"><%= new Date(review.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>

                        <!-- 3. Review Text -->
                        <p class="text-gray-300 text-base leading-relaxed pl-1"><%= review.review %></p>
                      </div>
                    <% }) %>
                    </div>
                  <% } else { %>
                    <div class="text-center py-12">
                      <p class="text-gray-400 text-lg">No reviews yet. Be the first to share your experience!</p>
                    </div>
                  <% } %>
                </div>

                <!-- Brand Info -->
                <div class="pt-8 border-t border-gray-800">
                  <h3 class="text-lg font-semibold mb-3 text-yellow-500">About <%= product.brand %></h3>
                  <p class="text-gray-300 leading-relaxed"><%= product.brandDescription || 'Discover the luxury and elegance of ' + product.brand %></p>
                </div>

                <!-- Simple Return Policy -->
                <div class="pt-6 border-t border-gray-800 flex items-start gap-3 text-gray-300">
                    <i class="fas fa-undo text-yellow-500 mt-1"></i>
                    <div class="flex flex-col">
                        <span class="font-medium text-white">7 Days Return Policy</span>
                        <span class="text-sm text-gray-400">Easy return within 7 days of delivery</span>
                    </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Suggestions -->
        <section class="border-t border-gray-800 py-20">
          <div class="w-full px-4 sm:px-8 md:px-12">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Suggestions</h2>
            <div class="grid grid-cols-3 gap-3 sm:gap-5 md:gap-8">
              <% if (suggestions && suggestions.length > 0) { %>
                <% suggestions.forEach(item => { %>
                  <a href="/shop/<%= item._id %>">
                  <div class="group cursor-pointer">
                    <div class="aspect-[2/3] gradient-bg rounded-xl overflow-hidden mb-4 md:mb-6">
                      <img
                        src="<%= item.images && item.images.length > 0 ? item.images[0] : '/images/placeholder.png' %>"
                        alt="<%= item.name %>"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    </div>
                    <h3 class="text-sm sm:text-base md:text-xl font-medium mb-1 md:mb-3 line-clamp-2"><%= item.name %></h3>
                    <p class="text-yellow-500 font-bold text-sm sm:text-base md:text-lg">
                      ₹<%= item.variants && item.variants.length > 0 && typeof item.variants[0].discountedPrice !== 'undefined' && item.variants[0].discountedPrice !== null ? item.variants[0].discountedPrice.toFixed(2) : 'N/A' %>
                    </p>
                  </div>
                  </a>
                <% }) %>
              <% } else { %>
                <p class="text-gray-400 col-span-3 text-center">No suggestions available</p>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="mt-16">
      <%- include("../../partials/user/footer") %>
    </footer>

    <!-- JS -->
    <script>
      const totalInCart = <%= totalCartQty %>;
      const MAX_CART_LIMIT = 10;
      const isProductAvailable = <%= product.isListed && !product.isDeleted %>;

      function changeImage(src, index) {
        document.getElementById("mainImage").src = src;
        document.querySelectorAll(".thumbnail").forEach((thumb, i) => {
          thumb.classList.remove("border-yellow-500");
          thumb.classList.add("border-gray-700");
          if (i === index) {
            thumb.classList.add("border-yellow-500");
            thumb.classList.remove("border-gray-700");
          }
        });
      }

      function getEffectiveMax(stock) {
         // The global limit is strict: Total items in cart <= MAX_CART_LIMIT.
         // Effectively, we can only add (MAX - CurrentTotal) items.
         // Note: If we are just browsing, we don't know if we are 'adding' distinct items or not, 
         // but simply, the 'addable amount' is remaining capacity.
         
         const remainingCapacity = Math.max(0, MAX_CART_LIMIT - totalInCart);
         return Math.min(stock, remainingCapacity);
      }

      function updatePriceDisplay(discountedPrice, basePrice, stock, quantity) {
        const priceSection = document.getElementById("priceSection");
        const addButton = document.getElementById("addToCartBtn");
        
        const currentSize = window.currentSize; 
        const effectiveMax = getEffectiveMax(stock, currentSize);
        
        const isOutOfStock = (stock === 0); 
        const isLimitReached = (quantity > effectiveMax); // Should be prevented by input clamp, but good for safety
        
        if (!isProductAvailable) {
          priceSection.innerHTML = '<span class="text-red-500 font-semibold">Currently Unavailable</span>';
          addButton.disabled = true;
          addButton.textContent = 'Currently Unavailable';
          addButton.classList.remove('bg-yellow-500', 'hover:bg-yellow-600', 'text-black');
          addButton.classList.add('bg-gray-600', 'cursor-not-allowed', 'text-white');
        } else if (isOutOfStock) {
          priceSection.innerHTML = '<span class="text-red-600 font-semibold">Out of Stock</span>';
          addButton.disabled = true;
          addButton.textContent = 'Out of Stock';
          addButton.classList.remove('bg-yellow-500', 'hover:bg-yellow-600', 'text-black');
          addButton.classList.add('bg-gray-600', 'cursor-not-allowed', 'text-white');
        } else if (effectiveMax === 0) {
           priceSection.innerHTML = `<span class="text-yellow-500">You have ${MAX_PER_PRODUCT} of this item in cart</span>`;
           addButton.disabled = true;
           addButton.textContent = 'Limit Reached';
           addButton.classList.remove('bg-yellow-500', 'hover:bg-yellow-600', 'text-black');
           addButton.classList.add('bg-gray-600', 'cursor-not-allowed');
        } else {
           let html = `<span class="text-yellow-500">₹${typeof discountedPrice !== 'undefined' && discountedPrice !== null ? discountedPrice.toFixed(2) : 'N/A'}</span>`;
           if (discountedPrice < basePrice) {
             html += `<span class="line-through text-gray-500 ml-2">₹${typeof basePrice !== 'undefined' && basePrice !== null ? basePrice.toFixed(2) : 'N/A'}</span>`;
           }
           priceSection.innerHTML = html;
           
           if (isLimitReached) {
             addButton.disabled = true;
             addButton.textContent = `Max ${effectiveMax} allowed`;
              addButton.classList.remove('bg-yellow-500', 'hover:bg-yellow-600', 'text-black');
              addButton.classList.add('bg-gray-600', 'cursor-not-allowed');
           } else {
             addButton.disabled = false;
             addButton.textContent = 'ADD TO CART';
             addButton.classList.remove('bg-gray-600', 'cursor-not-allowed');
             addButton.classList.add('bg-yellow-500', 'hover:bg-yellow-600', 'text-black');
           }
        }
      }

      function selectSize(size, discountedPrice, basePrice, stock) {
        document.querySelectorAll(".size-btn").forEach((btn) => {
          btn.classList.remove(
            "bg-yellow-500",
            "text-black",
            "border-yellow-500"
          );
          btn.classList.add("bg-gray-800", "text-white", "border-gray-600");
          if (btn.dataset.size === size) {
            btn.classList.add(
              "bg-yellow-500",
              "text-black",
              "border-yellow-500"
            );
          }
        });

        window.currentDiscounted = discountedPrice;
        window.currentBase = basePrice;
        window.currentStock = stock;
        window.currentSize = size;

        const quantityInput = document.getElementById('quantityInput');
        const effectiveMax = getEffectiveMax(stock, size);
        quantityInput.max = effectiveMax;
        
        let currentVal = parseInt(quantityInput.value) || 1;
        if (currentVal > effectiveMax) {
           quantityInput.value = effectiveMax > 0 ? effectiveMax : 1; 
        }
        
        updatePriceDisplay(discountedPrice, basePrice, stock, parseInt(quantityInput.value));
        document.getElementById("selectedVariantSize").value = size;
      }

      document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
          tab.addEventListener('click', function() {
            const target = this.id.replace('Tab', 'Content');
            tabs.forEach(t => {
              t.classList.remove('border-yellow-500', 'text-yellow-500');
              t.classList.add('text-gray-400', 'border-transparent');
            });
            this.classList.add('border-yellow-500', 'text-yellow-500');
            this.classList.remove('text-gray-400', 'border-transparent');
            contents.forEach(content => content.classList.add('hidden'));
            const targetContent = document.getElementById(target);
            if (targetContent) targetContent.classList.remove('hidden');
          });
        });

        // Initialize current values for first variant
        const firstVariantSize = "<%= product.variants.length > 0 ? product.variants[0].mlSize : '' %>";
        window.currentSize = firstVariantSize;
        window.currentDiscounted = <%= product.variants.length > 0 ? product.variants[0].discountedPrice : 0 %>;
        window.currentBase = <%= product.variants.length > 0 ? product.variants[0].basePrice : 0 %>;
        window.currentStock = <%= product.variants.length > 0 ? product.variants[0].stock : 0 %>;

        // Quantity input handler
        const quantityInput = document.getElementById('quantityInput');
        
        // Initial setup
        const initialMax = getEffectiveMax(window.currentStock, window.currentSize);
        quantityInput.max = initialMax;
        updatePriceDisplay(window.currentDiscounted, window.currentBase, window.currentStock, 1);

        quantityInput.addEventListener('input', function() {
          let q = parseInt(this.value) || 1;
          const effectiveMax = getEffectiveMax(window.currentStock, window.currentSize);

          if (q < 1) {
            q = 1;
            this.value = 1;
          }
          // Clamp to effective max
          if (q > effectiveMax && effectiveMax > 0) {
             q = effectiveMax;
             this.value = effectiveMax;
          }

          if (window.currentStock !== undefined) {
            updatePriceDisplay(window.currentDiscounted, window.currentBase, window.currentStock, q);
          }
        });

        // Magnifying Lens Logic
        const container = document.getElementById('imageContainer');
        const img = document.getElementById('mainImage');
        const lens = document.getElementById('magnifierLens');
        const LENS_SIZE = 250; // Match the style width/height

        if (container && img && lens) {
            
            container.addEventListener('mousemove', function(e) {
                // Ensure lens is visible for calculations if needed, though we use const now
                lens.classList.remove('hidden');

                const rect = container.getBoundingClientRect();
                let x = e.clientX - rect.left;
                let y = e.clientY - rect.top;

                // Position lens centered on cursor
                let left = x - (LENS_SIZE / 2);
                let top = y - (LENS_SIZE / 2);

                // Boundary checks to keep lens strictly inside the image container
                if (left < 0) left = 0;
                if (top < 0) top = 0;
                if (left + LENS_SIZE > rect.width) left = rect.width - LENS_SIZE;
                if (top + LENS_SIZE > rect.height) top = rect.height - LENS_SIZE;

                // Set lens position
                lens.style.left = left + 'px';
                lens.style.top = top + 'px';

                // Calculate ratio
                const ZOOM = 2.5;
                
                // Correct formula for lens "looking" at the image at cursor position (x, y):
                // We want the center of the lens (LENS_SIZE/2) to display the pixel 'x' from the original image.
                // The background is scaled by ZOOM.
                // Lens_Pixel_Value = (Lens_Coord - Bg_Pos) / ZOOM
                // We want: x = (LENS_SIZE/2 - Bg_Pos) / ZOOM
                // => x * ZOOM = LENS_SIZE/2 - Bg_Pos
                // => Bg_Pos = LENS_SIZE/2 - (x * ZOOM)
                
                const bgX = (LENS_SIZE / 2) - (x * ZOOM);
                const bgY = (LENS_SIZE / 2) - (y * ZOOM);

                lens.style.backgroundImage = `url('${img.src}')`;
                lens.style.backgroundSize = `${rect.width * ZOOM}px ${rect.height * ZOOM}px`;
                lens.style.backgroundPosition = `${bgX}px ${bgY}px`;
            });

            container.addEventListener('mouseenter', function() {
                lens.classList.remove('hidden');
            });

            container.addEventListener('mouseleave', function() {
                lens.classList.add('hidden');
            });
        }
      });

      function showLoginPrompt() {
          Swal.fire({
              title: 'Login Required',
              text: 'Please login to continue',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#eab308',
              cancelButtonColor: '#d33',
              confirmButtonText: 'Login',
              background: '#1a1a1a',
              color: '#ffffff'
          }).then((result) => {
              if (result.isConfirmed) {
                  window.location.href = '/login';
              }
          });
      }

      function addToCart(productId) {
        const quantity = document.getElementById('quantityInput').value;
        const variantSize = document.getElementById('selectedVariantSize').value;

        fetch('/cart/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ 
            productId: productId,
            quantity: quantity,
            variantSize: variantSize
          })
        })
        .then(response => {
            if (response.redirected && response.url.includes('/login')) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            // If server returns JSON even on 401
            if (response.status === 401) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            return response.json();
        })
        .then(data => {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Added to Cart!',
              text: data.message || 'Product added to your cart',
              showConfirmButton: false,
              timer: 1500,
              background: '#1a1a1a', 
              color: '#ffffff'
            });
          } else {
             if (data.redirect) {
                if (data.redirect.includes('login')) {
                    showLoginPrompt();
                } else {
                    window.location.href = data.redirect;
                }
             } else {
                Swal.fire({
                  icon: 'error',
                  title: 'Oops...',
                  text: data.message || 'Could not add to cart',
                  background: '#1a1a1a', 
                  color: '#ffffff',
                  // Handle specific case where backend sends success: false but message is login required
                  didClose: () => {
                     if (data.message && (data.message.toLowerCase().includes('login') || data.message.toLowerCase().includes('authenticated'))) {
                         showLoginPrompt();
                     }
                  }
                });
             }
          }
        })
        .catch(error => {
          console.error('Error:', error);
          if (error.message !== 'Login required') {
             // Handle actual parsing error (e.g. if HTML returned but not detected as redirect)
             if (error.name === 'SyntaxError') {
                 // Likely HTML returned instead of JSON -> login page?
                 showLoginPrompt();
             } else {
                 Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong. Please try again.',
                    background: '#1a1a1a', 
                    color: '#ffffff'
                 });
             }
          }
        });
      }

      function addToWishlist(productId) {
        fetch('/wishlist/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ productId: productId })
        })
        .then(response => {
             if (response.redirected && response.url.includes('/login')) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            if (response.status === 401) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            return response.json();
        })
        .then(data => {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Added!',
              text: data.message || 'Product added to wishlist',
              showConfirmButton: false,
              timer: 1500,
              background: '#1a1a1a', 
              color: '#ffffff',
              didClose: () => {
                  location.reload();
              }
            });
          } else {
            if (data.redirect) {
               if (data.redirect.includes('login')) {
                    showLoginPrompt();
                } else {
                    window.location.href = data.redirect;
                }
            } else {
              Swal.fire({
                icon: 'info',
                title: 'Note',
                text: data.message,
                background: '#1a1a1a',
                color: '#ffffff',
                didClose: () => {
                     if (data.message && (data.message.toLowerCase().includes('login') || data.message.toLowerCase().includes('authenticated'))) {
                         showLoginPrompt();
                     }
                  }
              });
            }
          }
        })
        .catch(error => {
          console.error('Error:', error);
          if (error.message !== 'Login required') {
              if (error.name === 'SyntaxError') {
                 showLoginPrompt();
             } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Something went wrong!',
                    background: '#1a1a1a',
                    color: '#ffffff'
                });
             }
          }
        });
      }
      
      function removeFromWishlist(productId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you really want to remove this product from your wishlist?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#eab308',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, remove it!',
            cancelButtonText: 'No, keep it',
            background: '#1a1a1a',
            color: '#ffffff'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/wishlist/remove/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.redirected && response.url.includes('/login')) {
                        showLoginPrompt();
                        throw new Error('Login required');
                    }
                    if (response.status === 401) {
                        showLoginPrompt();
                        throw new Error('Login required');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Removed!',
                            text: data.message || 'Product removed from wishlist',
                            showConfirmButton: false,
                            timer: 1500,
                            background: '#1a1a1a', 
                            color: '#ffffff',
                            didClose: () => {
                               location.reload(); 
                            }
                        });
                    } else {
                         if (data.redirect) {
                            if (data.redirect.includes('login')) {
                                showLoginPrompt();
                            } else {
                                window.location.href = data.redirect;
                            }
                         } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: data.message || 'Could not remove from wishlist',
                                background: '#1a1a1a', 
                                color: '#ffffff'
                            });
                         }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    if (error.message !== 'Login required') {
                        if (error.name === 'SyntaxError') {
                           showLoginPrompt();
                       } else {
                          Swal.fire({
                              icon: 'error',
                              title: 'Oops...',
                              text: 'Something went wrong!',
                              background: '#1a1a1a',
                              color: '#ffffff'
                          });
                       }
                    }
                });
            }
        });
      }

      // Check for server-side error and display via SweetAlert
      <% if (typeof error !== 'undefined' && error) { %>
        document.addEventListener('DOMContentLoaded', () => {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: <%- JSON.stringify(error) %>,
            background: '#1a1a1a', 
            color: '#ffffff',
            confirmButtonColor: '#eab308'
          });
        });
      <% } %>
    </script>
    <%- include("../../partials/user/footer") %>
  </body>
</html>