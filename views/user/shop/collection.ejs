<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dité - Categories</title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/shop/collection.css">
  </head>
  <body>
    <!-- Header -->
    <%- include("../../partials/user/header") %>

    <!-- Categories Section -->
    <section class="categories-section">
      <div class="container">
        <h1 class="categories-title">Categories</h1>
        <p class="categories-subtitle">
          Browse our premium products, organized by gender and category for your
          style and preference.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <main class="container">
      <!-- Men Category -->
      <% if (products.some(product => product.gender === 'MEN')) { %>
      <section class="category-section">
        <a href="/shop/men">
          <h2 class="category-heading">Men</h2>
        </a>
        <div class="product-list">
          <% let menProducts = products.filter(product => product.gender ===
          'MEN').slice(0, 5); %> <% menProducts.forEach(product => { %>
          <a href="shop/<%=product._id%>">
            <div class="product-item">
              <button
                class="wishlist-btn"
                title="Add to Wishlist"
                onclick="toggleWishlist(this)"
              >
                <i class="far fa-heart"></i>
              </button>
              <img
                src="<%= product.images[0] %>"
                alt="<%= product.name %>"
                class="product-image"
              />
              <div class="product-info">
                <h3 class="product-name"><%= product.name %></h3>
              </div>
            </div>
          </a>
          <% }); %> 
          <!-- "More" only shows if >5 men products exist -->
          <% if (products.filter(product => product.gender ===
          'MEN').length > 5) { %>
          <a href="/shop/men">
            <div class="more-item">
              <div class="more-content">
                <p class="more-text">More</p>
              </div>
            </div>
          </a>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Women Category -->
      <% if (products.some(product => product.gender === 'WOMEN')) { %>
      <section class="category-section">
        <a href="/shop/women">
          <h2 class="category-heading">Women</h2>
        </a>
        <div class="product-list">
          <% let womenProducts = products.filter(product => product.gender ===
          'WOMEN').slice(0, 5); %> <% womenProducts.forEach(product => { %>
          <a href="shop/<%=product._id%>">
            <div class="product-item">
              <button
                class="wishlist-btn"
                title="Add to Wishlist"
                onclick="toggleWishlist(this)"
              >
                <i class="far fa-heart"></i>
              </button>
              <img
                src="<%= product.images[0] %>"
                alt="<%= product.name %>"
                class="product-image"
              />
              <div class="product-info">
                <h3 class="product-name"><%= product.name %></h3>
              </div>
            </div>
          </a>
          <% }); %> 
          <!-- "More" only shows if >5 women products exist -->
          <% if (products.filter(product => product.gender ===
          'WOMEN').length > 5) { %>
          <a href="/shop/women">
            <div class="more-item">
              <div class="more-content">
                <p class="more-text">More</p>
              </div>
            </div>
          </a>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Unisex Category -->
      <% if (products.some(product => product.gender === 'UNISEX')) { %>
      <section class="category-section">
        <a href="/shop/unisex">
          <h2 class="category-heading">Unisex</h2>
        </a>
        <div class="product-list">
          <% let unisexProducts = products.filter(product => product.gender ===
          'UNISEX').slice(0, 5); %> <% unisexProducts.forEach(product => { %>
          <a href="shop/<%=product._id%>">
            <div class="product-item">
              <button
                class="wishlist-btn"
                title="Add to Wishlist"
                onclick="toggleWishlist(this)"
              >
                <i class="far fa-heart"></i>
              </button>
              <img
                src="<%= product.images[0] %>"
                alt="<%= product.name %>"
                class="product-image"
              />
              <div class="product-info">
                <h3 class="product-name"><%= product.name %></h3>
              </div>
            </div>
          </a>
          <% }); %> 
          <!-- "More" only shows if >5 unisex products exist -->
          <% if (products.filter(product => product.gender ===
          'UNISEX').length > 5) { %>
          <a href="/shop/unisex">
            <div class="more-item">
              <div class="more-content">
                <p class="more-text">More</p>
              </div>
            </div>
          </a>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Dynamic Category Sections -->
      <% categories.forEach(category => { %> <% let validCategoryProducts =
      products.filter(product => category.products.includes(product._id)); %> <%
      if (validCategoryProducts.length > 0) { %>
      <section class="category-section">
        <a href="/categories/<%= category.name %>">
          <h2 class="category-heading"><%= category.name %></h2>
        </a>
        <div class="product-list">
          <% let categoryProducts = validCategoryProducts.slice(0, 5); %> <%
          categoryProducts.forEach(product => { %>
          <a href="shop/<%=product._id%>">
            <div class="product-item">
              <button
                class="wishlist-btn"
                title="Add to Wishlist"
                onclick="toggleWishlist(this)"
              >
                <i class="far fa-heart"></i>
              </button>
              <img
                src="<%= product.images[0] %>"
                alt="<%= product.name %>"
                class="product-image"
              />
              <div class="product-info">
                <h3 class="product-name"><%= product.name %></h3>
              </div>
            </div>
          </a>
          <% }); %> 
          <!-- "More" only shows if >5 products in this category exist -->
          <% if (validCategoryProducts.length > 5) { %>
          <a href="/categories/<%=category.name%>">
            <div class="more-item">
              <div class="more-content">
                <p class="more-text">More</p>
              </div>
            </div>
          </a>
          <% } %>
        </div>
      </section>
      <% } %> <% }); %>
    </main>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

    <script>
      function toggleWishlist(button) {
        button.classList.toggle("active");
        const icon = button.querySelector("i");
        icon.classList.toggle("far");
        icon.classList.toggle("fas");
      }
    </script>
  </body>
</html>