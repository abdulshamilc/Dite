<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Dité - Shop</title>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/shop/shop.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
    <style>
      .product-price, .base-price, .discounted-price {
        font-family: Arial, sans-serif !important;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <%- include("../../partials/user/header") %>

    <!-- Shop Section -->
    <section class="shop-section">
      <div class="container">
        <h1 class="shop-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Shop' %></h1>
        <p class="shop-subtitle">
          Discover our handpicked collection of premium products, crafted for style and quality.
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <main class="container">
      <% if (error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <!-- Search Section -->
      <div class="search-section">
        <form id="searchForm" style="width: 100%; max-width: 500px; margin: 0 auto;">
          <div class="search-bar">
            <input
              type="text"
              class="search-input"
              id="searchInput"
              name="search"
              placeholder="Search products..."
              value="<%= search %>"
            />
            <i class="fas <%= (search && search.trim() !== '') ? 'fa-times' : 'fa-search' %> search-icon" id="searchActionBtn"></i>
          </div>
        </form>
      </div>

      <!-- Filter Section -->
      <div class="filter-section">
        <form id="filterForm" style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; width: 100%;">
          <!-- Gender Filter - Always show as dropdown or active filter -->
          <% if (gender && gender !== 'ALL') { %>
            <button type="button" class="filter-btn" onclick="clearGender()" style="display: flex; align-items: center; justify-content: space-between;">
              <%= gender %> <i class="fas fa-times ml-2"></i>
            </button>
          <% } else { %>
            <select class="filter-dropdown" id="genderFilter" name="gender">
              <option value="ALL" <%= gender === 'ALL' ? 'selected' : '' %>>GENDER</option>
              <option value="MEN" <%= gender === 'MEN' ? 'selected' : '' %>>MEN</option>
              <option value="WOMEN" <%= gender === 'WOMEN' ? 'selected' : '' %>>WOMEN</option>
              <option value="UNISEX" <%= gender === 'UNISEX' ? 'selected' : '' %>>UNISEX</option>
            </select>
          <% } %>

          <!-- Sort Filter - Always show as dropdown or active filter -->
          <% if (sort && sort !== '') { 
               let sortLabel = 'SORT BY';
               if(sort === 'price_asc') sortLabel = 'Price: Low to High';
               else if(sort === 'price_desc') sortLabel = 'Price: High to Low';
               else if(sort === 'newest') sortLabel = 'Newest';
               else if(sort === 'popular') sortLabel = 'Most Popular';
          %>
            <button type="button" class="filter-btn" onclick="clearSort()" style="display: flex; align-items: center; justify-content: space-between;">
              <%= sortLabel %> <i class="fas fa-times ml-2"></i>
            </button>
          <% } else { %>
            <select class="filter-dropdown" id="sortFilter" name="sort">
              <option value="" <%= sort === '' ? 'selected' : '' %>>SORT BY</option>
              <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
              <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
            </select>
          <% } %>
          
          <!-- Filter Button to Open Modal -->
          <button type="button" class="filter-btn" id="filterButton">FILTER</button>
        </form>
      </div>

      <!-- Product Grid -->
      <div class="product-grid">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <% const isInWishlist = wishlist && wishlist.some(item => item.product && item.product._id.toString() === product._id.toString()); %>
            <a href="/shop/<%= product._id %>">
              <div class="product-card">
                <button class="wishlist-btn <%= isInWishlist ? 'active' : '' %>" data-product-id="<%= product._id %>" title="<%= isInWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>" onclick="toggleWishlist(event); return false;">
                  <i class="<%= isInWishlist ? 'fas' : 'far' %> fa-heart"></i>
                </button>
                <img
                  src="<%= product.images[0] %>"
                  alt="<%= product.name %>"
                  class="product-image"
                />
                <div class="product-info">
                  <h3 class="product-name"><%= product.name %></h3>
                  <div class="product-price">
                    <% if(product.variants[0].discountedPrice < product.variants[0].basePrice) { %>
                      <span class="base-price"><%= product.variants[0].basePrice %> Rs</span>
                    <% } %>
                    <span class="discounted-price"><%= product.variants[0].discountedPrice %> Rs</span>
                  </div>
                  <button class="shop-now-btn">Shop Now</button>
                </div>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 50px; color: #999;">
            No products found matching your criteria.
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <button 
            class="pagination-btn" 
            <%= page === 1 ? 'disabled' : '' %>
            onclick="updatePage('<%= page - 1 %>')"
          >‹ Previous</button>
          
          <% for (let i = 1; i <= totalPages; i++) { %>
            <div 
              class="pagination-dot <%= i === page ? 'active' : '' %>" 
              onclick="updatePage('<%= i %>')"
              title="Page <%= i %>"
            ></div>
          <% } %>
          
          <button 
            class="pagination-btn" 
            <%= page === totalPages ? 'disabled' : '' %>
            onclick="updatePage('<%= page + 1 %>')"
          >Next ›</button>
        </div>
      <% } %>
    </main>

    <!-- Filter Modal -->
    <div id="filterModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Filters</h2>
          <span class="close" onclick="closeFilterModal()">&times;</span>
        </div>
        <div class="modal-body">
          <!-- Price Range -->
          <div class="filter-group">
            <h3>Price Range</h3>
            <div class="price-selects">
              <div class="price-select-group">
                <label>From:</label>
                <select id="minPriceSelect" class="price-select">
                  <option value="" <%= (!queryMinPrice || queryMinPrice === '') ? 'selected' : '' %>>Lowest</option>
                  <% minPriceOptions.slice(1).forEach(option => { %>
                    <option value="<%= option %>" <%= (queryMinPrice == option) ? 'selected' : '' %>><%= option %> Rs</option>
                  <% }); %>
                </select>
              </div>
              <div class="price-select-group">
                <label>To:</label>
                <select id="maxPriceSelect" class="price-select">
                  <% maxPriceOptions.slice(0, -1).forEach(option => { %>
                    <option value="<%= option %>" <%= (queryMaxPrice == option) ? 'selected' : '' %>><%= option %> Rs</option>
                  <% }); %>
                  <option value="" <%= (!queryMaxPrice || queryMaxPrice === '') ? 'selected' : '' %>>Highest</option>
                </select>
              </div>
            </div>
          </div>
          <!-- Brands -->
          <div class="filter-group">
            <h3>Brands</h3>
            <% topBrands.forEach(brand => { %>
              <label class="checkbox-label">
                <input type="checkbox" value="<%= brand.toLowerCase() %>" <%= selectedBrands.map(b => b.toLowerCase()).includes(brand.toLowerCase()) ? 'checked' : '' %>>
                <%= brand %>
              </label>
            <% }); %>
            <div id="moreBrands" class="brands-hidden">
              <% otherBrands.forEach(brand => { %>
                <label class="checkbox-label">
                  <input type="checkbox" value="<%= brand.toLowerCase() %>" <%= selectedBrands.map(b => b.toLowerCase()).includes(brand.toLowerCase()) ? 'checked' : '' %>>
                  <%= brand %>
                </label>
              <% }); %>
            </div>
            <% if (otherBrands.length > 0) { %>
              <button type="button" class="show-more-btn" onclick="toggleMoreBrands(event)">Show More</button>
            <% } %>
          </div>
          <!-- Concentrations -->
          <div class="filter-group">
            <h3>Concentration</h3>
            <% concentrations.forEach(conc => { %>
              <label class="checkbox-label">
                <input type="checkbox" value="<%= conc.toLowerCase() %>" <%= selectedConcentrations.map(c => c.toLowerCase()).includes(conc.toLowerCase()) ? 'checked' : '' %>>
                <%= conc %>
              </label>
            <% }); %>
          </div>
        </div>
        <div class="modal-footer">
          <button onclick="clearFilters()">Clear</button>
          <button onclick="applyFilters()">Apply</button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

    <!-- Toast Container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      // Preserve current params for updates
      const currentParams = new URLSearchParams(window.location.search);
      const currentPage = '<%= page %>';
      let searchTimer;

      function buildQuery(newParams = {}) {
        const params = new URLSearchParams(currentParams);
        let shouldResetPage = false;
        Object.entries(newParams).forEach(([key, value]) => {
          if (value === 'ALL' || value === '' || value === null || value === undefined || !value) {
            params.delete(key);
          } else {
            params.set(key, value);
          }
          if (key !== 'page') {
            shouldResetPage = true;
          }
        });
        if (shouldResetPage) {
          params.set('page', 1);
        }
        return `?${params.toString()}`;
      }

      function performSearch() {
        clearTimeout(searchTimer);
        const searchVal = document.getElementById('searchInput').value;
        const newParams = { search: searchVal };
        window.location.search = buildQuery(newParams);
      }

      function clearSearch() {
        document.getElementById('searchInput').value = '';
        const newParams = { search: '' };
        window.location.search = buildQuery(newParams);
      }

      // Dynamic Icon Logic
      const searchInput = document.getElementById('searchInput');
      const searchActionBtn = document.getElementById('searchActionBtn');
      
      if (searchInput && searchActionBtn) {
          searchInput.addEventListener('input', function() {
              if (this.value.trim().length > 0) {
                  searchActionBtn.classList.remove('fa-search');
                  searchActionBtn.classList.add('fa-times');
              } else {
                  searchActionBtn.classList.remove('fa-times');
                  searchActionBtn.classList.add('fa-search');
              }
              debounceSearch();
          });
          
          searchActionBtn.addEventListener('click', function() {
              if (this.classList.contains('fa-times')) {
                  clearSearch();
              } else {
                  performSearch();
              }
          });
      }

      function debounceSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          performSearch();
        }, 500);
      }

      function updatePage(newPage) {
        const params = new URLSearchParams(currentParams);
        params.set('page', newPage);
        window.location.search = params.toString();
      }

      // Search input events handled in dynamic logic block above
      // document.getElementById('searchInput').addEventListener('input', debounceSearch);
      
      document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch();
        }
      });

      // Filter changes - only change if dropdown exists
      const genderFilter = document.getElementById('genderFilter');
      if (genderFilter) {
        genderFilter.addEventListener('change', function() {
          const newParams = { gender: this.value };
          window.location.search = buildQuery(newParams);
        });
      }

      const sortFilter = document.getElementById('sortFilter');
      if (sortFilter) {
        sortFilter.addEventListener('change', function() {
          const newParams = { sort: this.value };
          window.location.search = buildQuery(newParams);
        });
      }

      // Filter Button Logic
      const filterBtn = document.getElementById('filterButton');

      function hasModalFilters() {
        const params = new URLSearchParams(window.location.search);
        return params.has('minPrice') || params.has('maxPrice') || params.has('brands') || params.has('concentrations');
      }

      function clearModalFilters() {
        const clearParams = { minPrice: '', maxPrice: '', brands: '', concentrations: '' };
        window.location.search = buildQuery(clearParams);
      }

      function updateFilterButton() {
        const hasFilters = hasModalFilters();
        filterBtn.textContent = hasFilters ? 'CLEAR' : 'FILTER';
        filterBtn.onclick = hasFilters ? clearModalFilters : openFilterModal;
      }

      // Call on load
      updateFilterButton();

      // Modal functions
      function openFilterModal() {
        document.getElementById('filterModal').style.display = 'block';
      }

      function closeFilterModal() {
        document.getElementById('filterModal').style.display = 'none';
      }

      // Close modal on outside click
      window.onclick = function(event) {
        const modal = document.getElementById('filterModal');
        if (event.target === modal) {
          closeFilterModal();
        }
      }

      function toggleMoreBrands(event) {
        const moreBrands = document.getElementById('moreBrands');
        const btn = event.target;
        if (moreBrands.classList.contains('brands-hidden')) {
          moreBrands.classList.remove('brands-hidden');
          btn.textContent = 'Show Less';
        } else {
          moreBrands.classList.add('brands-hidden');
          btn.textContent = 'Show More';
        }
      }

      function applyFilters() {
        const minP = document.getElementById('minPriceSelect').value;
        const maxP = document.getElementById('maxPriceSelect').value;
        const checkboxes = document.querySelectorAll('.filter-group input[type="checkbox"]:checked');
        let selectedBrands = [];
        let selectedConcs = [];
        checkboxes.forEach(cb => {
          const group = cb.closest('.filter-group').querySelector('h3').textContent;
          if (group === 'Brands') {
            selectedBrands.push(cb.value);
          } else if (group === 'Concentration') {
            selectedConcs.push(cb.value);
          }
        });

        let newParams = {};
        if (minP && minP !== '') newParams.minPrice = minP;
        if (maxP && maxP !== '') newParams.maxPrice = maxP;
        if (selectedBrands.length > 0) {
          newParams.brands = selectedBrands.join(',');
        }
        if (selectedConcs.length > 0) {
          newParams.concentrations = selectedConcs.join(',');
        }

        window.location.search = buildQuery(newParams);
        closeFilterModal();
      }

      function clearFilters() {
        document.getElementById('minPriceSelect').selectedIndex = 0;
        document.getElementById('maxPriceSelect').selectedIndex = document.getElementById('maxPriceSelect').options.length - 1;
        document.querySelectorAll('.filter-group input[type="checkbox"]').forEach(cb => {
          cb.checked = false;
        });
        document.getElementById('moreBrands').classList.add('brands-hidden');
        const showMoreBtn = document.querySelector('.show-more-btn');
        if (showMoreBtn) showMoreBtn.textContent = 'Show More';
        const clearParams = { minPrice: '', maxPrice: '', brands: '', concentrations: '' };
        window.location.search = buildQuery(clearParams);
        closeFilterModal();
      }

      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `
          <span>${message}</span>
          <button class="close" onclick="const t=this.closest('.toast'); t.classList.add('fadeOut'); setTimeout(() => { if (t.parentElement) t.parentElement.removeChild(t); }, 300);">&times;</button>
        `;
        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('fadeOut');
          setTimeout(() => {
            if (container.contains(toast)) {
              container.removeChild(toast);
            }
          }, 300);
        }, 5000);
      }

      function showLoginPrompt() {
          Swal.fire({
              title: 'Login Required',
              text: 'Please login to continue',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#d4af37',
              cancelButtonColor: '#d33',
              confirmButtonText: 'Login',
              background: '#1a1a1a',
              color: '#ffffff'
          }).then((result) => {
              if (result.isConfirmed) {
                  window.location.href = '/login';
              }
          });
      }

      function toggleWishlist(event) {
        event.stopPropagation();
        const button = event.currentTarget;
        const productId = button.dataset.productId;
        const isActive = button.classList.contains('active');
        const url = isActive ? `/wishlist/remove/${productId}` : `/wishlist/add/${productId}`;

        const body = isActive ? {} : {};
        
        fetch(url, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify(body)
        })
        .then(response => {
            if (response.redirected && response.url.includes('/login')) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            if (response.status === 401) {
                showLoginPrompt();
                throw new Error('Login required');
            }
            return response.json();
        })
        .then(data => {
          if (data.redirect && data.redirect.includes('login')) {
             showLoginPrompt();
             return;
          }
           if (data.redirect) {
            window.location.href = data.redirect;
            return;
          }
          if (data.success) {
            button.classList.toggle('active');
            const icon = button.querySelector('i');
            icon.classList.toggle('far');
            icon.classList.toggle('fas');
            button.title = isActive ? 'Add to Wishlist' : 'Remove from Wishlist';
            showToast(data.message || (isActive ? 'Removed from wishlist!' : 'Added to wishlist!'), 'success');
          } else {
             if (data.message && (data.message.toLowerCase().includes('login') || data.message.toLowerCase().includes('authenticated'))) {
                 showLoginPrompt();
             } else {
                 showToast(data.message || 'Failed to update wishlist.', 'error');
             }
            if (isActive) {
              button.classList.add('active');
              const icon = button.querySelector('i');
              if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas');
              }
            } else {
              button.classList.remove('active');
              const icon = button.querySelector('i');
              if (icon.classList.contains('fas')) {
                icon.classList.remove('fas');
                icon.classList.add('far');
              }
            }
          }
        })
        .catch(err => {
          console.error('Error:', err);
          if (err.message !== 'Login required') {
             if (err.name === 'SyntaxError') {
                 showLoginPrompt();
             } else {
                 showToast('An error occurred. Please try again.', 'error');
             }
          }
          if (isActive) {
            button.classList.add('active');
            const icon = button.querySelector('i');
            if (icon.classList.contains('far')) {
              icon.classList.remove('far');
              icon.classList.add('fas');
            }
          } else {
            button.classList.remove('active');
            const icon = button.querySelector('i');
            if (icon.classList.contains('fas')) {
              icon.classList.remove('fas');
              icon.classList.add('far');
            }
          }
        });
      }

      function clearGender() {
        const newParams = { gender: '' };
        window.location.search = buildQuery(newParams);
      }

      function clearSort() {
        const newParams = { sort: '' };
        window.location.search = buildQuery(newParams);
      }
    </script>
  </body>
</html>