<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dité - Luxury Fragrances</title>
    <%- include("../partials/user/headerHead") %>
    <%- include("../partials/user/footerHead") %>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        overflow-x: hidden;
      }

      body {
        font-family: "Arial", sans-serif;
        background-color: #000000;
        color: #ffffff;
        line-height: 1.6;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }
      
      /* Carousel */
      .carousel {
        position: relative;
        margin-top: 100px; /* Increased to add more space and prevent header overlap */
        height: 600px; /* Keep as is */
        width: 100vw; /* Full viewport width */
        max-width: none; /* Override any max-width */
        margin-left: calc(-50vw + 50%); /* Center it full-width */
        overflow: hidden;
      }

      .carousel-inner {
        display: flex;
        width: 300%; /* Three slides */
        height: 100%;
        transition: transform 0.5s ease;
      }

      .carousel-inner img {
        width: 33.333%; /* Each slide takes 1/3 of the container */
        height: 100%;
        object-fit: contain; /* Fit the image without cropping or zooming */
        object-position: center;
        flex-shrink: 0;
        display: block;
        max-width: 100%;
      }

      .carousel-dots {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 10;
      }

      .carousel-dots .dot {
        width: 12px;
        height: 12px;
        background-color: #ffffff;
        opacity: 0.5;
        border-radius: 50%;
        cursor: pointer;
        transition: opacity 0.3s ease, background-color 0.3s ease;
      }

      .carousel-dots .dot.active {
        opacity: 1;
        background-color: #d4af37;
      }

      .carousel-dots .dot:hover {
        opacity: 0.8;
        background-color: #d4af37;
      }

      /* Section Titles */
      .section-title {
        text-align: center;
        font-size: 32px;
        margin-bottom: 50px;
        color: #d4af37;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      /* Collections Section */
      .collections {
        padding: 40px 0;
        background-color: #111111;
      }

      .collections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 40px;
      }

      .collection-item {
        position: relative;
        height: 400px;
        border-radius: 10px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease;
      }

      .collection-item:hover {
        transform: translateY(-10px);
      }

      .collection-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .collection-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        padding: 30px 20px 20px;
        text-align: center;
      }

      .collection-overlay h3 {
        font-size: 24px;
        margin-bottom: 10px;
        color: #d4af37;
        text-transform: uppercase;
      }

      /* Story Section */
      .story {
        padding: 80px 0;
        background-color: #0a0a0a;
      }

      .story-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
      }

      .story-text h2 {
        font-size: 36px;
        margin-bottom: 30px;
        color: #d4af37;
      }

      .story-text p {
        font-size: 16px;
        line-height: 1.8;
        color: #cccccc;
        margin-bottom: 20px;
      }

      .story-image {
        text-align: center;
      }

      .story-image img {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
      }

      /* Trending Section */
      .trending {
        padding: 80px 0;
        background-color: #111111;
      }

      .trending-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 40px;
      }

      .trending-item {
        background-color: #1a1a1a;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s ease;
      }

      .trending-item:hover {
        transform: translateY(-5px);
      }

      .trending-item img {
        width: 100%;
        height: 250px;
        object-fit: cover;
      }

      .trending-info {
        padding: 20px;
        text-align: center;
      }

      .trending-info h4 {
        font-size: 18px;
        margin-bottom: 10px;
        color: #d4af37;
      }

      .trending-info p {
        font-size: 14px;
        color: #cccccc;
      }

      /* Responsive Design */
      @media (max-width: 768px) {
        .nav-menu {
          display: none;
        }

        .story-content {
          grid-template-columns: 1fr;
          gap: 40px;
        }

        .collections-grid,
        .trending-grid {
          grid-template-columns: 1fr;
        }

        .footer-content {
          flex-direction: column;
          text-align: center;
        }

        .carousel-inner img {
          object-fit: contain; /* Fit the image without cropping or zooming on mobile too */
          height: 100%;
          width: 33.333%;
        }

        .carousel {
          margin-top: 80px; /* Adjusted for mobile if needed */
        }
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <%- include("../partials/user/header") %>

    <!-- Carousel Section -->
    <section class="carousel" id="home">
      <div class="carousel-inner" id="carouselInner">
        <img
          src="/images/Carosal/2.jpg"
          alt="Carousel Image 1"
        />
        <img
          src="/images/Carosal/3.jpg"
          alt="Carousel Image 2"
        />
        <img
          src="/images/Carosal/dior-black-sauvage-024molas2h6aptt5.jpg"
          alt="Carousel Image 3"
        />
      </div>
      <div class="carousel-dots">
        <span class="dot active" onclick="showSlide(0)"></span>
        <span class="dot" onclick="showSlide(1)"></span>
        <span class="dot" onclick="showSlide(2)"></span>
      </div>
    </section>

    <!-- Collections Section -->
    <section class="collections" id="collections">
      <div class="container">
        <h2 class="section-title">Our Fragrance Collections</h2>
        <div class="collections-grid">
          <div class="collection-item">
            <a href="/shop/men">
            <img
              src="/images/user/outSideHome/Login.jpg"
              alt="Men's Collection"
            />
            <div class="collection-overlay">
              <h3>Men</h3>
            </div>
            </a>
          </div>
          <div class="collection-item">
            <a href="/shop/women">
            <img
              src="/images/user/outSideHome/2ef8839c79f8732773808a3500adaa9a.jpg"
              alt="Women's Collection"
            />
            <div class="collection-overlay">
              <h3>Women</h3>
            </div>
            </a>
          </div>
          <div class="collection-item">
            <a href="/shop/unisex">
            <img
              src="/images/user/outSideHome/Unisex.jpg"
              alt="Unisex Collection"
            />
            <div class="collection-overlay">
              <h3>Unisex</h3>
            </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="story">
      <div class="container">
        <div class="story-content">
          <div class="story-text">
            <h2>Where Scent Becomes Story</h2>
            <p>
              Each fragrance tells a unique story, crafted with the finest
              ingredients and decades of expertise. Our perfumes are more than
              just scents - they are memories waiting to be made.
            </p>
            <p>
              Discover the perfect fragrance that speaks to your soul and
              becomes part of your personal narrative.
            </p>
          </div>
          <div class="story-image">
            <img
              src="/images/user/home/SentBecomeStory.jpg"
              alt="Luxury Perfume"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Collections -->
    <section class="trending">
      <div class="container">
        <h2 class="section-title">Trending Collections</h2>
        <div class="trending-grid">
          <div class="trending-item">
           <a href="/shop">
            <img
              src="/images/Stock colections/Dior homme.jpg"
              alt="Best Seller"
            />
            </a>
            <div class="trending-info">
              <h4>Best Seller</h4>
              <p>Our most popular fragrance</p>
            </div>
          </div>
          <div class="trending-item">
            <a href="/shop">
            <img
              src="/images/Stock colections/Absolu-Aventus-Creed.jpg"
              alt="Limited Edition"
            />
            </a>
            <div class="trending-info">
              <h4>Limited Edition</h4>
              <p>Exclusive seasonal collection</p>
            </div>
          </div>
          <div class="trending-item">
            <a href="/shop">
            <img
              src="/images/Stock colections/Dior homme instense.jpg"
              alt="New Arrival"
            />
            </a>
            <div class="trending-info">
              <h4>New Arrival</h4>
              <p>Fresh from our laboratory</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <%- include("../partials/user/footer") %>

    <script>
      let currentSlide = 0;
      const totalSlides = 3;
      const dots = document.querySelectorAll(".carousel-dots .dot");
      const carouselInner = document.getElementById("carouselInner");
      let autoSlideInterval;

      function updateDots() {
        dots.forEach((dot, index) => {
          dot.classList.toggle("active", index === currentSlide);
        });
      }

      function showSlide(index) {
        stopAutoSlide();
        carouselInner.style.transform = `translateX(-${index * (100 / totalSlides)}%)`;
        currentSlide = index;
        updateDots();
        startAutoSlide();
      }

      function startAutoSlide() {
        autoSlideInterval = setInterval(() => {
          currentSlide = (currentSlide + 1) % totalSlides;
          showSlide(currentSlide);
        }, 4000); // 4 seconds per slide to match original 12s cycle
      }

      function stopAutoSlide() {
        if (autoSlideInterval) {
          clearInterval(autoSlideInterval);
        }
      }

      // Initialize
      updateDots();
      showSlide(0);
      startAutoSlide();
    </script>
  </body>
</html>