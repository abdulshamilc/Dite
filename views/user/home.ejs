<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dité - Luxury Fragrances</title>
    <%- include("../partials/user/headerHead") %>
    <%- include("../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/home.css">
  </head>
  <body>
    <!-- Header -->
    <%- include("../partials/user/header") %>

    <!-- Carousel Section -->
    <section class="carousel" id="home">
      <div class="carousel-inner" id="carouselInner">
        <img
          src="/images/Carosal/2.jpg"
          alt="Carousel Image 1"
        />
        <img
          src="/images/Carosal/3.jpg"
          alt="Carousel Image 2"
        />
        <img
          src="/images/Carosal/dior-black-sauvage-024molas2h6aptt5.jpg"
          alt="Carousel Image 3"
        />
      </div>
      <div class="carousel-dots">
        <span class="dot active" onclick="showSlide(0)"></span>
        <span class="dot" onclick="showSlide(1)"></span>
        <span class="dot" onclick="showSlide(2)"></span>
      </div>
    </section>

    <!-- Collections Section -->
    <section class="collections" id="collections">
      <div class="container">
        <h2 class="section-title">Our Fragrance Collections</h2>
        <div class="collections-grid">
          <div class="collection-item">
            <a href="/shop/men">
            <img
              src="/images/user/outSideHome/Login.jpg"
              alt="Men's Collection"
            />
            <div class="collection-overlay">
              <h3>Men</h3>
            </div>
            </a>
          </div>
          <div class="collection-item">
            <a href="/shop/women">
            <img
              src="/images/user/outSideHome/2ef8839c79f8732773808a3500adaa9a.jpg"
              alt="Women's Collection"
            />
            <div class="collection-overlay">
              <h3>Women</h3>
            </div>
            </a>
          </div>
          <div class="collection-item">
            <a href="/shop/unisex">
            <img
              src="/images/user/outSideHome/Unisex.jpg"
              alt="Unisex Collection"
            />
            <div class="collection-overlay">
              <h3>Unisex</h3>
            </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="story">
      <div class="container">
        <div class="story-content">
          <div class="story-text">
            <h2>Where Scent Becomes Story</h2>
            <p>
              Each fragrance tells a unique story, crafted with the finest
              ingredients and decades of expertise. Our perfumes are more than
              just scents - they are memories waiting to be made.
            </p>
            <p>
              Discover the perfect fragrance that speaks to your soul and
              becomes part of your personal narrative.
            </p>
          </div>
          <div class="story-image">
            <img
              src="/images/user/home/SentBecomeStory.jpg"
              alt="Luxury Perfume"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Collections -->
    <section class="trending">
      <div class="container">
        <h2 class="section-title">Trending Collections</h2>
        <div class="trending-grid">
          <div class="trending-item">
           <a href="/shop">
            <img
              src="/images/Stock colections/Dior homme.jpg"
              alt="Best Seller"
            />
            </a>
            <div class="trending-info">
              <h4>Best Seller</h4>
              <p>Our most popular fragrance</p>
            </div>
          </div>
          <div class="trending-item">
            <a href="/shop">
            <img
              src="/images/Stock colections/Absolu-Aventus-Creed.jpg"
              alt="Limited Edition"
            />
            </a>
            <div class="trending-info">
              <h4>Limited Edition</h4>
              <p>Exclusive seasonal collection</p>
            </div>
          </div>
          <div class="trending-item">
            <a href="/shop">
            <img
              src="/images/Stock colections/Dior homme instense.jpg"
              alt="New Arrival"
            />
            </a>
            <div class="trending-info">
              <h4>New Arrival</h4>
              <p>Fresh from our laboratory</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <%- include("../partials/user/footer") %>

    <script>
      let currentSlide = 0;
      const totalSlides = 3;
      const dots = document.querySelectorAll(".carousel-dots .dot");
      const carouselInner = document.getElementById("carouselInner");
      let autoSlideInterval;

      function updateDots() {
        dots.forEach((dot, index) => {
          dot.classList.toggle("active", index === currentSlide);
        });
      }

      function showSlide(index) {
        stopAutoSlide();
        carouselInner.style.transform = `translateX(-${index * (100 / totalSlides)}%)`;
        currentSlide = index;
        updateDots();
        startAutoSlide();
      }

      function startAutoSlide() {
        autoSlideInterval = setInterval(() => {
          currentSlide = (currentSlide + 1) % totalSlides;
          showSlide(currentSlide);
        }, 4000); // 4 seconds per slide to match original 12s cycle
      }

      function stopAutoSlide() {
        if (autoSlideInterval) {
          clearInterval(autoSlideInterval);
        }
      }

      // Initialize
      updateDots();
      showSlide(0);
      startAutoSlide();
    </script>
  </body>
</html>