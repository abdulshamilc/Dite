<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wishlist - Dité</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/wishlist/wishlist.css">
  </head>
  
  <body>
    <!-- Header -->
    <%- include("../../partials/user/header") %>

    <main class="wishlist-container">
      <h1 class="wishlist-title">WISHLIST</h1>

      <section class="wishlist-items">
        <% if (wishlist && wishlist.items.length > 0) { %>
          <% wishlist.items.forEach(item => { %>
            <div class="cart-item"
              data-product-id="<%= item.productId %>"
              data-item-id="<%= item._id %>"
              onclick="goToProduct('<%= item.productId %>')">

              <img src="<%= item.image %>" alt="<%= item.name %>" class="item-image"/>

              <div class="item-details">
                <div class="item-header">
                  <div>
                    <div class="item-name"><%= item.name %></div>
                    <div class="item-brand"><%= item.brand %></div>
                    <div class="item-variants">
                      Available in <%= item.numVariants %> sizes
                    </div>
                  </div>

                  <div class="item-controls">

                    <!-- REMOVE FORM -->
                    <form action="/wishlist/remove/<%= item.productId %>"
                          method="POST"
                          id="deleteForm_<%= item.productId %>"
                          style="display: inline-block">

                      <button type="button"
                              class="remove-btn"
                              data-product-id="<%= item.productId %>"
                              onclick="confirmDelete(event)">
                        <svg width="16" height="16" fill="none" stroke="currentColor"
                          viewBox="0 0 24 24">
                          <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4
                                   a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        </svg>
                      </button>
                    </form>

                    <!-- ADD TO CART -->
                    <button class="add-to-cart-btn"
                            onclick="event.stopPropagation(); addToCartFromWishlist('<%= item._id %>')">
                      Add to Cart
                    </button>

                  </div>
                </div>
              </div>
            </div>
          <% }); %>

        <% } else { %>
          <div class="no-items">
            <p>No items in your wishlist yet.</p>
          </div>
        <% } %>
      </section>

      <!-- SUGGESTIONS -->
      <% if (suggestedProducts && suggestedProducts.length > 0) { %>
        <section class="suggestions-section">
          <h3 class="suggestions-title">Suggested Products</h3>

          <div class="suggestions-grid">
            <% suggestedProducts.forEach(product => { %>
              <div class="suggestion-card">
                <img src="<%= product.images[0] || '/default-image.jpg' %>" />
                <h4><%= product.name %></h4>
                <p><%= product.brand %> - <%= product.concentration %></p>

                <button class="add-suggestion-btn"
                        data-product-id="<%= product._id %>"
                        onclick="addToWishlistSuggestion(this)">
                  Add to Wishlist
                </button>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>
    </main>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

    <!-- Toast -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      function goToProduct(id) {
        window.location.href = `/product/${id}`;
      }

      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;

        toast.innerHTML = `
          <span>${message}</span>
          <button class="close"
            onclick="const t=this.closest('.toast'); t.classList.add('fadeOut');
                     setTimeout(() => t.remove(), 300);">&times;</button>
        `;

        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('fadeOut');
          setTimeout(() => toast.remove(), 300);
        }, 5000);
      }
    </script>

    <script>
      /* FIXED VERSION — SAFE PRODUCT ID */
      function confirmDelete(event) {
        event.stopPropagation();
        
        const productId = event.currentTarget.dataset.productId;
        const form = document.getElementById(`deleteForm_${productId}`);

        Swal.fire({
          title: 'Are you sure?',
          text: 'You are removing this item from the wishlist!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          cancelButtonColor: '#666',
          confirmButtonText: 'Yes, remove it!',
          background: '#2a2a2a',
          color: '#ffffff'
        }).then(result => {
          if (result.isConfirmed) {
            form.submit();
          }
        });
      }
    </script>

    <script>
      function addToCartFromWishlist(itemId) {
        fetch(`/wishlist/addToCart/${itemId}`, { 
          method: "POST",
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                icon: 'success',
                title: 'Moved to Cart!',
                text: data.message || 'Item moved to cart successfully',
                showConfirmButton: false,
                timer: 1500,
                background: '#1a1a1a',
                color: '#ffffff'
              }).then(() => {
                // Reload to remove item from wishlist and update cart count
                window.location.reload();
              });
            } else {
              showToast(data.message || 'Error adding to cart', 'error');
            }
          })
          .catch(err => {
            console.error('Error:', err);
            showToast('Server error. Please try again.', 'error');
          });
      }

      function addToWishlistSuggestion(btn) {
        const pid = btn.dataset.productId;

        fetch(`/wishlist/add/${pid}`, { 
          method: "POST",
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                icon: 'success',
                title: 'Added!',
                text: data.message || 'Added to wishlist',
                showConfirmButton: false,
                timer: 1500,
                background: '#1a1a1a',
                color: '#ffffff'
              }).then(() => {
                window.location.reload();
              });
            } else {
              showToast(data.message || 'Could not add to wishlist', 'error');
            }
          })
          .catch(err => {
              console.error('Error:', err);
              showToast('Server error. Please try again.', 'error');
          });
      }
    </script>

  </body>
</html>