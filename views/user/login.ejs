<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Dité</title>
    <link rel="stylesheet" href="/style/user/login.css" />
  </head>
  <body>
    <div class="login-container">
      <!-- Form -->
      <div class="login-form">
        <div class="logo">
          <img src="/images/logo/Dite White Logo.png" alt="Dité Logo" />
        </div>

        <% if (errors && errors.message) { %>
        <div class="error-box"><%= errors.message %></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="form-group">
            <input
              type="text"
              class="form-input"
              placeholder="Email"
              name="email"
            />
          </div>
          <div class="form-group">
            <input
              type="password"
              class="form-input"
              placeholder="Password"
              name="password"
            />
            <a href="/forgot-password" class="forgot-password"
              >forget password</a
            >
          </div>

          <button type="submit" class="login-btn">Login</button>
        </form>

        <div class="signup-link-container">
          New User ? <a href="/signup" class="signup-link">Sign up now</a>
        </div>

        <div class="divider">OR</div>

        <div class="social-login">
          <div class="social-login-title">Login Using</div>
          <div class="social-icons">
            <!-- Google -->
            <svg class="social-icon" viewBox="0 0 24 24">
              <path
                fill="#4285f4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              />
              <path
                fill="#34a853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              />
              <path
                fill="#fbbc05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              />
              <path
                fill="#ea4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              />
            </svg>
            <!-- Apple -->
            <svg class="social-icon" viewBox="0 0 24 24">
              <path
                fill="#000"
                d="M16.365 1.43c0 1.14-.417 2.097-1.248 2.873-.833.774-1.844 1.18-3.037 1.18-.046-1.073.31-2.012 1.07-2.807.76-.795 1.71-1.246 3.002-1.246.07 0 .14 0 .213.01zm4.568 17.35c-.38.87-.83 1.67-1.35 2.39-.71 1-1.29 1.69-1.74 2.07-.7.66-1.46 1-2.28 1-.58 0-1.29-.17-2.12-.52-.83-.34-1.6-.51-2.31-.51-.74 0-1.52.17-2.34.51-.83.35-1.5.52-2 .52-.78 0-1.55-.33-2.31-1-.49-.42-1.1-1.13-1.82-2.11-.78-1.07-1.42-2.31-1.92-3.71-.52-1.43-.78-2.82-.78-4.17 0-1.54.34-2.87 1.02-3.97.54-.9 1.26-1.61 2.17-2.15.91-.54 1.89-.82 2.95-.85.58 0 1.34.2 2.28.58.93.39 1.54.59 1.82.59.2 0 .82-.24 1.87-.7 1-.39 1.84-.55 2.54-.5 1.88.15 3.29.9 4.23 2.25-1.68 1.02-2.52 2.45-2.52 4.27 0 1.43.52 2.63 1.56 3.58.47.45.99.8 1.56 1.05-.13.38-.27.74-.42 1.08z"
              />
            </svg>
          </div>
        </div>
      </div>

      <!-- Right Image -->
      <div class="login-image">
        <img src="/images/user/outSideHome/Login.jpg" alt="Login Side Image" />
      </div>
    </div>
  </body>
</html>
