<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart - Dité</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%- include("../../partials/user/headerHead") %>
    <%- include("../../partials/user/footerHead") %>
    <link rel="stylesheet" href="/style/user/cart.css">
  </head>
  <body>
    <!-- Header -->
    <%- include("../../partials/user/header") %>

    <!-- Main Content -->
    <main class="cart-container">

      <h1 class="cart-title">CART</h1>

      <div class="cart-content">
        <!-- Cart Items -->
        <div class="cart-items">
          <% if (cart && cart.items.length > 0) { %>
            <% cart.items.forEach(item => { %>
              <div class="cart-item <%= item.stockStatus === 'Out of Stock' ? 'out-of-stock-dim' : '' %>">
                <img
                  src="<%= item.image %>"
                  alt="<%= item.name %>"
                  class="item-image"
                />
                <div class="item-details">
                  <div class="item-header">
                    <div>
                      <div class="item-name"><%= item.name %></div>
                      <% if (item.size) { %>
                        <div class="item-size"><%= item.size %></div>
                      <% } %>
                    </div>
                    <div class="item-price">
                        <span>Rs.<%= item.discountedPrice.toFixed(2) %></span>
                    </div>
                  </div>
                  <div class="item-controls">
                    <form
                      action="/cart/delete/<%= item._id %>"
                      method="POST"
                      style="display: inline"
                      id="deleteForm_<%= item._id %>"
                    >
                      <button type="button" class="remove-btn" onclick="confirmDelete('<%= item._id %>')">
                        <svg
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                          ></path>
                        </svg>
                      </button>
                    </form>
                    <div class="quantity-controls">
                      <button
                        class="quantity-btn"
                        id="btn-dec-<%= item._id %>"
                        onclick="updateQuantity('<%= item._id %>', '<%= item.size %>', 'dec', <%= item.quantity %>)"
                      >
                        -
                      </button>
                      <span class="quantity">Qty: <span id="qty-<%= item._id %>"><%= item.quantity %></span></span>
                      <button
                        class="quantity-btn"
                        id="btn-inc-<%= item._id %>"
                        onclick="updateQuantity('<%= item._id %>', '<%= item.size %>', 'inc', <%= item.quantity %>)"
                        <% if (item.stockStatus === 'Out of Stock' || item.stockStatus === 'Unlisted') { %>
                          disabled style="opacity: 0.3; cursor: not-allowed;"
                        <% } %>
                      >
                        +
                      </button>
                    </div>
                  </div>
                  <div class="item-footer">
                    <div>
                      <div class="stock-status"><%= item.stockStatus %></div>
                      <div class="delivery-info">
                        Arrives by Tuesday,
                        <span class="delivery-date">Jul 07 @ 10:00</span>
                      </div>
                    </div>
                    <div class="free-delivery"></div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p style="text-align: center; padding: 2rem; color: #999;">Your cart is empty.</p>
          <% } %>
        </div>

        <!-- Order Summary -->
        <aside class="order-summary">
          <h2 class="summary-title">Order Summary</h2>

          <div class="summary-items">
            <% if (cart && cart.items.length > 0) { %>
              <% cart.items.forEach(item => { %>
                <div class="summary-item" id="summary-item-<%= item._id %>" style="flex-direction: column; align-items: flex-start; gap: 0.5rem; padding-bottom: 1rem; border-bottom: 1px solid #444;">
                  <div style="display: flex; justify-content: space-between; width: 100%; font-size: 1.1rem;">
                      <span style="font-weight: 500;"><%= item.name %></span>
                      <span id="summary-base-<%= item._id %>" style="color: #ccc;">Rs.<%= (item.basePrice * item.quantity).toFixed(2) %></span>
                  </div>
                  
                  <% const savings = (item.basePrice - item.discountedPrice) * item.quantity; %>
                  <div id="savings-container-<%= item._id %>" style="display: <%= savings > 0 ? 'flex' : 'none' %>; justify-content: space-between; width: 100%; font-size: 1rem; color: #ef4444;">
                      <span>Discount Applied</span>
                      <span id="summary-savings-<%= item._id %>">-Rs.<%= savings.toFixed(2) %></span>
                  </div>

                  <% if (savings > 0 && offersMap && offersMap[item._id]) { %>
                      <div style="font-size: 0.95rem; color: #ffffff; margin-top: 0.2rem;">
                          <div>Offer: <%= offersMap[item._id].name %></div>
                          <div>Expires: <%= new Date(offersMap[item._id].endDate).toLocaleDateString() %></div>
                      </div>
                  <% } %>
                  
                  <div style="display: flex; justify-content: space-between; width: 100%; margin-top: 0.5rem; font-weight: 600; font-size: 1.1rem;">
                      <span>Total</span>
                      <span id="summary-total-<%= item._id %>">Rs.<%= (item.discountedPrice * item.quantity).toFixed(2) %></span>
                  </div>
                </div>
              <% }); %>
              <div class="summary-item">
                <span>Delivery Charges</span>
                <span>Rs.40.00</span>
              </div>
              <% if (subtotal > total) { %>
                <div class="summary-item discount">
                  <span>Discount</span>
                  <span>Rs.<%= (subtotal - total).toFixed(2) %></span>
                </div>
              <% } %>
            <% } %>
          </div>

          <hr class="summary-divider" />

          <div class="subtotal">
            <span>Subtotal</span>
            <span>Rs.<%= subtotal.toFixed(2) %></span>
          </div>

          <div class="promo-section">
            <input type="text" class="promo-input" placeholder="Promo Code" />
            <button class="apply-btn">Apply</button>
          </div>

          <div class="total-section">
            <div class="total-label">TOTAL :</div>
            <div class="total-amount">Rs.<%= (total + 40).toFixed(2) %></div>
          </div>

          <% 
             let hasOutOfStock = false;
             if (cart && cart.items) {
                 hasOutOfStock = cart.items.some(item => item.stockStatus === 'Out of Stock');
             }
          %>

          <% if (hasOutOfStock) { %>
              <button class="checkout-btn" disabled style="background-color: #555; cursor: not-allowed; opacity: 0.7;">Some items unavailable</button>
              <p style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem; text-align: center;">Please remove out of stock items to proceed.</p>
          <% } else { %>
              <a href="checkout/address"><button class="checkout-btn">CHECKOUT</button></a>
          <% } %>
        </aside>
      </div>
    </main>

    <!-- Footer -->
    <%- include("../../partials/user/footer") %>

    <!-- Toast Container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.innerHTML = `
          <span>${message}</span>
          <button class="close" onclick="const t=this.closest('.toast'); t.classList.add('fadeOut'); setTimeout(() => { if (t.parentElement) t.parentElement.removeChild(t); }, 300);">&times;</button>
        `;
        container.appendChild(toast);

        // Auto fade out after 5 seconds
        setTimeout(() => {
          toast.classList.add('fadeOut');
          setTimeout(() => {
            if (container.contains(toast)) {
              container.removeChild(toast);
            }
          }, 300);
        }, 5000);
      }

      async function updateQuantity(itemId, size, action, currentQty) {
        if (action === 'inc' && currentQty >= 10) {
          showToast('You cannot add more than 10 Quantity.', 'error');
          return;
        }

        try {
          const res = await fetch(`/cart/quantity/${itemId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ size, action }),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            if (!data.newQuantity || data.newQuantity === 0) {
              window.location.reload(); // Item removed
            } else {
              // Update List Quantity
              const qtyEl = document.getElementById(`qty-${itemId}`);
              if(qtyEl) qtyEl.innerText = data.newQuantity;

              // Update Summary - Base Price Total
              const summaryBase = document.getElementById(`summary-base-${itemId}`);
              if(summaryBase) summaryBase.innerText = `Rs.${data.itemTotal.toFixed(2)}`;

              // Update Summary - Savings
              const savingsContainer = document.getElementById(`savings-container-${itemId}`);
              const savingsVal = document.getElementById(`summary-savings-${itemId}`);
              if(savingsContainer && savingsVal) {
                  if (data.itemSavings > 0) {
                      savingsVal.innerText = `-Rs.${data.itemSavings.toFixed(2)}`;
                      savingsContainer.style.display = 'flex';
                  } else {
                      savingsContainer.style.display = 'none';
                  }
              }

              // Update Summary - Item Final Total
              const summaryTotal = document.getElementById(`summary-total-${itemId}`);
              if(summaryTotal) summaryTotal.innerText = `Rs.${data.itemDiscountedTotal.toFixed(2)}`;

              // Update Global Cart Total
              const globalTotal = document.querySelector('.total-amount');
              if(globalTotal) globalTotal.innerText = `Rs.${data.cartTotal.toFixed(2)}`;

              // Update Button Handlers
              const btnInc = document.getElementById(`btn-inc-${itemId}`);
              const btnDec = document.getElementById(`btn-dec-${itemId}`);
              if(btnInc) btnInc.setAttribute('onclick', `updateQuantity('${itemId}', '${size}', 'inc', ${data.newQuantity})`);
              if(btnDec) btnDec.setAttribute('onclick', `updateQuantity('${itemId}', '${size}', 'dec', ${data.newQuantity})`);
            }
          } else {
            showToast(data.message || "Failed to update quantity", 'error');
          }
        } catch (error) {
          console.error("Error:", error);
          showToast("An error occurred while updating quantity.", 'error');
        }
      }

      function confirmDelete(itemId) {
        Swal.fire({
          title: 'Are you sure?',
          text: "Your Are Removing The Product Form Cart !!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          cancelButtonColor: '#666',
          confirmButtonText: 'Yes, remove it!',
          cancelButtonText: 'Cancel',
          background: '#2a2a2a',
          color: '#ffffff'
        }).then((result) => {
          if (result.isConfirmed) {
            document.getElementById('deleteForm_' + itemId).submit();
          }
        });
      }

      // Show success/error toasts if passed
      document.addEventListener('DOMContentLoaded', function() {
        <% if (typeof success !== 'undefined' && success) { %>
          showToast('<%= success %>', 'success');
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          showToast('<%= error %>', 'error');
        <% } %>
      });
    </script>
  </body>
</html> 