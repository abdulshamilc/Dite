<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Details - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link rel="stylesheet" href="/style/admin/orders/orderDetails.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>
    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>
      <!-- Page Content -->
      <main class="flex-1 p-6">
        <div class="max-w-6xl mx-auto w-full">
          <!-- Header -->
          <div class="mb-8">
            <a href="/admin/orders" class="text-sm text-brand hover:underline mb-4 inline-block flex items-center gap-2">
              <i data-lucide="arrow-left" class="w-4 h-4"></i>
              Back to Orders
            </a>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h1 class="text-3xl font-bold mb-2">Order Details</h1>
                <p class="text-gray-400">Order ID: <span class="text-brand font-semibold">#<%= order.orderID %></span></p>
              </div>
              <%
              let isPartialCancel = (order.cancelProducts && order.cancelProducts.length > 0) && order.orderStatus !== 'Cancelled';
              let isFullCancel = order.orderStatus === 'Cancelled';
              let statusClass = 'status-pending';
              let statusText = 'Placed';
              if (order.orderStatus) {
                  const lowerStatus = order.orderStatus.toLowerCase();
                  if (lowerStatus === 'delivered') {
                      statusClass = 'status-delivered';
                      statusText = 'Delivered';
                  } else if (lowerStatus === 'shipped') {
                      statusClass = 'status-shipped';
                      statusText = 'Shipped';
                  } else if (isPartialCancel) {
                      statusClass = 'status-partial';
                      statusText = 'Partially Cancelled';
                  } else if (isFullCancel) {
                      statusClass = 'status-cancelled';
                      statusText = 'Cancelled';
                  } else {
                      statusText = order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1);
                      statusClass = `status-${lowerStatus}`;
                  }
              }
              %>
              <div class="flex items-center gap-4 ml-4">
                <span class="status-badge <%= statusClass %>"><%= statusText %></span>
              </div>
            </div>
          </div>
          <!-- Main Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-8">
            <!-- Order Summary -->
            <div class="lg:col-span-2">
              <div class="card p-6 mb-6">
                <h2 class="text-xl font-bold mb-4 text-brand">Order Summary</h2>
               
                <!-- Active Order Items -->
                <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
                  <h3 class="text-lg font-semibold text-gray-300 mb-3">Active Items</h3>
                  <% if (order.items && order.items.length > 0) { %>
                    <% let hasActiveItems = false; %>
                    <% order.items.forEach(item => { %>
                      <% 
                      // Show original quantity without subtracting returns/cancels
                      const originalQuantity = item.originalQuantity || item.quantity || 1;
                      if (originalQuantity > 0) { 
                      %>
                        <% hasActiveItems = true; %>
                        <div class="flex items-center gap-4">
                          <% if (item.image) { %>
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded flex-shrink-0 border border-gray-600">
                          <% } else { %>
                            <div class="w-16 h-16 bg-gray-700 rounded flex items-center justify-center flex-shrink-0">
                              <span class="text-gray-400 text-xs">No Image</span>
                            </div>
                          <% } %>
                          <div class="flex-1 min-w-0">
                            <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                            <p class="text-gray-500 text-sm"><%= (item.mlSize || 0) + ' ml' %></p>
                          </div>
                          <div class="text-right flex-shrink-0">
                            <p class="font-semibold">₹<%= ((item.discoundedPrice || item.discountedPrice || item.basePrice || 0) * originalQuantity).toFixed(2) %></p>
                            <p class="text-sm text-gray-400">Qty: <%= originalQuantity %></p>
                          </div>
                        </div>
                      <% } %>
                    <% }); %>
                    <% if (!hasActiveItems) { %>
                      <p class="text-gray-400 text-center py-4">No active items remaining.</p>
                    <% } %>
                  <% } else { %>
                    <p class="text-gray-400 text-center py-4">No active items found.</p>
                  <% } %>
                </div>
                <!-- Canceled Items Section -->
                <% if (order.cancelProducts && order.cancelProducts.length > 0) { %>
                <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
                  <h3 class="text-lg font-semibold text-red-400 mb-3 flex items-center gap-2">
                    Canceled Items
                    <span class="canceled-badge">CANCELED</span>
                  </h3>
                  <% order.cancelProducts.forEach(item => { %>
                  <div class="flex items-center gap-4 canceled-item">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded flex-shrink-0 border border-gray-600">
                    <% } else { %>
                      <div class="w-16 h-16 bg-gray-700 rounded flex items-center justify-center flex-shrink-0">
                        <span class="text-gray-400 text-xs">No Image</span>
                      </div>
                    <% } %>
                    <div class="flex-1 min-w-0">
                      <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                      <p class="text-gray-500 text-sm"><%= (item.mlSize || 0) + ' ml' %></p>
                      <% if (item.reason) { %>
                        <p class="reason-text">Reason: <%= item.reason %></p>
                      <% } %>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <p class="font-semibold text-red-400">₹<%= ((item.discountedPrice || item.basePrice || 0) * (item.canceledQuantity || 1)).toFixed(2) %></p>
                      <p class="text-sm text-gray-400">Canceled Qty: <%= item.canceledQuantity || 1 %></p>
                      <% if (item.canceledAt) { %>
                        <p class="text-xs text-gray-500">Canceled: <%= new Date(item.canceledAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                      <% } %>
                    </div>
                  </div>
                  <% }); %>
                </div>
                <% } %>
                <!-- Returned Items Section -->
                <% if (order.returndProduct && order.returndProduct.length > 0) { %>
                <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
                  <h3 class="text-lg font-semibold text-red-400 mb-3 flex items-center gap-2">
                    Returned Items
                    <span class="returned-badge">RETURNED</span>
                  </h3>
                  <% order.returndProduct.forEach(item => { %>
                  <div class="returned-item flex items-center gap-4" onclick="window.location.href='/admin/return/<%= order._id %> '">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.name %>" class="w-16 h-16 object-cover rounded flex-shrink-0 border border-gray-600">
                    <% } else { %>
                      <div class="w-16 h-16 bg-gray-700 rounded flex items-center justify-center flex-shrink-0">
                        <span class="text-gray-400 text-xs">No Image</span>
                      </div>
                    <% } %>
                    <div class="flex-1 min-w-0">
                      <p class="font-semibold"><%= item.name || 'Unknown Product' %></p>
                      <p class="text-gray-500 text-sm"><%= (item.mlSize || 0) + ' ml' %></p>
                      <% if (item.reason && item.reason.trim() !== "") { %>
                        <p class="reason-text-return">Reason: <%= item.reason %></p>
                      <% } %>
                      <% if (item.rejectReason && item.rejectReason.trim() !== "" && item.adminApproved === 'Rejected') { %>
                        <p class="reject-reason">Reject Reason: <%= item.rejectReason %></p>
                      <% } %>
                      <p class="text-xs text-gray-500 mt-1">
                        Requested on: <%= new Date(item.returnedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </p>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <% const itemTotal = (item.basePrice || 0) * (item.returndQuantity || 1); %>
                      <p class="font-semibold text-red-400">₹<%= itemTotal.toFixed(2) %></p>
                      <p class="text-sm text-gray-400">Returned Qty: <%= item.returndQuantity || 1 %></p>
                      <span class="approval-badge <%= item.adminApproved === 'Requested' ? 'status-requested' : item.adminApproved === 'Approved' ? 'status-approved' : 'status-rejected' %>">
                        <%= item.adminApproved %>
                      </span>
                    </div>
                  </div>
                  <% }); %>
                </div>
                <% } %>
                <!-- Pricing -->
                <div class="space-y-2">
                  <div class="flex justify-between text-gray-300">
                    <span>Subtotal</span>
                    <span>₹<%= (order.totalAmount + (order.discountAmount || 0)).toFixed(2) %></span>
                  </div>
                  
                  <% if (order.couponCode) { %>
                    <div class="flex justify-between text-gray-300">
                        <span>Coupon Applied (<span class="text-brand font-semibold"><%= order.couponCode %></span>)</span>
                        <span class="text-brand">-₹<%= (order.discountAmount || 0).toFixed(2) %></span>
                    </div>
                  <% } else if (order.discountAmount > 0 || discount > 0) { %>
                    <div class="flex justify-between text-gray-300">
                        <span>Discount</span>
                        <span class="text-brand">-₹<%= Number(order.discountAmount || discount || 0).toFixed(2) %></span>
                    </div>
                  <% } %>

                  <div class="flex justify-between text-gray-300">
                    <span>Delivery Charge</span>
                    <span>₹<%= (order.deliveryCharge || 40).toFixed(2) %></span>
                  </div>
                  <div class="flex justify-between text-gray-300">
                    <span>Tax</span>
                    <span>₹<%= (order.tax || 0).toFixed(2) %></span>
                  </div>
                  <div class="flex justify-between text-lg font-bold text-brand pt-2 border-t border-gray-700">
                    <span>Total Paid</span>
                    <span>₹<%= (order.totalAmount || 0).toFixed(2) %></span>
                  </div>
                </div>
              </div>
              <!-- Order History Timeline -->
              <div class="card p-6">
                <h2 class="text-xl font-bold mb-6 text-brand">Order History</h2>
               
                <div class="relative space-y-6">
                  <%
                  // Build history array: status changes from tracking, plus order placed, cancellations, returns
                  let history = [];
                 
                  // Always add Order Placed
                  history.push({
                    date: order.placedAt || order.createdAt || new Date(),
                    status: 'Order Placed',
                    message: 'Order received and confirmed',
                    type: 'status'
                  });
                 
                  // Add tracking events (status changes) - ensures Out for Delivery, Delivered, etc., are included
                  if (order.tracking && order.tracking.length > 0) {
                    order.tracking.forEach(event => {
                      if (event.status && event.date) {
                        history.push({
                          date: new Date(event.date),
                          status: event.status,
                          message: event.message || `Status updated to ${event.status}`,
                          type: 'status'
                        });
                      }
                    });
                  }
                 
                  // Add partial/full cancellation if applicable (from cancelStatus)
                  if (order.cancelStatus && order.cancelStatus !== 'Active') {
                    const cancelDate = order.cancelledAt || order.updatedAt || new Date();
                    history.push({
                      date: cancelDate,
                      status: order.cancelStatus,
                      message: `${order.cancelStatus} by user`,
                      type: 'cancel'
                    });
                  }
                 
                  // Add individual return events from returndProduct (for partial/full returns, regardless of orderStatus)
                  if (order.returndProduct && order.returndProduct.length > 0) {
                    order.returndProduct.forEach(item => {
                      if (item.returnedAt) {
                        const itemName = item.name || 'Item';
                        history.push({
                          date: new Date(item.returnedAt),
                          status: `Returned: ${itemName.substring(0, 30)}${itemName.length > 30 ? '...' : ''}`,
                          message: item.reason ? `Reason: ${item.reason}` : 'Item returned and processed',
                          type: 'return'
                        });
                      }
                    });
                  }
                 
                  // Fallback: Add overall return event if orderStatus is 'Returned' and no individual returns
                  if (order.orderStatus === 'Returned' && (!order.returndProduct || order.returndProduct.length === 0)) {
                    const returnDate = order.updatedAt || new Date();
                    history.push({
                      date: returnDate,
                      status: 'Returned',
                      message: 'Order returned and processed',
                      type: 'return'
                    });
                  }
                 
                  // Sort by date ascending
                  history.sort((a, b) => a.date - b.date);
                  %>
                 
                  <% if (history.length === 0) { %>
                    <p class="text-gray-400 text-center py-4">No history available.</p>
                  <% } else { %>
                    <% history.forEach((event, index) => { %>
                      <%
                      let dotClass = 'timeline-dot pending';
                      let lineClass = 'timeline-line pending';
                      let textClass = 'text-gray-500';
                      let badgeClass = 'event-status';
                     
                      if (event.type === 'status' && (event.status.toLowerCase().includes('delivered') || event.status.toLowerCase().includes('out for delivery') || event.status === 'Returned')) {
                        dotClass = 'timeline-dot completed';
                        lineClass = 'timeline-line completed';
                        textClass = 'text-green-400';
                      } else if (event.type === 'cancel') {
                        dotClass = 'timeline-dot cancel';
                        lineClass = 'timeline-line cancel';
                        textClass = 'text-red-400';
                        badgeClass = 'event-cancel';
                      } else if (event.type === 'return') {
                        dotClass = 'timeline-dot return';
                        lineClass = 'timeline-line return';
                        textClass = 'text-orange-400';
                        badgeClass = 'event-return';
                      } else if (index === history.length - 1) {
                        dotClass = 'timeline-dot current';
                        lineClass = 'timeline-line current';
                        textClass = 'text-brand';
                      }
                     
                      const formattedDate = event.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) + ' - ' + event.date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                      %>
                      <div class="timeline-item">
                        <div class="<%= dotClass %>"></div>
                        <div class="flex-1">
                          <div class="flex items-center justify-between mb-1">
                            <p class="font-semibold <%= textClass %>"><%= event.status %></p>
                            <span class="<%= badgeClass %> event-badge"><%= event.type.toUpperCase() %></span>
                          </div>
                          <p class="text-sm text-gray-400 mb-1"><%= formattedDate %></p>
                          <% if (event.message) { %>
                            <p class="text-sm <%= textClass === 'text-brand' ? 'text-gray-300' : 'text-gray-500' %>"><%= event.message %></p>
                          <% } %>
                        </div>
                        <% if (index < history.length - 1) { %>
                          <div class="<%= lineClass %>"></div>
                        <% } %>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            </div>
            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Status Update -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Update Status</h3>
                <% const isOrderFinished = ['Cancelled', 'Returned', 'Delivered'].includes(order.orderStatus); %>
                <form id="statusUpdateForm" method="POST" action="/admin/orders/<%= order._id %>/status" class="space-y-4">
                  <select id="statusSelect" name="status" class="bg-gray-800 p-2 rounded w-full text-white <%= isOrderFinished ? 'opacity-50 cursor-not-allowed' : '' %>" required <%= isOrderFinished ? 'disabled' : '' %>>
                    <option value="">Select Status</option>
                    <option value="Placed" <%= order.orderStatus === 'Placed' ? 'selected' : '' %>>Placed</option>
                    <option value="Shipped" <%= order.orderStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="Out for Delivery" <%= order.orderStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                    <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                  </select>
                  <button type="submit" class="btn btn-primary w-full <%= isOrderFinished ? 'opacity-50 cursor-not-allowed' : '' %>" <%= isOrderFinished ? 'disabled' : '' %>>
                    <%= isOrderFinished ? `Order is ${order.orderStatus}` : 'Update Status' %>
                  </button>
                </form>
              </div>
              <!-- Customer Details -->
              <div class="card p-6">
                <div class="flex justify-between items-center mb-4">
                  <h3 class="font-bold text-brand">Customer Details</h3>
                  <% if (user && user._id) { %>
                    <a href="/admin/customers/<%= user._id %>" class="text-sm text-brand hover:underline flex items-center gap-1">
                      <i data-lucide="user" class="w-4 h-4"></i>
                      View Profile
                    </a>
                  <% } %>
                </div>
                <div class="text-sm space-y-2 text-gray-300">
                  <% if (user) { %>
                    <div class="flex justify-between">
                      <span class="font-semibold">Name:</span>
                      <span><%= user.name || 'N/A' %></span>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Email:</span>
                      <span><%= user.email || 'N/A' %></span>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Phone:</span>
                      <span><%= user.phone || 'N/A' %></span>
                    </div>
                    <div class="flex justify-between">
                      <span class="font-semibold">Joined:</span>
                      <span><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
                    </div>
                    <% if (typeof user.totalOrders !== 'undefined') { %>
                      <div class="flex justify-between">
                        <span class="font-semibold">Total Orders:</span>
                        <span><%= user.totalOrders %></span>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="text-gray-400">Customer details not available.</p>
                  <% } %>
                </div>
              </div>
              <!-- Shipping Address -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Shipping Address</h3>
                <div class="text-sm space-y-1 text-gray-300">
                  <% if (order.address) { %>
                    <p class="font-semibold"><%= order.address.fullName || '' %></p>
                    <p><%= order.address.street || order.address.address || '' %></p>
                    <p><%= order.address.hoNo || '' %></p>
                    <p><%= (order.address.city || '') + ', ' + (order.address.state || '') + ' ' + (order.address.pin || order.address.zipCode || '') %></p>
                    <p><%= order.address.country || '' %></p>
                    <p class="mt-3 text-brand"><%= order.address.phone || '' %></p>
                  <% } else { %>
                    <p class="text-gray-400">Shipping address not available.</p>
                  <% } %>
                </div>
              </div>
              <!-- Payment Method -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Payment Method</h3>
                <div class="text-sm space-y-2 text-gray-300">
                  <%
                  let paymentDisplay = 'Payment details not available.';
                  if (order.paymentMethod) {
                      if (typeof order.paymentMethod === 'string' && order.paymentMethod.toLowerCase() === 'cod') {
                          paymentDisplay = 'Cash On Delivery';
                      } else if (typeof order.paymentMethod === 'object' && order.paymentMethod.last4) {
                          paymentDisplay = `${order.paymentMethod.type || 'Card'} ending in ${order.paymentMethod.last4}`;
                      } else {
                          paymentDisplay = typeof order.paymentMethod === 'string' ? order.paymentMethod : 'Payment details not available.';
                      }
                  }
                  %>
                  <p><%= paymentDisplay %></p>
                </div>
              </div>
              <!-- Coupon -->
              <% if (order.coupon) { %>
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Coupon</h3>
                <div class="text-sm space-y-2 text-gray-300">
                  <p class="font-semibold"><%= order.coupon.code || 'Coupon Applied' %></p>
                  <p><%= order.coupon.description || '' %></p>
                  <% if (order.coupon.discountType === 'percentage') { %>
                  <p class="text-brand"><%= order.coupon.discountValue %>% off</p>
                  <% } else { %>
                  <p class="text-brand">₹<%= order.coupon.discountValue || 0 %> off</p>
                  <% } %>
                </div>
              </div>
              <% } %>
              <!-- Actions -->
              <div class="space-y-3">
                <button id="orderReportBtn" class="block w-full border border-gray-600 py-3 rounded font-semibold hover:border-brand transition text-center">Order Report (PDF)</button>
                
                <% if (order.address && order.address.geolocation && order.address.geolocation.trim() !== '') { %>
                  <% 
                    let mapUrl = order.address.geolocation; 
                    if (!mapUrl.startsWith('http')) {
                        mapUrl = `https://www.google.com/maps?q=${mapUrl}`;
                    }
                  %>
                  <a href="<%= mapUrl %>" target="_blank" class="block w-full btn btn-secondary py-3 rounded font-semibold transition text-center flex items-center justify-center gap-2">
                    <i data-lucide="map-pin" class="w-4 h-4"></i>
                    View Location on Map
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    <!-- Error Popup Modal -->
    <div
      id="errorPopup"
      class="hidden fixed top-5 right-5 bg-red-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="alert-circle" class="w-5 h-5"></i>
      <span id="errorMessage">Something went wrong!</span>
      <button id="closeErrorPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <!-- Success Popup Modal -->
    <div
      id="successPopup"
      class="hidden fixed top-5 right-5 bg-green-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="check-circle" class="w-5 h-5"></i>
      <span id="successMessage">Success!</span>
      <button id="closeSuccessPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <script>
      lucide.createIcons();
      // Order Report
      const orderReportBtn = document.getElementById('orderReportBtn');
      if (orderReportBtn) {
        orderReportBtn.addEventListener('click', async () => {
          try {
            // Directly open in new tab or trigger download
             window.location.href = `/admin/orders/<%= order._id %>/export`;
          } catch (err) {
            showErrorPopup('Error exporting order: ' + err.message);
          }
        });
      }
      // Function to show error popup
      function showErrorPopup(message) {
        const popup = document.getElementById("errorPopup");
        const messageElement = document.getElementById("errorMessage");
        messageElement.textContent = message || "An unexpected error occurred.";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        // Auto-hide after 4 seconds
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }
      // Close manually
      document.getElementById("closeErrorPopup").addEventListener("click", () => {
        document.getElementById("errorPopup").classList.add("hidden");
      });
      // Function to show success popup
      function showSuccessPopup(message) {
        const popup = document.getElementById("successPopup");
        const messageElement = document.getElementById("successMessage");
        messageElement.textContent = message || "Success!";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        // Auto-hide after 4 seconds
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }
      // Close success popup manually
      document.getElementById("closeSuccessPopup").addEventListener("click", () => {
        document.getElementById("successPopup").classList.add("hidden");
      });
      // Display server-side flash messages on load
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        showErrorPopup("<%= errorMessage %>");
      <% } %>
      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        showSuccessPopup("<%= successMessage %>");
      <% } %>

      // Status Update Intercept
      document.getElementById('statusUpdateForm').addEventListener('submit', function(e) {
        const select = document.getElementById('statusSelect');
        const initialStatus = "<%= order.orderStatus %>";
        const selectedStatus = select.value;
        
        // Define Status Flow
        const statusFlow = ['Placed', 'Shipped', 'Out for Delivery', 'Delivered'];
        
        // If user manually selected a DIFFERENT status, let it submit normally
        if (selectedStatus && selectedStatus !== initialStatus) {
            return; 
        }

        // If user didn't change status (or selected same), assume "Next Status" intent
        e.preventDefault(); // Stop creating post request immediately

        const currentIndex = statusFlow.indexOf(initialStatus);
        
        if (currentIndex === -1 || currentIndex === statusFlow.length - 1) {
            // Already at end or unknown status, just submit current (likely to fail or refresh)
            // Or show info that no next status exists
            if (initialStatus === 'Delivered') {
                 showErrorPopup("Order is already Delivered.");
                 return;
            }
             this.submit();
             return;
        }

        const nextStatus = statusFlow[currentIndex + 1];

        // SweetAlert Confirmation
        Swal.fire({
            title: 'Update Status?',
            text: `Are you sure you want to change status from "${initialStatus}" to "${nextStatus}"?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#000000', // Black confirm
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Update',
            background: '#1a1a1a', // Dark background for theme
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                // Set the select to the next status
                select.value = nextStatus;
                // Submit the form
                this.submit();
            }
        });
      });
    </script>
  </body>
</html>