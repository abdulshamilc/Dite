<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Coupon - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style/admin/coupons/editCoupons.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header -->
    <%- include("../../partials/admin/admin-header") %>
    
    <div class="flex">
      <!-- Sidebar -->
      <%- include("../../partials/admin/admin-sidebar") %>
      
      <!-- Content -->
      <main class="flex-1 p-6">
        <div class="max-w-4xl mx-auto">
          <!-- Back Link -->
          <a href="/admin/coupons" class="text-sm text-brand hover:underline mb-4 inline-block flex items-center gap-2">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Coupons
          </a>

          <h1 class="text-3xl font-bold mb-8">Edit Coupon</h1>

          <div class="card p-8">
            <form id="editCouponForm" action="/admin/coupons/edit/<%= coupon._id %>" method="POST">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="form-group">
                  <label for="couponName">Name <span class="required-asterisk">*</span></label>
                  <input type="text" id="couponName" name="name" maxlength="255" value="<%= coupon.name %>">
                  <div class="error-message" id="nameError">Name is required.</div>
                </div>

                <!-- Code (Read Only) -->
                <div class="form-group">
                  <label>Coupon Code (Cannot be changed)</label>
                  <input type="text" value="<%= coupon.code %>" disabled class="bg-gray-700 cursor-not-allowed">
                </div>
              </div>

              <!-- Description -->
              <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="1000" rows="3"><%= coupon.description || '' %></textarea>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Discount Type -->
                <div class="form-group">
                  <label for="discountType">Discount Type <span class="required-asterisk">*</span></label>
                  <select id="discountType" name="discountType">
                    <option value="percentage" <%= coupon.discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                    <option value="flat" <%= coupon.discountType === 'flat' ? 'selected' : '' %>>Flat (Rs)</option>
                  </select>
                </div>

                <!-- Discount Value -->
                <div class="form-group">
                  <label for="discountValue">Discount Value <span class="required-asterisk">*</span></label>
                  <input type="number" id="discountValue" name="discountValue" min="0" step="0.01" value="<%= coupon.discountValue %>">
                  <div class="error-message" id="discountValueError">Invalid discount value.</div>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Min Cart Value -->
                <div class="form-group">
                  <label for="minCartValue">Min Cart Value <span class="required-asterisk">*</span></label>
                  <input type="number" id="minCartValue" name="minCartValue" min="0" value="<%= coupon.minCartValue %>">
                </div>

                <!-- Max Discount Amount (Visible if percentage, else default 0 or hidden) -->
                <div class="form-group" id="maxDiscountDiv">
                  <label for="maxDiscountAmount">Max Discount (Amount) <span class="required-asterisk">*</span></label>
                  <input type="number" id="maxDiscountAmount" name="maxDiscountAmount" min="0" value="<%= coupon.maxDiscountAmount || 0 %>">
                </div>
              </div>

              <!-- Usage Limit -->
              <div class="form-group">
                  <label for="usageLimit">Usage Limit <span class="required-asterisk">*</span></label>
                  <input type="number" id="usageLimit" name="usageLimit" min="1" value="<%= coupon.usageLimit %>">
                  <div class="error-message" id="usageLimitError">Usage limit must be at least 1.</div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                  <% 
                    const todayStr = new Date().toISOString().split('T')[0];
                    const startStr = new Date(coupon.startDate).toISOString().split('T')[0];
                    // If current start date is in past, allow it (min = startStr), else min = today
                    const minStart = startStr < todayStr ? startStr : todayStr;
                    // End date min: max(today, startStr)
                    const minEnd = startStr > todayStr ? startStr : todayStr;
                  %>
                  <!-- Start Date -->
                  <div class="form-group">
                    <label for="startDate">Start Date <span class="required-asterisk">*</span></label>
                    <input type="date" id="startDate" name="startDate" 
                           value="<%= startStr %>"
                           min="<%= minStart %>">
                    <div class="error-message" id="startDateError">Start date is required.</div>
                  </div>
  
                  <!-- End Date -->
                  <div class="form-group">
                    <label for="endDate">End Date <span class="required-asterisk">*</span></label>
                    <input type="date" id="endDate" name="endDate" 
                           value="<%= new Date(coupon.endDate).toISOString().split('T')[0] %>"
                           min="<%= minEnd %>">
                    <div class="error-message" id="endDateError">End date is required.</div>
                  </div>
              </div>

              <!-- Buttons -->
              <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-gray-700">
                <a href="/admin/coupons" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary hover:bg-[#b09476]">Update Coupon</button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>

    <script>
      lucide.createIcons();
      
      // Dynamic Max Discount Visibility
      const typeSelect = document.getElementById('discountType');
      const maxDiscountDiv = document.getElementById('maxDiscountDiv');
      
      function toggleMaxDiscount() {
        if(typeSelect.value === 'flat') {
          // For flat, max discount is irrelevant (or same as value), can hide or disable
          document.getElementById('maxDiscountAmount').value = 0;
          maxDiscountDiv.style.opacity = '0.5';
          document.getElementById('maxDiscountAmount').readOnly = true;
        } else {
          maxDiscountDiv.style.opacity = '1';
          document.getElementById('maxDiscountAmount').readOnly = false;
        }
      }
      typeSelect.addEventListener('change', toggleMaxDiscount);
      // Run once on load
      toggleMaxDiscount();
      
      // Date Logic for Edit
      const startInput = document.getElementById('startDate');
      const endInput = document.getElementById('endDate');
      
      // Enforce restrictions when user *changes* the dates
      startInput.addEventListener('change', function() {
        const startVal = this.value;
        if (!startVal) return;
        
        const startDate = new Date(startVal);
        const today = new Date();
        today.setHours(0,0,0,0);
        
        if (startDate < today) {
             Swal.fire({
                icon: 'warning',
                title: 'Invalid Date',
                text: 'Start Date cannot be in the past.',
                confirmButtonColor: '#d33'
            });
            this.value = new Date().toISOString().split('T')[0];
            return;
        }
        
        // Update End Date Min
        const minEnd = new Date(startDate);
        minEnd.setDate(minEnd.getDate() + 1);
        endInput.min = minEnd.toISOString().split('T')[0];
        
        // If current end date is invalid vs new start date
        if (endInput.value) {
            const endDate = new Date(endInput.value);
            if (endDate <= startDate) {
                endInput.value = '';
            }
        }
      });
      
      endInput.addEventListener('change', function() {
         const startVal = startInput.value;
         const endVal = this.value;
         
         if (!startVal) {
             Swal.fire({
                icon: 'warning',
                title: 'Missing Start Date',
                text: 'Please check Start Date first.',
                confirmButtonColor: '#d33'
            });
            this.value = '';
            return;
         }
         
         const startDate = new Date(startVal);
         const endDate = new Date(endVal);
         
         if (endDate <= startDate) {
             Swal.fire({
                icon: 'warning',
                title: 'Invalid Date Range',
                text: 'End Date must be after Start Date.',
                confirmButtonColor: '#d33'
            });
            this.value = '';
         }
      });

      // Form Validation
      document.getElementById('editCouponForm').addEventListener('submit', function(e) {
        let hasError = false;

        if(!document.getElementById('couponName').value.trim()) {
           document.getElementById('nameError').style.display = 'block';
           hasError = true;
        }
        
        const discountVal = parseFloat(document.getElementById('discountValue').value);
        if(isNaN(discountVal) || discountVal <= 0) {
           document.getElementById('discountValueError').style.display = 'block';
           hasError = true;
        }

        const usage = parseInt(document.getElementById('usageLimit').value);
        if(isNaN(usage) || usage < 1) {
           document.getElementById('usageLimitError').style.display = 'block';
           hasError = true;
        }

        const start = document.getElementById('startDate').value;
        const end = document.getElementById('endDate').value;
        if(!start) {
            document.getElementById('startDateError').style.display = 'block';
            hasError = true;
        }
        if(!end) {
            document.getElementById('endDateError').style.display = 'block';
            hasError = true;
        }
        
        if(start && end && new Date(end) <= new Date(start)) {
             Swal.fire({
                icon: 'warning',
                title: 'Invalid Date Range',
                text: 'End Date must be after Start Date.',
                confirmButtonColor: '#d33'
            });
            hasError = true;
        }

        if(hasError) e.preventDefault();
      });
    </script>
  </body>
</html>
