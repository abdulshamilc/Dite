  <!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Offers</title>
      <script src="https://cdn.tailwindcss.com"></script>
      <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <link rel="stylesheet" href="/style/admin/offers/offers.css">
    </head>
    <body class="min-h-screen bg-black text-white">
      <!-- Header Partial -->
      <%- include("../../partials/admin/admin-header") %>

      <div class="flex">
        <!-- Sidebar Partial -->
        <%- include("../../partials/admin/admin-sidebar") %>

        <!-- Page Content -->
        <main class="flex-1 p-6">
          <!-- Heading + Add Button -->
          <div class="flex justify-between items-center mb-4">
            <h1 class="text-2xl font-bold">Offer Management</h1>
            <button onclick="openAddOfferModal()" class="bg-green-600 px-4 py-2 rounded hover:bg-green-700">
              + Add Offer
            </button>
          </div>

          <!-- Counts -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="count-box">
              <p class="text-gray-400">Total Offers</p>
              <p class="text-xl font-bold"><%= totalOffers %></p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Active Offers</p>
              <p class="text-xl font-bold text-green-400">
                <%= activeOffersCount %>
              </p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Inactive Offers</p>
              <p class="text-xl font-bold text-red-400">
                <%= inactiveOffersCount %>
              </p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Total Discount Value</p>
              <p class="text-xl font-bold">
                Rs.<%= totalDiscountCount[0].totalDiscount %>
              </p>
            </div>
          </div>

          <!-- Filter + Search -->
          <div class="flex justify-between mb-4">
            <span>All Offers</span>
            <div class="flex space-x-4">
              <select id="statusFilter" class="bg-gray-800 p-2 rounded">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
              <div class="flex space-x-2">
                <input
                  type="text"
                  id="searchInput"
                  placeholder="Search Offer Name or ID..."
                  class="bg-gray-800 p-2 rounded"
                />
                <button
                  id="clearSearch"
                  class="bg-gray-600 px-3 py-2 rounded hover:bg-gray-700"
                  title="Clear Search"
                >
                  <i data-lucide="x" class="w-5 h-5"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Offers Table -->
          <div class="overflow-x-auto">
            <table class="min-w-full table-auto border-collapse">
              <thead>
                <tr class="bg-gray-800">
                  <th class="px-4 py-2 text-left">NAME</th>
                  <th class="px-4 py-2 text-left">APPLIES TO</th>
                  <th class="px-4 py-2 text-left">START DATE</th>
                  <th class="px-4 py-2 text-left">END DATE</th>
                  <th class="px-4 py-2 text-left">DISCOUNT</th>
                  <th class="px-4 py-2 text-left">TYPE</th>
                  <th class="px-4 py-2 text-left">STATUS</th>
                </tr>
              </thead>
              <tbody>
                <% offers.forEach(offer => { %>
                <tr class="border-b border-gray-700 hover:bg-gray-900 cursor-pointer" onclick="window.location.href='/admin/offers/<%= offer._id %>'">
                  <td class="px-4 py-2"><%= offer.name %></td>
                  <td class="px-4 py-2">
                    <%= offer.appliesTo %>: 
                    <% 
                      if (offer.targetId) {
                        if (Array.isArray(offer.targetId)) {
                          const names = offer.targetId.map(t => t ? t.name : 'Unknown').join(', ');
                          %><%= names %><%
                        } else {
                          %><%= offer.targetId.name || 'N/A' %><%
                        }
                      } else {
                        %>N/A<%
                      }
                    %>
                  </td>
                  <td class="px-4 py-2"><%= new Date(offer.startDate).toLocaleDateString() %></td>
                  <td class="px-4 py-2"><%= new Date(offer.endDate).toLocaleDateString() %></td>
                  <td class="px-4 py-2">
                    <%= offer.discountType === 'percentage' ? offer.discountValue + '%' : 'Rs ' + offer.discountValue %>
                  </td>
                  <td class="px-4 py-2">
                    <%= offer.discountType.charAt(0).toUpperCase() + offer.discountType.slice(1) %>
                  </td>
                  <td class="px-4 py-2">
                    <% if(offer.isActive) { %>
                    <span class="status-active">Active</span>
                    <% } else { %>
                    <span class="status-inactive">Inactive</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Pagination and Page Limit -->
          <div class="flex justify-between items-center mt-4">
            <!-- Pagination -->
            <div class="flex-1 flex justify-center items-center space-x-4">
              <% if (totalPages > 1) { %>
                <% if (currentPage > 1) { %>
                  <a
                    href="/admin/offers?page=<%= currentPage - 1 %>&limit=<%= limit %>"
                    class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
                  >
                    <i data-lucide="chevron-left" class="w-5 h-5"></i>
                  </a>
                <% } %>
                <span class="text-gray-400"><%= currentPage %> / <%= totalPages %></span>
                <% if (currentPage < totalPages) { %>
                  <a
                    href="/admin/offers?page=<%= currentPage + 1 %>&limit=<%= limit %>"
                    class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
                  >
                    <i data-lucide="chevron-right" class="w-5 h-5"></i>
                  </a>
                <% } %>
              <% } %>
            </div>

            <!-- Page Limit -->
            <div class="flex items-center space-x-2">
              <label for="pageLimit" class="text-gray-400">Show</label>
              <select id="limitSelect" onchange="changePageLimit(this.value)">
                <option value="5" <%= limit == 5 ? "selected" : "" %>>5</option>
                <option value="10" <%= limit == 10 ? "selected" : "" %>>10</option>
                <option value="20" <%= limit == 20 ? "selected" : "" %>>20</option>
                <option value="50" <%= limit == 50 ? "selected" : "" %>>50</option>
              </select>
              <span class="text-gray-400">per page</span>
            </div>
          </div>
        </main>
      </div>

      <!-- Add Offer Modal -->
      <div id="addOfferModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50 p-4">
        <div class="add-offer-modal w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-lg">
          <div class="add-offer-modal-title">Add New Offer</div>
          <form id="addOfferForm" class="add-offer-form" action="/admin/offers" method="POST">
            <div class="form-group">
              <label for="offerName">Name <span class="required-asterisk">*</span></label>
              <input type="text" id="offerName" name="name" maxlength="255" />
              <div class="error-message" id="nameError">Name is required.</div>
            </div>
            <div class="form-group">
              <label for="offerDescription">Description</label>
              <textarea id="offerDescription" name="description" maxlength="1000"></textarea>
            </div>
            <div class="form-group">
              <label for="discountType">Discount Type <span class="required-asterisk">*</span></label>
              <select id="discountType" name="discountType">
                <option value="">Select discount type...</option>
                <option value="percentage">Percentage (%)</option>
                <option value="flat">Flat (Rs)</option>
              </select>
              <div class="error-message" id="discountTypeError">Discount type is required.</div>
            </div>
            <div class="form-group">
              <label for="discountValue">Discount Value <span class="required-asterisk">*</span></label>
              <input type="number" id="discountValue" name="discountValue" min="0" step="0.01" />
              <div class="error-message" id="discountValueError">Discount value must be greater than 0.</div>
            </div>
            <div class="form-group">
              <label>Applies To <span class="required-asterisk">*</span></label>
              <div class="radio-group">
                <div class="radio-option">
                  <input type="radio" id="appliesToProduct" name="appliesTo" value="product" />
                  <label for="appliesToProduct">Product</label>
                </div>
                <div class="radio-option">
                  <input type="radio" id="appliesToCategory" name="appliesTo" value="category" />
                  <label for="appliesToCategory">Categories</label>
                </div>
              </div>
              <div class="error-message" id="appliesToError">Please select what the offer applies to.</div>
            </div>
            <!-- Product Select Section -->
            <div id="productSelect" class="target-select">
              <label>Select Products (Multiple) <span class="required-asterisk">*</span></label>
              <div class="product-options">
                <% if (typeof products !== 'undefined' && products.length > 0) { %>
                  <% products.forEach(product => { %>
                    <div class="product-option <% if (product.variants && product.variants.length > 0) { %>has-variants<% } %>" onclick="toggleProduct(event, '<%= product._id %>')">
                      <input type="checkbox" name="targetId" value="<%= product._id %>" style="display: none;" />
                      <img src="<%= product.images && product.images.length > 0 ? product.images[0] : '/placeholder.jpg' %>" alt="<%= product.name %>" />
                      <div>
                        <div class="font-bold"><%= product.name %></div>
                        <div class="text-sm text-gray-400">
                          <% if (product.variants && product.variants.length > 0) { %>
                            Rs <%= product.variants[0].basePrice %> 
                          <% } else if (product.price) { %>
                            Rs <%= product.price %> 
                          <% } else { %>
                            Base Price: N/A
                          <% } %> - <%= product.description ? product.description.substring(0, 50) + '...' : 'No description' %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p class="text-gray-400">No products available.</p>
                <% } %>
              </div>
              <div class="error-message" id="productError">Please select at least one product.</div>
            </div>
            <!-- Category Select Section -->
            <div id="categorySelect" class="target-select">
              <label>Select Categories <span class="required-asterisk">*</span></label>
              <select name="targetId" class="category-select">
                <option value="">Choose a category...</option>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                  <% categories.forEach(category => { %>
                    <option value="<%= category._id %>"><%= category.name %> - <%= category.description ? category.description.substring(0, 50) + '...' : 'No description' %></option>
                  <% }) %>
                <% } else { %>
                  <option value="">No categories available.</option>
                <% } %>
              </select>
              <div class="error-message" id="categoryError">Please select a category.</div>
            </div>
            <div class="form-group">
              <label for="startDate">Start Date <span class="required-asterisk">*</span></label>
              <input type="date" id="startDate" name="startDate" />
              <div class="error-message" id="startDateError">Start date is required.</div>
            </div>
            <div class="form-group">
              <label for="endDate">End Date <span class="required-asterisk">*</span></label>
              <input type="date" id="endDate" name="endDate" />
              <div class="error-message" id="endDateError">End date is required and must be after start date.</div>
            </div>
            <div class="modal-buttons">
              <button type="button" onclick="closeAddOfferModal()" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700">Cancel</button>
              <button type="submit" class="px-4 py-2 bg-green-600 rounded hover:bg-green-700">Add Offer</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Error Popup Modal -->
      <div
        id="errorPopup"
        class="hidden fixed top-5 right-5 bg-red-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
      >
        <i data-lucide="alert-circle" class="w-5 h-5"></i>
        <span id="errorMessage">Something went wrong!</span>
        <button id="closeErrorPopup" class="ml-3 hover:text-gray-300">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Success Popup Modal -->
      <div
        id="successPopup"
        class="hidden fixed top-5 right-5 bg-green-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
      >
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span id="successMessage">Success!</span>
        <button id="closeSuccessPopup" class="ml-3 hover:text-gray-300">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- JS for actions -->
      <script>
        lucide.createIcons();

        // Modal functions
        function openAddOfferModal() {
          document.getElementById('addOfferModal').classList.remove('hidden');
          document.getElementById('addOfferForm').reset();
          // Set default discount type
          document.getElementById('discountType').value = '';
          // Hide both selects initially
          document.getElementById('productSelect').classList.remove('active');
          document.getElementById('categorySelect').classList.remove('active');
          // Clear all errors
          clearFormErrors();
          // Clear product selections
          document.querySelectorAll('#productSelect input[type="checkbox"]').forEach(checkbox => checkbox.checked = false);
          document.querySelectorAll('.product-option').forEach(opt => opt.classList.remove('selected'));
          // Set min date for startDate to today
          const today = new Date().toISOString().split('T')[0];
          document.getElementById('startDate').min = today;
          document.getElementById('startDate').value = today; // Default to today
          document.getElementById('endDate').min = today;
          document.getElementById('endDate').value = '';
          // Set max date for endDate to 1 year from today
          const oneYearFromToday = new Date();
          oneYearFromToday.setFullYear(oneYearFromToday.getFullYear() + 1);
          document.getElementById('endDate').max = oneYearFromToday.toISOString().split('T')[0];
        }

        function closeAddOfferModal() {
          document.getElementById('addOfferModal').classList.add('hidden');
          clearFormErrors();
        }

        function clearFormErrors() {
          const errorElements = document.querySelectorAll('.error-message');
          errorElements.forEach(el => {
            el.style.display = 'none';
          });
          const inputElements = document.querySelectorAll('.add-offer-form input, .add-offer-form select');
          inputElements.forEach(el => {
            el.classList.remove('error');
          });
        }

        function showFieldError(fieldId, message) {
          const errorEl = document.getElementById(fieldId + 'Error');
          if (errorEl) {
            errorEl.textContent = message;
            errorEl.style.display = 'block';
          }
          const field = document.getElementById(fieldId);
          if (field) {
            field.classList.add('error');
          }
        }

        // Handle appliesTo radio change
        document.querySelectorAll('input[name="appliesTo"]').forEach(radio => {
          radio.addEventListener('change', function() {
            const appliesTo = this.value;
            document.getElementById('productSelect').classList.toggle('active', appliesTo === 'product');
            document.getElementById('categorySelect').classList.toggle('active', appliesTo === 'category');
            // Reset targetId selections and errors
            if (appliesTo === 'product') {
              document.querySelectorAll('#productSelect input[type="checkbox"]').forEach(checkbox => checkbox.checked = false);
              document.querySelectorAll('.product-option').forEach(opt => opt.classList.remove('selected'));
              document.getElementById('productError').style.display = 'none';
            } else {
              document.querySelector('#categorySelect select').value = '';
              document.getElementById('categoryError').style.display = 'none';
            }
            document.getElementById('appliesToError').style.display = 'none';
          });
        });

        // Handle product toggle (multiple selection)
        function toggleProduct(event, id) {
          const checkbox = document.querySelector(`#productSelect input[value="${id}"]`);
          const option = event.currentTarget;

          // Toggle checkbox
          checkbox.checked = !checkbox.checked;

          // Toggle selected class
          if (checkbox.checked) {
            option.classList.add('selected');
          } else {
            option.classList.remove('selected');
          }

          // Hide error if at least one selected
          const selectedCount = document.querySelectorAll('#productSelect input[type="checkbox"]:checked').length;
          if (selectedCount > 0) {
            document.getElementById('productError').style.display = 'none';
          }

          // Visual feedback
          option.style.background = '#c5a987';
          setTimeout(() => { option.style.background = ''; }, 200);
        }

        // Handle startDate change to update endDate min
        document.getElementById('startDate').addEventListener('change', function() {
          const start = this.value;
          const endInput = document.getElementById('endDate');
          if (start) {
            endInput.min = start;
            if (endInput.value < start) {
              endInput.value = '';
            }
          }
          document.getElementById('startDateError').style.display = 'none';
          this.classList.remove('error');
        });

        // Date validation (endDate > startDate)
        document.getElementById('endDate').addEventListener('change', function() {
          const start = document.getElementById('startDate').value;
          const end = this.value;
          if (start && end && new Date(end) <= new Date(start)) {
            showFieldError('endDate', 'End date must be after start date.');
            this.value = '';
          } else {
            document.getElementById('endDateError').style.display = 'none';
            this.classList.remove('error');
          }
        });

        // Form validation before submit
        document.getElementById('addOfferForm').addEventListener('submit', function(e) {
          clearFormErrors();
          let hasErrors = false;
          let errorMessages = [];

          // Name
          const name = document.getElementById('offerName').value.trim();
          if (!name) {
            showFieldError('offerName', 'Name is required.');
            hasErrors = true;
            errorMessages.push('Name is required.');
          }

          // Discount Type
          const discountType = document.getElementById('discountType').value;
          if (!discountType) {
            showFieldError('discountType', 'Discount type is required.');
            hasErrors = true;
            errorMessages.push('Discount type is required.');
          }

          // Discount Value
          const discountValue = parseFloat(document.getElementById('discountValue').value);
          if (isNaN(discountValue) || discountValue <= 0) {
            showFieldError('discountValue', 'Discount value must be greater than 0.');
            hasErrors = true;
            errorMessages.push('Discount value must be greater than 0.');
          } else if (discountType === 'percentage' && discountValue > 100) {
            showFieldError('discountValue', 'Percentage discount cannot exceed 100%.');
            hasErrors = true;
            errorMessages.push('Percentage discount cannot exceed 100%.');
          }

          // Applies To
          const appliesTo = document.querySelector('input[name="appliesTo"]:checked');
          if (!appliesTo) {
            showFieldError('appliesTo', 'Please select what the offer applies to.');
            hasErrors = true;
            errorMessages.push('Please select applies to.');
          }

          // Target ID
          let targetId = null;
          if (appliesTo && appliesTo.value === 'product') {
            const selectedProducts = document.querySelectorAll('#productSelect input[type="checkbox"]:checked');
            if (selectedProducts.length === 0) {
              showFieldError('product', 'Please select at least one product.');
              hasErrors = true;
              errorMessages.push('Please select at least one product.');
            }
          } else if (appliesTo && appliesTo.value === 'category') {
            targetId = document.querySelector('#categorySelect select').value;
            if (!targetId) {
              showFieldError('category', 'Please select a category.');
              hasErrors = true;
              errorMessages.push('Please select a category.');
            }
          }

          // Start Date
          const startDate = document.getElementById('startDate').value;
          if (!startDate) {
            showFieldError('startDate', 'Start date is required.');
            hasErrors = true;
            errorMessages.push('Start date is required.');
          }

          // End Date
          const endDate = document.getElementById('endDate').value;
          if (!endDate) {
            showFieldError('endDate', 'End date is required.');
            hasErrors = true;
            errorMessages.push('End date is required.');
          } else if (startDate && new Date(endDate) <= new Date(startDate)) {
            showFieldError('endDate', 'End date must be after start date.');
            hasErrors = true;
            errorMessages.push('End date must be after start date.');
          }

          if (hasErrors) {
            e.preventDefault();
            showErrorPopup(errorMessages.join(' '));
          }
        });

        // Handle page limit change
        function changePageLimit(limit) {
          const url = new URL(window.location.href);
          url.searchParams.set("limit", limit);
          url.searchParams.set("page", 1);
          window.location.href = url.toString();
        }

        // Function to filter table rows based on search and status
        function filterTable() {
          const searchQuery = document.getElementById("searchInput").value.trim().toLowerCase();
          const statusFilter = document.getElementById("statusFilter").value;
          const rows = document.querySelectorAll("tbody tr");

          rows.forEach((row) => {
            const name = row.cells[0].textContent.toLowerCase();
            const appliesTo = row.cells[1].textContent.toLowerCase();
            const status = row
              .querySelector("td:nth-child(7) span")
              .textContent.toLowerCase();

            const matchesSearch = searchQuery === "" || name.includes(searchQuery) || appliesTo.includes(searchQuery);
            const matchesStatus =
              statusFilter === "all" ||
              (statusFilter === "active" && status === "active") ||
              (statusFilter === "inactive" && status === "inactive");

            row.style.display = matchesSearch && matchesStatus ? "" : "none";
          });
        }

        // Search functionality (triggered by Enter key)
        document.getElementById("searchInput").addEventListener("keypress", function (event) {
          if (event.key === "Enter") {
            event.preventDefault();
            filterTable();
          }
        });

        // Clear search
        document.getElementById("clearSearch").addEventListener("click", () => {
          document.getElementById("searchInput").value = "";
          filterTable();
        });

        // Status filter
        document.getElementById("statusFilter").addEventListener("change", filterTable);

        // Function to show error popup
        function showErrorPopup(message) {
          const popup = document.getElementById("errorPopup");
          const messageElement = document.getElementById("errorMessage");

          messageElement.textContent = message || "An unexpected error occurred.";
          popup.classList.remove("hidden");
          popup.classList.add("opacity-100", "translate-y-0");

          // Auto-hide after 4 seconds
          setTimeout(() => {
            popup.classList.add("hidden");
          }, 4000);
        }

        // Close manually
        document.getElementById("closeErrorPopup").addEventListener("click", () => {
          document.getElementById("errorPopup").classList.add("hidden");
        });

        // Function to show success popup
        function showSuccessPopup(message) {
          const popup = document.getElementById("successPopup");
          const messageElement = document.getElementById("successMessage");

          messageElement.textContent = message || "Success!";
          popup.classList.remove("hidden");
          popup.classList.add("opacity-100", "translate-y-0");

          // Auto-hide after 4 seconds
          setTimeout(() => {
            popup.classList.add("hidden");
          }, 4000);
        }

        // Close success popup manually
        document.getElementById("closeSuccessPopup").addEventListener("click", () => {
          document.getElementById("successPopup").classList.add("hidden");
        });

        // Display server-side flash messages on load
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          showErrorPopup("<%= errorMessage %>");
        <% } %>
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
          showSuccessPopup("<%= successMessage %>");
        <% } %>

        // Close modal on outside click
        document.getElementById('addOfferModal').addEventListener('click', function(e) {
          if (e.target === this) closeAddOfferModal();
        });
      </script>
    </body>
  </html>