<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
  <link rel="stylesheet" href="/style/admin/products/addProducts.css">
</head>
<body class="min-h-screen bg-black">
  <!-- Header Partial -->
  <%- include("../../partials/admin/admin-header") %>
  <div class="flex">
    <!-- Sidebar Partial -->
    <%- include("../../partials/admin/admin-sidebar") %>
    <!-- Page Content -->
    <main class="flex-1 p-6 text-white">
      <button
        id="toggle-sidebar-mobile"
        class="lg:hidden fixed top-4 left-4 text-white focus:outline-none"
      >
        <i data-lucide="menu"></i>
      </button>
      <div class="form-container">
        <h2 class="text-2xl font-bold text-center mb-6">Add Products</h2>
        <form
          action="/admin/products/add-product"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-6"
          id="product-form"
        >
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium mb-2">Product Name <span class="required">*</span></label>
              <input
                type="text"
                name="name"
                placeholder="Enter product name..."
                class="w-full p-3 bg-gray-800 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                id="product-name"
                required
              />
              <div class="error-message" id="name-error"></div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Product Description <span class="required">*</span></label>
              <textarea
                name="description"
                placeholder="Enter product description..."
                class="w-full p-3 bg-gray-800 border-none rounded text-white h-24 focus:outline-none focus:ring-2 focus:ring-brand"
                id="description"
                required
              ></textarea>
              <div class="error-message" id="description-error"></div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Notes <span class="required">*</span></label>
              <textarea
                name="notes"
                placeholder="Enter additional notes..."
                class="w-full p-3 bg-gray-800 border-none rounded text-white h-24 focus:outline-none focus:ring-2 focus:ring-brand"
                id="notes"
                required
              ></textarea>
              <div class="error-message" id="notes-error"></div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Brand Name <span class="required">*</span></label>
              <input
                type="text"
                name="brand"
                placeholder="Enter brand name..."
                class="w-full p-3 bg-gray-800 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                id="brand"
                required
              />
              <div class="error-message" id="brand-error"></div>
            </div>
            <!-- Categories (Single Select) -->
            <div>
              <label class="block text-sm font-medium mb-2">Category <span class="required">*</span></label>
              <select
                name="category"
                class="w-full p-3 h-12 bg-gray-800 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                id="category-select"
                required
              >
                <option value="">Select a category</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category._id %>"><%= category.name %></option>
                <% }) %>
              </select>
              <div class="error-message" id="category-error"></div>
              <p class="text-sm text-gray-400 mt-1">Select a category for the product.</p>
            </div>
            <!-- Images -->
            <div>
              <label class="block text-sm font-medium mb-2">Edit Photos <span class="required">*</span></label>
              <div class="image-container mb-4">
                <% for (let i = 0; i < 4; i++) { %>
                <div class="image-group">
                  <div class="image-placeholder">
                    <img
                      id="preview-<%= i %>"
                      class="hidden w-24 h-32 object-cover"
                    />
                    <span id="placeholder-<%= i %>">Image <%= i + 1 %></span>
                  </div>
                  <input
                    type="file"
                    name="images"
                    accept="image/*"
                    class="hidden"
                    id="file-<%= i %>"
                    onchange="handleFileChange(event, <%= i %>)"
                    required
                  />
                  <button
                    type="button"
                    onclick="document.getElementById('file-<%= i %>').click()"
                    class="nav-btn bg-gray-700 text-white px-4 py-2 mt-2 rounded hover:bg-gray-800"
                  >
                    Add Image
                  </button>
                </div>
                <% } %>
              </div>
              <div class="error-message" id="images-error"></div>
            </div>
            <!-- Gender + Concentration -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium mb-2">Gender <span class="required">*</span></label>
                <select
                  name="gender"
                  class="w-full p-3 h-12 bg-gray-800 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                  id="gender"
                  required
                >
                  <option value="">Select Gender</option>
                  <option value="MEN">MEN</option>
                  <option value="WOMEN">WOMEN</option>
                  <option value="UNISEX">UNISEX</option>
                </select>
                <div class="error-message" id="gender-error"></div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-2">Concentration <span class="required">*</span></label>
                <select
                  name="concentration"
                  class="w-full p-3 h-12 bg-gray-800 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                  id="concentration"
                  required
                >
                  <option value="">Select Concentration</option>
                  <option value="Parfum">Parfum</option>
                  <option value="Eau de Parfum">Eau de Parfum</option>
                  <option value="Eau de Toilette">Eau de Toilette</option>
                  <option value="Eau de Cologne">Eau de Cologne</option>
                  <option value="Eau Fraiche">Eau Fraiche</option>
                </select>
                <div class="error-message" id="concentration-error"></div>
              </div>
            </div>
            <!-- Variants -->
            <div>
              <label class="block text-sm font-medium mb-2">Variants <span class="required">*</span></label>
              <div id="variants-container" class="space-y-4">
                <div class="variant-group grid grid-cols-1 sm:grid-cols-4 gap-4 p-4 bg-gray-800 rounded" data-variant-index="0">
                  <div>
                    <label class="block text-sm font-medium mb-2">Size (ml) <span class="required">*</span></label>
                    <select
                      name="variants[0][mlSize]"
                      class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                      id="ml-size-0"
                      required
                    >
                      <option value="">Select Size</option>
                      <option value="5">5 ml</option>
                      <option value="10">10 ml</option>
                      <option value="15">15 ml</option>
                      <option value="30">30 ml</option>
                      <option value="50">50 ml</option>
                      <option value="100">100 ml</option>
                      <option value="150">150 ml</option>
                      <option value="200">200 ml</option>
                      <option value="250">250 ml</option>
                      <option value="300">300 ml</option>
                    </select>
                    <div class="error-message" id="ml-size-error-0"></div>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Stock <span class="required">*</span></label>
                    <input
                      type="number"
                      name="variants[0][stock]"
                      placeholder="e.g., 100"
                      class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                      id="stock-0"
                      min="1"
                      required
                    />
                    <div class="error-message" id="stock-error-0"></div>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Base Price <span class="required">*</span></label>
                    <input
                      type="number"
                      name="variants[0][basePrice]"
                      placeholder="e.g., 100"
                      class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                      id="base-price-0"
                      min="1.01"
                      step="0.01"
                      required
                    />
                    <div class="error-message" id="base-price-error-0"></div>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Discounted Price <span class="required">*</span></label>
                    <input
                      type="number"
                      name="variants[0][discountedPrice]"
                      placeholder="e.g., 80"
                      class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
                      id="discounted-price-0"
                      min="0"
                      step="0.01"
                      required
                    />
                    <div class="error-message" id="discounted-price-error-0"></div>
                    <button
                      type="button"
                      id="add-variant"
                      class="nav-btn bg-gray-700 text-white px-4 py-2 mt-2 rounded hover:bg-gray-800 w-full"
                    >
                      Add Variant
                    </button>
                  </div>
                </div>
              </div>
              <div class="error-message mt-2" id="variants-error"></div>
            </div>
            <!-- Buttons -->
            <div class="flex justify-center space-x-4">
              <button
                type="button"
                id="cancel"
                class="logout-btn bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700"
                onclick="window.location.href='/admin/products'"
              >
                Cancel
              </button>
              <button
                type="submit"
                id="save"
                class="bg-brand text-white px-4 py-2 rounded hover:bg-yellow-700"
              >
                Save
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <!-- Crop Modal -->
  <div id="crop-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
    <div class="bg-gray-800 p-4 rounded-lg max-w-2xl w-full mx-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-white text-lg">Crop Image</h3>
        <button id="close-modal" class="text-white text-2xl">&times;</button>
      </div>
      <div class="relative bg-gray-900 rounded" style="height: 400px; width: 100%;">
        <img id="crop-image" class="absolute inset-0 w-full h-full object-contain mx-auto block" />
      </div>
      <div class="flex justify-end space-x-2 mt-4">
        <button id="cancel-crop" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">Cancel</button>
        <button id="apply-crop" class="bg-brand text-white px-4 py-2 rounded hover:bg-yellow-700">Apply Crop</button>
      </div>
    </div>
  </div>

  <script>
    lucide.createIcons();
    let croppers = {};
    let variantCount = 1;
    let currentIndex = null;
    window.croppedBlobs = {};
    // Existing product names for duplicate check
    const existingProductNames = [
      <% products.forEach(product => { %>
        "<%= product.name.toLowerCase() %>",
      <% }) %>
    ];
    // Toast notification function
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-xl text-white max-w-sm ${type === 'error' ? 'bg-red-500' : 'bg-green-500'}`;
      toast.textContent = message;
      toast.classList.add('toast');
      document.body.appendChild(toast);

      // Auto-hide after 3 seconds with fade-out
      setTimeout(() => {
        toast.classList.add('fade-out');
        setTimeout(() => {
          toast.remove();
        }, 300);
      }, 3000);
    }
    // Validation functions
    function showError(elementId, message) {
      const errorEl = document.getElementById(elementId);
      if (!errorEl) return;
      const field = errorEl.previousElementSibling;
      errorEl.textContent = message;
      errorEl.style.display = 'block';
      if (field && (field.tagName === 'INPUT' || field.tagName === 'TEXTAREA' || field.tagName === 'SELECT')) {
        field.classList.add('error-field');
      }
    }
    function hideError(elementId) {
      const errorEl = document.getElementById(elementId);
      if (!errorEl) return;
      errorEl.style.display = 'none';
      const field = errorEl.previousElementSibling;
      if (field && (field.tagName === 'INPUT' || field.tagName === 'TEXTAREA' || field.tagName === 'SELECT')) {
        field.classList.remove('error-field');
      }
    }
    function countWords(text) {
      return text.trim() ? text.trim().split(/\s+/).length : 0;
    }
    function validateImages() {
      const blobCount = Object.keys(window.croppedBlobs).length;
      if (blobCount !== 4) {
        showError('images-error', `Exactly 4 images are required (currently ${blobCount} cropped).`);
        return false;
      }
      hideError('images-error');
      return true;
    }
    function validateDescription() {
      const desc = document.getElementById('description').value;
      const wordCount = countWords(desc);
      if (wordCount < 10) {
        showError('description-error', 'Description must have at least 10 words.');
        return false;
      }
      if (wordCount > 150) {
        showError('description-error', 'Description must have at most 150 words.');
        return false;
      }
      hideError('description-error');
      return true;
    }
    function validateNotes() {
      const notes = document.getElementById('notes').value;
      const wordCount = countWords(notes);
      if (!notes.trim()) {
        showError('notes-error', 'Notes are required.');
        return false;
      }
      if (wordCount > 150) {
        showError('notes-error', 'Notes must have at most 150 words.');
        return false;
      }
      if (wordCount < 5) {
        showError('notes-error', 'Notes must have at least 5 words.');
        return false;
      }
      hideError('notes-error');
      return true;
    }
    function validateBrand() {
      const brand = document.getElementById('brand').value.trim();
      if (!brand) {
        showError('brand-error', 'Brand name is required.');
        return false;
      }
      if (brand.length < 3) {
        showError('brand-error', 'Brand name must be at least 3 characters.');
        return false;
      }
      if (brand.length > 24) {
        showError('brand-error', 'Brand name cannot exceed 24 characters.');
        return false;
      }
      if (!/[a-zA-Z]/.test(brand)) {
        showError('brand-error', 'Brand name must contain at least one letter.');
        return false;
      }
      // Optional: Check for special characters if "only char is not fine" meant no special chars?
      // Assuming alphanumeric + spaces is safe based on "combined is fine".
      if (!/^[a-zA-Z0-9\s]+$/.test(brand)) {
         showError('brand-error', 'Brand name can only contain letters, numbers, and spaces.');
         return false;
      }
      hideError('brand-error');
      return true;
    }
    function validateGender() {
      const gender = document.getElementById('gender').value;
      if (!gender) {
        showError('gender-error', 'Gender is required.');
        return false;
      }
      hideError('gender-error');
      return true;
    }
    function validateConcentration() {
      const concentration = document.getElementById('concentration').value;
      if (!concentration) {
        showError('concentration-error', 'Concentration is required.');
        return false;
      }
      hideError('concentration-error');
      return true;
    }
    function validateCategory() {
      const category = document.getElementById('category-select').value;
      if (!category) {
        showError('category-error', 'Category is required.');
        return false;
      }
      hideError('category-error');
      return true;
    }
    function validateVariant(index) {
      let valid = true;
      // ML Size
      const mlSize = document.getElementById(`ml-size-${index}`);
      if (!mlSize || !mlSize.value) {
        showError(`ml-size-error-${index}`, 'Size is required.');
        valid = false;
      } else {
        hideError(`ml-size-error-${index}`);
      }
      // Stock
      const stockEl = document.getElementById(`stock-${index}`);
      const stock = parseInt(stockEl.value);
      if (isNaN(stock) || stock < 1) {
        showError(`stock-error-${index}`, 'Stock must be at least 1.');
        valid = false;
      } else {
        hideError(`stock-error-${index}`);
      }
      // Base Price
      const basePriceEl = document.getElementById(`base-price-${index}`);
      const basePrice = parseFloat(basePriceEl.value);
      if (isNaN(basePrice) || basePrice <= 1) {
        showError(`base-price-error-${index}`, 'Base price must be greater than 1.');
        valid = false;
      } else {
        hideError(`base-price-error-${index}`);
      }
      // Discounted Price
      const discountedPriceEl = document.getElementById(`discounted-price-${index}`);
      const discountedPrice = parseFloat(discountedPriceEl.value);
      if (isNaN(discountedPrice) || discountedPrice > basePrice) {
        showError(`discounted-price-error-${index}`, 'Discounted price must be less than or equal to base price.');
        valid = false;
      } else {
        hideError(`discounted-price-error-${index}`);
      }
      return valid;
    }
    function validateAllVariants() {
      let valid = true;
      const variantGroups = document.querySelectorAll('.variant-group');
      const variantsError = document.getElementById('variants-error');
      if (variantGroups.length === 0) {
        if (variantsError) {
          variantsError.textContent = 'At least one variant is required.';
          variantsError.style.display = 'block';
        }
        valid = false;
      } else {
        if (variantsError) variantsError.style.display = 'none';
        variantGroups.forEach((group, index) => {
          if (!validateVariant(index)) {
            valid = false;
          }
        });
      }
      return valid;
    }
    function checkDuplicateName(name) {
      if (!name.trim()) return true; // Skip if empty
      const lowerName = name.trim().toLowerCase();
      return !existingProductNames.includes(lowerName);
    }
    // Modal functions
    function closeModal(cancel = false) {
      const modal = document.getElementById('crop-modal');
      modal.classList.add('hidden');
      if (croppers.modal) {
        croppers.modal.destroy();
        delete croppers.modal;
      }
      if (cancel && currentIndex !== null) {
        // Clear the file input if cancelled
        document.getElementById(`file-${currentIndex}`).value = '';
        // Reset preview
        const img = document.getElementById(`preview-${currentIndex}`);
        const placeholder = document.getElementById(`placeholder-${currentIndex}`);
        img.classList.add('hidden');
        img.src = '';
        placeholder.classList.remove('hidden');
        delete window.croppedBlobs[currentIndex];
        currentIndex = null;
        validateImages();
      }
    }
    async function applyCrop() {
      if (!croppers.modal) return;
      const canvas = croppers.modal.getCroppedCanvas({
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      });
      canvas.toBlob((blob) => {
        if (blob) {
          const reader = new FileReader();
          reader.onload = function(e) {
            const img = document.getElementById(`preview-${currentIndex}`);
            const placeholder = document.getElementById(`placeholder-${currentIndex}`);
            img.src = e.target.result;
            img.classList.remove('hidden');
            placeholder.classList.add('hidden');
            window.croppedBlobs[currentIndex] = blob;
            validateImages();
            closeModal(false);
            currentIndex = null;
          };
          reader.readAsDataURL(blob);
        } else {
          showToast('Failed to crop image. Please try again.', 'error');
          closeModal(true);
        }
      }, 'image/jpeg', 0.95);
    }
    // Event listeners for modal
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('close-modal').addEventListener('click', () => closeModal(true));
      document.getElementById('cancel-crop').addEventListener('click', () => closeModal(true));
      document.getElementById('apply-crop').addEventListener('click', applyCrop);
      // Close on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !document.getElementById('crop-modal').classList.contains('hidden')) {
          closeModal(true);
        }
      });
    });
    // Event listeners for real-time validation
    document.getElementById('product-name').addEventListener('blur', function() {
      const name = this.value.trim();
      if (!name) {
        showError('name-error', 'Product name is required.');
        return;
      }
      const isUnique = checkDuplicateName(name);
      if (!isUnique) {
        showError('name-error', 'Product name already exists. Please choose a unique name.');
      } else {
        hideError('name-error');
      }
    });
    document.getElementById('description').addEventListener('blur', validateDescription);
    document.getElementById('notes').addEventListener('blur', validateNotes);
    document.getElementById('brand').addEventListener('blur', validateBrand);
    document.getElementById('gender').addEventListener('change', validateGender);
    document.getElementById('concentration').addEventListener('change', validateConcentration);
    document.getElementById('category-select').addEventListener('change', validateCategory);
    // Variant real-time validation
    document.addEventListener('input', function(e) {
      if (e.target.matches('[id^="stock-"], [id^="base-price-"], [id^="discounted-price-"]')) {
        const index = e.target.id.split('-')[2];
        validateVariant(index);
      }
    });
    document.addEventListener('change', function(e) {
      if (e.target.matches('[id^="ml-size-"]')) {
        const index = e.target.id.split('-')[2];
        validateVariant(index);
      }
    });
    // Form submission validation
    document.getElementById('product-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const submitButton = document.getElementById('save');
      const originalButtonText = submitButton.textContent;
      
      // Disable button and show loading
      submitButton.disabled = true;
      submitButton.textContent = 'Saving...';
      submitButton.style.opacity = '0.6';
      submitButton.style.cursor = 'not-allowed';
      
      try {
        // Trigger all validations to update status
        const isValid = validateDescription() && validateNotes() && validateBrand() && validateGender() && validateConcentration() && validateCategory() && validateAllVariants() && validateImages();
        const name = document.getElementById('product-name').value.trim();
        if (!name) {
          showError('name-error', 'Product name is required.');
          showToast('Please fix the errors before submitting.', 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.style.opacity = '1';
          submitButton.style.cursor = 'pointer';
          return;
        }
        const isUnique = checkDuplicateName(name);
        if (!isUnique) {
          showError('name-error', 'Product name already exists. Please choose a unique name.');
          showToast('Please fix the errors before submitting.', 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.style.opacity = '1';
          submitButton.style.cursor = 'pointer';
          return;
        }
        hideError('name-error');
        if (!isValid) {
          showToast('Please fix the errors before submitting.', 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.style.opacity = '1';
          submitButton.style.cursor = 'pointer';
          return;
        }
        
        const form = e.target;
        const formData = new FormData(form);
        
        // Remove original file inputs to prevent duplicate/excess files
        formData.delete('images');
        
        // Validate that we have exactly 4 cropped images
        const blobCount = Object.keys(window.croppedBlobs).length;
        if (blobCount !== 4) {
          showToast('Please crop all 4 images before submitting.', 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.style.opacity = '1';
          submitButton.style.cursor = 'pointer';
          return;
        }
        
        // Append cropped blobs
        Object.keys(window.croppedBlobs).forEach((index) => {
          formData.append('images', window.croppedBlobs[index], `image-${index}.jpg`);
        });
        
        await submitForm(formData, submitButton, originalButtonText);
      } catch (err) {
        console.error('Form submission error:', err);
        showToast('An error occurred. Please try again.', 'error');
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.style.opacity = '1';
        submitButton.style.cursor = 'pointer';
      }
    });
    
    async function submitForm(formData, submitButton, originalButtonText) {
      try {
        // Create AbortController for timeout
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 120000); // 2 minute timeout
        
        showToast('Uploading product...', 'success');
        
        const res = await fetch('/admin/products/add-product', {
          method: "POST",
          body: formData,
          signal: controller.signal,
        });
        
        clearTimeout(timeoutId);
        
        let data;
        try {
          data = await res.json();
        } catch (jsonErr) {
          console.error('JSON parse error:', jsonErr);
          throw new Error('Invalid response from server');
        }
        
        if (res.ok && data.success) {
          showToast(data.message || 'Product added successfully!', 'success');
          submitButton.textContent = 'Success!';
          submitButton.style.backgroundColor = '#10b981';
          setTimeout(() => {
            window.location.href = '/admin/products';
          }, 1500);
        } else {
          const errorMsg = data?.error || 'An error occurred. Please try again.';
          console.error('Server error response:', data);
          showToast(errorMsg, 'error');
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText;
          submitButton.style.opacity = '1';
          submitButton.style.cursor = 'pointer';
        }
      } catch (err) {
        console.error('Submission error:', err);
        console.error('Error details:', {
          name: err.name,
          message: err.message,
          stack: err.stack
        });
        let errorMessage = 'An error occurred. Please try again.';
        if (err.name === 'AbortError') {
          errorMessage = 'Request timed out. Please check your connection and try again.';
        } else if (err.message.includes('Failed to fetch') || err.message.includes('NetworkError')) {
          errorMessage = 'Network error. Please check your connection and try again.';
        } else if (err.message) {
          errorMessage = err.message;
        }
        showToast(errorMessage, 'error');
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
        submitButton.style.opacity = '1';
        submitButton.style.cursor = 'pointer';
      }
    }
    function handleFileChange(event, index) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function (e) {
          const cropImg = document.getElementById('crop-image');
          cropImg.src = e.target.result;
          currentIndex = index;
          const modal = document.getElementById('crop-modal');
          modal.classList.remove('hidden');
          // Destroy previous cropper if exists
          if (croppers.modal) {
            croppers.modal.destroy();
          }
          // Wait a bit for image to load
          setTimeout(() => {
            croppers.modal = new Cropper(cropImg, {
              aspectRatio: 3 / 4,
              viewMode: 1,
              autoCropArea: 0.8,
              scalable: true,
              zoomable: true,
              dragMode: 'crop',
              cropBoxMovable: true,
              cropBoxResizable: true,
              minCropBoxWidth: 200,
              minCropBoxHeight: 266,
              ready: function () {
                console.log('Cropper is ready');
              }
            });
          }, 100);
        };
        reader.readAsDataURL(file);
      }
    }
    const sidebar = document.getElementById("sidebar");
    const toggleSidebarButton = document.getElementById("toggle-sidebar");
    const toggleSidebarMobileButton = document.getElementById("toggle-sidebar-mobile");
    if (toggleSidebarButton) {
      toggleSidebarButton.addEventListener("click", () => {
        sidebar.classList.toggle("sidebar-hidden");
      });
    }
    if (toggleSidebarMobileButton) {
      toggleSidebarMobileButton.addEventListener("click", () => {
        sidebar.classList.toggle("sidebar-hidden");
      });
    }
    document.getElementById("add-variant").addEventListener("click", () => {
      const container = document.getElementById("variants-container");
      const variantDiv = document.createElement("div");
      variantDiv.className = "variant-group grid grid-cols-1 sm:grid-cols-4 gap-4 p-4 bg-gray-800 rounded";
      variantDiv.dataset.variantIndex = variantCount;
      variantDiv.innerHTML = `
        <div>
          <label class="block text-sm font-medium mb-2">Size (ml) <span class="required">*</span></label>
          <select
            name="variants[${variantCount}][mlSize]"
            class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
            id="ml-size-${variantCount}"
            required
          >
            <option value="">Select Size</option>
            <option value="5">5 ml</option>
            <option value="10">10 ml</option>
            <option value="15">15 ml</option>
            <option value="30">30 ml</option>
            <option value="50">50 ml</option>
            <option value="100">100 ml</option>
            <option value="150">150 ml</option>
            <option value="200">200 ml</option>
            <option value="250">250 ml</option>
            <option value="300">300 ml</option>
          </select>
          <div class="error-message" id="ml-size-error-${variantCount}"></div>
          <button
            type="button"
            class="remove-variant nav-btn bg-red-600 text-white px-4 py-2 mt-2 rounded hover:bg-red-700 w-full mt-1"
          >
            Remove
          </button>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Stock <span class="required">*</span></label>
          <input
            type="number"
            name="variants[${variantCount}][stock]"
            placeholder="e.g., 100"
            class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
            id="stock-${variantCount}"
            min="1"
            required
          />
          <div class="error-message" id="stock-error-${variantCount}"></div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Base Price <span class="required">*</span></label>
          <input
            type="number"
            name="variants[${variantCount}][basePrice]"
            placeholder="e.g., 100"
            class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
            id="base-price-${variantCount}"
            min="1.01"
            step="0.01"
            required
          />
          <div class="error-message" id="base-price-error-${variantCount}"></div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Discounted Price <span class="required">*</span></label>
          <input
            type="number"
            name="variants[${variantCount}][discountedPrice]"
            placeholder="e.g., 80"
            class="w-full p-3 bg-gray-700 border-none rounded text-white focus:outline-none focus:ring-2 focus:ring-brand"
            id="discounted-price-${variantCount}"
            min="0"
            step="0.01"
            required
          />
          <div class="error-message" id="discounted-price-error-${variantCount}"></div>
        </div>
      `;
      container.appendChild(variantDiv);
      variantCount++;
      const removeButton = variantDiv.querySelector(".remove-variant");
      if (removeButton) {
        removeButton.addEventListener("click", () => {
          if (document.querySelectorAll('.variant-group').length > 1) {
            variantDiv.remove();
          } else {
            showToast('At least one variant is required.', 'error');
          }
        });
      }
      // Re-validate after adding
      setTimeout(() => validateAllVariants(), 100);
    });
    // Initial validation on load
    document.addEventListener('DOMContentLoaded', () => {
      validateAllVariants();
    });
  </script>
</body>
</html>