<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Details - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link rel="stylesheet" href="/style/admin/products/productDetails.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>
    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>
      <!-- Page Content -->
      <main class="flex-1 p-6">
        <div class="max-w-6xl mx-auto w-full">
          <!-- Header -->
          <div class="mb-8">
            <a href="/admin/products" class="text-sm text-brand hover:underline mb-4 inline-block flex items-center gap-2">
              <i data-lucide="arrow-left" class="w-4 h-4"></i>
              Back to Products
            </a>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h1 class="text-3xl font-bold mb-2">Product Details</h1>
                <p class="text-gray-400">Product ID: <span class="text-brand font-semibold">#<%= product._id %></span></p>
              </div>
              <%
              let statusClass = product.isListed ? 'status-listed' : 'status-unlisted';
              let statusText = product.isListed ? 'Listed' : 'Unlisted';
              %>
              <div class="flex items-center gap-4 ml-4">
                <span class="status-badge <%= statusClass %>"><%= statusText %></span>
              </div>
            </div>
          </div>
          <!-- Main Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-8">
            <!-- Product Summary -->
            <div class="lg:col-span-2">
              <div class="card p-6 mb-6">
                <h2 class="text-xl font-bold mb-4 text-brand">Product Summary</h2>
                <!-- Images -->
                <div class="product-images-grid">
                  <% if (product.images && product.images.length > 0) { %>
                    <% product.images.forEach(image => { %>
                      <img src="<%= image %>" alt="<%= product.name %>" class="product-image">
                    <% }); %>
                  <% } else { %>
                    <div class="w-full h-200 bg-gray-700 rounded flex items-center justify-center">
                      <span class="text-gray-400 text-xs">No Images</span>
                    </div>
                  <% } %>
                </div>
                <!-- Basic Details -->
                <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
                  <h3 class="text-lg font-semibold text-gray-300 mb-3">Basic Information</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                      <p class="text-gray-400 mb-1">Name:</p>
                      <p class="font-semibold"><%= product.name %></p>
                    </div>
                    <div>
                      <p class="text-gray-400 mb-1">Brand:</p>
                      <p class="font-semibold"><%= product.brand %></p>
                    </div>
                    <div>
                      <p class="text-gray-400 mb-1">Gender:</p>
                      <p class="font-semibold"><%= product.gender %></p>
                    </div>
                    <div>
                      <p class="text-gray-400 mb-1">Concentration:</p>
                      <p class="font-semibold"><%= product.concentration %></p>
                    </div>
                    <div class="md:col-span-2">
                      <p class="text-gray-400 mb-1">Description:</p>
                      <p class="text-gray-300"><%= product.description %></p>
                    </div>
                    <div class="md:col-span-2">
                      <p class="text-gray-400 mb-1">Notes:</p>
                      <p class="text-gray-300"><%= product.notes %></p>
                    </div>
                    <div class="md:col-span-2">
                      <p class="text-gray-400 mb-1">Category:</p>
                      <p class="font-semibold">
                        <% 
                          let category = product.category;
                          if (Array.isArray(category)) {
                            category = category[0];
                          }
                        %>
                        <% if (category) { %>
                          <%= category.name || category %>
                        <% } else { %>
                          N/A
                        <% } %>
                      </p>
                    </div>
                  </div>
                </div>
                <!-- Variants -->
                <% if (product.variants && product.variants.length > 0) { %>
                <div class="space-y-4">
                  <h3 class="text-lg font-semibold text-gray-300 mb-3">Variants</h3>
                  <table class="variant-table">
                    <thead>
                      <tr>
                        <th>Size (ml)</th>
                        <th>Stock</th>
                        <th>Base Price</th>
                        <th>Discounted Price</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% product.variants.forEach(variant => { %>
                      <tr>
                        <td><%= variant.mlSize %> ml</td>
                        <td class="<%= variant.stock > 0 ? 'stock-in' : 'stock-out' %> font-semibold">
                          <%= variant.stock > 0 ? variant.stock + ' pcs' : 'Out of Stock' %>
                        </td>
                        <td>₹<%= variant.basePrice.toFixed(2) %></td>
                        <td>₹<%= variant.discountedPrice.toFixed(2) %></td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
                <% } else { %>
                <p class="text-gray-400 text-center py-4">No variants available.</p>
                <% } %>
              </div>
            </div>
            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Status Update -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Update Status</h3>
                <button id="toggleListBtn" class="btn btn-primary w-full flex items-center justify-center gap-2" data-id="<%= product._id %>">
                  <i data-lucide="<%= product.isListed ? 'x' : 'check' %>" class="w-4 h-4"></i>
                  <%= product.isListed ? 'Unlist Product' : 'List Product' %>
                </button>
              </div>
              <!-- Product Offer -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Product Offers</h3>
                <% if (product.offers && product.offers.length > 0) { %>
                  <% product.offers.forEach(offer => { %>
                    <a href="/admin/offers/<%= offer._id %>" class="block">
                      <div class="offer-item hover:bg-gray-800 transition-colors cursor-pointer p-4 rounded border border-gray-700">
                        <div>
                          <h4 class="font-bold text-brand"><%= offer.name %></h4>
                          <p class="text-gray-300 text-sm"><%= offer.description || 'No description' %></p>
                          <small class="text-gray-500 block mt-2">
                            Valid: <%= new Date(offer.startDate).toLocaleDateString() %> - <%= new Date(offer.endDate).toLocaleDateString() %>
                          </small>
                        </div>
                      </div>
                    </a>
                  <% }) %>
                <% } else { %>
                  <p class="text-gray-400 text-center">No active offers.</p>
                <% } %>

              </div>
              <!-- Edit Product -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Actions</h3>
                <a href="/admin/products/edit-product/<%= product._id %>" class="block w-full btn btn-secondary text-center flex items-center justify-center gap-2 mb-3">
                  <i data-lucide="edit-3" class="w-4 h-4"></i>
                  Edit Product
                </a>
                <button id="deleteProductBtn" class="block w-full btn btn-danger flex items-center justify-center gap-2" data-id="<%= product._id %>" data-name="<%= product.name %>">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                  Delete Product
                </button>
                <button id="viewReviewsBtn" class="block w-full btn btn-primary flex items-center justify-center gap-2 mt-3">
                  <i data-lucide="star" class="w-4 h-4"></i>
                  View Reviews
                </button>
              </div>
              <!-- Product Details -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Product Details</h3>
                <div class="text-sm space-y-2 text-gray-300">
                  <div class="flex justify-between">
                    <span class="font-semibold">Created:</span>
                    <span><%= new Date(product.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Last Updated:</span>
                    <span><%= new Date(product.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Total Variants:</span>
                    <span><%= (product.variants || []).length %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Total Images:</span>
                    <span><%= (product.images || []).length %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    <!-- Reviews Modal -->
    <div id="reviewsModal" class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50">
      <div class="bg-gray-900 rounded-lg shadow-xl w-full max-w-4xl max-h-[90vh] flex flex-col mx-4 border border-gray-800">
        <!-- Modal Header -->
        <div class="p-6 border-b border-gray-800 flex justify-between items-center bg-gray-900 rounded-t-lg">
          <h2 class="text-2xl font-bold text-white flex items-center gap-2">
            <i data-lucide="star" class="w-6 h-6 text-yellow-500"></i>
            Product Reviews
          </h2>
          <button id="closeReviewsModal" class="text-gray-400 hover:text-white transition-colors">
            <i data-lucide="x" class="w-6 h-6"></i>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 overflow-y-auto custom-scrollbar">
          <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
            
            <!-- Statistics Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10 pb-10 border-b border-gray-800">
              <!-- Average Rating -->
              <div class="flex flex-col items-center justify-center text-center p-6 bg-gray-800/50 rounded-xl">
                <span class="text-5xl font-bold text-white mb-2"><%= reviewStats.averageRating %></span>
                <div class="flex gap-1 mb-2">
                   <% const avg = Math.round(reviewStats.averageRating); %>
                   <% for(let i=1; i<=5; i++) { %>
                      <svg class="w-5 h-5 <%= i <= avg ? 'text-yellow-500 fill-current' : 'text-gray-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.817a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"></path></svg>
                   <% } %>
                </div>
                <p class="text-sm text-gray-400"><%= reviewStats.totalReviews %> Reviews</p>
              </div>

              <!-- Rating Breakdown -->
              <div class="md:col-span-2 space-y-3">
                <% for(let star=5; star>=1; star--) { %>
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-1 w-12 text-sm text-gray-400 font-medium">
                    <span><%= star %></span>
                    <i data-lucide="star" class="w-3 h-3"></i>
                  </div>
                  <div class="flex-1 h-2 bg-gray-800 rounded-full overflow-hidden">
                    <div class="h-full bg-yellow-500 rounded-full" style="width: <%= reviewStats.percentages[star] %>%"></div>
                  </div>
                  <span class="w-10 text-right text-sm text-gray-400 font-medium"><%= reviewStats.starCounts[star] %></span>
                </div>
                <% } %>
              </div>
            </div>

            <!-- Reviews List -->
            <div class="space-y-6">
              <% reviews.forEach(review => { %>
                <div class="bg-gray-800/30 rounded-lg p-6 border border-gray-800 hover:border-gray-700 transition-colors">
                  <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center text-white font-bold text-lg">
                        <%= review.userName ? review.userName.charAt(0).toUpperCase() : 'U' %>
                      </div>
                      <div>
                        <h4 class="font-bold text-white"><%= review.userName %></h4>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                           <span><%= new Date(review.createdAt).toLocaleDateString() %></span>
                           <% if (review.orderId) { %>
                             <span class="px-1.5 py-0.5 bg-gray-800 rounded text-gray-400">Verified Purchase</span>
                           <% } %>
                        </div>
                      </div>
                    </div>
                    <div class="flex gap-0.5">
                      <% for(let i=1; i<=5; i++) { %>
                        <svg class="w-4 h-4 <%= i <= review.rating ? 'text-yellow-500 fill-current' : 'text-gray-700' %>" viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      <% } %>
                    </div>
                  </div>
                  <p class="text-gray-300 leading-relaxed"><%= review.review %></p>
                </div>
              <% }) %>
            </div>

          <% } else { %>
            <div class="flex flex-col items-center justify-center py-20 text-center">
              <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center mb-4">
                 <i data-lucide="star-off" class="w-8 h-8 text-gray-600"></i>
              </div>
              <h3 class="text-xl font-bold text-gray-400 mb-2">No Reviews Yet</h3>
              <p class="text-gray-500 max-w-sm">This product hasn't received any reviews from customers yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    <!-- Toggle List/Unlist Modal -->
    <div id="toggleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96 card">
        <h2 class="text-lg font-bold mb-4 text-brand">Confirm Action</h2>
        <p id="toggleMessage" class="mb-6 text-gray-300"></p>
        <div class="flex justify-end space-x-4">
          <button id="cancelToggle" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700 btn-secondary">Cancel</button>
          <form id="toggleForm" method="POST" action="">
            <button type="submit" class="px-4 py-2 bg-brand rounded hover:opacity-90 text-gray-800 font-semibold">Confirm</button>
          </form>
        </div>
      </div>
    </div>
    <!-- Delete Modal -->
    <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96 card">
        <h2 class="text-lg font-bold mb-4 text-brand">Confirm Deletion</h2>
        <p id="deleteMessage" class="mb-6 text-gray-300"></p>
        <div class="flex justify-end space-x-4">
          <button id="cancelDelete" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700 btn-secondary">Cancel</button>
          <form id="deleteForm" method="POST">
            <button type="submit" class="px-4 py-2 bg-red-600 rounded hover:bg-red-700 btn-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>
    <!-- Error Popup Modal -->
    <div
      id="errorPopup"
      class="hidden fixed top-5 right-5 bg-red-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="alert-circle" class="w-5 h-5"></i>
      <span id="errorMessage">Something went wrong!</span>
      <button id="closeErrorPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <!-- Success Popup Modal -->
    <div
      id="successPopup"
      class="hidden fixed top-5 right-5 bg-green-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="check-circle" class="w-5 h-5"></i>
      <span id="successMessage">Success!</span>
      <button id="closeSuccessPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <script>
      lucide.createIcons();
      // Toggle List/Unlist
      const toggleBtn = document.getElementById('toggleListBtn');
      const toggleModal = document.getElementById('toggleModal');
      const toggleMessage = document.getElementById('toggleMessage');
      const toggleForm = document.getElementById('toggleForm');
      const cancelToggle = document.getElementById('cancelToggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const id = toggleBtn.dataset.id;
          const action = toggleBtn.textContent.trim().toLowerCase().includes('unlist') ? 'unlist' : 'list';
          toggleMessage.textContent = `Are you sure you want to ${action} this product?`;
          toggleForm.action = `/admin/products/unlist/${id}`;
          toggleModal.classList.remove('hidden');
        });
      }
      cancelToggle.addEventListener('click', () => toggleModal.classList.add('hidden'));
      // Delete
      const deleteBtn = document.getElementById('deleteProductBtn');
      const deleteModal = document.getElementById('deleteModal');
      const deleteMessage = document.getElementById('deleteMessage');
      const deleteForm = document.getElementById('deleteForm');
      const cancelDelete = document.getElementById('cancelDelete');
      if (deleteBtn) {
        deleteBtn.addEventListener('click', () => {
          const id = deleteBtn.dataset.id;
          const name = deleteBtn.dataset.name;
          deleteMessage.textContent = `Are you sure you want to delete "${name}"? This action cannot be undone.`;
          deleteForm.action = `/admin/products/delete/${id}`;
          deleteModal.classList.remove('hidden');
        });
      }
      cancelDelete.addEventListener('click', () => deleteModal.classList.add('hidden'));
      
      // Reviews Modal Logic
      const viewReviewsBtn = document.getElementById('viewReviewsBtn');
      const reviewsModal = document.getElementById('reviewsModal');
      const closeReviewsModal = document.getElementById('closeReviewsModal');

      if (viewReviewsBtn) {
        viewReviewsBtn.addEventListener('click', () => {
          reviewsModal.classList.remove('hidden');
        });
      }

      if (closeReviewsModal) {
        closeReviewsModal.addEventListener('click', () => {
          reviewsModal.classList.add('hidden');
        });
      }

      // Close modal on outside click
      reviewsModal.addEventListener('click', (e) => {
        if (e.target === reviewsModal) {
          reviewsModal.classList.add('hidden');
        }
      });
      // Function to show error popup
      function showErrorPopup(message) {
        const popup = document.getElementById("errorPopup");
        const messageElement = document.getElementById("errorMessage");
        messageElement.textContent = message || "An unexpected error occurred.";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }
      // Close manually
      document.getElementById("closeErrorPopup").addEventListener("click", () => {
        document.getElementById("errorPopup").classList.add("hidden");
      });
      // Function to show success popup
      function showSuccessPopup(message) {
        const popup = document.getElementById("successPopup");
        const messageElement = document.getElementById("successMessage");
        messageElement.textContent = message || "Success!";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }
      // Close success popup manually
      document.getElementById("closeSuccessPopup").addEventListener("click", () => {
        document.getElementById("successPopup").classList.add("hidden");
      });
      // Display server-side session messages on load
      <% if (typeof error !== 'undefined' && error) { %>
        showErrorPopup("<%= error %>");
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        showSuccessPopup("<%= success %>");
      <% } %>
    </script>
  </body>
</html>