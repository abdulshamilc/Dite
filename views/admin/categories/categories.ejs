<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <link rel="stylesheet" href="/style/admin/categories/categories.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>

    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>

      <!-- Page Content -->
      <main class="flex-1 p-6">
        <div class="mb-6">
          <!-- Heading + Add Button on the same line -->
          <div class="flex justify-between items-center mb-4">
            <h1 class="text-2xl font-bold">Categories Management</h1>
            <button id="openAddModal" class="bg-yellow-600 px-4 py-2 rounded">
              + Add Categories
            </button>
          </div>

          <!-- Counts -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="count-box">
              <p class="text-gray-400">Total Categories</p>
              <p class="text-xl font-bold"><%= categories.length %></p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">New Categories</p>
              <p class="text-xl font-bold text-green-400">
                <%= newCategoriesCount %>
              </p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Active Categories</p>
              <p class="text-xl font-bold"><%= activeCategories %></p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Inactive Categories</p>
              <p class="text-xl font-bold"><%= inactiveCategories %></p>
            </div>
          </div>

          <!-- Filter + Search -->
          <div class="flex justify-between mb-4">
            <span>All Categories</span>
            <div class="flex space-x-4">
              <select id="statusFilter" class="bg-gray-800 p-2 rounded">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="blocked">Blocked</option>
              </select>
              <div class="flex space-x-2">
                <input
                  type="text"
                  id="searchInput"
                  placeholder="Search Categories"
                  class="bg-gray-800 p-2 rounded"
                />
                <button
                  id="clearSearch"
                  class="bg-gray-600 px-3 py-2 rounded hover:bg-gray-700"
                  title="Clear Search"
                >
                  <i data-lucide="x" class="w-5 h-5"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto border-collapse">
            <thead>
              <tr class="bg-gray-800">
                <th class="px-4 py-2 text-left">NAME</th>
                <th class="px-4 py-2 text-left">DESCRIPTION</th>
                <th class="px-4 py-2 text-left">PRODUCTS</th>
                <th class="px-4 py-2 text-left">STATUS</th>
                <th class="px-4 py-2 text-left">ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(category => { %>
                <tr class="border-b border-gray-700 hover:bg-gray-900">
                  <td class="px-4 py-2"><%= category.name %></td>
                  <td class="px-4 py-2"><%= category.description %></td>
                  <td class="px-4 py-2"><%= category.products.length %></td>
                  <td class="px-4 py-2">
                    <% if (category.isActive) { %>
                      <span class="status-active">Active</span>
                    <% } else { %>
                      <span class="status-blocked">INACTIVE</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-2 flex space-x-2">
                    <!-- Edit Button -->
                    <button
                      type="button"
                      class="text-blue-500 hover:text-blue-600 open-edit-modal"
                      data-id="<%= category._id %>"
                      data-name="<%= category.name %>"
                      data-description="<%= category.description %>"
                      title="Edit"
                    >
                      <i data-lucide="edit-3" class="w-5 h-5"></i>
                    </button>

                    <!-- Active / Inactive Button -->
                    <% if (category.isActive) { %>
                      <button
                        type="button"
                        class="text-red-500 hover:text-red-600 open-block-modal"
                        data-id="<%= category._id %>"
                        data-name="<%= category.name %>"
                        title="Deactivate"
                      >
                        <i data-lucide="x" class="w-5 h-5"></i>
                      </button>
                    <% } else { %>
                      <button
                        type="button"
                        class="text-green-500 hover:text-green-600 open-block-modal"
                        data-id="<%= category._id %>"
                        data-name="<%= category.name %>"
                        title="Activate"
                      >
                        <i data-lucide="check" class="w-5 h-5"></i>
                      </button>
                    <% } %>

                    <!-- Delete Button -->
                    <button
                      type="button"
                      class="text-red-500 hover:text-red-600 open-delete-modal"
                      data-id="<%= category._id %>"
                      data-name="<%= category.name %>"
                      title="Delete"
                    >
                      <i data-lucide="trash-2" class="w-5 h-5"></i>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <!-- Confirmation Modal for Deactivation/Activation -->
    <div
      id="blockModal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
    >
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96">
        <h2 class="text-lg font-bold mb-4">Confirm Action</h2>
        <p id="blockMessage" class="mb-6 text-gray-300"></p>

        <div class="flex justify-end space-x-4">
          <button
            id="cancelBlock"
            class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700"
          >
            Cancel
          </button>
          <form id="blockForm" method="POST">
            <button
              type="submit"
              class="px-4 py-2 bg-red-600 rounded hover:bg-red-700"
            >
              Confirm
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div
      id="deleteModal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
    >
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96">
        <h2 class="text-lg font-bold mb-4">Confirm Deletion</h2>
        <p id="deleteMessage" class="mb-6 text-gray-300"></p>

        <div class="flex justify-end space-x-4">
          <button
            id="cancelDelete"
            class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700"
          >
            Cancel
          </button>
          <form id="deleteForm" method="POST">
            <button
              type="submit"
              class="px-4 py-2 bg-red-600 rounded hover:bg-red-700"
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Add Category Modal -->
<div
  id="addCategoryModal"
  class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
>
  <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96">
    <h2 class="text-lg font-bold mb-4">Add New Category</h2>
    <form id="addCategoryForm" method="POST" action="/admin/categories/addCategorie">
      <div class="mb-4">
        <label for="categoryName" class="block text-gray-300 mb-2">Name</label>
        <input
          type="text"
          id="categoryName"
          name="name"
          class="w-full bg-gray-800 p-2 rounded text-white border border-gray-700 focus:border-yellow-600 focus:outline-none"
          placeholder="Enter category name"
        />
        <p id="nameError" class="text-red-500 text-sm mt-1 hidden"></p>
      </div>
      <div class="mb-4">
        <label for="categoryDescription" class="block text-gray-300 mb-2">Description</label>
        <textarea
          id="categoryDescription"
          name="description"
          class="w-full bg-gray-800 p-2 rounded text-white border border-gray-700 focus:border-yellow-600 focus:outline-none"
          placeholder="Enter category description"
          rows="4"
        ></textarea>
        <!-- <CHANGE> Added error message field for description validation -->
        <p id="descriptionError" class="text-red-500 text-sm mt-1 hidden"></p>
      </div>
      <div class="flex justify-end space-x-4">
        <button
          type="button"
          id="cancelAdd"
          class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-4 py-2 bg-yellow-600 rounded hover:bg-yellow-700"
        >
          Add
        </button>
      </div>
    </form>
  </div>
</div>

    <!-- Edit Category Modal -->
    <div
      id="editCategoryModal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
    >
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96">
        <h2 class="text-lg font-bold mb-4">Edit Category</h2>
        <form id="editCategoryForm" method="POST">
          <div class="mb-4">
            <label for="editCategoryName" class="block text-gray-300 mb-2">Name</label>
            <input
              type="text"
              id="editCategoryName"
              name="name"
              class="w-full bg-gray-800 p-2 rounded text-white"
              placeholder="Enter category name"
            />
          </div>
          <div class="mb-4">
            <label for="editCategoryDescription" class="block text-gray-300 mb-2">Description</label>
            <textarea
              id="editCategoryDescription"
              name="description"
              class="w-full bg-gray-800 p-2 rounded text-white"
              placeholder="Enter category description"
              rows="4"
            ></textarea>
          </div>
          <div class="flex justify-end space-x-4">
            <button
              type="button"
              id="cancelEdit"
              class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-4 py-2 bg-yellow-600 rounded hover:bg-yellow-700"
            >
              Save
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Pagination and Page Limit -->
    <div class="flex justify-between items-center mt-4">
      <!-- Pagination -->
      <div class="flex-1 flex justify-center items-center space-x-4">
        <% if (totalPages > 1) { %>
          <% if (currentPage > 1) { %>
            <a
              href="/admin/categories?page=<%= currentPage - 1 %>&limit=<%= limit %>"
              class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
            >
              <i data-lucide="chevron-left" class="w-5 h-5"></i>
            </a>
          <% } %>
          <span class="text-gray-400"><%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a
              href="/admin/categories?page=<%= currentPage + 1 %>&limit=<%= limit %>"
              class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
            >
              <i data-lucide="chevron-right" class="w-5 h-5"></i>
            </a>
          <% } %>
        <% } %>
      </div>

      <!-- Page Limit -->
      <div class="flex items-center space-x-2">
        <label for="pageLimit" class="text-gray-400">Show</label>
        <select id="limitSelect" onchange="changePageLimit(this.value)" class="bg-white text-black rounded">
          <option value="5" <%= limit == 5 ? "selected" : "" %>>5</option>
          <option value="10" <%= limit == 10 ? "selected" : "" %>>10</option>
          <option value="20" <%= limit == 20 ? "selected" : "" %>>20</option>
          <option value="50" <%= limit == 50 ? "selected" : "" %>>50</option>
        </select>
        <span class="text-gray-400">per page</span>
      </div>
    </div>
    <!-- Error Popup Modal -->
<div
  id="errorPopup"
  class="hidden fixed top-5 right-5 bg-red-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
>
  <i data-lucide="alert-circle" class="w-5 h-5"></i>
  <span id="errorMessage">Something went wrong!</span>
  <button id="closeErrorPopup" class="ml-3 hover:text-gray-300">
    <i data-lucide="x" class="w-4 h-4"></i>
  </button>
</div>

<!-- Success Popup Modal -->
<div
  id="successPopup"
  class="hidden fixed top-5 right-5 bg-green-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
>
  <i data-lucide="check-circle" class="w-5 h-5"></i>
  <span id="successMessage">Success!</span>
  <button id="closeSuccessPopup" class="ml-3 hover:text-gray-300">
    <i data-lucide="x" class="w-4 h-4"></i>
  </button>
</div>

    <script>
      lucide.createIcons();

      // Handle page limit change
      function changePageLimit(limit) {
        const url = new URL(window.location.href);
        url.searchParams.set("limit", limit);
        url.searchParams.set("page", 1);
        window.location.href = url.toString();
      }

      // Function to filter table rows based on search and status
      function filterTable() {
        const searchQuery = document.getElementById("searchInput").value.trim().toLowerCase();
        const statusFilter = document.getElementById("statusFilter").value;
        const rows = document.querySelectorAll("tbody tr");

        rows.forEach((row) => {
          const categoryName = row.querySelector("td:first-child").textContent.toLowerCase();
          const status = row
            .querySelector("td:nth-child(4) span")
            .textContent.toLowerCase();

          const matchesSearch = searchQuery === "" || categoryName.includes(searchQuery);
          const matchesStatus =
            statusFilter === "all" ||
            (statusFilter === "active" && status === "active") ||
            (statusFilter === "blocked" && status === "inactive");

          row.style.display = matchesSearch && matchesStatus ? "" : "none";
        });
      }

      // Search functionality (triggered by Enter key)
      document.getElementById("searchInput").addEventListener("keypress", function (event) {
        if (event.key === "Enter") {
          event.preventDefault();
          filterTable();
        }
      });

      // Clear search
      document.getElementById("clearSearch").addEventListener("click", () => {
        document.getElementById("searchInput").value = "";
        filterTable();
      });

      // Status filter
      document.getElementById("statusFilter").addEventListener("change", filterTable);

      // Modal open for deactivation/activation
      document.querySelectorAll(".open-block-modal").forEach((button) => {
        button.addEventListener("click", () => {
          const categoryId = button.dataset.id;
          const categoryName = button.dataset.name;
          const isDeactivating = button.title === "Deactivate";

          document.getElementById("blockMessage").textContent = isDeactivating
            ? `Are you sure you want to deactivate ${categoryName}?`
            : `Are you sure you want to activate ${categoryName}?`;

          document.getElementById("blockForm").action = `/admin/categories/active/${categoryId}`;

          document.getElementById("blockModal").classList.remove("hidden");
        });
      });

      // Modal cancel for deactivation/activation
      document.getElementById("cancelBlock").addEventListener("click", () => {
        document.getElementById("blockModal").classList.add("hidden");
      });

      // Modal open for delete
      document.querySelectorAll(".open-delete-modal").forEach((button) => {
        button.addEventListener("click", () => {
          const categoryId = button.dataset.id;
          const categoryName = button.dataset.name;

          document.getElementById(
            "deleteMessage"
          ).textContent = `Are you sure you want to delete ${categoryName}?`;

          document.getElementById("deleteForm").action = `/admin/categories/delete/${categoryId}`;

          document.getElementById("deleteModal").classList.remove("hidden");
        });
      });

      // Modal cancel for delete
      document.getElementById("cancelDelete").addEventListener("click", () => {
        document.getElementById("deleteModal").classList.add("hidden");
      });

      // Modal open for add category
      document.getElementById("openAddModal").addEventListener("click", () => {
        document.getElementById("addCategoryModal").classList.remove("hidden");
      });

      // Modal cancel for add category
      document.getElementById("cancelAdd").addEventListener("click", () => {
        document.getElementById("addCategoryModal").classList.add("hidden");
        document.getElementById("addCategoryForm").reset();
      });

      // Modal open for edit category
      document.querySelectorAll(".open-edit-modal").forEach((button) => {
        button.addEventListener("click", () => {
          const categoryId = button.dataset.id;
          const categoryName = button.dataset.name;
          const categoryDescription = button.dataset.description;

          document.getElementById("editCategoryName").value = categoryName;
          document.getElementById("editCategoryDescription").value = categoryDescription;
          document.getElementById("editCategoryForm").action = `/admin/categories/edit/${categoryId}`;

          document.getElementById("editCategoryModal").classList.remove("hidden");
        });
      });

      // Modal cancel for edit category
      document.getElementById("cancelEdit").addEventListener("click", () => {
        document.getElementById("editCategoryModal").classList.add("hidden");
        document.getElementById("editCategoryForm").reset();
      });

  // Function to show error popup
  function showErrorPopup(message) {
    const popup = document.getElementById("errorPopup");
    const messageElement = document.getElementById("errorMessage");

    messageElement.textContent = message || "An unexpected error occurred.";
    popup.classList.remove("hidden");
    popup.classList.add("opacity-100", "translate-y-0");

    // Auto-hide after 4 seconds
    setTimeout(() => {
      popup.classList.add("hidden");
    }, 4000);
  }

  // Close manually
  document.getElementById("closeErrorPopup").addEventListener("click", () => {
    document.getElementById("errorPopup").classList.add("hidden");
  });

  // Function to show success popup
  function showSuccessPopup(message) {
    const popup = document.getElementById("successPopup");
    const messageElement = document.getElementById("successMessage");

    messageElement.textContent = message || "Success!";
    popup.classList.remove("hidden");
    popup.classList.add("opacity-100", "translate-y-0");

    // Auto-hide after 4 seconds
    setTimeout(() => {
      popup.classList.add("hidden");
    }, 4000);
  }

  // Close success popup manually
  document.getElementById("closeSuccessPopup").addEventListener("click", () => {
    document.getElementById("successPopup").classList.add("hidden");
  });

  // Display server-side flash messages on load
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    showErrorPopup("<%= errorMessage %>");
  <% } %>
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    showSuccessPopup("<%= successMessage %>");
  <% } %>

  // Client-side validation for add category form
  const addForm = document.getElementById("addCategoryForm");
  const nameInput = document.getElementById("categoryName");
  const descInput = document.getElementById("categoryDescription");
  const nameError = document.getElementById("nameError");
  const descError = document.getElementById("descriptionError");

  // Clear errors on input
  nameInput.addEventListener("input", () => {
    nameError.classList.add("hidden");
    nameInput.classList.remove("border-red-500");
  });
  descInput.addEventListener("input", () => {
    descError.classList.add("hidden");
    descInput.classList.remove("border-red-500");
  });

  // Validate on submit
  addForm.addEventListener("submit", (e) => {
    let isValid = true;

    // Validate name
    if (!nameInput.value.trim()) {
      nameError.textContent = "Name is required.";
      nameError.classList.remove("hidden");
      nameInput.classList.add("border-red-500");
      isValid = false;
    }

    // Validate description
    if (!descInput.value.trim()) {
      descError.textContent = "Description is required.";
      descError.classList.remove("hidden");
      descInput.classList.add("border-red-500");
      isValid = false;
    }

    if (!isValid) {
      e.preventDefault();
      showErrorPopup("Please fill in all required fields.");
    }
  });

      
    </script>
  </body>
</html>