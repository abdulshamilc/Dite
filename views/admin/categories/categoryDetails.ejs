<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category Details - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style/admin/products/productDetails.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>
    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>
      <!-- Page Content -->
      <main class="flex-1 p-6">
        <div class="max-w-6xl mx-auto w-full">
          <!-- Header -->
          <div class="mb-8">
            <a href="/admin/categories" class="text-sm text-brand hover:underline mb-4 inline-block flex items-center gap-2">
              <i data-lucide="arrow-left" class="w-4 h-4"></i>
              Back to Categories
            </a>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h1 class="text-3xl font-bold mb-2">Category Details</h1>
                <p class="text-gray-400">Category ID: <span class="text-brand font-semibold">#<%= category._id %></span></p>
              </div>
              <%
              let statusClass = category.isActive ? 'status-active-badge' : 'status-inactive-badge';
              let statusText = category.isActive ? 'Active' : 'Inactive';
              %>
              <div class="flex items-center gap-4 ml-4">
                <span class="status-badge <%= statusClass %>"><%= statusText %></span>
              </div>
            </div>
          </div>

          <!-- Main Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-8">
            <!-- Category Summary -->
            <div class="lg:col-span-2">
              <div class="card p-6 mb-6">
                <h2 class="text-xl font-bold mb-4 text-brand">Category Summary</h2>
                
                <!-- Category Name Heading -->
                <div class="coupon-code-heading mb-6"><%= category.name %></div>
                
                <!-- Basic Details -->
                <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
                  <h3 class="text-lg font-semibold text-gray-300 mb-3">Basic Information</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                      <p class="text-gray-400 mb-1">Category Name:</p>
                      <p class="font-semibold"><%= category.name %></p>
                    </div>
                    <div>
                      <p class="text-gray-400 mb-1">Total Products:</p>
                      <p class="font-semibold text-xl"><%= products.length %></p>
                    </div>
                    <div class="md:col-span-2">
                      <p class="text-gray-400 mb-1">Description:</p>
                      <p class="text-gray-300"><%= category.description || 'No description' %></p>
                    </div>
                  </div>
                </div>

                <!-- Products List -->
                <div class="space-y-4">
                  <h3 class="text-lg font-semibold text-gray-300 mb-3">All Products in this Category (<%= products.length %>)</h3>
                  
                    <% if (products && products.length > 0) { %>
                      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <% products.forEach(product => { %>
                          <a href="/admin/products/<%= product._id %>" class="block group">
                            <div class="bg-gray-800 rounded-lg p-3 hover:bg-gray-700 transition-colors h-full flex flex-col items-center">
                              <div class="w-full aspect-square mb-3 overflow-hidden rounded bg-gray-900">
                                <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                              </div>
                              <p class="text-sm font-medium text-center text-gray-200 group-hover:text-white line-clamp-2"><%= product.name %></p>
                            </div>
                          </a>
                        <% }); %>
                      </div>
                    <% } else { %>
                      <div class="text-center py-10 text-gray-500 bg-gray-800/50 rounded-lg">
                        <i data-lucide="package-open" class="w-12 h-12 mx-auto mb-3 opacity-50"></i>
                        <p class="text-gray-400">No products found in this category.</p>
                      </div>
                    <% } %>
                  
                </div>
              </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Status Update -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Update Status</h3>
                <button id="toggleActiveBtn" class="btn btn-primary w-full flex items-center justify-center gap-2" data-id="<%= category._id %>">
                  <i data-lucide="<%= category.isActive ? 'x' : 'check' %>" class="w-4 h-4"></i>
                  <%= category.isActive ? 'Deactivate Category' : 'Activate Category' %>
                </button>
              </div>

              <!-- Actions -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Actions</h3>
                <button id="openEditModal" class="block w-full btn btn-secondary text-center flex items-center justify-center gap-2 mb-3"
                    data-id="<%= category._id %>"
                    data-name="<%= category.name %>"
                    data-description="<%= category.description %>">
                  <i data-lucide="edit-3" class="w-4 h-4"></i>
                  Edit Category
                </button>
                <button id="deleteBtn" class="block w-full btn btn-danger flex items-center justify-center gap-2" 
                    data-id="<%= category._id %>" 
                    data-name="<%= category.name %>">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                  Delete Category
                </button>
              </div>

              <!-- Category Details -->
              <div class="card p-6">
                <h3 class="font-bold mb-4 text-brand">Category Details</h3>
                <div class="text-sm space-y-2 text-gray-300">
                  <div class="flex justify-between">
                    <span class="font-semibold">Created:</span>
                    <span><%= category.createdAt ? new Date(category.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Last Updated:</span>
                    <span><%= category.updatedAt ? new Date(category.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Total Products:</span>
                    <span><%= products.length %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-semibold">Status:</span>
                    <span class="<%= category.isActive ? 'text-green-400' : 'text-red-400' %>"><%= statusText %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Edit Category Modal -->
    <div id="editCategoryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96 card">
        <h2 class="text-lg font-bold mb-4 text-brand">Edit Category</h2>
        <form id="editCategoryForm" method="POST" action="/admin/categories/edit/<%= category._id %>" class="space-y-4">
          <div>
            <label for="editCategoryName" class="block text-sm font-medium text-gray-300 mb-2">Name</label>
            <input
              type="text"
              id="editCategoryName"
              name="name"
              class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-md text-white focus:border-brand focus:outline-none"
              value="<%= category.name %>"
              required
            />
          </div>
          <div>
            <label for="editCategoryDescription" class="block text-sm font-medium text-gray-300 mb-2">Description</label>
            <textarea
              id="editCategoryDescription"
              name="description"
              class="w-full px-3 py-2 bg-gray-800 border border-gray-600 rounded-md text-white focus:border-brand focus:outline-none"
              rows="4"
              required
            ><%= category.description %></textarea>
          </div>
          <div class="flex justify-end space-x-4">
            <button type="button" id="cancelEdit" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700 btn-secondary">Cancel</button>
            <button type="submit" class="px-4 py-2 bg-brand rounded hover:opacity-90 text-gray-800 font-semibold">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Toggle Active/Inactive Modal -->
    <div id="toggleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96 card">
        <h2 class="text-lg font-bold mb-4 text-brand">Confirm Action</h2>
        <p id="toggleMessage" class="mb-6 text-gray-300"></p>
        <div class="flex justify-end space-x-4">
          <button id="cancelToggle" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700 btn-secondary">Cancel</button>
          <form id="toggleForm" method="POST" action="">
            <button type="submit" class="px-4 py-2 bg-brand rounded hover:opacity-90 text-gray-800 font-semibold">Confirm</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96 card">
        <h2 class="text-lg font-bold mb-4 text-brand">Confirm Deletion</h2>
        <p id="deleteMessage" class="mb-6 text-gray-300"></p>
        <div class="flex justify-end space-x-4">
          <button id="cancelDelete" class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700 btn-secondary">Cancel</button>
          <form id="deleteForm" method="POST">
            <button type="submit" class="px-4 py-2 bg-red-600 rounded hover:bg-red-700 btn-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Error Popup Modal -->
    <div
      id="errorPopup"
      class="hidden fixed top-5 right-5 bg-red-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="alert-circle" class="w-5 h-5"></i>
      <span id="errorMessage">Something went wrong!</span>
      <button id="closeErrorPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Success Popup Modal -->
    <div
      id="successPopup"
      class="hidden fixed top-5 right-5 bg-green-600 text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 z-50 transition-all duration-300"
    >
      <i data-lucide="check-circle" class="w-5 h-5"></i>
      <span id="successMessage">Success!</span>
      <button id="closeSuccessPopup" class="ml-3 hover:text-gray-300">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <script>
      lucide.createIcons();

      // Toggle Active/Inactive
      const toggleBtn = document.getElementById('toggleActiveBtn');
      const toggleModal = document.getElementById('toggleModal');
      const toggleMessage = document.getElementById('toggleMessage');
      const toggleForm = document.getElementById('toggleForm');
      const cancelToggle = document.getElementById('cancelToggle');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const id = toggleBtn.dataset.id;
          const action = toggleBtn.textContent.trim().toLowerCase().includes('deactivate') ? 'deactivate' : 'activate';
          toggleMessage.textContent = `Are you sure you want to ${action} this category?${action === 'deactivate' ? ' All associated products will be unlisted.' : ''}`;
          toggleForm.action = `/admin/categories/active/${id}`;
          toggleModal.classList.remove('hidden');
        });
      }

      if (cancelToggle) {
        cancelToggle.addEventListener('click', () => toggleModal.classList.add('hidden'));
      }

      // Edit Modal Logic
      const editModal = document.getElementById('editCategoryModal');
      const openEditBtn = document.getElementById('openEditModal');
      const cancelEditBtn = document.getElementById('cancelEdit');

      if (openEditBtn) {
        openEditBtn.addEventListener('click', () => {
          editModal.classList.remove('hidden');
        });
      }
      
      if (cancelEditBtn) {
        cancelEditBtn.addEventListener('click', () => {
          editModal.classList.add('hidden');
        });
      }

      // Delete Modal Logic
      const deleteBtn = document.getElementById('deleteBtn');
      const deleteModal = document.getElementById('deleteModal');
      const deleteMessage = document.getElementById('deleteMessage');
      const deleteForm = document.getElementById('deleteForm');
      const cancelDelete = document.getElementById('cancelDelete');

      if (deleteBtn) {
        deleteBtn.addEventListener('click', () => {
          const id = deleteBtn.dataset.id;
          const name = deleteBtn.dataset.name;
          deleteMessage.textContent = `Are you sure you want to delete "${name}"? This action cannot be undone.`;
          deleteForm.action = `/admin/categories/delete/${id}`;
          deleteModal.classList.remove('hidden');
        });
      }

      if (cancelDelete) {
        cancelDelete.addEventListener('click', () => deleteModal.classList.add('hidden'));
      }

      // Close modals on outside click
      window.addEventListener('click', (e) => {
        if (e.target === editModal) {
          editModal.classList.add('hidden');
        }
        if (e.target === deleteModal) {
          deleteModal.classList.add('hidden');
        }
        if (e.target === toggleModal) {
          toggleModal.classList.add('hidden');
        }
      });

      // Function to show error popup
      function showErrorPopup(message) {
        const popup = document.getElementById("errorPopup");
        const messageElement = document.getElementById("errorMessage");
        messageElement.textContent = message || "An unexpected error occurred.";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }

      // Close error popup manually
      document.getElementById("closeErrorPopup").addEventListener("click", () => {
        document.getElementById("errorPopup").classList.add("hidden");
      });

      // Function to show success popup
      function showSuccessPopup(message) {
        const popup = document.getElementById("successPopup");
        const messageElement = document.getElementById("successMessage");
        messageElement.textContent = message || "Success!";
        popup.classList.remove("hidden");
        popup.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          popup.classList.add("hidden");
        }, 4000);
      }

      // Close success popup manually
      document.getElementById("closeSuccessPopup").addEventListener("click", () => {
        document.getElementById("successPopup").classList.add("hidden");
      });

      // Display server-side session messages on load
      <% if (typeof error !== 'undefined' && error) { %>
        showErrorPopup("<%= error %>");
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        showSuccessPopup("<%= success %>");
      <% } %>
    </script>
  </body>
</html>