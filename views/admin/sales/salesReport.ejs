<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sales Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/style/admin/sales/salesReport.css">
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>
    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>
      <!-- Page Content -->
      <main class="flex-1 p-6">
        <!-- Heading + Export Button -->
        <div class="flex justify-between items-center mb-4">
          <h1 class="text-2xl font-bold">Sales Report</h1>
          <button class="export-btn" id="exportBtn">
            <i data-lucide="download" class="w-4 h-4 inline mr-2"></i>
            Export Report
          </button>
        </div>
        <!-- Period Selection Buttons -->
        <div class="flex gap-2 mb-6 flex-wrap">
          <button class="period-btn <%= period === 'today' ? 'active' : '' %>" data-period="today">Today</button>
          <button class="period-btn <%= period === 'week' ? 'active' : '' %>" data-period="week">Week</button>
          <button class="period-btn <%= period === 'month' ? 'active' : '' %>" data-period="month">Month</button>
          <button class="period-btn <%= period === 'year' ? 'active' : '' %>" data-period="year">Year</button>
          <button class="period-btn <%= period === 'custom' ? 'active' : '' %>" id="customBtn" data-period="custom">Custom</button>
        </div>
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <!-- 1. Total Revenue -->
          <div class="stat-card">
            <div class="stat-value"><%= totalRevenue %></div>
            <div class="stat-label">Total Revenue</div>
          </div>
          <!-- 2. Avg Order Value -->
          <div class="stat-card">
            <div class="stat-value"><%= avgOrderValue %></div>
            <div class="stat-label">Avg Order Value</div>
          </div>
          <!-- 3. Total Orders -->
          <div class="stat-card">
            <div class="stat-value"><%= totalOrders %></div>
            <div class="stat-label">Total Orders</div>
          </div>
          <!-- 4. Total Customers -->
          <div class="stat-card">
            <div class="stat-value"><%= newCustomers %></div>
            <div class="stat-label">Total Customers</div>
          </div>
          <!-- 5. Product Discounts -->
          <div class="stat-card">
            <div class="stat-value">₹<%= typeof totalProductDiscount !== 'undefined' ? totalProductDiscount.toLocaleString() : 0 %></div>
            <div class="stat-label">Product Discounts</div>
          </div>
          <!-- 6. Coupon Deductions -->
          <div class="stat-card">
            <div class="stat-value">₹<%= typeof totalCouponDiscount !== 'undefined' ? totalCouponDiscount.toLocaleString() : 0 %></div>
            <div class="stat-label">Coupon Deductions</div>
          </div>
          <!-- 7. Total Returned Orders -->
          <div class="stat-card">
             <div class="stat-value"><%= typeof totalReturns !== 'undefined' ? totalReturns : 0 %></div>
             <div class="stat-label">Total Returned Orders</div>
          </div>
          <!-- 8. Returned Customers -->
          <div class="stat-card">
             <div class="stat-value"><%= typeof returnCustomers !== 'undefined' ? returnCustomers : 0 %></div>
             <div class="stat-label">Returned Customers</div>
          </div>
        </div>
        <!-- Revenue Overview Chart - Full Width -->
        <div class="mb-8">
          <div class="chart-container">
            <div class="chart-title">Revenue Overview</div>
            <canvas id="revenueChart"></canvas>
            <div class="flex justify-center mt-4 gap-6 text-sm">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#e5e7eb] rounded"></div>
                <span class="text-gray-400">Today's Revenue</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#c5a987] rounded"></div>
                <span class="text-gray-400">Past Revenue</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Last 2 Charts in a Single Row (Small Size) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
          <!-- Sales by Category -->
          <div class="small-chart-container">
            <div class="small-chart-title">Sales by Category</div>
            <canvas id="categoryChart"></canvas>
          </div>
          <!-- Sales by Gender -->
          <div class="small-chart-container">
            <div class="small-chart-title">Sales by Gender</div>
            <canvas id="genderChart"></canvas>
            <div class="gender-legend">
              <div class="legend-item">
                <div class="legend-bar men-bar"></div>
                <span>MEN: ₹<%= menSales || 0 %></span>
              </div>
              <div class="legend-item">
                <div class="legend-bar women-bar"></div>
                <span>WOMEN: ₹<%= womenSales || 0 %></span>
              </div>
              <div class="legend-item">
                <div class="legend-bar unisex-bar"></div>
                <span>UNISEX: ₹<%= unisexSales || 0 %></span>
              </div>
            </div>
          </div>
        </div>
        <!-- Sales Report Table - Order Based -->
        <div class="sales-table-container">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-white">Sales Report - Orders & Transactions</h2>
            <div class="flex gap-4 text-sm">
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-[#c5a987]/20 border-l-2 border-white rounded-sm"></div>
                <span class="text-gray-400">Today's Orders</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-gray-900 border border-gray-700 rounded-sm"></div>
                <span class="text-gray-400">Past Orders</span>
              </div>
            </div>
          </div>
          <% if (orderSalesData && orderSalesData.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="min-w-full table-auto border-collapse">
              <thead>
                <tr class="bg-gray-800">
                  <th class="px-4 py-2 text-left">Order ID</th>
                  <th class="px-4 py-2 text-left">Date</th>
                  <th class="px-2 py-2 text-left">Customer</th>
                  <th class="px-2 py-2 text-left">Status</th>
                  <th class="px-4 py-2 text-left">Amount</th>
                  <th class="px-4 py-2 text-left">Coupon</th>
                  <th class="px-4 py-2 text-left">Method</th>
                </tr>
              </thead>
              <tbody>
                <% orderSalesData.forEach(function(row) { %>
                <tr class="border-b border-gray-700 hover:bg-gray-900">
                  <td class="px-4 py-2 font-mono text-xs"><%= row.orderId %></td>
                  <td class="px-4 py-2 text-xs"><%= row.date %></td>
                  <td class="px-2 py-2 text-sm">
                    <div class="font-medium truncate w-24"><%= row.customerName %></div>
                  </td>
                  <td class="px-2 py-2">
                    <span class="px-2 py-1 text-[10px] rounded <%= row.status === 'Delivered' ? 'bg-green-900 text-green-200' : row.status === 'Placed' ? 'bg-blue-900 text-blue-200' : row.status === 'Cancelled' ? 'bg-red-900 text-red-200' : row.status === 'Returned' ? 'bg-purple-900 text-purple-200' : 'bg-yellow-900 text-yellow-200' %>">
                      <%= row.status %>
                    </span>
                  </td>
                  <td class="px-4 py-2 font-bold text-sm">
                    <% if (row.isDebit) { %>
                        <span class="text-red-400">-₹<%= row.amount.toLocaleString() %></span>
                    <% } else { %>
                        <span class="text-green-400">+₹<%= row.amount.toLocaleString() %></span>
                    <% } %>
                  </td>
                  <td class="px-4 py-2 text-xs">
                    <% if(row.discountAmount > 0) { %>
                        <div class="text-orange-400">-₹<%= row.discountAmount.toLocaleString() %></div>
                        <div class="text-[10px] text-gray-500"><%= row.couponCode %></div>
                    <% } else { %>
                        <span>-</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-2 text-xs"><%= row.paymentMethod %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <!-- Pagination Controls -->
          <% if (totalPages > 1) { %>
          <div class="flex items-center justify-center gap-1 mt-4">
            <%
              const queryParams = `limit=${limit}&startDate=${dateRange.startDate || ''}&endDate=${dateRange.endDate || ''}&period=${period}`;
              const getPageUrl = (pageNum) => `?page=${pageNum}&${queryParams}`;
            %>
            <!-- Previous Button -->
            <% if (currentPage > 1) { %>
              <a href="<%= getPageUrl(currentPage - 1) %>" class="pagination-prev">‹ Previous</a>
            <% } else { %>
              <button class="pagination-prev" disabled>‹ Previous</button>
            <% } %>
            <!-- Page Numbers -->
            <% if (totalPages <= 5) { %>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="<%= getPageUrl(i) %>" class="pagination-page <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
              <% } %>
            <% } else { %>
              <% if (currentPage <= 3) { %>
                <% for(let i = 1; i <= 4; i++) { %>
                  <a href="<%= getPageUrl(i) %>" class="pagination-page <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } %>
                <span class="pagination-ellipsis">...</span>
                <a href="<%= getPageUrl(totalPages) %>" class="pagination-page"> <%= totalPages %> </a>
              <% } else if (currentPage >= totalPages - 2) { %>
                <a href="<%= getPageUrl(1) %>" class="pagination-page">1</a>
                <span class="pagination-ellipsis">...</span>
                <% for(let i = totalPages - 3; i <= totalPages; i++) { %>
                  <a href="<%= getPageUrl(i) %>" class="pagination-page <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } %>
              <% } else { %>
                <a href="<%= getPageUrl(1) %>" class="pagination-page">1</a>
                <span class="pagination-ellipsis">...</span>
                <% for(let i = currentPage - 1; i <= currentPage + 1; i++) { %>
                  <a href="<%= getPageUrl(i) %>" class="pagination-page <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                <% } %>
                <span class="pagination-ellipsis">...</span>
                <a href="<%= getPageUrl(totalPages) %>" class="pagination-page"><%= totalPages %></a>
              <% } %>
            <% } %>
            <!-- Next Button -->
            <% if (currentPage < totalPages) { %>
              <a href="<%= getPageUrl(currentPage + 1) %>" class="pagination-next">Next ›</a>
            <% } else { %>
              <button class="pagination-next" disabled>Next ›</button>
            <% } %>
          </div>
          <% } %>
          <% } else { %>
          <p class="text-center text-gray-500 py-8">No order data available</p>
          <% } %>
        </div>
      </main>
    </div>
    <!-- Custom Date Modal -->
    <div id="customModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
      <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-gray-800">
        <h3 class="text-lg font-bold text-white mb-4">Custom Date Range</h3>
      
        <div class="mb-4">
          <label class="block text-gray-400 text-sm mb-1">Start Date</label>
          <input type="date" id="modalStartDate" value="<%= dateRange.startDate || '' %>" class="w-full bg-gray-700 text-white rounded px-3 py-2 border border-gray-600 focus:border-brand outline-none transition-colors">
        </div>
      
        <div class="mb-4">
          <label class="block text-gray-400 text-sm mb-1">End Date</label>
          <input type="date" id="modalEndDate" value="<%= dateRange.endDate || '' %>" class="w-full bg-gray-700 text-white rounded px-3 py-2 border border-gray-600 focus:border-brand outline-none transition-colors">
        </div>
        <div class="flex justify-end space-x-2">
          <button id="resetDates" class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700">Reset</button>
          <button id="applyCustom" class="px-4 py-2 bg-brand text-gray-800 rounded hover:bg-[#b7947a]">Apply</button>
        </div>
      </div>
    </div>
    <!-- Export Modal -->
    <div id="exportModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
      <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-gray-800">
        <h3 class="text-lg font-bold text-white mb-4">Export Sales Report</h3>
      
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-300 mb-2">Select Format:</label>
          <div class="flex space-x-4">
            <label class="flex items-center">
              <input type="radio" id="formatExcel" name="exportFormat" value="excel" checked class="mr-2">
              <span class="text-gray-300">Excel</span>
            </label>
            <label class="flex items-center">
              <input type="radio" id="formatPdf" name="exportFormat" value="pdf" class="mr-2">
              <span class="text-gray-300">PDF</span>
            </label>
          </div>
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-300 mb-2">Select Period:</label>
          <div class="space-y-2">
            <label class="flex items-center">
              <input type="radio" name="periodType" value="weekly" class="mr-2">
              <span class="text-gray-300">Last Week</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="periodType" value="monthly" class="mr-2">
              <span class="text-gray-300">Last Month</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="periodType" value="yearly" class="mr-2">
              <span class="text-gray-300">Last Year</span>
            </label>
            <label class="flex items-center">
              <input type="radio" name="periodType" value="custom" class="mr-2">
              <span class="text-gray-300">Custom Date Range</span>
            </label>
          </div>
        </div>
        <div id="customDateRange" class="hidden mb-4 space-y-2">
          <label class="block text-sm font-medium text-gray-300">Start Date:</label>
          <input type="date" id="startDate" class="w-full p-2 border border-gray-600 rounded bg-gray-700 text-white">
          <label class="block text-sm font-medium text-gray-300">End Date:</label>
          <input type="date" id="endDate" class="w-full p-2 border border-gray-600 rounded bg-gray-700 text-white">
        </div>
        <div class="flex justify-end space-x-2">
          <button id="cancelExport" class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700">Cancel</button>
          <button id="confirmExport" class="px-4 py-2 bg-brand text-gray-800 rounded hover:bg-[#b7947a]">Download Excel</button>
        </div>
      </div>
    </div>
    <!-- JS for Charts and Actions -->
    <script>
     lucide.createIcons();
      // Use raw injection + JSON.stringify in template to produce valid JS objects
      const revenueData = <%- JSON.stringify(revenueData || { labels: [], datasets: [] }) %>;
      const categoryData = <%- JSON.stringify(categoryData || { labels: [], datasets: [] }) %>;
      const genderData = <%- JSON.stringify(genderData || { labels: ["Men", "Women", "Unisex"], datasets:[{ data:[0,0,0], backgroundColor:["#3b82f6","#ec4899","#10b981"] }] }) %>;
      // Initialize Revenue Chart
      if (revenueData && revenueData.labels && revenueData.labels.length > 0) {
        new Chart(document.getElementById('revenueChart'), {
          type: 'bar',
          data: revenueData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  color: '#9ca3af',
                  callback: function(value) {
                    return '₹' + value.toLocaleString();
                  }
                },
                grid: { color: '#374151' }
              },
              x: { ticks: { color: '#9ca3af' }, grid: { color: '#374151' } }
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return 'Revenue: ₹' + context.parsed.y.toLocaleString();
                  }
                }
              }
            }
          }
        });
      } else {
        // Fallback: No Data chart
        new Chart(document.getElementById('revenueChart'), {
          type: 'bar',
          data: { labels: ["No Data"], datasets: [{ label: "Revenue", data: [0], backgroundColor: "#374151" }] },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { display: false }, x: { display: false } },
            plugins: { legend: { display: false } }
          }
        });
      }
      // Category Chart (with fallback)
      if (categoryData && categoryData.labels && categoryData.labels.length > 0 && categoryData.datasets && categoryData.datasets[0].data.some(d => d > 0)) {
        new Chart(document.getElementById('categoryChart'), {
          type: 'doughnut',
          data: categoryData,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: '#9ca3af', font: { size: 10 } }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const label = context.label || '';
                    const value = context.parsed || 0;
                    return label + ': ₹' + value.toLocaleString();
                  }
                }
              }
            }
          }
        });
      } else {
        new Chart(document.getElementById('categoryChart'), {
          type: 'doughnut',
          data: { labels: ["No Data"], datasets: [{ data: [1], backgroundColor: ["#374151"] }] },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
          }
        });
      }
      // Gender Chart (always render - data/labels always valid, even zeros)
      new Chart(document.getElementById('genderChart'), {
        type: 'bar',
        data: genderData,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: {
              beginAtZero: true,
              ticks: {
                color: '#9ca3af',
                callback: function(value) {
                  return '₹' + value.toLocaleString();
                }
              },
              grid: { color: '#374151' }
            },
            y: {
              ticks: { color: '#9ca3af' },
              grid: { color: '#374151' }
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return '₹' + context.parsed.x.toLocaleString();
                }
              }
            }
          }
        }
      });
      // Period Selection Logic
      const periodButtons = document.querySelectorAll('[data-period]');
      const currentPeriod = '<%= period || "today" %>'; // Assume default or from backend
      periodButtons.forEach(btn => {
        if (btn.dataset.period === currentPeriod) {
          btn.classList.add('active');
        }
        btn.addEventListener('click', () => {
          // Special handling for Custom: Open modal instead of redirect
          if (btn.dataset.period === 'custom') {
            document.getElementById('customModal').classList.remove('hidden');
            return; // Don't redirect
          }
          let startDate, endDate;
          const today = new Date().toISOString().split('T')[0];
          if (btn.dataset.period === 'today') {
            startDate = endDate = today;
          } else if (btn.dataset.period === 'week') {
            const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
            startDate = oneWeekAgo;
            endDate = today;
          } else if (btn.dataset.period === 'month') {
            const oneMonthAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
            startDate = oneMonthAgo;
            endDate = today;
          } else if (btn.dataset.period === 'year') {
            const oneYearAgo = new Date(Date.now() - 365 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
            startDate = oneYearAgo;
            endDate = today;
          }
          // Update active class
          periodButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          window.location.href = `/admin/sales?startDate=${startDate}&endDate=${endDate}&period=${btn.dataset.period}`;
        });
      });
      // Custom Modal Logic
      const customModal = document.getElementById('customModal');
      const applyCustomBtn = document.getElementById('applyCustom');
      const resetDatesBtn = document.getElementById('resetDates');
      applyCustomBtn.addEventListener('click', () => {
        const startDate = document.getElementById('modalStartDate').value;
        const endDate = document.getElementById('modalEndDate').value;
        const today = new Date().toISOString().split('T')[0];
        if (!startDate || !endDate) {
          Swal.fire({
            title: 'Error',
            text: 'Please provide both start and end dates.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }
        if (startDate > today || endDate > today) {
          Swal.fire({
            title: 'Error',
            text: 'Dates cannot be in the future. Please select dates up to today.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }
        if (endDate < startDate) {
          Swal.fire({
            title: 'Error',
            text: 'End date cannot be before the start date.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }
        window.location.href = `/admin/sales?startDate=${startDate}&endDate=${endDate}&period=custom`;
        customModal.classList.add('hidden');
      });
      resetDatesBtn.addEventListener('click', () => {
        window.location.href = `/admin/sales`;
      });
      // Close custom modal on outside click
      customModal.addEventListener('click', (e) => {
        if (e.target === customModal) {
          customModal.classList.add('hidden');
        }
      });
      // Export Modal Logic
      const modal = document.getElementById('exportModal');
      const exportBtn = document.getElementById('exportBtn');
      const cancelBtn = document.getElementById('cancelExport');
      const confirmBtn = document.getElementById('confirmExport');
      const customRange = document.getElementById('customDateRange');
      const periodRadios = document.querySelectorAll('input[name="periodType"]');
      const excelRadio = document.getElementById('formatExcel');
      const pdfRadio = document.getElementById('formatPdf');

      // Update button text dynamicallly
      function updateButtonText() {
        if (pdfRadio.checked) {
          confirmBtn.textContent = 'Download PDF';
        } else {
          confirmBtn.textContent = 'Download Excel'; 
        }
      }

      excelRadio.addEventListener('change', updateButtonText);
      pdfRadio.addEventListener('change', updateButtonText);

      exportBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
        updateButtonText(); // Ensure correct text on open
      });
      cancelBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
        customRange.classList.add('hidden');
      });
      periodRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          if (e.target.value === 'custom') {
            customRange.classList.remove('hidden');
          } else {
            customRange.classList.add('hidden');
          }
        });
      });
      confirmBtn.addEventListener('click', async () => {
        const selectedType = document.querySelector('input[name="periodType"]:checked')?.value;
        // Robust selection check
        const isPdf = document.getElementById('formatPdf').checked;
        const selectedFormat = isPdf ? 'pdf' : 'excel';
        
        if (!selectedType) {
          Swal.fire({
            title: 'Error',
            text: 'Please select a period type.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }
        let startDate, endDate;
        const today = new Date().toISOString().split('T')[0];
        const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        const oneMonthAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        const oneYearAgo = new Date(Date.now() - 365 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        if (selectedType === 'weekly') {
          startDate = oneWeekAgo;
          endDate = today;
        } else if (selectedType === 'monthly') {
          startDate = oneMonthAgo;
          endDate = today;
        } else if (selectedType === 'yearly') {
          startDate = oneYearAgo;
          endDate = today;
        } else if (selectedType === 'custom') {
          startDate = document.getElementById('startDate').value;
          endDate = document.getElementById('endDate').value;
          if (!startDate || !endDate) {
            Swal.fire({
              title: 'Error',
              text: 'Please select both start and end dates.',
              icon: 'error',
              confirmButtonText: 'OK'
            });
            return;
          }
          if (startDate > today || endDate > today) {
            Swal.fire({
              title: 'Error',
              text: 'Dates cannot be in the future. Please select dates up to today.',
              icon: 'error',
              confirmButtonText: 'OK'
            });
            return;
          }
          if (endDate < startDate) {
            Swal.fire({
              title: 'Error',
              text: 'End date cannot be before the start date.',
              icon: 'error',
              confirmButtonText: 'OK'
            });
            return;
          }
        }
        try {
          const endpoint = selectedFormat === 'pdf' ? '/admin/sales-report/export-pdf' : '/admin/sales-report/export';
          const extension = selectedFormat === 'pdf' ? 'pdf' : 'xlsx';

          // Show loading state
          const originalText = confirmBtn.textContent;
          confirmBtn.textContent = 'Generating...';
          confirmBtn.disabled = true;

          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ startDate, endDate }),
          });
          
          if (response.ok) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `sales-report-${startDate}-to-${endDate}.${extension}`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            modal.classList.add('hidden');
          } else {
            console.error('Export response not OK:', response.status, response.statusText);
            const errorText = await response.text();
             Swal.fire({
              title: 'Error',
              text: 'Export failed. Server returned error: ' + (errorText || response.statusText),
              icon: 'error',
              confirmButtonText: 'OK'
            });
          }
        } catch (error) {
          console.error('Export error:', error);
          Swal.fire({
            title: 'Error',
            text: 'Export failed. Please try again.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
        } finally {
            confirmBtn.textContent = originalText;
            confirmBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>