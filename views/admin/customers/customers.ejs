<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diet</title>
    <link rel="stylesheet" href="/style/admin/customers.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  </head>
  <body class="min-h-screen bg-black text-white">
    <!-- Header Partial -->
    <%- include("../../partials/admin/admin-header") %>

    <div class="flex">
      <!-- Sidebar Partial -->
      <%- include("../../partials/admin/admin-sidebar") %>

      <!-- Page Content -->
      <main class="flex-1 p-6">
        <div class="mb-6">
          <h1 class="text-2xl font-bold mb-4">Customer Management</h1>
          <div class="flex justify-between mb-4">

          </div>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6"
          >
            <div class="count-box">
              <p class="text-gray-400">Total Customers</p>
              <p class="text-xl font-bold"><%= customers.length %></p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">New Customers</p>
              <p class="text-xl font-bold text-green-400">
                <%= newCustomerCount %>
              </p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Total Orders</p>
              <p class="text-xl font-bold">
                <%= totelOrdersCount[0].totelOrders %>
              </p>
            </div>
            <div class="count-box">
              <p class="text-gray-400">Total Spent</p>
              <p class="text-xl font-bold">
                Rs.<%= totelSpentCount[0].totelSpent %>
              </p>
            </div>
          </div>
          <div class="flex justify-between mb-4">
            <span>All Customers</span>
            <div class="flex space-x-4">
              <!-- Sort By -->
              <div class="flex items-center space-x-2">
                <select id="sortFilter" class="bg-gray-800 p-2 rounded text-white" onchange="applyFilters()">
                  <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                  <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                  <option value="a_z" <%= sort === 'a_z' ? 'selected' : '' %>>Name A-Z</option>
                  <option value="z_a" <%= sort === 'z_a' ? 'selected' : '' %>>Name Z-A</option>
                </select>
              </div>

              <!-- Status Filter -->
              <select id="statusFilter" class="bg-gray-800 p-2 rounded text-white" onchange="applyFilters()">
                <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Status</option>
                <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="blocked" <%= status === 'blocked' ? 'selected' : '' %>>Blocked</option>
              </select>

              <!-- Search bar -->
              <div class="flex space-x-2">
                 <input
                  type="text"
                  id="searchInput"
                  value="<%= search %>"
                  placeholder="Search Name/Email..."
                  class="bg-gray-800 p-2 rounded text-white placeholder-gray-500"
                  onkeypress="if(event.key === 'Enter') applyFilters()"
                />
                <button onclick="applyFilters()" class="bg-brand text-white px-3 rounded hover:bg-yellow-700 transition">
                  <i data-lucide="search" class="w-4 h-4"></i>
                </button>
                 <% if(search || status !== 'all' || sort !== 'newest') { %>
                  <a href="/admin/customers" class="flex items-center justify-center bg-gray-700 text-white px-3 rounded hover:bg-gray-600 transition" title="Clear Filters">
                    <i data-lucide="x" class="w-4 h-4"></i>
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto border-collapse">
            <thead>
              <tr class="bg-gray-800">
                <th class="px-4 py-2 text-left">NAME</th>
                <th class="px-4 py-2 text-left">EMAIL</th>

                <th class="px-4 py-2 text-left">STATUS</th>
              </tr>
            </thead>
            <tbody>
              <% customers.forEach(customer => { %>
              <tr class="border-b border-gray-700 hover:bg-gray-900 cursor-pointer" onclick="window.location.href='/admin/customers/<%= customer._id %>'">
                <td class="px-4 py-2"><%= customer.name %></td>
                <td class="px-4 py-2"><%= customer.email %></td>

                <td class="px-4 py-2">
                  <% if(!customer.isBlocked) { %>
                  <span class="status-active">Active</span>
                  <% } else { %>
                  <span class="status-blocked">Blocked</span>
                  <% } %>
                </td>

              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <!-- Confirmation Modal -->
    <div
      id="blockModal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
    >
      <div class="bg-gray-900 p-6 rounded-lg shadow-lg w-96">
        <h2 class="text-lg font-bold mb-4">Confirm Action</h2>
        <p id="blockMessage" class="mb-6 text-gray-300"></p>

        <div class="flex justify-end space-x-4">
          <button
            id="cancelBlock"
            class="px-4 py-2 bg-gray-600 rounded hover:bg-gray-700"
          >
            Cancel
          </button>
          <form id="blockForm" method="POST">
            <button
              type="submit"
              class="px-4 py-2 bg-red-600 rounded hover:bg-red-700"
            >
              Confirm
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Pagination and Page Limit -->
    <div class="flex justify-between items-center mt-4">
      <!-- Pagination Controls (Centered) -->
      <div class="flex-1 flex justify-center items-center space-x-4">
        <% if (totalPages > 1) { %>
          <% if (currentPage > 1) { %>
            <a
              href="/admin/customers?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>"
              class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
            >
              <i data-lucide="chevron-left" class="w-5 h-5"></i>
            </a>
          <% } %>
          <span class="text-gray-400">
            <%= currentPage %> / <%= totalPages %>
          </span>
          <% if (currentPage < totalPages) { %>
            <a
              href="/admin/customers?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>"
              class="px-3 py-1 rounded bg-gray-800 text-white hover:bg-gray-700"
            >
              <i data-lucide="chevron-right" class="w-5 h-5"></i>
            </a>
          <% } %>
        <% } %>
      </div>

      <!-- Page Limit Dropdown (Right) -->
      <div class="flex items-center space-x-2">
        <label for="pageLimit" class="text-gray-400">Show</label>
        <select
          id="pageLimit"
          class="bg-white p-2 rounded text-black"
          onchange="changePageLimit(this.value)"
        >
          <option value="5" <%= limit == 5 ? 'selected' : '' %>>5</option>
          <option value="10" <%= limit == 10 ? 'selected' : '' %>>10</option>
          <option value="20" <%= limit == 20 ? 'selected' : '' %>>20</option>
          <option value="50" <%= limit == 50 ? 'selected' : '' %>>50</option>
        </select>
        <span class="text-gray-400">per page</span>
      </div>
    </div>

    <script>
      lucide.createIcons();

      // Handle page limit change
      function changePageLimit(limit) {
        const url = new URL(window.location.href);
        url.searchParams.set('limit', limit);
        url.searchParams.set('page', 1); // Reset to page 1 when limit changes
        window.location.href = url.toString();
      }

      // Apply Filters (Search, Sort, Status)
      function applyFilters() {
        const search = document.getElementById('searchInput').value.trim();
        const sort = document.getElementById('sortFilter').value;
        const status = document.getElementById('statusFilter').value;
        
        const url = new URL(window.location.href);
        
        if (search) url.searchParams.set('search', search);
        else url.searchParams.delete('search');

        if (sort && sort !== 'newest') url.searchParams.set('sort', sort);
        else url.searchParams.delete('sort'); // Default

        if (status && status !== 'all') url.searchParams.set('status', status);
        else url.searchParams.delete('status'); // Default

        url.searchParams.set('page', 1); // Reset to page 1
        window.location.href = url.toString();
      }

      document.querySelectorAll(".open-block-modal").forEach((button) => {
        button.addEventListener("click", () => {
          const userId = button.dataset.id;
          const userName = button.dataset.name;

          // Update modal message
          document.getElementById(
            "blockMessage"
          ).textContent = `Are you sure you want to block/unblock ${userName}?`;

          // Update form action
          document.getElementById(
            "blockForm"
          ).action = `/admin/customers/block/${userId}`;

          // Show modal
          document.getElementById("blockModal").classList.remove("hidden");
        });
      });

      // Cancel button
      document.getElementById("cancelBlock").addEventListener("click", () => {
        document.getElementById("blockModal").classList.add("hidden");
      });
    </script>
  </body>
</html>