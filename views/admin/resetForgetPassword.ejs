<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dité - Reset Password</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: #000;
    }

    .container {
      display: flex;
      width: 800px;
      height: 500px;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
      background: #d6c2aa;
    }

    /* Left Section (Image) */
    .left {
      flex: 1;
      background: url("/images/Admin/otpforget.jpg") no-repeat center center/cover;
    }

    /* Right Section (Content) */
    .right {
      flex: 1;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .logo img {
      max-width: 140px;
      margin-bottom: 20px;
    }

    .title {
      font-size: 26px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 14px;
      margin-bottom: 25px;
      color: #333;
    }

    /* Password input fields */
    .password-inputs {
      width: 100%;
      max-width: 280px;
      margin-bottom: 20px;
    }

    .password-inputs input {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      outline: none;
      box-sizing: border-box;
    }

    .password-inputs input:focus {
      border-color: #333;
      box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
    }

    .password-inputs input::placeholder {
      color: #999;
    }

    /* Password requirements */
    .password-requirements {
      text-align: left;
      font-size: 12px;
      color: #666;
      margin-bottom: 15px;
    }

    .password-requirements ul {
      margin: 0;
      padding-left: 20px;
    }

    .password-requirements li {
      margin-bottom: 5px;
    }

    /* Confirm button */
    button {
      width: 100%;
      max-width: 280px;
      padding: 12px;
      border: none;
      border-radius: 8px;
      background: black;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }

    button:disabled {
      background: #ccc;
      cursor: not-allowed;
    }

    .resend {
      margin-top: 15px;
      font-size: 14px;
      color: #333;
    }

    .resend a {
      color: blue;
      text-decoration: none;
      margin-left: 5px;
    }

    .back {
      margin-top: 20px;
      font-size: 14px;
      color: #444;
      text-decoration: none;
      display: block;
    }

    /* Messages */
    #errorMsg {
      color: red;
      font-size: 14px;
      margin-bottom: 10px;
    }
    #successMsg {
      color: green;
      font-size: 14px;
      margin-bottom: 10px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .container {
        flex-direction: column;
        width: 90%;
        height: auto;
      }
      .left {
        height: 250px;
      }
      .right {
        padding: 30px 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Left Image -->
    <div class="left"></div>

    <!-- Right Content -->
    <div class="right">
      <div class="logo">
        <img src="/images/logo/Dite White Logo.png" alt="Dité Logo">
      </div>

      <!-- Messages -->
      <span id="errorMsg"></span>
      <span id="successMsg"></span>

      <div class="title">Reset Your Password</div>
      <div class="subtitle">Enter your new password below</div>

      <!-- Password Form -->
      <form id="passwordForm">
        <div class="password-inputs">
          <input 
            type="password" 
            id="newPassword"
            name="newPassword" 
            placeholder="New Password"
          />
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword"
            placeholder="Confirm Password"
            
          />

        <button type="submit" id="submitBtn">RESET PASSWORD</button>
      </form>

      <a href="/admin" class="back">Go back to Login page</a>
    </div>
  </div>

 <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>


 


  const newPasswordInput = document.getElementById('newPassword');
  const confirmPasswordInput = document.getElementById('confirmPassword');
  const submitBtn = document.getElementById('submitBtn');

  function checkPasswordsMatch() {
    const newPass = newPasswordInput.value.trim();
    const confirmPass = confirmPasswordInput.value.trim();

    // Enable button only when passwords match and not empty
    const isValid = newPass !== "" && newPass === confirmPass;
    submitBtn.disabled = !isValid;

    return isValid;
  }

  // Real-time validation
  newPasswordInput.addEventListener('input', checkPasswordsMatch);
  confirmPasswordInput.addEventListener('input', checkPasswordsMatch);

  // Handle form submit
  document.getElementById("passwordForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const newPassword = newPasswordInput.value.trim();
    const confirmPassword = confirmPasswordInput.value.trim();

    if (newPassword !== confirmPassword) {
      document.getElementById("errorMsg").innerText = "Passwords do not match!";
      document.getElementById("successMsg").innerText = "";
      return;
    }

    try {
      const token = "<%= token %>";
      const res = await axios.post(`/admin/reset-password/${token}`, { newPassword, confirmPassword });

      document.getElementById("successMsg").innerText = res.data.message || "Password reset successfully!";
      document.getElementById("errorMsg").innerText = "";

      if (res.data.success) {
        setTimeout(() => {
          window.location.href = "/admin";
        }, 2000);
      }
    } catch (err) {
      const msg = err.response?.data?.message || "Something went wrong!";
      document.getElementById("errorMsg").innerText = msg;
      document.getElementById("successMsg").innerText = "";
    }
  });

  // Initial validation check
  checkPasswordsMatch();
</script>

</body>
</html>