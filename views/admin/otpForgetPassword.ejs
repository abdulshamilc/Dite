<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dité - OTP Verification</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #000;
      }

      .container {
        display: flex;
        width: 800px;
        height: 500px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        background: #d6c2aa;
      }

      /* Left Section (Image) */
      .left {
        flex: 1;
        background: url("/images/Admin/otpforget.jpg") no-repeat center
          center/cover;
      }

      /* Right Section (Content) */
      .right {
        flex: 1;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
      }

      .logo img {
        max-width: 140px;
        margin-bottom: 20px;
      }

      .title {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 10px;
      }

      .subtitle {
        font-size: 14px;
        margin-bottom: 25px;
        color: #333;
      }

      /* OTP input boxes */
      .otp-inputs {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
      }

      .otp-inputs input {
        width: 45px;
        height: 50px;
        text-align: center;
        font-size: 20px;
        border: 1px solid #ccc;
        border-radius: 8px;
        outline: none;
      }

      /* Confirm button */
      button {
        width: 100%;
        max-width: 280px;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: black;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
      }

      .resend {
        margin-top: 15px;
        font-size: 14px;
        color: #333;
      }

      .resend a {
        color: blue;
        text-decoration: none;
        margin-left: 5px;
      }

      .back {
        margin-top: 20px;
        font-size: 14px;
        color: #444;
        text-decoration: none;
        display: block;
      }

      /* Messages */
      #errorMsg {
        color: red;
        font-size: 14px;
        margin-bottom: 10px;
      }
      #successMsg {
        color: green;
        font-size: 14px;
        margin-bottom: 10px;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .container {
          flex-direction: column;
          width: 90%;
          height: auto;
        }
        .left {
          height: 250px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Left Image -->
      <div class="left"></div>

      <!-- Right Content -->
      <div class="right">
        <div class="logo">
          <img src="/images/logo/DiteLogo.png" alt="Dité Logo" />
        </div>

        <!-- Messages -->
        <span id="errorMsg"></span>
        <span id="successMsg"></span>

        <div class="title">Confirm with OTP</div>
        <div class="subtitle">Please check your mail address for OTP</div>

        <!-- OTP Inputs -->
        <form id="otpForm">
          <div class="otp-inputs">
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
            <input type="text" maxlength="1" />
          </div>

          <!-- Timer + Resend -->
          <div class="resend">
            Remaining Time: <span id="timer">01:00</span>
            Didn’t receive code?
            <a href="#" id="resendLink">Resend</a>
          </div>

          <button type="submit">CONFIRM</button>
        </form>

        <a href="/admin" class="back">Go back to Login page</a>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      // Timer
      let time = 60;
      const timerEl = document.getElementById("timer");
      const countdown = setInterval(() => {
        time--;
        let m = String(Math.floor(time / 60)).padStart(2, "0");
        let s = String(time % 60).padStart(2, "0");
        timerEl.textContent = `${m}:${s}`;
        if (time <= 0) clearInterval(countdown);
      }, 1000);

      // OTP Input Auto-Focus
      const inputs = document.querySelectorAll(".otp-inputs input");
      inputs.forEach((input, index) => {
        input.addEventListener("input", () => {
          if (input.value && index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
        });
      });

      // Handle OTP Submit
      document
        .getElementById("otpForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          let otp = "";
          inputs.forEach((i) => (otp += i.value));
          console.log("Entered OTP:", otp);

          // Example: axios.post('/verify-otp',{otp})
          try {
            const res = await axios.post("/admin/verify-otp", { otp });

            if (res.data.success && res.data.redirectUrl) {
              window.location.href = res.data.redirectUrl;
            }
          } catch (err) {
            // Error message
            console.error(err);
            const msg = err.response?.data?.message || "Something went wrong!";
            document.getElementById("errorMsg").innerText = msg;
            document.getElementById("successMsg").innerText = "";
          }
        });

      // Resend handler
      document.getElementById("resendLink").addEventListener("click", (e) => {
        e.preventDefault();
        // You can call backend API here to resend
      });
    </script>
  </body>
</html>
