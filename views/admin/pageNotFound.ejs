<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Dité</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <link rel="stylesheet" href="/style/admin/pageNotFound.css">
  
</head>
<body class="min-h-screen bg-black flex flex-col">

  <!-- Header Partial -->
  <%- include("../partials/admin/admin-header") %>

  <div class="flex flex-1">
    <!-- Sidebar Partial -->
    <%- include("../partials/admin/admin-sidebar") %>

    <!-- 404 Page Content -->
    <main class="flex-1 flex flex-col items-center justify-center text-center text-white p-6">
      <i data-lucide="alert-triangle" class="w-20 h-20 text-brand mb-6"></i>
      <h1 class="text-5xl font-bold mb-4">404</h1>
      <p class="text-xl mb-6">Oops! The page you’re looking for doesn’t exist.</p>
      <a href="/admin" 
         class="px-6 py-3 bg-brand text-black font-semibold rounded-lg shadow-md hover:bg-opacity-90 transition">
        Go Back Home
      </a>
    </main>
  </div>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
