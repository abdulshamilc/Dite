<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Profile - Dité</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .brand-text { color: #c5a987; }
    .btn-brand {
      background-color: #c5a987;
      color: black;
      font-weight: 600;
      transition: all 0.3s;
    }
    .btn-brand:hover {
      background-color: #d4af37;
      transform: translateY(-1px);
    }
    .btn-outline-brand {
      border: 2px solid #c5a987;
      color: #c5a987;
      font-weight: 600;
      transition: all 0.3s;
    }
    .btn-outline-brand:hover {
      background-color: #c5a987;
      color: black;
    }
    .input-dark {
      background-color: #1f2937;
      border: 1px solid #374151;
      color: white;
    }
    .input-dark:focus {
      border-color: #c5a987;
      outline: none;
      box-shadow: 0 0 0 2px rgba(197, 169, 135, 0.2);
    }
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.75);
      z-index: 50;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }
    .modal.active {
      display: flex;
    }
    .modal-content {
      background-color: #111827;
      border: 1px solid #374151;
      border-radius: 1rem;
      max-width: 500px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      animation: slideIn 0.3s ease-out;
    }
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .stat-card {
      background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
      border: 1px solid #374151;
      transition: all 0.3s;
    }
    .stat-card:hover {
      border-color: #c5a987;
      transform: translateY(-2px);
    }
    .profile-header {
      background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
      border: 1px solid #374151;
    }
    
    .session-item {
      transition: all 0.2s;
    }
    .session-item:hover {
      background-color: rgba(31, 41, 55, 0.5);
    }
  </style>
</head>
<body class="min-h-screen bg-black text-white">
  <%- include("../../partials/admin/admin-header") %>
  <div class="flex">
    <%- include("../../partials/admin/admin-sidebar") %>
    
    <main class="flex-1 p-6 lg:p-10">
      <div class="max-w-5xl mx-auto">
        
        <!-- Profile Header Card -->
        <div class="profile-header rounded-2xl p-8 mb-6">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="relative">
              <div class="w-28 h-28 rounded-2xl bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center ring-4 ring-gray-800 shadow-xl">
                <span class="text-5xl font-bold brand-text"><%= admin.email.charAt(0).toUpperCase() %></span>
              </div>
              <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-green-500 rounded-full border-4 border-gray-900 flex items-center justify-center">
                <i data-lucide="check" class="w-5 h-5 text-white"></i>
              </div>
            </div>
            
            <div class="flex-1 text-center md:text-left">
              <div class="flex flex-col md:flex-row md:items-center gap-3 mb-2">
                <h1 class="text-3xl font-bold"><%= admin.email.split('@')[0] %></h1>
                <span class="px-4 py-1.5 bg-gray-800 rounded-full text-xs font-bold brand-text uppercase tracking-wider inline-block w-fit mx-auto md:mx-0">
                  <%= admin.role %>
                </span>
              </div>
              <div class="flex items-center gap-2 text-gray-400 justify-center md:justify-start mb-4">
                <i data-lucide="mail" class="w-4 h-4"></i>
                <span><%= admin.email %></span>
              </div>
              <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                <button onclick="openPasswordModal()" class="btn-brand px-5 py-2.5 rounded-lg flex items-center gap-2 shadow-lg">
                  <i data-lucide="lock" class="w-4 h-4"></i>
                  Change Password
                </button>
                <button onclick="open2FAModal()" class="px-5 py-2.5 rounded-lg border border-gray-600 hover:bg-gray-800 flex items-center gap-2 transition-all">
                  <i data-lucide="shield-check" class="w-4 h-4 <%= is2FAEnabled ? 'text-green-500' : 'text-gray-400' %>"></i>
                  Two-Factor Auth
                  <% if(is2FAEnabled) { %>
                    <span class="ml-1 w-2 h-2 rounded-full bg-green-500"></span>
                  <% } %>
                </button>
                <a href="/admin/logout" class="btn-outline-brand px-5 py-2.5 rounded-lg flex items-center gap-2">
                  <i data-lucide="log-out" class="w-4 h-4"></i>
                  Logout
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Sessions Section -->
        <div class="stat-card rounded-xl p-6 mb-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold flex items-center gap-2">
              <i data-lucide="monitor-smartphone" class="w-5 h-5 brand-text"></i>
              Active Sessions
            </h2>
            <span class="text-xs font-medium text-gray-400 bg-gray-800 px-3 py-1 rounded-full"><%= activeSessions.length %> Active</span>
          </div>
          
          <div class="space-y-1">
            <% if (activeSessions && activeSessions.length > 0) { %>
              <% activeSessions.forEach(session => { %>
                <div class="session-item flex items-center justify-between p-4 rounded-lg border border-gray-800/50">
                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center">
                      <i data-lucide="<%= session.isCurrent ? 'monitor' : 'globe' %>" class="w-5 h-5 <%= session.isCurrent ? 'brand-text' : 'text-gray-400' %>"></i>
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <p class="font-medium text-gray-200"><%= session.device || 'Unknown Device' %></p>
                        <% if (session.isCurrent) { %>
                          <span class="text-[10px] font-bold bg-green-500/10 text-green-500 px-2 py-0.5 rounded border border-green-500/20">Current</span>
                        <% } %>
                      </div>
                      <p class="text-xs text-gray-500 mt-0.5">Expires: <%= new Date(session.lastAccess).toLocaleString() %></p>
                    </div>
                  </div>
                  
                  <% if (!session.isCurrent) { %>
                    <button onclick="endSession('<%= session.id %>')" class="text-xs font-medium text-red-400 hover:text-red-300 hover:underline">
                      End Session
                    </button>
                  <% } %>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center py-8 text-gray-500">
                No active sessions found.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Account Information & Security -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="stat-card rounded-xl p-6">
            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
              <i data-lucide="user-circle" class="w-5 h-5 brand-text"></i>
              Account Information
            </h2>
            <div class="space-y-5">
              <div class="flex items-start gap-3 pb-4 border-b border-gray-800">
                <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="mail" class="w-5 h-5 brand-text"></i>
                </div>
                <div class="flex-1">
                  <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Email Address</p>
                  <p class="text-gray-200 break-all"><%= admin.email %></p>
                </div>
              </div>

              <div class="flex items-start gap-3 pb-4 border-b border-gray-800">
                <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="fingerprint" class="w-5 h-5 brand-text"></i>
                </div>
                <div class="flex-1">
                  <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Account ID</p>
                  <p class="font-mono text-xs text-gray-400 break-all"><%= admin._id %></p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="clock" class="w-5 h-5 brand-text"></i>
                </div>
                <div class="flex-1">
                  <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Account Created</p>
                  <p class="text-gray-200"><%= new Date(admin.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="stat-card rounded-xl p-6">
            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
              <i data-lucide="shield" class="w-5 h-5 brand-text"></i>
              Security Actions
            </h2>
            <div class="space-y-4">
              <button onclick="openPasswordModal()" class="w-full bg-gray-800/50 hover:bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition-all text-left group">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <i data-lucide="lock" class="w-5 h-5 brand-text group-hover:scale-110 transition-transform"></i>
                    <div>
                      <h3 class="font-semibold text-gray-200">Change Password</h3>
                      <p class="text-xs text-gray-400">Update your account password</p>
                    </div>
                  </div>
                  <i data-lucide="chevron-right" class="w-4 h-4 text-gray-500"></i>
                </div>
              </button>

              <button onclick="open2FAModal()" class="w-full bg-gray-800/50 hover:bg-gray-800 rounded-lg p-4 border border-gray-700 hover:border-gray-600 transition-all text-left group">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <i data-lucide="shield-check" class="w-5 h-5 brand-text group-hover:scale-110 transition-transform"></i>
                    <div>
                      <h3 class="font-semibold text-gray-200">Two-Factor Authentication</h3>
                      <p class="text-xs text-gray-400">
                        <%= is2FAEnabled ? 'Enabled and secure' : 'Enable 2FA for better security' %>
                      </p>
                    </div>
                  </div>
                  <% if (is2FAEnabled) { %>
                    <span class="text-xs font-bold text-green-500 bg-green-500/10 px-2 py-1 rounded border border-green-500/20">Enabled</span>
                  <% } else { %>
                    <i data-lucide="chevron-right" class="w-4 h-4 text-gray-500"></i>
                  <% } %>
                </div>
              </button>

              <div class="bg-red-900/10 rounded-lg p-4 border border-red-900/30 mt-2">
                <div class="flex items-start gap-3">
                  <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500 mt-0.5"></i>
                  <div class="flex-1">
                    <h3 class="font-semibold text-red-500 mb-1">Danger Zone</h3>
                    <p class="text-xs text-gray-400 mb-3">Logout from all devices to secure your account</p>
                    <a href="/admin/logout" class="text-xs text-red-400 hover:text-red-300 font-semibold hover:underline flex items-center gap-1">
                      End all sessions
                      <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Password Change Modal -->
  <div id="passwordModal" class="modal">
    <div class="modal-content">
      <div class="p-6 border-b border-gray-700">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center">
              <i data-lucide="lock" class="w-5 h-5 brand-text"></i>
            </div>
            <div>
              <h2 class="text-xl font-bold">Change Password</h2>
              <p class="text-sm text-gray-400">Update your account password</p>
            </div>
          </div>
          <button onclick="closePasswordModal()" class="w-8 h-8 rounded-lg hover:bg-gray-800 flex items-center justify-center transition-colors">
            <i data-lucide="x" class="w-5 h-5 text-gray-400"></i>
          </button>
        </div>
      </div>

      <form id="changePasswordForm" class="p-6">
        <div class="space-y-4">
          <div>
            <div class="flex justify-between mb-2">
              <label class="block text-sm font-medium text-gray-300">Current Password</label>
              <a href="/admin/forgot-password" class="text-xs brand-text hover:underline">Forgot password?</a>
            </div>
            <div class="relative">
              <input type="password" id="currentPassword" name="currentPassword" class="w-full rounded-lg px-4 py-3 input-dark pr-12" placeholder="Enter your current password" required>
              <button type="button" class="absolute right-3 top-3 text-gray-500 hover:text-gray-300" onclick="togglePassword('currentPassword')">
                <i data-lucide="eye" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-300 mb-2">New Password</label>
            <div class="relative">
              <input type="password" id="newPassword" name="newPassword" class="w-full rounded-lg px-4 py-3 input-dark pr-12" placeholder="Minimum 8 characters" required>
              <button type="button" class="absolute right-3 top-3 text-gray-500 hover:text-gray-300" onclick="togglePassword('newPassword')">
                <i data-lucide="eye" class="w-5 h-5"></i>
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-1">Use at least 8 characters with a mix of letters and numbers</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-300 mb-2">Confirm New Password</label>
            <div class="relative">
              <input type="password" id="confirmPassword" name="confirmPassword" class="w-full rounded-lg px-4 py-3 input-dark pr-12" placeholder="Re-enter your new password" required>
              <button type="button" class="absolute right-3 top-3 text-gray-500 hover:text-gray-300" onclick="togglePassword('confirmPassword')">
                <i data-lucide="eye" class="w-5 h-5"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="flex gap-3 mt-6 pt-6 border-t border-gray-700">
          <button type="button" onclick="closePasswordModal()" class="flex-1 px-6 py-3 rounded-lg border-2 border-gray-700 text-gray-300 font-semibold hover:bg-gray-800 transition-colors">
            Cancel
          </button>
          <button type="submit" class="flex-1 btn-brand px-6 py-3 rounded-lg flex items-center justify-center gap-2 shadow-lg">
            <i data-lucide="check" class="w-4 h-4"></i>
            Update Password
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2FA Modal -->
  <div id="twoFAModal" class="modal">
    <div class="modal-content">
      <div class="p-6 border-b border-gray-700">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center">
              <i data-lucide="shield-check" class="w-5 h-5 brand-text"></i>
            </div>
            <div>
              <h2 class="text-xl font-bold">Two-Factor Authentication</h2>
              <p class="text-sm text-gray-400">Enhanced security for your account</p>
            </div>
          </div>
          <button onclick="close2FAModal()" class="w-8 h-8 rounded-lg hover:bg-gray-800 flex items-center justify-center transition-colors">
            <i data-lucide="x" class="w-5 h-5 text-gray-400"></i>
          </button>
        </div>
      </div>

      <div class="p-6">
        <% if (is2FAEnabled) { %>
          <!-- Disable Flow -->
          <div class="text-center py-4">
            <div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-500/20">
              <i data-lucide="check-circle" class="w-8 h-8 text-green-500"></i>
            </div>
            <h3 class="text-lg font-bold mb-2">2FA is Currently Enabled</h3>
            <p class="text-gray-400 text-sm mb-6">Your account is secured with two-factor authentication.</p>
            
            <form id="disable2FAForm" class="text-left space-y-4">
               <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">Enter Password to Disable</label>
                  <input type="password" name="password" id="disable2FAPassword" class="w-full rounded-lg px-4 py-2.5 input-dark" placeholder="Current Password" required>
               </div>
               <div>
                  <label class="block text-sm font-medium text-gray-300 mb-1">Enter 2FA Code</label>
                  <input type="text" name="token" id="disable2FAToken" class="w-full rounded-lg px-4 py-2.5 input-dark" placeholder="6-digit code" maxlength="6" pattern="\d{6}" required>
               </div>
               <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-lg transition-colors flex items-center justify-center gap-2">
                  <i data-lucide="shield-off" class="w-4 h-4"></i>
                  Disable 2FA
               </button>
            </form>
          </div>
        <% } else { %>
          <!-- Enable Flow -->
          <div id="enableSteps">
             <!-- Step 1: Generate -->
             <div id="stepGenerate" class="text-center">
                <p class="text-gray-300 mb-6">Scan the QR code below with your authenticator app (Google Authenticator, Authy, etc.) to set up 2FA.</p>
                <div class="bg-white p-4 rounded-xl w-fit mx-auto mb-6">
                   <div id="qrCodeContainer" class="w-48 h-48 flex items-center justify-center bg-gray-100">
                      <span class="text-gray-500 text-sm flex items-center gap-2">
                        <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Loading...
                      </span>
                   </div>
                </div>
                <div class="space-y-4">
                   <div>
                      <label class="block text-sm font-medium text-gray-300 mb-2">Enter the 6-digit code from app</label>
                      <input type="text" id="verify2FAInput" class="w-full text-center text-2xl tracking-[0.5em] font-mono rounded-lg px-4 py-3 input-dark" placeholder="000000" maxlength="6">
                   </div>
                   <button onclick="verifyAndEnable2FA()" class="w-full btn-brand py-3 rounded-lg font-bold shadow-lg">Verify & Enable</button>
                </div>
             </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    lucide.createIcons();
    const is2FAEnabled = <%= is2FAEnabled %>;

    // --- Modal Logic ---
    function openPasswordModal() {
      document.getElementById('passwordModal').classList.add('active');
    }

    function closePasswordModal() {
      document.getElementById('passwordModal').classList.remove('active');
      document.getElementById('changePasswordForm').reset();
    }

    function open2FAModal() {
      document.getElementById('twoFAModal').classList.add('active');
      if (!is2FAEnabled) {
          generateQR();
      }
    }

    function close2FAModal() {
      document.getElementById('twoFAModal').classList.remove('active');
    }

    // Close Modals on outside click
    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        e.target.classList.remove('active');
      }
    });

    // --- Active Sessions Logic ---
    async function endSession(sessionId) {
        const result = await Swal.fire({
            title: 'End Session?',
            text: "This will log out the device associated with this session.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#374151',
            confirmButtonText: 'Yes, end it',
            background: '#111827',
            color: '#fff'
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch('/admin/profile/end-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId })
                });
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        title: 'Session Ended',
                        icon: 'success',
                        background: '#111827',
                        color: '#fff',
                        confirmButtonColor: '#c5a987'
                    }).then(() => location.reload());
                } else {
                     Swal.fire('Error', data.message, 'error');
                }
            } catch (e) {
                console.error(e);
            }
        }
    }

    // --- Password Logic ---
    function togglePassword(inputId) {
      const input = document.getElementById(inputId);
      const button = input.nextElementSibling;
      const icon = button.querySelector('i');
      
      if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-lucide', 'eye-off');
      } else {
        input.type = 'password';
        icon.setAttribute('data-lucide', 'eye');
      }
      lucide.createIcons();
    }

    document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      // ... (Same password logic as before) ...
      const currentPassword = document.getElementById('currentPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if(newPassword !== confirmPassword) {
         Swal.fire({ icon: 'error', title: 'Mismatch', text: 'New passwords do not match', background: '#111827', color: '#fff', confirmButtonColor: '#c5a987' });
         return;
      }

      try {
        const btn = this.querySelector('button[type="submit"]');
        const originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Updating...`;
        lucide.createIcons();

        const response = await fetch('/admin/profile/change-password', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
        });
        const data = await response.json();

        if (response.ok && data.success) {
            await Swal.fire({ icon: 'success', title: 'Success', text: 'Password updated', background: '#111827', color: '#fff', confirmButtonColor: '#c5a987' });
            closePasswordModal();
        } else {
             Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#111827', color: '#fff', confirmButtonColor: '#c5a987' });
        }
        btn.disabled = false;
        btn.innerHTML = originalHTML;
        lucide.createIcons();
      } catch(e) { console.error(e); }
    });


    // --- 2FA Logic ---
    async function generateQR() {
        if(is2FAEnabled) return;
        try {
            const res = await fetch('/admin/profile/2fa/generate', { method: 'POST' });
            const data = await res.json();
            if(data.success) {
                document.getElementById('qrCodeContainer').innerHTML = `<img src="${data.qrCode}" alt="QR Code" class="w-full h-full object-contain">`;
            }
        } catch(e) { console.error(e); }
    }

    async function verifyAndEnable2FA() {
        const token = document.getElementById('verify2FAInput').value;
        if(!token || token.length !== 6) {
             Swal.fire({ icon: 'error', title: 'Invalid Code', text: 'Please enter a 6-digit code', background: '#111827', color: '#fff' });
             return;
        }

        try {
            const res = await fetch('/admin/profile/2fa/enable', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ token })
            });
            const data = await res.json();
            if(data.success) {
                await Swal.fire({ icon: 'success', title: '2FA Enabled', background: '#111827', color: '#fff', confirmButtonColor: '#c5a987' });
                location.reload();
            } else {
                 Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#111827', color: '#fff' });
            }
        } catch(e) { console.error(e); }
    }

    const disableForm = document.getElementById('disable2FAForm');
    if(disableForm) {
        disableForm.addEventListener('submit', async(e) => {
            e.preventDefault();
            const password = document.getElementById('disable2FAPassword').value;
            const token = document.getElementById('disable2FAToken').value;

            try {
                const res = await fetch('/admin/profile/2fa/disable', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ password, token })
                });
                const data = await res.json();
                if(data.success) {
                    await Swal.fire({ icon: 'success', title: '2FA Disabled', background: '#111827', color: '#fff', confirmButtonColor: '#c5a987' });
                    location.reload();
                } else {
                     Swal.fire({ icon: 'error', title: 'Error', text: data.message, background: '#111827', color: '#fff' });
                }
            } catch(e) { console.error(e); }
        });
    }

  </script>
</body>
</html>