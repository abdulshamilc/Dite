<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <style>
        .bg-brand { background-color: #C5A987; }
        .text-brand { color: #C5A987; }
        .border-brand { border-color: #C5A987; }
    </style>
</head>
<body class="min-h-screen bg-black">
    <%
        // Sample data - in a real app, this would come from your database/API
        const stats = [
            { title: "Total Revenue", value: "$45,231.89", change: "+20.1%", icon: "dollar-sign" },
            { title: "Orders", value: "2,350", change: "+180.1%", icon: "shopping-cart" },
            { title: "Products", value: "12,234", change: "+19%", icon: "package" },
            { title: "Active Users", value: "573", change: "+201", icon: "users" }
        ];

        const recentOrders = [
            { id: "#3210", customer: "Olivia Martin", status: "Completed", amount: "$42.25", date: "2024-01-15", email: "olivia@example.com" },
            { id: "#3209", customer: "Jackson Lee", status: "Processing", amount: "$74.99", date: "2024-01-14", email: "jackson@example.com" },
            { id: "#3208", customer: "Isabella Nguyen", status: "Shipped", amount: "$99.99", date: "2024-01-14", email: "isabella@example.com" },
            { id: "#3207", customer: "William Kim", status: "Pending", amount: "$39.95", date: "2024-01-13", email: "william@example.com" },
            { id: "#3206", customer: "Sofia Davis", status: "Completed", amount: "$19.99", date: "2024-01-13", email: "sofia@example.com" },
            { id: "#3205", customer: "Michael Chen", status: "Cancelled", amount: "$129.99", date: "2024-01-12", email: "michael@example.com" },
            { id: "#3204", customer: "Emma Wilson", status: "Processing", amount: "$89.50", date: "2024-01-12", email: "emma@example.com" }
        ];

        const products = [
            { id: 1, name: "Wireless Headphones", price: "$99.99", stock: 45, status: "Active", category: "Electronics", sku: "WH001", image: "/wireless-headphones.png" },
            { id: 2, name: "Smart Watch", price: "$199.99", stock: 23, status: "Active", category: "Electronics", sku: "SW002", image: "/smartwatch-lifestyle.png" },
            { id: 3, name: "Laptop Stand", price: "$49.99", stock: 0, status: "Out of Stock", category: "Accessories", sku: "LS003", image: "/laptop-stand.png" },
            { id: 4, name: "USB-C Cable", price: "$19.99", stock: 156, status: "Active", category: "Accessories", sku: "UC004", image: "/usb-cable.png" },
            { id: 5, name: "Bluetooth Speaker", price: "$79.99", stock: 67, status: "Active", category: "Electronics", sku: "BS005", image: "/bluetooth-speaker.png" },
            { id: 6, name: "Phone Case", price: "$24.99", stock: 234, status: "Active", category: "Accessories", sku: "PC006", image: "/colorful-phone-case-display.png" }
        ];

        const customers = [
            { id: 1, name: "Olivia Martin", email: "olivia@example.com", phone: "+1 (555) 123-4567", totalOrders: 12, totalSpent: "$1,245.67", status: "Active", joinDate: "2023-08-15", lastOrder: "2024-01-15", location: "New York, NY" },
            { id: 2, name: "Jackson Lee", email: "jackson@example.com", phone: "+1 (555) 234-5678", totalOrders: 8, totalSpent: "$892.34", status: "Active", joinDate: "2023-09-22", lastOrder: "2024-01-14", location: "Los Angeles, CA" },
            { id: 3, name: "Isabella Nguyen", email: "isabella@example.com", phone: "+1 (555) 345-6789", totalOrders: 15, totalSpent: "$2,156.89", status: "VIP", joinDate: "2023-06-10", lastOrder: "2024-01-14", location: "San Francisco, CA" },
            { id: 4, name: "William Kim", email: "william@example.com", phone: "+1 (555) 456-7890", totalOrders: 3, totalSpent: "$234.56", status: "Active", joinDate: "2023-12-05", lastOrder: "2024-01-13", location: "Chicago, IL" },
            { id: 5, name: "Sofia Davis", email: "sofia@example.com", phone: "+1 (555) 567-8901", totalOrders: 22, totalSpent: "$3,456.78", status: "VIP", joinDate: "2023-04-18", lastOrder: "2024-01-13", location: "Miami, FL" },
            { id: 6, name: "Michael Chen", email: "michael@example.com", phone: "+1 (555) 678-9012", totalOrders: 1, totalSpent: "$129.99", status: "Inactive", joinDate: "2023-11-30", lastOrder: "2024-01-12", location: "Seattle, WA" }
        ];

        const coupons = [
            { id: 1, code: "WELCOME20", name: "Welcome Discount", type: "Percentage", value: "20%", minOrder: "$50.00", maxDiscount: "$100.00", usageLimit: 1000, usedCount: 245, status: "Active", startDate: "2024-01-01", endDate: "2024-03-31", description: "20% off for new customers" },
            { id: 2, code: "SAVE50", name: "Fixed Amount Discount", type: "Fixed Amount", value: "$50.00", minOrder: "$200.00", maxDiscount: "$50.00", usageLimit: 500, usedCount: 89, status: "Active", startDate: "2024-01-15", endDate: "2024-02-29", description: "$50 off on orders above $200" },
            { id: 3, code: "FREESHIP", name: "Free Shipping", type: "Free Shipping", value: "Free", minOrder: "$25.00", maxDiscount: "$15.00", usageLimit: 2000, usedCount: 1456, status: "Active", startDate: "2024-01-01", endDate: "2024-12-31", description: "Free shipping on orders above $25" },
            { id: 4, code: "EXPIRED10", name: "Expired Coupon", type: "Percentage", value: "10%", minOrder: "$30.00", maxDiscount: "$50.00", usageLimit: 100, usedCount: 67, status: "Expired", startDate: "2023-12-01", endDate: "2023-12-31", description: "10% off holiday discount" },
            { id: 5, code: "DRAFT25", name: "Draft Coupon", type: "Percentage", value: "25%", minOrder: "$100.00", maxDiscount: "$200.00", usageLimit: 200, usedCount: 0, status: "Draft", startDate: "2024-02-01", endDate: "2024-02-14", description: "Valentine's Day special discount" }
        ];
    %>

    <!-- Header -->
    <header class="border-b border-brand/20 bg-black">
        <div class="flex h-16 items-center px-6">
            <div class="flex items-center space-x-4">
                <h1 class="text-xl font-bold text-brand">E-Commerce Admin</h1>
            </div>
            <div class="ml-auto flex items-center space-x-4">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-2.5 top-2.5 h-4 w-4 text-gray-400"></i>
                    <input type="search" placeholder="Search..." class="w-[300px] pl-8 bg-gray-900 border-gray-700 text-white placeholder:text-gray-400 rounded px-3 py-2 border">
                </div>
                <button class="text-white hover:bg-gray-800 p-2 rounded">
                    <i data-lucide="bell" class="h-4 w-4"></i>
                </button>
                <button class="text-white hover:bg-gray-800 p-2 rounded">
                    <i data-lucide="settings" class="h-4 w-4"></i>
                </button>
            </div>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-64 border-r border-brand/20 bg-black">
            <nav class="space-y-2 p-4">
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center bg-brand text-black" data-tab="dashboard">
                    <i data-lucide="bar-chart-3" class="mr-2 h-4 w-4"></i>
                    Dashboard
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="orders">
                    <i data-lucide="shopping-cart" class="mr-2 h-4 w-4"></i>
                    Orders
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="products">
                    <i data-lucide="package" class="mr-2 h-4 w-4"></i>
                    Products
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="sales">
                    <i data-lucide="file-text" class="mr-2 h-4 w-4"></i>
                    Sales Report
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="customers">
                    <i data-lucide="users" class="mr-2 h-4 w-4"></i>
                    Customers
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="coupons">
                    <i data-lucide="gift" class="mr-2 h-4 w-4"></i>
                    Coupons
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="categories">
                    <i data-lucide="tag" class="mr-2 h-4 w-4"></i>
                    Categories
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="refunds">
                    <i data-lucide="rotate-ccw" class="mr-2 h-4 w-4"></i>
                    Refund/Return
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="banners">
                    <i data-lucide="image" class="mr-2 h-4 w-4"></i>
                    Banners
                </button>
                <button class="nav-btn w-full justify-start text-left px-4 py-2 rounded flex items-center text-white hover:bg-gray-800" data-tab="referrals">
                    <i data-lucide="user-plus" class="mr-2 h-4 w-4"></i>
                    Referrals
                </button>

                <div class="pt-4 mt-4 border-t border-brand/20">
                    <button class="w-full justify-start text-left px-4 py-2 rounded flex items-center text-red-400 hover:bg-red-900/20 hover:text-red-300" onclick="console.log('Logout clicked')">
                        <i data-lucide="log-out" class="mr-2 h-4 w-4"></i>
                        Logout
                    </button>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6 bg-black">
            <!-- Dashboard Tab -->
            <div id="dashboard" class="tab-content space-y-6">
                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                    <% stats.forEach(stat => { %>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg">
                        <div class="flex flex-row items-center justify-between space-y-0 pb-2 p-6">
                            <h3 class="text-sm font-medium text-white"><%= stat.title %></h3>
                            <i data-lucide="<%= stat.icon %>" class="h-4 w-4 text-brand"></i>
                        </div>
                        <div class="px-6 pb-6">
                            <div class="text-2xl font-bold text-brand"><%= stat.value %></div>
                            <p class="text-xs text-gray-400">
                                <span class="text-brand"><%= stat.change %></span> from last month
                            </p>
                        </div>
                    </div>
                    <% }); %>
                </div>

                <div class="bg-gray-900 border-brand/20 border rounded-lg">
                    <div class="p-6 pb-2">
                        <h3 class="text-white text-lg font-semibold">Recent Orders</h3>
                        <p class="text-gray-400 text-sm">You have <%= recentOrders.length %> orders this week.</p>
                    </div>
                    <div class="p-6 pt-0">
                        <div class="space-y-4">
                            <% recentOrders.forEach(order => { %>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-4">
                                    <div>
                                        <p class="text-sm font-medium text-white"><%= order.customer %></p>
                                        <p class="text-sm text-gray-400"><%= order.id %></p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <span class="px-2 py-1 text-xs rounded <%= order.status === 'Completed' ? 'bg-brand text-black' : 'bg-gray-700 text-white' %>">
                                        <%= order.status %>
                                    </span>
                                    <p class="text-sm font-medium text-brand"><%= order.amount %></p>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products Tab -->
            <div id="products" class="tab-content space-y-6 hidden">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-white">Products Management</h2>
                    <div class="flex space-x-2">
                        <button class="bg-transparent border border-brand text-brand hover:bg-brand hover:text-black px-4 py-2 rounded">Import Products</button>
                        <button class="bg-transparent border border-brand text-brand hover:bg-brand hover:text-black px-4 py-2 rounded">Export Products</button>
                        <button class="bg-brand text-black hover:opacity-90 px-4 py-2 rounded flex items-center">
                            <i data-lucide="plus" class="mr-2 h-4 w-4"></i>
                            Add Product
                        </button>
                    </div>
                </div>

                <div class="grid gap-4 md:grid-cols-4">
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="package" class="h-4 w-4 text-brand"></i>
                            <div>
                                <p class="text-sm text-gray-400">Total Products</p>
                                <p class="text-xl font-bold text-white"><%= products.length %></p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="eye" class="h-4 w-4 text-green-400"></i>
                            <div>
                                <p class="text-sm text-gray-400">Active</p>
                                <p class="text-xl font-bold text-white"><%= products.filter(p => p.status === 'Active').length %></p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="trash-2" class="h-4 w-4 text-red-400"></i>
                            <div>
                                <p class="text-sm text-gray-400">Out of Stock</p>
                                <p class="text-xl font-bold text-white"><%= products.filter(p => p.status === 'Out of Stock').length %></p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="dollar-sign" class="h-4 w-4 text-brand"></i>
                            <div>
                                <p class="text-sm text-gray-400">Total Value</p>
                                <p class="text-xl font-bold text-white">$12,234</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-900 border-brand/20 border rounded-lg">
                    <div class="p-6 pb-2">
                        <div class="flex items-center justify-between">
                            <h3 class="text-white text-lg font-semibold">All Products</h3>
                            <div class="flex space-x-2">
                                <select class="bg-gray-800 border border-brand/20 text-white rounded px-3 py-1 text-sm">
                                    <option>All Categories</option>
                                    <option>Electronics</option>
                                    <option>Accessories</option>
                                    <option>Clothing</option>
                                    <option>Home & Garden</option>
                                </select>
                                <select class="bg-gray-800 border border-brand/20 text-white rounded px-3 py-1 text-sm">
                                    <option>All Status</option>
                                    <option>Active</option>
                                    <option>Out of Stock</option>
                                    <option>Discontinued</option>
                                </select>
                                <input placeholder="Search products..." class="w-64 bg-gray-800 border-brand/20 text-white placeholder:text-gray-400 border rounded px-3 py-1">
                            </div>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-brand/20">
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Product</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">SKU</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Category</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Price</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Stock</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-brand/20">
                                <% products.forEach(product => { %>
                                <tr class="hover:bg-gray-800/50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center space-x-3">
                                            <img src="<%= product.image || '/placeholder.svg' %>" alt="<%= product.name %>" class="h-10 w-10 rounded-lg object-cover border border-brand/20">
                                            <div>
                                                <p class="text-sm font-medium text-white"><%= product.name %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= product.sku %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300"><%= product.category %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-brand"><%= product.price %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm <%= product.stock === 0 ? 'text-red-400' : product.stock < 20 ? 'text-brand' : 'text-white' %>">
                                        <%= product.stock %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-2 py-1 text-xs rounded <%= product.status === 'Active' ? 'bg-green-600 text-white' : product.status === 'Out of Stock' ? 'bg-red-600 text-white' : 'bg-gray-600 text-white' %>">
                                            <%= product.status %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <div class="flex space-x-2">
                                            <button class="text-white hover:bg-gray-800 p-1 rounded" title="View Product">
                                                <i data-lucide="eye" class="h-4 w-4"></i>
                                            </button>
                                            <button class="text-white hover:bg-gray-800 p-1 rounded" title="Edit Product">
                                                <i data-lucide="edit" class="h-4 w-4"></i>
                                            </button>
                                            <button class="text-brand hover:bg-brand/20 p-1 rounded" title="Duplicate Product">
                                                <i data-lucide="plus" class="h-4 w-4"></i>
                                            </button>
                                            <button class="text-red-400 hover:bg-red-900/20 p-1 rounded" title="Delete Product">
                                                <i data-lucide="trash-2" class="h-4 w-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <input type="checkbox" class="rounded border-brand/20 bg-gray-800">
                        <span class="text-sm text-gray-400">Select all</span>
                        <button class="border border-brand/20 text-gray-400 ml-4 bg-transparent px-3 py-1 rounded text-sm">Bulk Edit</button>
                        <button class="border border-red-600/20 text-red-400 bg-transparent px-3 py-1 rounded text-sm">Bulk Delete</button>
                    </div>
                    <div class="flex items-center space-x-4">
                        <p class="text-sm text-gray-400">Showing 1-6 of <%= products.length %> products</p>
                        <div class="flex space-x-2">
                            <button class="border border-brand/20 text-gray-400 bg-transparent px-3 py-1 rounded text-sm">Previous</button>
                            <button class="border border-brand/20 text-gray-400 bg-transparent px-3 py-1 rounded text-sm">Next</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orders Tab -->
            <div id="orders" class="tab-content space-y-6 hidden">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-white">Orders Management</h2>
                    <div class="flex space-x-2">
                        <button class="bg-transparent border border-brand text-brand hover:bg-brand hover:text-black px-4 py-2 rounded">Export Orders</button>
                        <button class="bg-brand text-black hover:opacity-90 px-4 py-2 rounded flex items-center">
                            <i data-lucide="plus" class="mr-2 h-4 w-4"></i>
                            New Order
                        </button>
                    </div>
                </div>

                <div class="grid gap-4 md:grid-cols-4">
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="shopping-cart" class="h-4 w-4 text-brand"></i>
                            <div>
                                <p class="text-sm text-gray-400">Total Orders</p>
                                <p class="text-xl font-bold text-white">2,350</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="package" class="h-4 w-4 text-green-400"></i>
                            <div>
                                <p class="text-sm text-gray-400">Completed</p>
                                <p class="text-xl font-bold text-white">1,890</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="rotate-ccw" class="h-4 w-4 text-blue-400"></i>
                            <div>
                                <p class="text-sm text-gray-400">Processing</p>
                                <p class="text-xl font-bold text-white">320</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-900 border-brand/20 border rounded-lg p-4">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="dollar-sign" class="h-4 w-4 text-yellow-400"></i>
                            <div>
                                <p class="text-sm text-gray-400">Revenue</p>
                                <p class="text-xl font-bold text-white">$45,231</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-900 border-brand/20 border rounded-lg">
                    <div class="p-6 pb-2">
                        <div class="flex items-center justify-between">
                            <h3 class="text-white text-lg font-semibold">All Orders</h3>
                            <div class="flex space-x-2">
                                <select class="bg-gray-800 border border-brand/20 text-white rounded px-3 py-1 text-sm">
                                    <option>All Status</option>
                                    <option>Pending</option>
                                    <option>Processing</option>
                                    <option>Shipped</option>
                                    <option>Completed</option>
                                    <option>Cancelled</option>
                                </select>
                                <input placeholder="Search orders..." class="w-64 bg-gray-800 border-brand/20 text-white placeholder:text-gray-400 border rounded px-3 py-1">
                            </div>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-brand/20">
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Order ID</th>
