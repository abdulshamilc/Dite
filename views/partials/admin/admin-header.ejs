<header class="bg-gradient-to-r from-[#0b0f19] via-[#0d1220] to-[#0b0f19] sticky top-0 z-50 border-b border-gray-800/50 backdrop-blur-sm">
  <div class="flex h-20 items-center justify-between px-6">
    <!--  Logo -->
    <div class="flex items-center space-x-4">
      <img src="/images/logo/DiteLogo.png" alt="Dite Logo" class="h-10 w-auto drop-shadow-lg">
    </div>
    
    <!--  Notification and User Profile Buttons -->
    <div class="flex items-center space-x-3">
      <div class="relative">
        <button id="notificationBtn" class="text-gray-300 hover:text-white hover:bg-gray-800/80 p-2.5 rounded-lg transition-all duration-200 relative group">
          <i data-lucide="bell" class="h-5 w-5 group-hover:scale-110 transition-transform"></i>
          <span id="notificationCount" class="hidden absolute -top-1 -right-1 bg-gradient-to-br from-red-500 to-red-600 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center shadow-lg ring-2 ring-[#0b0f19] animate-pulse">0</span>
        </button>
        
        <!-- Notification Dropdown -->
        <div id="notificationDropdown" class="hidden absolute right-0 mt-3 w-96 bg-gradient-to-b from-gray-900 to-gray-950 border border-gray-800 rounded-xl shadow-2xl overflow-hidden">
          <!-- Header -->
          <div class="px-5 py-4 border-b border-gray-800 bg-gray-900/50">
            <div class="flex items-center justify-between">
              <h3 class="text-white font-semibold text-base flex items-center gap-2">
                <i data-lucide="bell" class="h-4 w-4 text-blue-400"></i>
                Notifications
              </h3>
              <button id="markAllReadBtn" class="text-xs text-blue-400 hover:text-blue-300 transition-colors font-medium hover:underline">
                Mark all read
              </button>
            </div>
          </div>
          
          <!-- Notification List -->
          <div id="notificationList" class="max-h-[420px] overflow-y-auto custom-scrollbar">
            <!-- Populated by JS -->
          </div>
          
          <!-- Footer -->
          <div class="px-5 py-3 border-t border-gray-800 bg-gray-900/50 text-center">
            <button id="clearReadBtn" class="text-xs text-red-400 hover:text-red-300 transition-colors font-medium hover:underline">
              Clear read notifications
            </button>
          </div>
        </div>
      </div>

      <button class="text-gray-300 hover:text-white hover:bg-gray-800/80 p-2.5 rounded-lg transition-all duration-200 group">
        <i data-lucide="user" class="h-5 w-5 group-hover:scale-110 transition-transform"></i>
      </button>
    </div>
  </div>
</header>
<%- include("./flash-messages") %>

<style>
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(31, 41, 55, 0.5);
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(75, 85, 99, 0.8);
  border-radius: 3px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(107, 114, 128, 0.9);
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('notificationBtn');
        const dropdown = document.getElementById('notificationDropdown');
        const badge = document.getElementById('notificationCount');
        const list = document.getElementById('notificationList');
        const markAllBtn = document.getElementById('markAllReadBtn');
        const clearBtn = document.getElementById('clearReadBtn');

        // Initial Fetch
        fetchNotifications();

        // Toggle Dropdown
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
            
            if(!dropdown.classList.contains('hidden')) {
                fetchNotifications();
            }
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });

        // Fetch Data
        async function fetchNotifications() {
            try {
                const res = await fetch('/admin/notifications');
                const data = await res.json();
                
                renderNotifications(data.notifications || []);
                updateBadge(data.unreadCount || 0);

            } catch(err) {
                console.error('Failed to load notifications', err);
            }
        }

        function updateBadge(count) {
            if(count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function renderNotifications(notifs) {
            if(notifs.length === 0) {
                list.innerHTML = `
                    <div class="flex flex-col items-center justify-center p-12 text-gray-500">
                        <div class="bg-gray-800/50 p-4 rounded-full mb-3">
                            <i data-lucide="bell-off" class="h-8 w-8 opacity-50"></i>
                        </div>
                        <span class="text-sm font-medium">No notifications yet</span>
                        <span class="text-xs text-gray-600 mt-1">We'll notify you when something arrives</span>
                    </div>`;
                lucide.createIcons();
                return;
            }

            list.innerHTML = notifs.map(n => `
                <div class="px-5 py-4 border-b border-gray-800/50 hover:bg-gray-800/40 transition-all duration-200 ${n.isRead ? 'opacity-60' : 'bg-gradient-to-r from-gray-800/20 to-transparent'} group">
                    <div class="flex items-center justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1.5">
                                <span class="text-[10px] font-bold uppercase tracking-wider ${getTypeColor(n.type)} ${getTypeBg(n.type)} px-2 py-0.5 rounded-md whitespace-nowrap">${n.type}</span>
                                <span class="text-[10px] text-gray-500 font-medium whitespace-nowrap">${formatTime(n.createdAt)}</span>
                            </div>
                            <p class="text-sm text-gray-300 leading-relaxed truncate-2-lines">${n.message}</p>
                        </div>
                        
                        <div class="flex-shrink-0 flex items-center self-center">
                            ${!n.isRead ? `
                                <button onclick="markRead('${n._id}', event)" title="Mark as read" class="text-gray-600 hover:text-blue-500 transition-colors p-2 rounded-full hover:bg-gray-800/50 focus:outline-none transform hover:scale-110 active:scale-95 transition-all duration-200">
                                    <i data-lucide="check-check" class="h-5 w-5"></i>
                                </button>
                            ` : `
                                <div class="text-blue-500 p-2" title="Read">
                                    <i data-lucide="check-check" class="h-5 w-5"></i>
                                </div>
                            `}
                        </div>
                    </div>
                </div>
            `).join('');
            
            lucide.createIcons();
        }

        function getTypeColor(type) {
            switch(type) {
                case 'stock': return 'text-red-400';
                case 'return': return 'text-orange-400';
                case 'offer': return 'text-blue-400';
                case 'coupon': return 'text-purple-400';
                default: return 'text-gray-400';
            }
        }

        function getTypeBg(type) {
            switch(type) {
                case 'stock': return 'bg-red-500/10 border border-red-500/20';
                case 'return': return 'bg-orange-500/10 border border-orange-500/20';
                case 'offer': return 'bg-blue-500/10 border border-blue-500/20';
                case 'coupon': return 'bg-purple-500/10 border border-purple-500/20';
                default: return 'bg-gray-500/10 border border-gray-500/20';
            }
        }

        function formatTime(date) {
            const now = new Date();
            const notifDate = new Date(date);
            const diffMs = now - notifDate;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins}m ago`;
            if (diffHours < 24) return `${diffHours}h ago`;
            if (diffDays < 7) return `${diffDays}d ago`;
            return notifDate.toLocaleDateString();
        }

        // Global exposure for onclick
        window.markRead = async (id, event) => {
            try {
                // Optimistic update
                if(event && event.currentTarget) {
                    event.currentTarget.classList.remove('text-gray-600', 'hover:text-blue-500');
                    event.currentTarget.classList.add('text-blue-500', 'animate-pulse');
                    event.currentTarget.innerHTML = `<i data-lucide="check-check" class="h-5 w-5"></i>`;
                    lucide.createIcons();
                }
                
                await fetch(`/admin/notifications/${id}/read`, { method: 'PATCH' });
                fetchNotifications();
            } catch(err) { console.error(err); }
        };

        markAllBtn.addEventListener('click', async () => {
            try {
                await fetch('/admin/notifications/read-all', { method: 'PATCH' });
                fetchNotifications();
            } catch(err) { console.error(err); }
        });

        clearBtn.addEventListener('click', async () => {
            try {
                await fetch('/admin/notifications/clear-read', { method: 'DELETE' });
                fetchNotifications();
            } catch(err) { console.error(err); }
        });
        
        // Poll every 60s
        setInterval(fetchNotifications, 60000);
    });
</script>