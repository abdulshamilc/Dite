    </a>
    <a
      href="/admin/sales"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="file-text" class="mr-3 h-5 w-5"></i>
      Sales Report
    </a>
    <a
      href="/admin/customers"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="users" class="mr-3 h-5 w-5"></i>
      Customers
    </a>
    <a
      href="/admin/coupons"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="gift" class="mr-3 h-5 w-5"></i>
      Coupons
    </a>
    <a
      href="/admin/categories"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
