<style>
  /* Admin Sidebar Responsive Styles */
  .admin-sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .admin-sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 1024px) {
    .admin-sidebar-overlay {
      display: block;
      top: 60px; /* Below header */
    }

    .admin-sidebar {
      position: fixed !important;
      top: 60px !important; /* Below header */
      left: 0 !important;
      width: 250px !important;
      height: calc(100vh - 60px) !important;
      z-index: 45;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 4px 0 15px rgba(0, 0, 0, 0.4);
      padding-top: 10px;
      overflow-y: auto;
    }

    .admin-sidebar.active {
      transform: translateX(0);
    }

    .admin-sidebar-close {
      display: none !important; /* Hide close button since sidebar is below header */
    }
  }

  @media (max-width: 768px) {
    .admin-sidebar-overlay {
      top: 56px;
    }

    .admin-sidebar {
      top: 56px !important;
      width: 220px !important;
      height: calc(100vh - 56px) !important;
    }

    .admin-sidebar nav {
      padding: 8px !important;
    }

    .admin-sidebar nav .space-y-3 {
      gap: 4px !important;
    }

    .admin-sidebar nav a {
      padding: 10px 12px !important;
      font-size: 13px;
      border-radius: 6px;
    }

    .admin-sidebar nav a i {
      width: 18px;
      height: 18px;
      margin-right: 8px;
    }
  }

  @media (max-width: 480px) {
    .admin-sidebar-overlay {
      top: 50px;
    }

    .admin-sidebar {
      top: 50px !important;
      width: 200px !important;
      height: calc(100vh - 50px) !important;
    }

    .admin-sidebar nav {
      padding: 6px !important;
    }

    .admin-sidebar nav a {
      padding: 8px 10px !important;
      font-size: 12px;
      border-radius: 5px;
    }

    .admin-sidebar nav a i {
      width: 16px;
      height: 16px;
      margin-right: 6px;
    }
  }

  .admin-sidebar-close {
    display: none;
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 18px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .admin-sidebar-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<!-- Sidebar Overlay -->
<div class="admin-sidebar-overlay" id="adminSidebarOverlay" onclick="toggleAdminSidebar()"></div>

<!-- Sidebar -->
<aside id="adminSidebar" class="admin-sidebar w-64 bg-black sticky top-20 h-[calc(100vh-5rem)] overflow-y-auto">
  <!-- Close button for mobile -->
  <button class="admin-sidebar-close" id="adminSidebarClose" onclick="toggleAdminSidebar()">&times;</button>

  <nav class="space-y-3 p-5">
    <a
      href="/admin/dashboard"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="bar-chart-3" class="mr-3 h-5 w-5"></i>
      Dashboard
    </a>
    <a
      href="/admin/orders"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="shopping-cart" class="mr-3 h-5 w-5"></i>
      Orders
    </a>
    <a
      href="/admin/products"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="package" class="mr-3 h-5 w-5"></i>
      Products
    </a>
    <a
      href="/admin/sales"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="file-text" class="mr-3 h-5 w-5"></i>
      Sales Report
    </a>
    <a
      href="/admin/customers"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="users" class="mr-3 h-5 w-5"></i>
      Customers
    </a>
    <a
      href="/admin/coupons"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="gift" class="mr-3 h-5 w-5"></i>
      Coupons
    </a>
    <a
      href="/admin/categories"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="tag" class="mr-3 h-5 w-5"></i>
      Categories
    </a>
    <a
      href="/admin/return"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="rotate-ccw" class="mr-3 h-5 w-5"></i>
      Refund/Return
    </a>
    <a
      href="/admin/offers"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="percent" class="mr-3 h-5 w-5"></i>
      Offers
    </a>

    <div class="pt-5 mt-5 border-t border-brand/20">
      <a
        href="/admin/logout"
        class="logout-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-red-400 hover:bg-red-900/20 hover:text-red-300"
      >
        <i data-lucide="log-out" class="mr-3 h-5 w-5"></i>
        Logout
      </a>
    </div>
  </nav>
</aside>

<script>
  // Admin Sidebar Toggle Function
  function toggleAdminSidebar() {
    const sidebar = document.getElementById('adminSidebar');
    const overlay = document.getElementById('adminSidebarOverlay');
    const hamburger = document.getElementById('adminHamburger');

    if (sidebar && overlay) {
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
      
      if (hamburger) {
        hamburger.classList.toggle('active');
      }

      // Toggle body scroll
      if (sidebar.classList.contains('active')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    }
  }

  // Close sidebar when clicking on a menu item (mobile only)
  document.addEventListener('DOMContentLoaded', function() {
    const navBtns = document.querySelectorAll('.admin-sidebar .nav-btn, .admin-sidebar .logout-btn');
    
    navBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        if (window.innerWidth <= 1024) {
          const sidebar = document.getElementById('adminSidebar');
          const overlay = document.getElementById('adminSidebarOverlay');
          const hamburger = document.getElementById('adminHamburger');
          
          if (sidebar) sidebar.classList.remove('active');
          if (overlay) overlay.classList.remove('active');
          if (hamburger) hamburger.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    });
  });

  // Active state highlighting
  document.addEventListener("DOMContentLoaded", function () {
    const navBtns = document.querySelectorAll(".nav-btn");
    const currentPath = window.location.pathname;

    navBtns.forEach((btn) => {
      const btnPath = new URL(btn.href, window.location.origin).pathname;
      
      let isActive = false;
      if (btnPath === '/admin/dashboard') {
         isActive = currentPath === btnPath;
      } else {
         isActive = currentPath.startsWith(btnPath);
      }

      if (isActive) {
        btn.classList.add("bg-brand", "text-black");
        btn.classList.remove("text-white");
      } else {
        btn.classList.remove("bg-brand", "text-black");
        btn.classList.add("text-white");
      }
    });
  });
</script>
