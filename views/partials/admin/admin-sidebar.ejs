    <div class="pt-5 mt-5 border-t border-brand/20">
      <a
        href="/admin/logout"
        class="logout-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-red-400 hover:bg-red-900/20 hover:text-red-300"
      >
        <i data-lucide="log-out" class="mr-3 h-5 w-5"></i>
        Logout
      </a>
    </div>
  </nav>
</aside>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const navBtns = document.querySelectorAll(".nav-btn");
    const currentPath = window.location.pathname;

    navBtns.forEach((btn) => {
      const btnPath = new URL(btn.href, window.location.origin).pathname;
      
      // Check for exact match or if the current path starts with the button path (excluding dashboard to avoid false positives)
      // Special case: exact match for dashboard, startswith for others
      let isActive = false;
      if (btnPath === '/admin/dashboard') {
         isActive = currentPath === btnPath;
      } else {
         isActive = currentPath.startsWith(btnPath);
      }

      if (isActive) {
        btn.classList.add("bg-brand", "text-black");
        btn.classList.remove("text-white");
      } else {
        btn.classList.remove("bg-brand", "text-black");
        btn.classList.add("text-white");
      }
    });
  });
</script>