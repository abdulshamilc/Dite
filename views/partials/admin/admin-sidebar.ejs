      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="shopping-cart" class="mr-3 h-5 w-5"></i>
      Orders
    </a>
    <a
      href="/admin/products"
      class="nav-btn w-full justify-start text-left px-4 py-3 rounded-lg flex items-center text-white hover:bg-gray-800"
    >
      <i data-lucide="package" class="mr-3 h-5 w-5"></i>
