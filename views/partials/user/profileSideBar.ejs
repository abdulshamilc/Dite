<style>
  /* Mobile Toggle Button */
  .sidebar-toggle {
    display: none;
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 1100;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #d4af37, #c5a987);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
    transition: all 0.3s ease;
  }

  .sidebar-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
  }

  .sidebar-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #1a1a1a;
    margin: 5px auto;
    transition: all 0.3s ease;
    border-radius: 2px;
  }

  .sidebar-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .sidebar-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .sidebar-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Overlay */
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Sidebar Base */
  .sidebar {
    width: 100%;
    background: #201a14;
    border-radius: 14px;
    padding: 16px;
  }

  .greeting {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #2a221b;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 12px;
  }

  .avatar-sm {
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: #3a2f25;
    display: grid;
    place-items: center;
    color: #e8dccf;
    font-weight: 700;
  }

  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    outline: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text);
    transition: all 0.2s ease;
  }

  .menu a:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .menu a[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 85%, #000 15%);
    color: #121212;
    outline-color: color-mix(in srgb, var(--accent) 90%, #000 10%);
    font-weight: 700;
  }

  .menu .bullet {
    inline-size: 18px;
    block-size: 18px;
    border-radius: 5px;
    background: rgba(0, 0, 0, 0.4);
    outline: 1px solid rgba(255, 255, 255, 0.18);
  }

  .sidebar-footer {
    margin-top: 12px;
    background: #bfa688;
    color: #1a1a1a;
    border-radius: 10px;
    padding: 12px;
    text-align: center;
    font-weight: 600;
    opacity: 0.85;
  }

  /* Desktop */
  @media (min-width: 960px) {
    .sidebar {
      width: 260px;
      position: sticky;
      top: 24px;
    }
  }

  /* Mobile - Slide from Left */
  @media (max-width: 959px) {
    .sidebar-toggle {
      display: block;
    }

    .sidebar-overlay {
      display: block;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: 280px;
      max-width: 85vw;
      height: 100vh;
      z-index: 1060;
      border-radius: 0 16px 16px 0;
      padding: 80px 16px 24px;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
    }

    .sidebar.active {
      transform: translateX(0);
    }

    /* Close button inside sidebar for mobile */
    .sidebar-close {
      position: absolute;
      top: 20px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .sidebar-close:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  }

  @media (min-width: 960px) {
    .sidebar-close {
      display: none;
    }
  }
</style>

<!-- Mobile Toggle Button -->
<button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="profileSidebar" aria-label="Profile navigation">
  <!-- Close button for mobile -->
  <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">&times;</button>

  <div class="greeting">
    <img src="<%= user.image ? user.image : `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=3a2f25&color=d3a35b&size=128&bold=true` %>" class="avatar-sm" style="object-fit: cover; display: block;" alt="<%= user.name %>">
    <div>Hello, <strong><%= user.name %></strong></div>
  </div>

  <nav>
  <ul class="menu">
    <li>
      <a href="/profile" aria-current="<%= currentPath === '/profile' ? 'page' : false %>">
        <span class="bullet"></span> Profile
      </a>
    </li>

    <li>
      <a href="/orders" aria-current="<%= currentPath === '/orders' ? 'page' : false %>">
        <span class="bullet"></span> My Orders
      </a>
    </li>

    <li>
      <a href="/wallet" aria-current="<%= currentPath === '/wallet' ? 'page' : false %>">
        <span class="bullet"></span> Wallet
      </a>
    </li>

    <li>
      <a href="/address" aria-current="<%= currentPath === '/address' ? 'page' : false %>">
        <span class="bullet"></span> Address
      </a>
    </li>

    <li>
      <a href="/referrals" aria-current="<%= currentPath === '/referrals' ? 'page' : false %>">
        <span class="bullet"></span> Refer and Earn
      </a>
    </li>

    <li>
      <a href="/security" aria-current="<%= currentPath === '/security' ? 'page' : false %>">
        <span class="bullet"></span> Security
      </a>
    </li>

    <li>
      <a href="/logout" aria-current="<%= currentPath === '/logout' ? 'page' : false %>">
        <span class="bullet"></span> LogOut
      </a>
    </li>
  </ul>
</nav>


  <div class="sidebar-footer">Account</div>
</aside>

<script>
(function() {
  const toggle = document.getElementById('sidebarToggle');
  const sidebar = document.getElementById('profileSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  const closeBtn = document.getElementById('sidebarClose');

  function openSidebar() {
    sidebar.classList.add('active');
    overlay.classList.add('active');
    toggle.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar.classList.remove('active');
    overlay.classList.remove('active');
    toggle.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (toggle) {
    toggle.addEventListener('click', function() {
      if (sidebar.classList.contains('active')) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });
  }

  if (overlay) {
    overlay.addEventListener('click', closeSidebar);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeSidebar);
  }

  // Close on menu item click (for mobile)
  const menuLinks = sidebar.querySelectorAll('.menu a');
  menuLinks.forEach(link => {
    link.addEventListener('click', function() {
      if (window.innerWidth < 960) {
        closeSidebar();
      }
    });
  });
})();
</script>
