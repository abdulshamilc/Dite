<header class="header bg-black">
  <nav class="nav flex items-center justify-between py-4">
    
    <!-- Logo -->
    <div class="logo">
      <img src="/images/logo/DiteLogo.png" alt="Dité Logo" class="h-10" />
    </div>

    <!-- Hamburger Menu Button -->
    <div class="hamburger" onclick="toggleMobileMenu()">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <!-- Navigation Menu -->
    <ul id="nav-menu" class="nav-menu flex space-x-6 text-white font-medium">
      <li><a href="/" class="hover:text-gray-300">Home</a></li>
      <li><a href="/shop" class="hover:text-gray-300">Shop</a></li>
      <li><a href="/collections" class="hover:text-gray-300">Collections</a></li>
    </ul>

    <!-- Icons -->
    <div class="nav-icons flex space-x-4 text-white text-lg relative">
      
      <!-- Wishlist Icon (FIXED) -->
      <% if (session && session.user) { %>
        <a href="/wishlist">
          <i class="fas fa-heart cursor-pointer hover:text-gray-300 text-white"></i>
        </a>
      <% } else { %>
        <a href="/login">
          <i class="fas fa-heart cursor-pointer hover:text-gray-300 text-white"></i>
        </a>
      <% } %>

      <!-- Profile Dropdown or Login Redirect -->
      <% if (session && session.user) { %>
        <div class="relative group">
          <a href="#" class="hover:text-gray-300 profile-icon">
            <i class="fas fa-user"></i>
          </a>
          <ul class="absolute bg-black text-white rounded-md py-2 w-40 right-0">
            <li><a href="/profile" class="block px-4 py-2 hover:bg-gray-800">Profile</a></li>
            <li><a href="/orders" class="block px-4 py-2 hover:bg-gray-800">Orders</a></li>
            <li><a href="/wishlist" class="block px-4 py-2 hover:bg-gray-800">Wishlist</a></li>
            <li><a href="/logout" class="block px-4 py-2 hover:bg-gray-800">Logout</a></li>
          </ul>
        </div>
      <% } else { %>
        <a href="/login" class="hover:text-gray-300">
          <i class="fas fa-user"></i>
        </a>
      <% } %>

      <!-- Cart Icon with Badge -->
      <div class="relative">
        <a href="/cart" class="hover:text-gray-300">
          <i class="fas fa-shopping-bag"></i>
        </a>
        <% if (session && session.cart && session.cart.itemCount > 0) { %>
          <span class="cart-count"><%= session.cart.itemCount %></span>
        <% } else { %>
          <span class="cart-count" style="display: none;">0</span>
        <% } %>
      </div>

    </div>
  </nav>
</header>

<!-- Profile Dropdown Script -->
<% if (session && session.user) { %>
<script>
  const profileIcon = document.querySelector('.profile-icon');
  const group = profileIcon.parentElement;

  profileIcon.addEventListener('click', (e) => {
    e.preventDefault();
    group.classList.toggle('active');
  });

  document.addEventListener('click', (e) => {
    if (!group.contains(e.target)) {
      group.classList.remove('active');
    }
  });
</script>
<% } %>

<!-- Mobile Menu Script -->
<script>
  function toggleMobileMenu() {
    const navMenu = document.getElementById('nav-menu');
    navMenu.classList.toggle('active');
  }

  document.addEventListener('click', (e) => {
    const navMenu = document.getElementById('nav-menu');
    const hamburger = document.querySelector('.hamburger');
    
    if (!hamburger.contains(e.target) && !navMenu.contains(e.target)) {
      navMenu.classList.remove('active');
    }
  });
</script>
