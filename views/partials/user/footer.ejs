<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dité Footer</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cormorant Garamond', 'Georgia', serif;
            background: #0a0a0a;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Spacer for demo */
        .content-spacer {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.3);
        }

        /* Footer Styles */
        .footer {
            background: linear-gradient(180deg, rgba(10, 10, 10, 0.95) 0%, rgba(0, 0, 0, 0.98) 100%);
            border-top: 1px solid rgba(212, 175, 55, 0.2);
            position: relative;
            overflow: hidden;
        }

        .footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, #d4af37, transparent);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; }
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Footer Top - Logo & Socials */
        .footer-top {
            padding: 4rem 2rem 3rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2.5rem;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        }

        .footer-logo {
            transition: transform 0.4s ease;
        }

        .footer-logo:hover {
            transform: scale(1.05);
        }

        .footer-logo img {
            height: 60px;
            width: auto;
            filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.3));
            transition: filter 0.3s ease;
        }

        .footer-logo:hover img {
            filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.6));
        }

        .footer-socials {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .footer-socials a {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 50%;
            color: #d4af37;
            font-size: 1.3rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .footer-socials a::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.2), transparent);
            transform: translate(-50%, -50%);
            transition: all 0.5s ease;
        }

        .footer-socials a:hover::before {
            width: 200%;
            height: 200%;
        }

        .footer-socials a:hover {
            background: rgba(212, 175, 55, 0.1);
            border-color: #d4af37;
            transform: translateY(-8px) rotate(360deg);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
        }

        .footer-socials a i {
            position: relative;
            z-index: 1;
        }

        /* Footer Middle - Links & Newsletter */
        .footer-middle {
            padding: 4rem 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        }

        .footer-links h4,
        .footer-newsletter h4 {
            color: #d4af37;
            font-size: 1.3rem;
            font-weight: 400;
            letter-spacing: 2px;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            position: relative;
            display: inline-block;
        }

        .footer-links h4::after,
        .footer-newsletter h4::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 40px;
            height: 2px;
            background: linear-gradient(90deg, #d4af37, transparent);
            animation: expandLine 2s ease-in-out infinite;
        }

        @keyframes expandLine {
            0%, 100% { width: 40px; }
            50% { width: 60px; }
        }

        .footer-links ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-links ul li a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            font-size: 1.05rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            display: inline-block;
            position: relative;
            padding-left: 20px;
        }

        .footer-links ul li a::before {
            content: '→';
            position: absolute;
            left: 0;
            opacity: 0;
            transform: translateX(-10px);
            transition: all 0.3s ease;
            color: #d4af37;
        }

        .footer-links ul li a:hover {
            color: #d4af37;
            padding-left: 25px;
        }

        .footer-links ul li a:hover::before {
            opacity: 1;
            transform: translateX(0);
        }

        /* Newsletter Form */
        .footer-newsletter form {
            display: flex;
            margin-top: 1.5rem;
            position: relative;
        }

        .footer-newsletter input {
            flex: 1;
            padding: 1rem 1.5rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 50px 0 0 50px;
            color: #fff;
            font-size: 1rem;
            letter-spacing: 0.5px;
            outline: none;
            transition: all 0.3s ease;
        }

        .footer-newsletter input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .footer-newsletter input:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #d4af37;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
        }

        .footer-newsletter button {
            padding: 1rem 2rem;
            background: linear-gradient(135deg, #d4af37, #f4e5c3);
            border: none;
            border-radius: 0 50px 50px 0;
            color: #000;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .footer-newsletter button::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: all 0.5s ease;
        }

        .footer-newsletter button:hover::before {
            width: 300%;
            height: 300%;
        }

        .footer-newsletter button:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
        }

        .footer-newsletter button i {
            position: relative;
            z-index: 1;
            transition: transform 0.3s ease;
        }

        .footer-newsletter button:hover i {
            transform: translateX(5px);
        }

        /* Footer Bottom */
        .footer-bottom {
            padding: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .footer-bottom p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.95rem;
            letter-spacing: 1px;
        }

        .footer-bottom-links {
            display: flex;
            gap: 2rem;
        }

        .footer-bottom-links a {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 0.95rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            position: relative;
        }

        .footer-bottom-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1px;
            background: #d4af37;
            transition: width 0.3s ease;
        }

        .footer-bottom-links a:hover {
            color: #d4af37;
        }

        .footer-bottom-links a:hover::after {
            width: 100%;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .footer-top {
                padding: 3rem 1.5rem 2rem;
                gap: 2rem;
            }

            .footer-logo img {
                height: 45px;
            }

            .footer-socials {
                gap: 1.5rem;
            }

            .footer-socials a {
                width: 45px;
                height: 45px;
                font-size: 1.1rem;
            }

            .footer-middle {
                padding: 3rem 1.5rem;
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .footer-newsletter form {
                flex-direction: column;
                gap: 1rem;
            }

            .footer-newsletter input,
            .footer-newsletter button {
                border-radius: 50px;
            }

            .footer-bottom {
                padding: 1.5rem;
                flex-direction: column;
                text-align: center;
            }

            .footer-bottom-links {
                flex-direction: column;
                gap: 1rem;
            }
        }

        @media (max-width: 480px) {
            .footer-socials {
                gap: 1rem;
            }

            .footer-socials a {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="content-spacer">
        <p>← Your page content here →</p>
    </div>

    <footer class="footer">
        <div class="footer-top container">
            <div class="footer-logo">
                <img src="/images/logo/DiteLogo.png" alt="Dité Logo">
            </div>

            <div class="footer-socials">
                <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                <a href="https://www.x.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fab fa-x-twitter"></i></a>
                <a href="https://www.youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
            </div>
        </div>

        <div class="footer-middle container">
            <div class="footer-links">
                <h4>Home</h4>
                <ul>
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/faq">FAQ's</a></li>
                </ul>
            </div>

            <div class="footer-links">
                <h4>Products</h4>
                <ul>
                    <li><a href="/shop/men">Mens</a></li>
                    <li><a href="/shop/women">Women</a></li>
                    <li><a href="/shop/unisex">Unisex</a></li>
                </ul>
            </div>

            <div class="footer-newsletter">
                <h4>Subscribe to Newsletter</h4>
                <form action="#" method="POST">
                    <input type="email" placeholder="Your Email" required>
                    <button type="submit" aria-label="Subscribe">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="footer-bottom container">
            <p>© 2025 Dité. All rights reserved.</p>
            <div class="footer-bottom-links">
                <a href="/terms">Terms & Conditions</a>
                <a href="/privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>
</body>
</html>